timestamp=2026-11-09T10:42:11.017Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /tmp/read_production.py << 'PY'\nfrom pathlib import Path\nimport pandas as pd\n\ndef read_production(farm_id):\n    fname = f'production_{farm_id}.csv'\n    p = Path('/app/dataset') / fname\n    # Special handling for semicolon-separated UTF16LE files\n    if farm_id in ['FARM_AA', 'FARM_AC', 'FARM_AE', 'FARM_AG']:\n        df = pd.read_csv(p, sep=';', encoding='utf-16le', skiprows=3, decimal=',')\n        df.columns = [c.strip().replace('\\t', '') for c in df.columns]\n        return df\n    # try normal\n    for enc in ['utf-8', 'utf-16le', 'utf-16be']:\n        try:\n            df = pd.read_csv(p, sep=None, engine='python', skiprows=3, encoding=enc, on_bad_lines='skip')\n            if len(df.columns) > 1:\n                break\n        except:\n            continue\n    else:\n        raise ValueError(f'Could not read {fname}')\n    df.columns = [c.strip().replace('\\t', '') for c in df.columns]\n    # Sometimes timestamp has tab stuck\n    if df.columns[0].startswith('timestamp'):\n        df = df.rename(columns={df.columns[0]: 'timestamp'})\n    df['timestamp'] = df['timestamp'].astype(str).str.replace('\\t', '')\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
