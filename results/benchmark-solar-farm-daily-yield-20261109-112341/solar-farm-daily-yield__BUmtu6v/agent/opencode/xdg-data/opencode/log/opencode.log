timestamp=2026-11-09T10:47:38.858Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /tmp/parse_maint3.py << 'PY'\nimport re\nfrom pathlib import Path\n\ntext = Path('/app/dataset/maintenance_notes.txt').read_text(encoding='utf-8')\n# Better patterns\n# Pattern 1: \"on FARM_NAME on the DDth of MONTH from HH:MM to HH:MM\"\n# Pattern 2: \"on FARM_NAME on MONTH DD,? from HH:MM to HH:MM\" or \"starting at ... finishing at ...\"\n# Pattern 3: \"at FARM_NAME on MONTH DD starting at HH:MM and finishing at HH:MM\"\n\n# Look for each maintenance entry line\nwindows = []\n# extract all sentences that mention Status\nfor line in text.splitlines():\n    if 'COMPLETED' not in line and 'CANCELLED' not in line:\n        continue\n    status = 'COMPLETED' if 'COMPLETED' in line else 'CANCELLED'\n    # try patterns\n    # at/on farm\n    m = re.search(r'(?:at|on)\\s+([A-Z][A-Za-z\\s\\'-]+?)(?:\\s+on\\s+|\\s+,\\s+|\\s+the\\s+|\\s+from|\\s+starting)', line)\n    farm = m.group(1).strip() if m else None\n    # date\n    m = re.search(r'(\\d{1,2})(?:st|nd|rd|th)\\s+of\\s+(March|April|May)', line, re.I)\n    if m:\n        day = int(m.group(1))\n        month = m.group(2)\n    else:\n        m = re.search(r'(March|April|May)\\s+(\\d{1,2})', line, re.I)\n        if m:\n            month = m.group(1)\n            day = int(m.group(2))\n        else:\n            day, month = None, None\n    # times\n    times = re.findall(r'(\\d{1,2}:\\d{2})', line)\n    print(farm, day, month, times, status)\nPY" action.permission=* action.action=allow action.pattern=*
