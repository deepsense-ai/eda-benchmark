timestamp=2026-11-09T10:53:54.203Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef is_in_completed_maintenance(farm_name, dt_utc, maint_windows, meta_lookup):\n    \"\"\"Check if UTC datetime falls in a COMPLETED maintenance window for this farm.\"\"\"\n    # Find windows by farm name\n    for w in maint_windows:\n        if w['status'] != 'COMPLETED':\n            continue\n        w_farm = w['farm']\n        # match by name similarity - exact or contains\n        if w_farm and farm_name:\n            w_norm = w_farm.lower().strip()\n            f_norm = farm_name.lower().strip()\n            if w_norm == f_norm or w_norm in f_norm or f_norm in w_norm:\n                pass  # proceed to check time\n            else:\n                continue  # different farm\n        # build window in UTC? window times are in local time of farm\n        # need farm timezone\n        tz_name = meta_lookup.get('timezone') if meta_lookup is not None else None\n        if not tz_name or w['day'] is None or not w['start'] or not w['end']:\n            continue\n        try:\n            # build local datetimes for the window - assume same year as data (2024) and month as in window or March\n            month_map = {'March': 3, 'April': 4, 'May': 5, 'January': 1, 'February': 2}\n            month = month_map.get(w['month'], 3)\n            year = 2024\n            start_hm = w['start']\n            end_hm = w['end']\n            start_dt_local = datetime(year, month, w['day'],\n                                      int(start_hm.split(':')[0]),\n                                      int(start_hm.split(':')[1]),\n                                      tzinfo=ZoneInfo(tz_name))\n            end_dt_local = datetime(year, month, w['day'],\n                                    int(end_hm.split(':')[0]),\n                                    int(end_hm.split(':')[1]),\n                                    tzinfo=ZoneInfo(tz_name))\n            start_utc = start_dt_local.astimezone(ZoneInfo('UTC'))\n            end_utc = end_dt_local.astimezone(ZoneInfo('UTC'))\n            if start_utc <= dt_utc < end_utc:\n                return True\n        except Exception:\n            continue\n    return False\nPY" action.permission=* action.action=allow action.pattern=*
