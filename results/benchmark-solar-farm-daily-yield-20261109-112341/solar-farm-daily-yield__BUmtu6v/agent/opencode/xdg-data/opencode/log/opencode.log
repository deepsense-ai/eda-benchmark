timestamp=2026-11-09T10:47:26.310Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /tmp/parse_maint2.py << 'PY'\nimport re\nfrom pathlib import Path\n\ntext = Path('/app/dataset/maintenance_notes.txt').read_text(encoding='utf-8')\n# Try to extract COMPLETED windows with dates and times and farm names\n# Pattern examples: \"on Sakura Energy Site on the 16th of March from 08:00 to 12:00 local time. Status: COMPLETED.\"\n# Or \"Scheduled cleaning at Vistula Photovoltaics on March 15, starting at 12:00 and finishing at 14:00 local time. Status: COMPLETED.\"\npatterns = [\n    r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+the\\s+(\\d+)(?:st|nd|rd|th)\\s+of\\s+(\\w+)[^\\d]+(\\d{1,2}:\\d{2})\\s+to\\s+(\\d{1,2}:\\d{2})',\n    r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d+)[^\\d]+(\\d{1,2}:\\d{2})\\s+to\\s+(\\d{1,2}:\\d{2})',\n    r'at\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d+)[^\\d]+(\\d{1,2}:\\d{2})\\s+(?:starting|from)[^\\d]+(\\d{1,2}:\\d{2})\\s+finishing',\n    r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d+)[^\\d]+from\\s+(\\d{1,2}:\\d{2})\\s+to\\s+(\\d{1,2}:\\d{2})',\n]\nfor p in patterns:\n    for m in re.finditer(p, text, re.IGNORECASE):\n        print(m.groups())\nPY" action.permission=* action.action=allow action.pattern=*
