timestamp=2026-11-09T10:45:50.260Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /app/read_production.py << 'PY'\nfrom pathlib import Path\nimport pandas as pd\n\ndef read_production(farm_id):\n    fname = f'production_{farm_id}.csv'\n    p = Path('/app/dataset') / fname\n    # Try semicolon first for certain files\n    semicolon_candidates = ['FARM_C', 'FARM_E', 'FARM_AA', 'FARM_AC', 'FARM_AE', 'FARM_AG']\n    # also try for others if normal fails? but be selective\n    try_order = []\n    if farm_id in semicolon_candidates:\n        try_order.append('semicolon')\n    try_order.append('normal')\n    if farm_id not in semicolon_candidates:\n        try_order.append('semicolon')  # as fallback\n    for mode in try_order:\n        for enc in ['utf-8', 'utf-16le', 'utf-16be']:\n            try:\n                if mode == 'semicolon':\n                    df = pd.read_csv(p, sep=';', encoding=enc, skiprows=3, decimal=',', thousands=None, on_bad_lines='skip')\n                else:\n                    df = pd.read_csv(p, sep=None, engine='python', skiprows=3, encoding=enc, on_bad_lines='skip')\n                if len(df.columns) <= 1:\n                    continue\n                df.columns = [c.strip().replace('\\t', '').replace('\\ufeff', '') for c in df.columns]\n                # rename first col\n                if 'timestamp' in str(df.columns[0]).lower():\n                    df = df.rename(columns={df.columns[0]: 'timestamp'})\n                df['timestamp'] = df['timestamp'].astype(str).str.replace('\\t', '').str.strip()\n                # normalize column names for duplicates like reading/reading\n                cols = df.columns.tolist()\n                new_cols = []\n                seen = {}\n                for c in cols:\n                    base = c\n                    if base in seen:\n                        seen[base] += 1\n                        new_cols.append(f\"{base}_{seen[base]}\")\n                    else:\n                        seen[base] = 0\n                        new_cols.append(base)\n                df.columns = new_cols\n                return df\n            except Exception:\n                continue\n    raise ValueError(f'Could not read {fname}')\nPY" action.permission=* action.action=allow action.pattern=*
