timestamp=2026-11-09T10:57:50.543Z level=INFO run=195d671c message=evaluated permission=bash pattern="python3 << 'PY'\n# Let us look at FARM_A's actual values in the UTC window\nfrom read_production import read_production\nfrom utils import parse_numeric\nfrom datetime import datetime, timedelta\nfrom zoneinfo import ZoneInfo\nimport pandas as pd\n\nfarm_id = 'FARM_A'\ndf = read_production(farm_id)\ntz_name = 'Europe/Warsaw'\nWINDOW_START_UTC = datetime(2024, 3, 15, tzinfo=ZoneInfo('UTC'))\nWINDOW_END_UTC = WINDOW_START_UTC + timedelta(days=1)\n\ndt_utc_list = []\nfor ts in df['timestamp']:\n    s = str(ts).strip()\n    try:\n        dt = datetime.strptime(s, '%Y-%m-%d %H:%M:%S')\n    except:\n        try:\n            dt = datetime.strptime(s, '%d.%m.%Y %H:%M:%S')\n        except:\n            continue\n    try:\n        dt_local = dt.replace(tzinfo=ZoneInfo(tz_name))\n        dt_utc_list.append(dt_local.astimezone(ZoneInfo('UTC')))\n    except:\n        dt_utc_list.append(None)\n\ndf['dt_utc'] = dt_utc_list\ndf_f = df[(df['dt_utc'] >= WINDOW_START_UTC) & (df['dt_utc'] < WINDOW_END_UTC)]\nprint('count:', len(df_f))\nif len(df_f) > 0:\n    print(df_f[['timestamp', 'dt_utc', 'power_reading']].head())\nelse:\n    # look around\n    df['in_win'] = (df['dt_utc'] >= WINDOW_START_UTC) & (df['dt_utc'] < WINDOW_END_UTC)\n    print(df.loc[df['in_win'] == True])\nPY" action.permission=* action.action=allow action.pattern=*
