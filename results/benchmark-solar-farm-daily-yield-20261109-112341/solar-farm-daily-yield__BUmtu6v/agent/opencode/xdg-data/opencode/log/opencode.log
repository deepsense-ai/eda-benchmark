timestamp=2026-11-09T11:38:23.116Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\ndef answer() -> dict[str, int]:\n    import json\n    from pathlib import Path\n    from datetime import datetime, timedelta\n    from zoneinfo import ZoneInfo\n    import pandas as pd\n    import numpy as np\n\n    from read_production import read_production\n    from parse_maintenance import parse_maintenance_windows\n    from utils import parse_numeric\n    from column_selector import choose_best_value_column\n    from data_cleaner import is_plausible\n\n    DATA_DIR = Path('/app/dataset')\n    REPORT_DAY_UTC = datetime(2024, 3, 15, tzinfo=ZoneInfo('UTC'))\n    WINDOW_START_UTC = REPORT_DAY_UTC\n    WINDOW_END_UTC = REPORT_DAY_UTC + timedelta(days=1)\n\n    # Build metadata\n    farms = pd.read_csv(DATA_DIR / 'farms.csv')\n    farms['farm_name_norm'] = farms['farm_name'].astype(str).str.strip().str.lower()\n    reg = pd.read_csv(DATA_DIR / 'farm_registry.csv')\n    reg['farm_name_norm'] = reg['farm_name'].astype(str).str.strip().str.lower()\n    meta = farms.merge(reg, on='farm_name_norm', how='left')\n    meta = meta.set_index('farm_id')\n\n    # Build calibration\n    with open(DATA_DIR / 'sensors_calibration.json') as f:\n        data = json.load(f)\n    cal_farms = data['enterprise_platform']['deployment_environments']['system_config']['farms']\n    cal = {}\n    for fid, info in cal_farms.items():\n        cal[fid] = {\n            'offset': float(info['calibration_data']['calibration_offset']),\n            'value_col': info['calibration_data']['value_column_name'].strip(),\n            'reading_type': info['sensor_info']['reading_type'],\n            'unit': info['sensor_info']['unit'].strip()\n        }\n\n    maint_windows = parse_maintenance_windows()\n\n    def to_utc(ts_str, tz_name):\n        s = str(ts_str).strip()\n        formats = [\n            '%Y-%m-%d %H:%M:%S',\n            '%Y-%m-%d %H:%M',\n            '%d.%m.%Y %H:%M:%S',\n            '%d.%m.%Y %H:%M',\n            '%m/%d/%Y %H:%M:%S',\n            '%m/%d/%Y %H:%M',\n            '%Y/%m/%d %H:%M:%S',\n            '%Y/%m/%d %H:%M',\n        ]\n        dt = None\n        for fmt in formats:\n            try:\n                dt = datetime.strptime(s, fmt)\n                break\n            except:\n                continue\n        if dt is None:\n            try:\n                dt = pd.to_datetime(s).to_pydatetime()\n            except:\n                return None\n        try:\n            local_tz = ZoneInfo(tz_name)\n            dt_local = dt.replace(tzinfo=local_tz)\n            return dt_local.astimezone(ZoneInfo('UTC'))\n        except Exception:\n            return None\n\n    def is_in_completed_maintenance(farm_name, dt_utc, maint_windows, meta_lookup):\n        for w in maint_windows:\n            if w['status'] != 'COMPLETED':\n                continue\n            w_farm = w['farm']\n            if w_farm and farm_name:\n                w_norm = w_farm.lower().strip()\n                f_norm = farm_name.lower().strip()\n                if not (w_norm == f_norm or w_norm in f_norm or f_norm in w_norm):\n                    continue\n            tz_name = meta_lookup.get('timezone') if meta_lookup is not None else None\n            if not tz_name or w['day'] is None or not w['start'] or not w['end']:\n                continue\n            try:\n                month_map = {'March': 3, 'April': 4, 'May': 5, 'January': 1, 'February': 2}\n                month = month_map.get(w['month'], 3)\n                year = 2024\n                start_hm = w['start']\n                end_hm = w['end']\n                start_dt_local = datetime(year, month, w['day'],\n                                          int(start_hm.split(':')[0]),\n                                          int(start_hm.split(':')[1]),\n                                          tzinfo=ZoneInfo(tz_name))\n                end_dt_local = datetime(year, month, w['day'],\n                                        int(end_hm.split(':')[0]),\n                                        int(end_hm.split(':')[1]),\n                                        tzinfo=ZoneInfo(tz_name))\n                start_utc = start_dt_local.astimezone(ZoneInfo('UTC'))\n                end_utc = end_dt_local.astimezone(ZoneInfo('UTC'))\n                if start_utc <= dt_utc < end_utc:\n                    return True\n            except Exception:\n                continue\n        return False\n\n    def convert_energy_to_kwh(value, unit):\n        unit_norm = str(unit).strip().lower()\n        if unit_norm == 'kwh':\n            return float(value)\n        if unit_norm == 'mwh':\n            return float(value) * 1000.0\n        if unit_norm == 'wh':\n            return float(value) / 1000.0\n        if unit_norm == 'btu':\n            return float(value) * 0.00029307107\n        return float(value)\n\n    def process_farm(farm_id):\n        if farm_id not in cal:\n            return 0\n        c = cal[farm_id]\n        try:\n            df = read_production(farm_id)\n        except Exception:\n            return 0\n        val_col = choose_best_value_column(df, c['value_col'])\n        if val_col is None:\n            return 0\n        if 'timestamp' not in df.columns:\n            return 0\n        tz_name = None\n        farm_name = None\n        try:\n            if farm_id in meta.index:\n                tz_name = meta.at[farm_id, 'timezone']\n                farm_name = meta.at[farm_id, 'farm_name_x']\n        except Exception:\n            pass\n        if tz_name is None:\n            tz_name = 'UTC'\n        dt_utc_list = []\n        ok_idx = []\n        for i, ts in enumerate(df['timestamp']):\n            dt_utc = to_utc(ts, tz_name)\n            if dt_utc is not None:\n                dt_utc_list.append(dt_utc)\n                ok_idx.append(i)\n        if len(dt_utc_list) == 0:\n            return 0\n        df = df.iloc[ok_idx].copy().reset_index(drop=True)\n        df['dt_utc'] = dt_utc_list\n        df = df[(df['dt_utc'] >= WINDOW_START_UTC) & (df['dt_utc'] < WINDOW_END_UTC)]\n        if df.empty:\n            return 0\n        df['value_raw'] = df[val_col].apply(parse_numeric)\n        df = df[df['value_raw'].notna()]\n        if df.empty:\n            return 0\n        df = df[df['value_raw'].apply(is_plausible)]\n        if df.empty:\n            return 0\n        df['value_true'] = df['value_raw'] - c['offset']\n        df = df[df['value_true'] >= 0]\n        if df.empty:\n            return 0\n        df = df.drop_duplicates()\n        if df.empty:\n            return 0\n        try:\n            meta_lookup = meta.loc[farm_id] if farm_id in meta.index else None\n        except:\n            meta_lookup = None\n        mask_maint = df['dt_utc'].apply(lambda d: is_in_completed_maintenance(farm_name, d, maint_windows, meta_lookup))\n        df = df[~mask_maint]\n        if df.empty:\n            return 0\n        if c['reading_type'] == 'power':\n            df = df.sort_values('dt_utc').reset_index(drop=True)\n            dt_hours = []\n            for i in range(len(df)):\n                if i == 0:\n                    dt_hours.append(0.0)\n                else:\n                    delta = (df['dt_utc'].iloc[i] - df['dt_utc'].iloc[i-1]).total_seconds() / 3600.0\n                    if delta < 0:\n                        delta = 0.0\n                    dt_hours.append(delta)\n            df['interval_hours'] = dt_hours\n            if len(df) > 1:\n                med = df['interval_hours'].iloc[1:].median()\n                if pd.isna(med) or med <= 0:\n                    med = 0.5\n                df.loc[df.index[0], 'interval_hours'] = med\n            else:\n                df['interval_hours'] = 0.0\n            df['energy_kwh'] = df['value_true'] * df['interval_hours']\n            total_kwh = float(df['energy_kwh'].sum())\n        else:\n            total_energy_raw_units = float(df['value_true'].sum())\n            total_kwh = convert_energy_to_kwh(total_energy_raw_units, c['unit'])\n        total_kwh_int = round(total_kwh)\n        if total_kwh_int < 0:\n            total_kwh_int = 0\n        return total_kwh_int\n\n    results = {}\n    core_farms = [f'FARM_{c}' for c in 'ABCDEFGHIJKLMNOPQRSTUVWX']\n    for fid in core_farms:\n        try:\n            res = process_farm(fid)\n            results[fid] = int(res) if res is not None else 0\n        except Exception:\n            results[fid] = 0\n    return results\n\nif __name__ == '__main__':\n    import json\n    with open('/app/answer.json', 'w') as f:\n        json.dump(answer(), f, default=list)\nPY" action.permission=* action.action=allow action.pattern=*
