timestamp=2026-11-09T11:29:20.287Z level=INFO run=195d671c message=evaluated permission=bash pattern="python3 << 'PY'\n# FARM_T: reading_type is energy, unit is MWh, value_col is mwh_yield. So values are energy in MWh. We convert MWh to kWh by multiplying by 1000. So if the total is 1.77e9 kWh, that means total is ~1.77e6 MWh. Is that plausible? Let us look at the raw values (after calibration) in MWh scale before conversion.\nfrom read_production import read_production\nfrom column_selector import choose_best_value_column\nfrom utils import parse_numeric\nfrom datetime import datetime, timedelta\nfrom zoneinfo import ZoneInfo\nimport pandas as pd\n\nfarm_id = 'FARM_T'\ndf = read_production(farm_id)\nval_col = choose_best_value_column(df, 'mwh_yield')\nprint('val_col:', val_col)\n# get tz\nfarms = pd.read_csv('/app/dataset/farms.csv')\nfarms['farm_name_norm'] = farms['farm_name'].astype(str).str.strip().str.lower()\nreg = pd.read_csv('/app/dataset/farm_registry.csv')\nreg['farm_name_norm'] = reg['farm_name'].astype(str).str.strip().str.lower()\nmeta = farms.merge(reg, on='farm_name_norm', how='left')\nmeta = meta.set_index('farm_id')\ntz_name = meta.at[farm_id, 'timezone']\nWINDOW_START_UTC = datetime(2024, 3, 15, tzinfo=ZoneInfo('UTC'))\nWINDOW_END_UTC = WINDOW_START_UTC + timedelta(days=1)\n# parse\ndt_utc_list = []\nok_idx = []\nfor i, ts in enumerate(df['timestamp']):\n    s = str(ts).strip()\n    try:\n        dt = datetime.strptime(s, '%Y-%m-%d %H:%M:%S')\n    except:\n        continue\n    try:\n        dt_local = dt.replace(tzinfo=ZoneInfo(tz_name))\n        dt_utc_list.append(dt_local.astimezone(ZoneInfo('UTC')))\n        ok_idx.append(i)\n    except:\n        continue\ndf_clean = df.iloc[ok_idx].copy().reset_index(drop=True)\ndf_clean['dt_utc'] = dt_utc_list\ndf_f = df_clean[(df_clean['dt_utc'] >= WINDOW_START_UTC) & (df_clean['dt_utc'] < WINDOW_END_UTC)]\ndf_f['value_raw'] = df_f[val_col].apply(parse_numeric)\ndf_f2 = df_f[df_f['value_raw'].notna()].copy()\ndf_f2['value_true'] = df_f2['value_raw'] - 0.05\ndf_f2 = df_f2[df_f2['value_true'] >= 0]\nprint('rows:', len(df_f2), 'sum_mwh:', df_f2['value_true'].sum(), 'max:', df_f2['value_true'].max())\nPY" action.permission=* action.action=allow action.pattern=*
