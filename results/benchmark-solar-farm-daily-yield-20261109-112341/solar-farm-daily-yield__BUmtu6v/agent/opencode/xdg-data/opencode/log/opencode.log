timestamp=2026-11-09T10:56:28.614Z level=INFO run=195d671c message=evaluated permission=bash pattern="python3 << 'PY'\nfrom read_production import read_production\nfrom datetime import datetime\nfrom zoneinfo import ZoneInfo\n\ndf = read_production('FARM_A')\n# process\ndt_list = []\nok_idx = []\nfor i, ts in enumerate(df['timestamp']):\n    s = str(ts).strip()\n    try:\n        dt = datetime.strptime(s, '%Y-%m-%d %H:%M:%S')\n    except:\n        try:\n            dt = datetime.strptime(s, '%d.%m.%Y %H:%M:%S')\n        except:\n            continue\n    try:\n        dt_local = dt.replace(tzinfo=ZoneInfo('Europe/Warsaw'))\n        dt_list.append(dt_local.astimezone(ZoneInfo('UTC')))\n        ok_idx.append(i)\n    except:\n        continue\nprint(len(dt_list), len(ok_idx))\nPY" action.permission=* action.action=allow action.pattern=*
