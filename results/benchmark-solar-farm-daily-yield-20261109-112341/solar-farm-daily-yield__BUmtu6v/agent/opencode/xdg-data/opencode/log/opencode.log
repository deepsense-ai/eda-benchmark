timestamp=2026-11-09T10:58:38.904Z level=INFO run=195d671c message=evaluated permission=bash pattern="python3 << 'PY'\n# Now look at cumulative vs non-cumulative. For FARM_A (energy type, kWh), values appear as interval or cumulative readings depending on system. Also compare with the \"total\" - if we just sum all values in the 24-hour period (after filtering negatives etc), is that the total production for the day? For example, if each reading is the kWh produced in that interval, then sum is total. If each reading is cumulative total, then total is last - first. Which interpretation is correct?\n# Let us look at FARM_B as well - FARM_B is energy type (MwH according to calibration). Let us check its values.\nfrom read_production import read_production\nfrom utils import parse_numeric\nfrom datetime import datetime, timedelta\nfrom zoneinfo import ZoneInfo\nimport pandas as pd\n\nfarm_id = 'FARM_B'\ndf = read_production(farm_id)\n# need tz\nmeta = pd.read_csv('/app/dataset/farms.csv')\nreg = pd.read_csv('/app/dataset/farm_registry.csv')\n# merge\nfarms = pd.read_csv('/app/dataset/farms.csv')\nfarms['farm_name_norm'] = farms['farm_name'].astype(str).str.strip().str.lower()\nreg = pd.read_csv('/app/dataset/farm_registry.csv')\nreg['farm_name_norm'] = reg['farm_name'].astype(str).str.strip().str.lower()\nmeta = farms.merge(reg, on='farm_name_norm', how='left')\nmeta = meta.set_index('farm_id')\ntz_name = meta.at[farm_id, 'timezone']\n\nWINDOW_START_UTC = datetime(2024, 3, 15, tzinfo=ZoneInfo('UTC'))\nWINDOW_END_UTC = WINDOW_START_UTC + timedelta(days=1)\n\ndt_utc_list = []\nok_idx = []\nfor i, ts in enumerate(df['timestamp']):\n    s = str(ts).strip()\n    try:\n        dt = datetime.strptime(s, '%Y-%m-%d %H:%M:%S')\n    except:\n        try:\n            dt = datetime.strptime(s, '%d.%m.%Y %H:%M:%S')\n        except:\n            continue\n    try:\n        dt_local = dt.replace(tzinfo=ZoneInfo(tz_name))\n        dt_utc_list.append(dt_local.astimezone(ZoneInfo('UTC')))\n        ok_idx.append(i)\n    except:\n        continue\n\ndf_clean = df.iloc[ok_idx].copy()\ndf_clean['dt_utc'] = dt_utc_list\ndf_f = df_clean[(df_clean['dt_utc'] >= WINDOW_START_UTC) & (df_clean['dt_utc'] < WINDOW_END_UTC)]\nvals = df_f['value'].apply(parse_numeric).tolist()\nprint(vals[:10])\nPY" action.permission=* action.action=allow action.pattern=*
