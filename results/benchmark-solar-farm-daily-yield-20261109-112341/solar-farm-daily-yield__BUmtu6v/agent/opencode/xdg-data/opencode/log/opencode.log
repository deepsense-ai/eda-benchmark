timestamp=2026-11-09T11:22:09.348Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /app/read_production.py << 'PY'\nfrom pathlib import Path\nimport pandas as pd\n\ndef read_production(farm_id):\n    fname = f'production_{farm_id}.csv'\n    p = Path('/app/dataset') / fname\n    semicolon_candidates = ['FARM_C', 'FARM_E', 'FARM_AA', 'FARM_AC', 'FARM_AE', 'FARM_AG']\n    # try specific strategy\n    for enc in ['utf-16le', 'utf-8', 'utf-16be']:\n        try:\n            if farm_id in semicolon_candidates:\n                df = pd.read_csv(p, sep=';', encoding=enc, skiprows=3, decimal=',', on_bad_lines='skip')\n            else:\n                try:\n                    df = pd.read_csv(p, sep=',', encoding=enc, skiprows=3, on_bad_lines='skip')\n                except:\n                    df = pd.read_csv(p, sep=None, engine='python', skiprows=3, encoding=enc, on_bad_lines='skip')\n            if len(df.columns) > 1:\n                break\n        except Exception:\n            continue\n    else:\n        raise ValueError(f'Could not read {fname}')\n    df = df.copy()\n    df.columns = [str(c).strip().replace('\\t', '').replace('\\ufeff', '') for c in df.columns]\n    if 'timestamp' in str(df.columns[0]).lower():\n        df = df.rename(columns={df.columns[0]: 'timestamp'})\n    if 'timestamp' in df.columns:\n        df['timestamp'] = df['timestamp'].astype(str).str.replace('\\t', '').str.strip()\n    # disambiguate duplicate column names\n    cols = df.columns.tolist()\n    new_cols = []\n    seen = {}\n    for c in cols:\n        if c in seen:\n            seen[c] += 1\n            new_cols.append(f\"{c}_{seen[c]}\")\n        else:\n            seen[c] = 0\n            new_cols.append(c)\n    df.columns = new_cols\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
