timestamp=2026-11-09T11:30:04.629Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /tmp/clean.py << 'PY'\ndef is_plausible(value, reading_type=None, unit=None):\n    try:\n        v = float(value)\n    except:\n        return False\n    if np.isnan(v) or np.isinf(v):\n        return False\n    # reject obvious sentinels\n    if abs(v - 888888) < 1e-3 or abs(v - 999999) < 1e-3 or abs(v - 99999) < 1e-3:\n        return False\n    if v < -1e6 or v > 1e9:  # very extreme\n        return False\n    return True\nPY" action.permission=* action.action=allow action.pattern=*
