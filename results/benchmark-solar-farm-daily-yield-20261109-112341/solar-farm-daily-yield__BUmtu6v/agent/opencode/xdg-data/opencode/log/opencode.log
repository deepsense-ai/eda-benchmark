timestamp=2026-11-09T11:24:35.608Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /tmp/choose_col.py << 'PY'\ndef choose_best_value_column(df, specified_name):\n    # find all columns that match specified_name (case-insensitive, strip)\n    specified = str(specified_name).strip().lower()\n    candidates = []\n    for c in df.columns:\n        c_norm = str(c).strip().lower()\n        if c_norm == specified or c_norm.startswith(specified) or specified in c_norm:\n            candidates.append(c)\n    if not candidates:\n        # broader search\n        for c in df.columns:\n            cl = str(c).strip().lower()\n            if any(k in cl for k in ['power_reading', 'value', 'reading', 'output', 'yield', 'generation', 'meter', 'kw', 'mwh', 'wh', 'energy']):\n                candidates.append(c)\n    if not candidates:\n        return None\n    # if multiple, pick the one with most reasonable stats\n    best = candidates[0]\n    best_score = -float('inf')\n    for c in candidates:\n        try:\n            s = df[c].apply(lambda x: float(str(x).replace(',', '.')) if isinstance(x, str) else float(x))\n            s = s.replace([float('inf'), float('-inf')], float('nan')).dropna()\n            if len(s) == 0:\n                score = 0\n            else:\n                # prefer lower coefficient of variation, reasonable max\n                mean = s.mean()\n                std = s.std()\n                cv = std / abs(mean) if mean != 0 else float('inf')\n                maxv = s.max()\n                # penalize extremely large constant-like or absurd values\n                score = -cv - maxv / 1e7 if maxv > 1e6 else -cv\n            if score > best_score:\n                best = c\n                best_score = score\n        except:\n            continue\n    return best\nPY" action.permission=* action.action=allow action.pattern=*
