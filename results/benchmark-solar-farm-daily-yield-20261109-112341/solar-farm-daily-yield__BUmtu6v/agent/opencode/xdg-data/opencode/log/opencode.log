timestamp=2026-11-09T11:25:39.324Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /app/column_selector.py << 'PY'\ndef choose_best_value_column(df, specified_name):\n    specified = str(specified_name).strip().lower()\n    candidates = []\n    for c in df.columns:\n        c_norm = str(c).strip().lower()\n        if c_norm == specified:\n            candidates.append(c)\n    # also add partial matches if no exact\n    if not candidates:\n        for c in df.columns:\n            c_norm = str(c).strip().lower()\n            if specified and (specified in c_norm or c_norm in specified):\n                candidates.append(c)\n    if not candidates:\n        for c in df.columns:\n            cl = str(c).strip().lower()\n            if any(k in cl for k in ['power_reading', 'value', 'reading', 'output', 'yield', 'generation', 'meter', 'kw', 'mwh', 'wh', 'energy', 'power_out', 'kw_reading', 'kw_val']):\n                candidates.append(c)\n    if not candidates:\n        return None\n    best = candidates[0]\n    best_score = -float('inf')\n    from utils import parse_numeric\n    for c in candidates:\n        try:\n            s = df[c].apply(parse_numeric)\n            s = s.dropna()\n            if len(s) == 0:\n                score = -1000\n            else:\n                mean = s.mean()\n                std = s.std()\n                cv = std / abs(mean) if mean != 0 else float('inf')\n                maxv = s.max()\n                # prefer reasonable ranges\n                score = -cv\n                if maxv > 1e7:\n                    score -= 100\n                # prefer columns with more variation over baseline constants\n                if std < 1e-6:\n                    score -= 50\n            if score > best_score:\n                best = c\n                best_score = score\n        except Exception:\n            continue\n    return best\nPY" action.permission=* action.action=allow action.pattern=*
