timestamp=2026-11-09T11:13:16.068Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /app/read_production.py << 'PY'\nfrom pathlib import Path\nimport pandas as pd\n\ndef read_production(farm_id):\n    fname = f'production_{farm_id}.csv'\n    p = Path('/app/dataset') / fname\n    semicolon_candidates = ['FARM_C', 'FARM_E', 'FARM_AA', 'FARM_AC', 'FARM_AE', 'FARM_AG']\n    if farm_id in semicolon_candidates:\n        for enc in ['utf-8', 'utf-16le', 'utf-16be']:\n            try:\n                df = pd.read_csv(p, sep=';', encoding=enc, skiprows=3, decimal=',', thousands=None, on_bad_lines='skip')\n                break\n            except:\n                continue\n        else:\n            raise ValueError(f'Could not read {fname}')\n    else:\n        for enc in ['utf-8', 'utf-16le', 'utf-16be']:\n            try:\n                df = pd.read_csv(p, sep=',', encoding=enc, skiprows=3, on_bad_lines='skip')\n                if len(df.columns) > 1:\n                    break\n            except:\n                continue\n        else:\n            for enc in ['utf-8', 'utf-16le', 'utf-16be']:\n                try:\n                    df = pd.read_csv(p, sep=None, engine='python', skiprows=3, encoding=enc, on_bad_lines='skip')\n                    if len(df.columns) > 1:\n                        break\n                except:\n                    continue\n            else:\n                raise ValueError(f'Could not read {fname}')\n    orig_cols = [str(c) for c in df.columns]\n    norm_cols = [c.strip().replace('\\t', '').replace('\\ufeff', '') for c in orig_cols]\n    df = df.copy()\n    df.columns = norm_cols\n    if len(df.columns) > 0:\n        first = str(df.columns[0]).lower()\n        if 'timestamp' in first:\n            df = df.rename(columns={df.columns[0]: 'timestamp'})\n    if 'timestamp' in df.columns:\n        df['timestamp'] = df['timestamp'].astype(str).str.replace('\\t', '').str.strip()\n    df._orig_cols = orig_cols\n    df._norm_cols = norm_cols\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
