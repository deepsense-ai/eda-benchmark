timestamp=2026-11-09T11:33:02.814Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nfrom pathlib import Path\nfrom datetime import datetime, timedelta\nfrom zoneinfo import ZoneInfo\nimport pandas as pd\nimport numpy as np\n\nfrom read_production import read_production\nfrom parse_maintenance import parse_maintenance_windows\nfrom utils import parse_numeric\nfrom column_selector import choose_best_value_column\nfrom data_cleaner import is_plausible\n\nDATA_DIR = Path('/app/dataset')\nREPORT_DAY_UTC = datetime(2024, 3, 15, tzinfo=ZoneInfo('UTC'))\nWINDOW_START_UTC = REPORT_DAY_UTC\nWINDOW_END_UTC = REPORT_DAY_UTC + timedelta(days=1)\n\n# Build metadata\nfarms = pd.read_csv(DATA_DIR / 'farms.csv')\nfarms['farm_name_norm'] = farms['farm_name'].astype(str).str.strip().str.lower()\nreg = pd.read_csv(DATA_DIR / 'farm_registry.csv')\nreg['farm_name_norm'] = reg['farm_name'].astype(str).str.strip().str.lower()\nmeta = farms.merge(reg, on='farm_name_norm', how='left')\nmeta = meta.set_index('farm_id')\n\n# Build calibration\nwith open(DATA_DIR / 'sensors_calibration.json') as f:\n    data = json.load(f)\ncal_farms = data['enterprise_platform']['deployment_environments']['system_config']['farms']\ncal = {}\nfor fid, info in cal_farms.items():\n    cal[fid] = {\n        'offset': float(info['calibration_data']['calibration_offset']),\n        'value_col': info['calibration_data']['value_column_name'].strip(),\n        'reading_type': info['sensor_info']['reading_type'],\n        'unit': info['sensor_info']['unit'].strip()\n    }\n\nmaint_windows = parse_maintenance_windows()\nPY" action.permission=* action.action=allow action.pattern=*
