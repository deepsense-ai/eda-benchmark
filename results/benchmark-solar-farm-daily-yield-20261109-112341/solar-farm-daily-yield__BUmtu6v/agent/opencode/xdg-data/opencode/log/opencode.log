timestamp=2026-11-09T10:47:47.918Z level=INFO run=195d671c message=evaluated permission=bash pattern="cat > /tmp/parse_final.py << 'PY'\nimport re\nfrom pathlib import Path\n\ntext = Path('/app/dataset/maintenance_notes.txt').read_text(encoding='utf-8')\nwindows = []\nfor line in text.splitlines():\n    if 'COMPLETED' not in line and 'CANCELLED' not in line:\n        continue\n    status = 'COMPLETED' if 'COMPLETED' in line else 'CANCELLED'\n    # farm\n    m = re.search(r'(?:at|on)\\s+([A-Z][A-Za-z\\s\\'-]+?)(?:\\s+on\\s+|\\s+,\\s+|\\s+the\\s+|\\s+from|\\s+starting|\\s+on\\s+the)', line)\n    farm = m.group(1).strip() if m else None\n    # date\n    m = re.search(r'(\\d{1,2})(?:st|nd|rd|th)\\s+of\\s+(March|April|May|January|February)', line, re.I)\n    if m:\n        day = int(m.group(1))\n        month = m.group(2).capitalize()\n    else:\n        m = re.search(r'(March|April|May|January|February)\\s+(\\d{1,2})', line, re.I)\n        if m:\n            month = m.group(1).capitalize()\n            day = int(m.group(2))\n        else:\n            day, month = None, None\n    times = re.findall(r'(\\d{1,2}:\\d{2})', line)\n    if len(times) >= 2:\n        start_t, end_t = times[0], times[1]\n    else:\n        start_t, end_t = None, None\n    windows.append({'farm': farm, 'day': day, 'month': month, 'start': start_t, 'end': end_t, 'status': status})\nprint(windows)\nPY" action.permission=* action.action=allow action.pattern=*
