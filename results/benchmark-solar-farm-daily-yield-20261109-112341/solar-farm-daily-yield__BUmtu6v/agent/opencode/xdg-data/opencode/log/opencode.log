timestamp=2026-11-09T10:56:23.399Z level=INFO run=195d671c message=evaluated permission=bash pattern="python3 << 'PY'\n# Look further into FARM_A for the reporting day 2024-03-15? We are computing for 2024-03-15 UTC window. Let us look at FARM_A data filtered to around that day.\nfrom read_production import read_production\nfrom utils import parse_numeric\nfrom datetime import datetime\nfrom zoneinfo import ZoneInfo\n\ndf = read_production('FARM_A')\ntz = 'Europe/Warsaw'  # from meta\n# parse\ndt_list = []\nfor ts in df['timestamp']:\n    s = str(ts).strip()\n    try:\n        dt = datetime.strptime(s, '%Y-%m-%d %H:%M:%S')\n    except:\n        try:\n            dt = datetime.strptime(s, '%d.%m.%Y %H:%M:%S')\n        except:\n            continue\n    try:\n        dt_local = dt.replace(tzinfo=ZoneInfo(tz))\n        dt_list.append(dt_local.astimezone(ZoneInfo('UTC')))\n    except:\n        continue\n# add\ndf['dt_utc'] = dt_list\n# look around 15th\nfor i, (ts, du) in enumerate(zip(df['timestamp'].head(30), df['dt_utc'].head(30))):\n    if du:\n        print(i, ts, du, du.tzinfo)\nPY" action.permission=* action.action=allow action.pattern=*
