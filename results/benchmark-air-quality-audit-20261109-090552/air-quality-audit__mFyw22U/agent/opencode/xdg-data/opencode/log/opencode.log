timestamp=2026-11-09T08:12:33.666Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\n# Several stations missing first reading. ST002 is one of them. Not unique in that sense.\n# Another angle: \"One problematic station broadly follows local patterns, but not with the same rhythm as its peers.\"\n# Could mean its diurnal pattern is shifted? Or maybe lower correlation at fine timescale. \n# Or perhaps it's responding to events with different delay. But with only 24 points over 4 days, hard to say.\n# Let us look at another candidate for anomaly 1. Also consider PM10 stations too?\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\npm10 = readings[readings['pollutant']=='PM10']\npm10_pivot = pm10.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\nst_info = stations.set_index('station_id')\n\nfor st in pm10_pivot.columns:\n    d = st_info.loc[st, 'district']\n    peers = st_info[st_info['district']==d].index.intersection(pm10_pivot.columns)\n    peers_ref = [p for p in peers if p != st]\n    if len(peers_ref) < 2: continue\n    ref = pm10_pivot[peers_ref].median(axis=1, skipna=True)\n    t = pm10_pivot[st]\n    df = pd.DataFrame({'t': t, 'ref': ref}).dropna()\n    if len(df) > 10:\n        r0 = stats.pearsonr(df['t'], df['ref'])[0]\n        # check lag\n        best_r = r0\n        best_l = 0\n        for lag in range(-2,3):\n            if lag==0: continue\n            if lag>0:\n                a = t.iloc[lag:]; b = ref.iloc[:-lag]\n            else:\n                a = t.iloc[:lag]; b = ref.iloc[-lag:]\n            d2 = pd.DataFrame({'t': a, 'ref': b}).dropna()\n            if len(d2)>8:\n                try:\n                    rr = stats.pearsonr(d2['t'], d2['ref'])[0]\n                    if rr > best_r + 0.15:\n                        best_r, best_l = rr, lag\n                except:\n                    pass\n        if best_l != 0:\n            print(f'FOUND: {st} lag={best_l}, r0={r0:.3f}, rmax={best_r:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
