timestamp=2026-11-09T08:10:32.318Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\npm25 = readings[readings['pollutant']=='PM25']\npm10 = readings[readings['pollutant']=='PM10']\npm25_pivot = pm25.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\npm10_pivot = pm10.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\nst_info = stations.set_index('station_id')\n\ndef max_lag_corr(target, district, pivot, maxlag=3):\n    peers = st_info[st_info['district']==district].index.intersection(pivot.columns)\n    peers_ref = [p for p in peers if p != target]\n    if len(peers_ref) == 0: return None\n    ref = pivot[peers_ref].median(axis=1, skipna=True)\n    t = pivot[target]\n    best = (0, -10)\n    best_r0 = -10\n    try:\n        best_r0 = stats.pearsonr(t, ref)[0]\n    except:\n        best_r0 = np.nan\n    for lag in range(-maxlag, maxlag+1):\n        if lag < 0:\n            a = t.iloc[:lag]; b = ref.iloc[-lag:]\n        elif lag == 0:\n            a = t; b = ref\n        else:\n            a = t.iloc[lag:]; b = ref.iloc[:-lag]\n        if len(a) > 5 and len(b) > 5:\n            try:\n                r = stats.pearsonr(a, b)[0]\n            except:\n                continue\n            if r > best[1]:\n                best = (lag, r)\n    return best[0], best[1], best_r0\n\n# Check\nfor target in ['ST002', 'ST011', 'ST010', 'ST015']:\n    d = st_info.loc[target, 'district']\n    pivot = pm25_pivot if target in pm25_pivot.columns else pm10_pivot\n    res = max_lag_corr(target, d, pivot)\n    if res:\n        lag, rmax, r0 = res\n        print(f'{target} ({d}): lag={lag}, rmax={rmax:.3f}, r0={r0:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
