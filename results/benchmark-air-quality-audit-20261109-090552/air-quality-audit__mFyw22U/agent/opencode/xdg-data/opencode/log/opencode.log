timestamp=2026-11-09T08:13:06.837Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\n# ST060 shows highest correlation at lag ±3. That means it’s shifted relative to peer median - correlation is much better when aligned differently.\n# That fits \"broadly follows local patterns, but not with the same rhythm as its peers.\" So rhythm/timing is off. \n# This is anomaly type 1.\n# Another station: check ST002 in pm25 - we saw lag0 was moderate (0.536), is there better lag?\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\npm25 = readings[readings['pollutant']=='PM25']\npm25_pivot = pm25.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\nst_info = stations.set_index('station_id')\n\nst = 'ST002'\nd = st_info.loc[st, 'district']\npeers = st_info[st_info['district']==d].index.intersection(pm25_pivot.columns)\npeers_ref = [p for p in peers if p != st]\nref = pm25_pivot[peers_ref].median(axis=1, skipna=True)\nt = pm25_pivot[st]\n\nfor lag in range(-3, 4):\n    if lag > 0:\n        a = t.iloc[lag:]; b = ref.iloc[:-lag]\n    elif lag < 0:\n        a = t.iloc[:lag]; b = ref.iloc[-lag:]\n    else:\n        a = t; b = ref\n    df = pd.DataFrame({'t': a, 'ref': b}).dropna()\n    if len(df) > 8:\n        print(f'lag={lag}: r={stats.pearsonr(df[\"t\"], df[\"ref\"])[0]:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
