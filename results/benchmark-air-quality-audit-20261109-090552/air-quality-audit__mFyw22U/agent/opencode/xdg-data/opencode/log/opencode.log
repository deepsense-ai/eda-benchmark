timestamp=2026-11-09T08:15:26.818Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nweather_rd = pd.read_csv('/app/dataset/weather_readings.csv')\npm25 = readings[readings['pollutant']=='PM25']\npm25_pivot = pm25.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\n\nw_pivot_temp = weather_rd.pivot_table(index='timestamp', columns='district', values='temperature_c', aggfunc='median')\nw_pivot_hum = weather_rd.pivot_table(index='timestamp', columns='district', values='humidity_pct', aggfunc='median')\nw_pivot_wind = weather_rd.pivot_table(index='timestamp', columns='district', values='wind_speed_m_s', aggfunc='median')\nw_pivot_rain = weather_rd.pivot_table(index='timestamp', columns='district', values='rain_accumulation_mm', aggfunc='median')\nst_info = stations.set_index('station_id')\n\ndef analyze(st, pivot):\n    d = st_info.loc[st, 'district']\n    peers = st_info[st_info['district']==d].index.intersection(pivot.columns)\n    peers_ref = [p for p in peers if p != st]\n    if len(peers_ref) < 2: return\n    ref = pivot[peers_ref].median(axis=1, skipna=True)\n    t = pivot[st]\n    df = pd.DataFrame({'t': t, 'ref': ref}).dropna()\n    if len(df) < 10: return\n    resid = df['t'] - df['ref']\n    # check correlations\n    best = None\n    best_name = None\n    best_r = 0\n    for name, wp in [('temp', w_pivot_temp), ('hum', w_pivot_hum), ('wind', w_pivot_wind), ('rain', w_pivot_rain)]:\n        if d not in wp.columns: continue\n        w = wp[d].reindex(df.index)\n        wr = pd.DataFrame({'res': resid, 'w': w}).dropna()\n        if len(wr) < 8: continue\n        try:\n            r = stats.pearsonr(wr['res'], wr['w'])[0]\n            if abs(r) > abs(best_r):\n                best_r = r; best_name = name\n        except:\n            pass\n    print(f'{st}: mean={t.mean():.2f}, std={t.std():.2f}, peer_mean_std={pivot[peers_ref].std(axis=0).mean():.2f}, best_corr={best_name}={best_r:.3f}')\n\n# look for anomaly 3 candidates\nfor st in pm25_pivot.columns:\n    analyze(st, pm25_pivot)\nPY" action.permission=* action.action=allow action.pattern=*
