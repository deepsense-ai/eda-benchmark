timestamp=2026-11-09T08:10:12.144Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\npm25 = readings[readings['pollutant']=='PM25']\npm25_pivot = pm25.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\nst_info = stations.set_index('station_id')\n\ndef max_lag_corr(target, district, maxlag=3):\n    peers = st_info[st_info['district']==district].index.intersection(pm25_pivot.columns)\n    # exclude target if we want peer reference\n    peers_ref = [p for p in peers if p != target]\n    if len(peers_ref) == 0:\n        return None\n    ref = pm25_pivot[peers_ref].median(axis=1, skipna=True)\n    t = pm25_pivot[target]\n    best = (-10, -1)\n    for lag in range(-maxlag, maxlag+1):\n        if lag < 0:\n            a = t.iloc[:lag]; b = ref.iloc[-lag:]\n        elif lag == 0:\n            a = t; b = ref\n        else:\n            a = t.iloc[lag:]; b = ref.iloc[:-lag]\n        if len(a) > 5 and len(b) > 5:\n            try:\n                r = stats.pearsonr(a, b)[0]\n            except:\n                continue\n            if r > best[1]:\n                best = (lag, r)\n    return best\n\n# Try on a few examples\nfor target in ['ST001', 'ST002', 'ST003', 'ST010', 'ST011']:\n    d = st_info.loc[target, 'district']\n    res = max_lag_corr(target, d)\n    if res:\n        print(f'{target} ({d}): best_lag={res[0]}, r={res[1]:.3f}, lag0_r={stats.pearsonr(pm25_pivot[target], pm25_pivot[[p for p in st_info[st_info[\"district\"]==d].index if p in pm25_pivot.columns and p!=target]].median(axis=1, skipna=True))[0]:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
