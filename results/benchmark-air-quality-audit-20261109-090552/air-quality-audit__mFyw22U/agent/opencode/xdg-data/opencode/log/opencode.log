timestamp=2026-11-09T08:12:02.224Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\n# Another approach for phase shift: dynamic time warping or just look at shape similarity ignoring exact timing?\n# Or compute correlation with shifted series properly by aligning indices\n# For lag +1, shift t forward by 1 step: t shifted aligns t_{i+1} with ref_{i}. \n# So compare t.iloc[1:] with ref.iloc[:-1]. That gives lag +1 correlation.\n# Let us recompute carefully.\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\npm25 = readings[readings['pollutant']=='PM25']\npm25_pivot = pm25.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\nst_info = stations.set_index('station_id')\n\ntarget = 'ST002'\nd = st_info.loc[target, 'district']\npeers = st_info[st_info['district']==d].index.intersection(pm25_pivot.columns)\npeers_ref = [p for p in peers if p != target]\nref = pm25_pivot[peers_ref].median(axis=1, skipna=True)\n\n# Handle NaNs by interpolating or by aligning valid pairs\nt = pm25_pivot[target]\n# align\ndf = pd.DataFrame({'t': t, 'ref': ref}).interpolate(limit=1)\nfor lag in range(-2, 3):\n    if lag == 0:\n        a,b = df['t'], df['ref']\n    elif lag > 0:\n        a,b = df['t'].iloc[lag:], df['ref'].iloc[:-lag]\n    else:\n        a,b = df['t'].iloc[:lag], df['ref'].iloc[-lag:]\n    if len(a)>=10:\n        try:\n            print(f'lag={lag}: r={stats.pearsonr(a,b)[0]:.3f}')\n        except:\n            pass\nPY" action.permission=* action.action=allow action.pattern=*
