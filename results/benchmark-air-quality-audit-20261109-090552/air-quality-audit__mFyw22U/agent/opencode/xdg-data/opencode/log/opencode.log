timestamp=2026-11-09T08:10:41.943Z level=INFO run=5a234059 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\npm25 = readings[readings['pollutant']=='PM25']\npm10 = readings[readings['pollutant']=='PM10']\npm25_pivot = pm25.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\npm10_pivot = pm10.pivot_table(index='timestamp', columns='station_id', values='current_reading').sort_index()\nst_info = stations.set_index('station_id')\n\n# Check ST002 more carefully - has NaNs, lag1 correlation low. Also \"broadly follows local patterns, but not with the same rhythm\"\n# Maybe interpolate for lag analysis? Also look at the actual shape vs peers\ntarget = 'ST002'\nd = st_info.loc[target, 'district']\npivot = pm25_pivot\npeers = st_info[st_info['district']==d].index.intersection(pivot.columns)\npeers_ref = [p for p in peers if p != target]\nref = pivot[peers_ref].median(axis=1, skipna=True)\nt = pivot[target]\n\n# After interpolating small gaps?\nt_interp = t.interpolate(method='linear', limit=2)\nref_interp = ref.interpolate(method='linear', limit=2)\n# check lag\nfor lag in range(-2, 3):\n    if lag < 0:\n        a = t_interp.iloc[:lag]; b = ref_interp.iloc[-lag:]\n    elif lag == 0:\n        a = t_interp; b = ref_interp\n    else:\n        a = t_interp.iloc[lag:]; b = ref_interp.iloc[:-lag]\n    try:\n        r = stats.pearsonr(a, b)[0]\n        print(f'lag={lag}: r={r:.3f} (n={len(a)})')\n    except Exception as e:\n        print(f'lag={lag}: err')\nPY" action.permission=* action.action=allow action.pattern=*
