timestamp=2026-11-09T08:26:23.613Z level=INFO run=62a397e7 message=evaluated permission=bash pattern="cat > /tmp/step8.py << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nmask_real = ((df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) &\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) &\n             (df['age'] <= 120))\ndf_thresh = df[mask_real].copy()\n\n# IQR + glucose rule outliers\noutliers_final = set()\nfor colname in ['age', 'bmi']:\n    Q1 = df_thresh[colname].quantile(0.25)\n    Q3 = df_thresh[colname].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    m = (df_thresh[colname] < lower) | (df_thresh[colname] > upper)\n    outliers_final.update(df_thresh[m].index.tolist())\n\ncol = 'avg_glucose_level'\nQ1 = df_thresh[col].quantile(0.25)\nQ3 = df_thresh[col].quantile(0.75)\nIQR = Q3 - Q1\nlower = Q1 - 3 * IQR\nupper = Q3 + 3 * IQR\ngluc_out_mask = (df_thresh[col] < lower) | (df_thresh[col] > upper)\nfor idx in df_thresh[gluc_out_mask].index:\n    v = df_thresh.loc[idx, col]\n    others = df_thresh[df_thresh[col] == v]\n    total = len(others)\n    stroke = (others['stroke'] == 1).sum()\n    pct = stroke / total * 100 if total > 0 else 0\n    if pct >= 50:\n        continue\n    elif pct > 20:\n        df_log = df_thresh.copy()\n        df_log[col] = np.log2(df_log[col])\n        v_log = np.log2(v)\n        same_log = df_log[np.isclose(df_log[col], v_log, atol=1e-10)]\n        total_sl = len(same_log)\n        stroke_sl = (same_log['stroke'] == 1).sum()\n        pct_sl = stroke_sl / total_sl * 100 if total_sl > 0 else 0\n        if pct_sl >= 50:\n            continue\n        outliers_final.add(idx)\n    else:\n        outliers_final.add(idx)\n\n# Remove standard outliers\ndf_clean = df_thresh.drop(index=outliers_final).copy()\n\n# risk proxy and mahalanobis\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nrisk_proxy = np.ones(len(df_clean))\nfor c in num_cols:\n    risk_proxy *= (df_clean[c].values / df_clean[c].max())\ndf_clean['risk_proxy'] = risk_proxy\n\nX = df_clean[num_cols].values\nmean = X.mean(axis=0)\ncov = np.cov(X, rowvar=False)\ntry:\n    inv_cov = np.linalg.inv(cov)\nexcept:\n    inv_cov = np.linalg.pinv(cov)\ndiff = X - mean\nd2 = np.sum(diff @ inv_cov * diff, axis=1)\ndf_chi = X.shape[1]\ncrit = chi2.ppf(1 - 0.01, df=df_chi)\nmah_outliers = set(df_clean[d2 > crit].index.tolist())\n\n# Combine all outliers\nall_outliers = set(outliers_final)\nall_outliers.update(mah_outliers)\nprint(len(all_outliers))\nPY" action.permission=* action.action=allow action.pattern=*
