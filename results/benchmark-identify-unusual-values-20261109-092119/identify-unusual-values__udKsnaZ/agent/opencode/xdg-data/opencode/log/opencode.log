timestamp=2026-11-09T08:27:20.033Z level=INFO run=62a397e7 message=evaluated permission=bash pattern="cat > /tmp/step11.py << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nall_outliers = set()\n\n# unrealistic numeric\nmask_realistic = ((df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) &\n                  (df['bmi'] >= 10) & (df['bmi'] <= 60) &\n                  (df['age'] <= 120))\nall_outliers.update(df[~mask_realistic].index.tolist())\ndf_thresh = df[mask_realistic].copy()\n\n# std\nstd_out = set()\nfor colname in ['age', 'bmi']:\n    Q1 = df_thresh[colname].quantile(0.25)\n    Q3 = df_thresh[colname].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    m = (df_thresh[colname] < lower) | (df_thresh[colname] > upper)\n    std_out.update(df_thresh[m].index.tolist())\n\ncol = 'avg_glucose_level'\nQ1 = df_thresh[col].quantile(0.25)\nQ3 = df_thresh[col].quantile(0.75)\nIQR = Q3 - Q1\nlower = Q1 - 3 * IQR\nupper = Q3 + 3 * IQR\nfor idx in df_thresh[(df_thresh[col] < lower) | (df_thresh[col] > upper)].index:\n    v = df_thresh.loc[idx, col]\n    others = df_thresh[df_thresh[col] == v]\n    total = len(others)\n    stroke = (others['stroke'] == 1).sum()\n    pct = stroke / total * 100 if total > 0 else 0\n    if pct >= 50:\n        continue\n    elif pct > 20:\n        df_log = df_thresh.copy()\n        df_log[col] = np.log2(df_log[col])\n        v_log = np.log2(v)\n        same_log = df_log[np.isclose(df_log[col], v_log, atol=1e-10)]\n        total_sl = len(same_log)\n        stroke_sl = (same_log['stroke'] == 1).sum()\n        pct_sl = stroke_sl / total_sl * 100 if total_sl > 0 else 0\n        if pct_sl >= 50:\n            continue\n        std_out.add(idx)\n    else:\n        std_out.add(idx)\nall_outliers.update(std_out)\n\n# mah\ndf_clean = df_thresh.drop(index=std_out).copy()\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nX = df_clean[num_cols].values\nmean = X.mean(axis=0)\ncov = np.cov(X, rowvar=False)\ntry:\n    inv_cov = np.linalg.inv(cov)\nexcept:\n    inv_cov = np.linalg.pinv(cov)\ndiff = X - mean\nd2 = np.sum(diff @ inv_cov * diff, axis=1)\ncrit = chi2.ppf(1 - 0.01, df=X.shape[1])\nmah_out = set(df_clean[d2 > crit].index.tolist())\nall_outliers.update(mah_out)\n\n# Categorical checks\n# - For outlier detection in categorical variables, the age of children should be set to no more than 14.\n# - For outlier detection in categorical variables, the age of toddelrs should be set to no more than 3.\n# - check “smoker” or “formerly smoked” / person working in children? (unclear phrasing)\n#   \"check whether there are any values among the categorical variables that are unlikely in reality,\n#    such as “smoker” or “formerly smoked” / person working in children.\" Maybe something like a child who is a smoker/formerly smoked is unlikely? Or work_type 'children' combined with odd things?\n# - \"Additionaly you should chceck whether there are any toddlers that are students. If so they should be also considered as outliers.\"\n\ncat_out = set()\n# Check conditions\nfor idx, row in df.iterrows():  # check in original df\n    age = row['age']\n    work = str(row['work_type'])\n    smoke = str(row['smoking_status'])\n    # child age typically? \"age of children should be set to no more than 14\"\n    # \"age of toddelrs should be set to no more than 3\"\n    is_child = age <= 14  # child\n    is_toddler = age <= 3  # toddler\n    # unlikely: smoker or formerly smoked for very young children? Or \"smoker or formerly smoked / person working in children\" as the example given\n    # \"such as “smoker” or “formerly smoked” / person working in children\" - maybe a person who is a smoker/formerly smoked AND is a child (or working in children context)? Or just unusual combos like child with smoking status that implies they smoke? Or work_type children but age > 14? Or child who is smoker.\n    # Also: \"toddels that are students\" -> if age <= 3 and work_type is 'student' (or maybe student at that age)? Students are usually older children; toddlers as students is odd.\n    if is_toddler and work == 'student':\n        cat_out.add(idx)\n    # Also check: children (age <= 14) who are smokers or formerly smoked? That seems implausible.\n    if is_child and smoke in ('smoker', 'formerly smoked'):\n        cat_out.add(idx)\n    # Also maybe work_type 'children' but person is adult? Or vice versa? Or \"person working in children\" - maybe work_type relates to children; could be 'children' as work_type value. Let us look at values: work_type has 'children'.\n    # If someone has work_type 'children' but they are not a child (age > 14)? Or if age <= 14 but work_type is something else odd? Or the rule says \"person working in children\" as an example phrase - maybe work_type is 'children' but age is > 14? Or age is child but working as 'Govt_job' etc is fine. Hmm.\n    if work == 'children' and age > 14:\n        cat_out.add(idx)\n    # also maybe child (<=14) with certain adult work types? less clear; but common is child work restrictions. Not explicitly stated. The stated checks are: toddlers <=3 who are students -> outliers; and the age thresholds given for children/toddlers for \"outlier detection in categorical variables\".\n    # Let us also check: toddlers (age <=3) with work_type other than 'Never_worked' or 'children' maybe? Or just as stated.\n    if is_toddler and work not in ('Never_worked', 'children'):\n        # possible - but not explicitly stated. The explicit condition given is \"toddles that are students\"\n        pass\n\nall_outliers.update(cat_out)\nprint(len(cat_out), len(all_outliers))\nPY" action.permission=* action.action=allow action.pattern=*
