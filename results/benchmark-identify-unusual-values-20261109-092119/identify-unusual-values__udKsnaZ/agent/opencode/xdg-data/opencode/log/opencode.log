timestamp=2026-11-09T08:22:30.345Z level=INFO run=62a397e7 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n# Apply initial threshold filters\ndf_clean = df[(df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) &\n              (df['bmi'] >= 10) & (df['bmi'] <= 60) &\n              (df['age'] <= 120)].copy()\nprint(f'After threshold filters: {len(df_clean)} rows')\n\n# 3*IQR for numerical columns: age, bmi, avg_glucose_level\noutlier_indices_all = set()\n\nfor col in ['age', 'bmi', 'avg_glucose_level']:\n    Q1 = df_clean[col].quantile(0.25)\n    Q3 = df_clean[col].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    mask = (df_clean[col] < lower) | (df_clean[col] > upper)\n    out_idx = df_clean[mask].index.tolist()\n    print(f'{col}: lower={lower:.2f}, upper={upper:.2f}, outliers={len(out_idx)}')\n    outlier_indices_all.update(out_idx)\n\nprint(f'Total unique IQR outliers: {len(outlier_indices_all)}')\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
