timestamp=2026-11-09T08:24:57.905Z level=INFO run=62a397e7 message=evaluated permission=bash pattern="python -c \"\n# So no cases fall into the >20% and <50% bucket. Cases are either >=50% (not outliers) or <=20% (remain outliers, no transform needed).\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf_clean = df[(df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) &\n              (df['bmi'] >= 10) & (df['bmi'] <= 60) &\n              (df['age'] <= 120)].copy()\n\ncol = 'avg_glucose_level'\nQ1 = df_clean[col].quantile(0.25)\nQ3 = df_clean[col].quantile(0.75)\nIQR = Q3 - Q1\nlower = Q1 - 3 * IQR\nupper = Q3 + 3 * IQR\ngluc_out_mask = (df_clean[col] < lower) | (df_clean[col] > upper)\n\nfor v in sorted(df_clean[gluc_out_mask][col].unique()):\n    g_all = df_clean[df_clean[col] == v]\n    total = len(g_all)\n    stroke = (g_all['stroke'] == 1).sum()\n    pct = stroke / total * 100 if total > 0 else 0\n    if pct >= 50:\n        status = 'NOT_OUTLIER'\n    elif pct > 20:  # >20% means strictly greater than 20; so 21% qualifies\n        status = 'LOG2_THEN_RECHECK'\n    else:  # <=20%\n        status = 'IS_OUTLIER'\n    print(f'{v:8.2f}: pct={pct:5.1f}% -> {status}')\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
