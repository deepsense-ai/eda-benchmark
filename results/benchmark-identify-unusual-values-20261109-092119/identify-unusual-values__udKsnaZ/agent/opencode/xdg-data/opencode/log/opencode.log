timestamp=2026-11-09T08:23:57.832Z level=INFO run=62a397e7 message=evaluated permission=bash pattern="cat > /tmp/check_rule.py << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf_clean = df[(df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) &\n              (df['bmi'] >= 10) & (df['bmi'] <= 60) &\n              (df['age'] <= 120)].copy()\n\ncol = 'avg_glucose_level'\nQ1 = df_clean[col].quantile(0.25)\nQ3 = df_clean[col].quantile(0.75)\nIQR = Q3 - Q1\nlower = Q1 - 3 * IQR\nupper = Q3 + 3 * IQR\nmask_out = (df_clean[col] < lower) | (df_clean[col] > upper)\n\nnot_outliers_due_to_stroke = set()\ntransform_and_check = set()\n\nfor v in df_clean[mask_out][col].unique():\n    g_all = df_clean[df_clean[col] == v]\n    total = len(g_all)\n    stroke = (g_all['stroke'] == 1).sum()\n    pct = stroke / total * 100 if total > 0 else 0\n    if pct >= 50:  # 50% or more\n        not_outliers_due_to_stroke.add(v)\n    elif pct > 20:  # more than 20%\n        transform_and_check.add(v)\n\nprint('>=50% (not outliers):', not_outliers_due_to_stroke)\nprint('\\n>20% (need log2 transform check):', transform_and_check)\nPY" action.permission=* action.action=allow action.pattern=*
