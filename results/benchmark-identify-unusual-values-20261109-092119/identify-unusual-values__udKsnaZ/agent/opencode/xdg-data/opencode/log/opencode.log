timestamp=2026-11-09T08:26:55.479Z level=INFO run=62a397e7 message=evaluated permission=bash pattern="cat > /tmp/step10.py << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nall_outliers = set()\n\n# unrealistic\nmask_realistic = ((df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) &\n                  (df['bmi'] >= 10) & (df['bmi'] <= 60) &\n                  (df['age'] <= 120))\nall_outliers.update(df[~mask_realistic].index.tolist())\ndf_thresh = df[mask_realistic].copy()\n\n# std outliers\nstd_out = set()\nfor colname in ['age', 'bmi']:\n    Q1 = df_thresh[colname].quantile(0.25)\n    Q3 = df_thresh[colname].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    m = (df_thresh[colname] < lower) | (df_thresh[colname] > upper)\n    std_out.update(df_thresh[m].index.tolist())\n\ncol = 'avg_glucose_level'\nQ1 = df_thresh[col].quantile(0.25)\nQ3 = df_thresh[col].quantile(0.75)\nIQR = Q3 - Q1\nlower = Q1 - 3 * IQR\nupper = Q3 + 3 * IQR\nfor idx in df_thresh[(df_thresh[col] < lower) | (df_thresh[col] > upper)].index:\n    v = df_thresh.loc[idx, col]\n    others = df_thresh[df_thresh[col] == v]\n    total = len(others)\n    stroke = (others['stroke'] == 1).sum()\n    pct = stroke / total * 100 if total > 0 else 0\n    if pct >= 50:\n        continue\n    elif pct > 20:\n        df_log = df_thresh.copy()\n        df_log[col] = np.log2(df_log[col])\n        v_log = np.log2(v)\n        same_log = df_log[np.isclose(df_log[col], v_log, atol=1e-10)]\n        total_sl = len(same_log)\n        stroke_sl = (same_log['stroke'] == 1).sum()\n        pct_sl = stroke_sl / total_sl * 100 if total_sl > 0 else 0\n        if pct_sl >= 50:\n            continue\n        std_out.add(idx)\n    else:\n        std_out.add(idx)\nall_outliers.update(std_out)\n\n# remove std outliers\ndf_clean = df_thresh.drop(index=std_out).copy()\n# mahalanobis\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nX = df_clean[num_cols].values\nmean = X.mean(axis=0)\ncov = np.cov(X, rowvar=False)\ntry:\n    inv_cov = np.linalg.inv(cov)\nexcept:\n    inv_cov = np.linalg.pinv(cov)\ndiff = X - mean\nd2 = np.sum(diff @ inv_cov * diff, axis=1)\ncrit = chi2.ppf(1 - 0.01, df=X.shape[1])\nmah_out = set(df_clean[d2 > crit].index.tolist())\nall_outliers.update(mah_out)\nprint(f'Mah: {len(mah_out)}, total: {len(all_outliers)}')\nPY" action.permission=* action.action=allow action.pattern=*
