timestamp=2026-11-09T09:32:15.687Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# Combine patterns properly\nimport re\n\ndef parse_maintenance_line(line):\n    # find farm\n    farm = None\n    farm_names = ['Solar Park Alpha', 'Pacific Sunfield', 'Sakura Energy Site', 'Kowhai Solar Plant', 'Atacama Mirror One', 'Vistula Photovoltaics', 'Sahara Array', 'Outback Sun', 'Desert Oasis Solar', 'Thames Solar', 'Liberty Sun Park', 'Merlion Energy', 'Berlin Solar Node', 'Edo Sun Matrix', 'Maple Leaf Arrays', 'Roman Sunfields', 'Victoria Solar Park', 'Windy City Solar', 'Pearl River Energy', 'Iberian Photovoltaics', 'Ganges Solar', 'Aztec Sun', 'Eiffel Energy', 'Savannah Array']\n    for fn in farm_names:\n        if fn.lower() in line.lower():\n            farm = fn\n            break\n    # find status\n    status = 'COMPLETED' if 'completed' in line.lower() else ('CANCELLED' if 'cancelled' in line.lower() else None)\n    # find times\n    times = re.findall(r'(\\d{1,2}:\\d{2})', line)\n    # find date\n    m = re.search(r'on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+(?:of\\s+)?([A-Za-z]+)', line)\n    if not m:\n        m = re.search(r'on\\s+([A-Za-z]+)\\s+(\\d{1,2})(?:st|nd|rd|th)?,?', line)\n    day = int(m.group(1)) if m else None\n    month = m.group(2) if m else None\n    return farm, status, day, month, times\n\nlines = open('/app/dataset/maintenance_notes.txt').read().splitlines()\nfor l in lines:\n    if 'Status' in l or 'COMPLETED' in l or 'CANCELLED' in l:\n        print(parse_maintenance_line(l))\nPY" action.permission=* action.action=allow action.pattern=*
