timestamp=2026-11-09T09:42:44.128Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat >> /app/answer2.py << 'PY'\n\ndef is_in_maintenance_window(ts_utc, farm_id, maintenance_windows, farm_id_to_meta):\n    meta = farm_id_to_meta.get(farm_id)\n    if not meta:\n        return False\n    tz_str = meta['timezone']\n    try:\n        tz = pytz.timezone(tz_str)\n    except Exception:\n        return False\n    try:\n        ts_local = ts_utc.astimezone(tz)\n    except Exception:\n        return False\n    farm_key = meta['farm_key']\n    for w in maintenance_windows:\n        if w['farm_key'] != farm_key or w['status'] != 'COMPLETED':\n            continue\n        try:\n            start_str = f\"2024 {w['month']} {w['day']} {w['start_time']}\"\n            end_str = f\"2024 {w['month']} {w['day']} {w['end_time']}\"\n            fmt = \"%Y %B %d %H:%M\"\n            try:\n                w_start = tz.localize(datetime.strptime(start_str, fmt))\n                w_end = tz.localize(datetime.strptime(end_str, fmt))\n            except Exception:\n                start_str = f\"2024 {w['month'][:3]} {w['day']} {w['start_time']}\"\n                end_str = f\"2024 {w['month'][:3]} {w['day']} {w['end_time']}\"\n                fmt = \"%Y %b %d %H:%M\"\n                w_start = tz.localize(datetime.strptime(start_str, fmt))\n                w_end = tz.localize(datetime.strptime(end_str, fmt))\n        except Exception:\n            continue\n        if ts_local >= w_start and ts_local < w_end:\n            return True\n    return False\nPY" action.permission=* action.action=allow action.pattern=*
