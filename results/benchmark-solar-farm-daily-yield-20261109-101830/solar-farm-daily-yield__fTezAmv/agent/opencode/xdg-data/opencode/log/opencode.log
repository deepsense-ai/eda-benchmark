timestamp=2026-11-09T09:22:36.992Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# Better robust function\nimport pandas as pd\nfrom io import StringIO\n\ndef read_production_robust(path):\n    # try encodings\n    for enc in ['utf-8', 'utf-16le', 'utf-16be', 'latin-1']:\n        try:\n            with open(path, encoding=enc, errors='replace') as f:\n                text = f.read()\n        except:\n            continue\n        # split lines\n        lines = text.splitlines()\n        # find header line containing 'timestamp'\n        header_idx = None\n        for i, l in enumerate(lines[:10]):\n            if 'timestamp' in l.lower():\n                header_idx = i\n                break\n        if header_idx is None:\n            continue\n        header = lines[header_idx].strip()\n        # normalize separators\n        header = header.replace('\\t,', ',').replace(',\\t', ',').replace('\\t', ',')\n        header_cols = [c.strip() for c in header.split(',')]\n        data_lines = []\n        for i in range(header_idx + 1, len(lines)):\n            l = lines[i].strip()\n            if l:\n                data_lines.append(l)\n        if not data_lines:\n            continue\n        csv_data = '\\n'.join(data_lines)\n        try:\n            df = pd.read_csv(StringIO(csv_data), header=None, names=header_cols, on_bad_lines='skip')\n            return df\n        except:\n            continue\n    return pd.DataFrame()\nPY" action.permission=* action.action=allow action.pattern=*
