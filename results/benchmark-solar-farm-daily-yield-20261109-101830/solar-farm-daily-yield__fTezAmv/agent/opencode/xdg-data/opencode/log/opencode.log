timestamp=2026-11-09T09:22:59.116Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# Test a few more to see variations\nfrom io import StringIO\nimport pandas as pd\n\ndef read_production_robust(path):\n    for enc in ['utf-8', 'utf-16le', 'utf-16be', 'latin-1']:\n        try:\n            with open(path, encoding=enc, errors='replace') as f:\n                text = f.read()\n        except:\n            continue\n        lines = text.splitlines()\n        header_idx = None\n        for i, l in enumerate(lines[:15]):\n            if 'timestamp' in l.lower():\n                header_idx = i\n                break\n        if header_idx is None: continue\n        header = lines[header_idx].strip()\n        header = header.replace('\\t,', ',').replace(',\\t', ',').replace('\\t', ',')\n        header_cols = [c.strip() for c in header.split(',')]\n        data_lines = []\n        for i in range(header_idx + 1, len(lines)):\n            l = lines[i].strip()\n            if l: data_lines.append(l)\n        if not data_lines: continue\n        csv_data = '\\n'.join(data_lines)\n        try:\n            df = pd.read_csv(StringIO(csv_data), header=None, names=header_cols, on_bad_lines='skip')\n            return df\n        except: continue\n    return pd.DataFrame()\n\n# Check C and D\nimport os\nfor name in ['production_FARM_C.csv', 'production_FARM_D.csv', 'production_FARM_E.csv', 'production_FARM_F.csv', 'production_FARM_G.csv']:\n    df = read_production_robust(os.path.join('/app/dataset', name))\n    print(name, df.shape, df.columns.tolist()[:2])\nPY" action.permission=* action.action=allow action.pattern=*
