timestamp=2026-11-09T09:33:33.374Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat > /tmp/maint.py << 'PY'\nimport re\nfrom datetime import datetime\nimport pandas as pd\n\ndef parse_date(line):\n    m = re.search(r'on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+(?:of\\s+)?([A-Za-z]+)', line)\n    if m:\n        return int(m.group(1)), m.group(2)\n    m = re.search(r'on\\s+([A-Za-z]+)\\s+(\\d{1,2})(?:st|nd|rd|th)?,?', line)\n    if m:\n        return int(m.group(2)), m.group(1)\n    return None, None\n\ndef parse_times(line):\n    return re.findall(r'(\\d{1,2}:\\d{2})', line)\n\ndef parse_maintenance_lines(text, farm_names_list):\n    lines = [l.strip() for l in text.splitlines() if l.strip()]\n    windows = []\n    for l in lines:\n        low = l.lower()\n        if 'completed' not in low and 'cancelled' not in low:\n            continue\n        # find farm\n        farm_found = None\n        for fn in farm_names_list:\n            if fn.lower() in low:\n                farm_found = fn\n                break\n        if farm_found is None:\n            continue\n        status = 'COMPLETED' if 'completed' in low else 'CANCELLED'\n        day, month = parse_date(l)\n        times = parse_times(l)\n        if day is not None and month and len(times) >= 2:\n            windows.append({\n                'farm': farm_found,\n                'farm_key': farm_found.lower(),\n                'status': status,\n                'day': day,\n                'month': month,\n                'start_time': times[0],\n                'end_time': times[1],\n            })\n    return windows\nPY" action.permission=* action.action=allow action.pattern=*
