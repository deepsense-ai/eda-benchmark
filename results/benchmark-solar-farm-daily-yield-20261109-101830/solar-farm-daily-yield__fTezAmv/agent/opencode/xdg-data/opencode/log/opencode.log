timestamp=2026-11-09T09:22:30.848Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# So format is different - some files are utf-16le with BOM and tab/comma quirks, some are utf-8\n# Need a robust reader\nimport pandas as pd\nfrom io import StringIO\n\ndef read_any(path):\n    # Try encodings\n    for enc in ['utf-8', 'utf-16le', 'utf-16be', 'latin-1']:\n        try:\n            with open(path, 'rb') as f:\n                raw = f.read(2)\n            # skip BOM if utf-16le\n            with open(path, encoding=enc, errors='replace') as f:\n                lines = f.readlines()\n            # Clean\n            if len(lines) < 4:\n                continue\n            header = lines[3].strip()\n            # Clean header\n            header = header.replace('\\t,', ',').replace(',\\t', ',').replace('\\t', ',')\n            header_cols = [c.strip() for c in header.split(',')]\n            data_lines = []\n            start = 4\n            if len(lines) > 3 and 'timestamp' not in lines[3].lower():\n                # maybe header is on different line\n                start = 3\n            # Recompute if needed\n            if 'timestamp' not in header_cols[0].lower() and len(header_cols) > 1 and 'timestamp' not in header:\n                # look for actual header\n                for i, l in enumerate(lines[:10]):\n                    if 'timestamp' in l:\n                        header = l.strip()\n                        header = header.replace('\\t,', ',').replace(',\\t', ',').replace('\\t', ',')\n                        header_cols = [c.strip() for c in header.split(',')]\n                        start = i + 1\n                        break\n            data_lines = []\n            for i in range(start, len(lines)):\n                line = lines[i].strip()\n                if line:\n                    data_lines.append(line)\n            csv_data = '\\n'.join(data_lines)\n            df = pd.read_csv(StringIO(csv_data), header=None, names=header_cols, on_bad_lines='skip')\n            return df\n        except Exception:\n            continue\n    return pd.DataFrame()\nPY" action.permission=* action.action=allow action.pattern=*
