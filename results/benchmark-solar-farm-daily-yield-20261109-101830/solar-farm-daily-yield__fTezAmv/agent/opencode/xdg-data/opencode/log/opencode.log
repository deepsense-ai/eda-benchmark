timestamp=2026-11-09T09:39:37.018Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef build_spike_invalid_intervals(df, tz):\n    # Find spikes: inverter_temperature_C > 85.0\n    intervals = []  # list of (start_utc, end_utc) for invalidation\n    if 'inverter_temperature_C' not in df.columns:\n        return intervals\n    # Sort by timestamp\n    df_ts = df.copy()\n    # Parse timestamps to UTC\n    try:\n        df_ts['ts_utc'] = pd.to_datetime(df_ts['timestamp'], errors='coerce')\n    except Exception:\n        df_ts['ts_utc'] = pd.to_datetime(df_ts['timestamp'], errors='coerce', utc=True)\n    # Handle timezone\n    if df_ts['ts_utc'].dt.tz is None:\n        df_ts['ts_utc'] = df_ts['ts_utc'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\n    else:\n        df_ts['ts_utc'] = df_ts['ts_utc'].dt.tz_convert(tz)\n    # Convert to UTC for comparison? Or work in UTC - easier. Convert to UTC\n    df_ts['ts_utc'] = df_ts['ts_utc'].dt.tz_convert('UTC') if df_ts['ts_utc'].dt.tz is not None else df_ts['ts_utc']\n    # Find spikes\n    spikes = df_ts[df_ts['inverter_temperature_C'].astype(float) > 85.0]\n    for _, row in spikes.iterrows():\n        spike_ts = row['ts_utc']\n        if pd.isna(spike_ts):\n            continue\n        # interval is [spike_ts, spike_ts + 45 min)\n        start = spike_ts.to_pydatetime() if hasattr(spike_ts, 'to_pydatetime') else spike_ts\n        end = start + timedelta(minutes=45)\n        intervals.append((start, end))\n    return intervals\nPY" action.permission=* action.action=allow action.pattern=*
