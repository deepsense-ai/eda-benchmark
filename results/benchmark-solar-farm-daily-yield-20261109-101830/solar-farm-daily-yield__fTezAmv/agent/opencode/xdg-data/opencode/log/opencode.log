timestamp=2026-11-09T10:02:08.815Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# For this dataset, most numeric values are small (0-10^5 range). If parsing gives a value > 10^6 and there was a comma, and also the alternative interpretation gives a small value, prefer the small value. That is a pragmatic fix.\ndef parse_num_smart(s):\n    if pd.isna(s): return float('nan')\n    s = str(s).strip()\n    sl = s.lower()\n    if sl in ('nan','nat','inf','-inf','offline','null','none','', '-'): return float('nan')\n    candidates = []\n    # Try dot-decimal style (comma as thousands)\n    try:\n        c = s.replace(',', '')\n        v = float(c)\n        candidates.append(v)\n    except: pass\n    # Try European style (comma as decimal)\n    try:\n        c = s.replace('.', '').replace(',', '.')\n        v = float(c)\n        candidates.append(v)\n    except: pass\n    if not candidates: return float('nan')\n    # If only one, return it\n    if len(candidates) == 1: return candidates[0]\n    # Pick the more plausible one - prefer smaller magnitude unless context? or prefer the one that makes sense\n    # Prefer values that are not astronomically large if the other isn't\n    v1, v2 = candidates[0], candidates[1]\n    # If one is NaN, take other\n    # Prefer value with abs(v) < 10^7 as more plausible for sensor readings\n    def plausible(v):\n        return abs(v) < 10**7 and not (math.isinf(v) or math.isnan(v))\n    import math\n    p1, p2 = plausible(v1), plausible(v2)\n    if p1 and not p2: return v1\n    if p2 and not p1: return v2\n    # both plausible - prefer the smaller one? or just return v1\n    # or compare to typical range - but we don't know; return v1\n    return v1\nPY" action.permission=* action.action=allow action.pattern=*
