timestamp=2026-11-09T09:42:53.146Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat >> /app/answer2.py << 'PY'\n\ndef build_spike_intervals(df, tz):\n    intervals = []\n    if 'inverter_temperature_C' not in df.columns:\n        return intervals\n    try:\n        df_ts = df.copy()\n        df_ts['ts'] = pd.to_datetime(df_ts['timestamp'], errors='coerce')\n        if df_ts['ts'].dt.tz is None:\n            try:\n                df_ts['ts'] = df_ts['ts'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\n            except Exception:\n                df_ts['ts'] = df_ts['ts'].dt.tz_localize('UTC')\n        df_ts['ts_utc'] = df_ts['ts'].dt.tz_convert('UTC')\n        spikes = df_ts[df_ts['inverter_temperature_C'].astype(float) > 85.0]\n        for _, row in spikes.iterrows():\n            st = row['ts_utc']\n            if pd.isna(st): continue\n            start = st.to_pydatetime() if hasattr(st, 'to_pydatetime') else st\n            end = start + timedelta(minutes=45)\n            intervals.append((start, end))\n    except Exception:\n        pass\n    return intervals\n\ndef in_spike(ts_utc, intervals):\n    for s, e in intervals:\n        if ts_utc >= s and ts_utc < e:\n            return True\n    return False\nPY" action.permission=* action.action=allow action.pattern=*
