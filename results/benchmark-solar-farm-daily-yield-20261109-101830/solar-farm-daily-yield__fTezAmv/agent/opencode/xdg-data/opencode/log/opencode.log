timestamp=2026-11-09T09:23:57.893Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat > /tmp/read_robust2.py << 'PY'\nimport pandas as pd\nfrom io import StringIO\n\ndef read_production_robust(path):\n    # try encodings\n    best = None\n    for enc in ['utf-8', 'utf-16le', 'utf-16be', 'latin-1', 'cp1252']:\n        try:\n            with open(path, encoding=enc, errors='replace') as f:\n                text = f.read()\n        except:\n            continue\n        lines = text.splitlines()\n        # find header\n        header_idx = None\n        for i, l in enumerate(lines[:15]):\n            ll = l.lower()\n            if 'timestamp' in ll and ('power' in ll or 'value' in ll or 'reading' in ll or 'yield' in ll or 'generation' in ll or 'output' in ll or 'meter' in ll or 'kw' in ll):\n                header_idx = i\n                break\n            if 'timestamp' in ll:\n                header_idx = i\n                break\n        if header_idx is None:\n            continue\n        header = lines[header_idx].strip()\n        # normalize\n        header = header.replace('\\t', ',').replace(';', ',')\n        # collapse multiple commas\n        import re\n        header = re.sub(r',+', ',', header)\n        header_cols = [c.strip() for c in header.split(',')]\n        # clean empty\n        header_cols = [h for h in header_cols if h]\n        data_lines = []\n        for i in range(header_idx + 1, len(lines)):\n            l = lines[i].strip()\n            if not l: continue\n            # normalize separators\n            l = l.replace('\\t', ',').replace(';', ',')\n            l = re.sub(r',+', ',', l)\n            data_lines.append(l)\n        if not data_lines: continue\n        csv_data = '\\n'.join(data_lines)\n        try:\n            df = pd.read_csv(StringIO(csv_data), header=None, names=header_cols, on_bad_lines='skip')\n            # drop completely empty rows\n            df = df.dropna(how='all')\n            best = df\n            break\n        except Exception as e:\n            continue\n    if best is None:\n        return pd.DataFrame()\n    return best\nPY" action.permission=* action.action=allow action.pattern=*
