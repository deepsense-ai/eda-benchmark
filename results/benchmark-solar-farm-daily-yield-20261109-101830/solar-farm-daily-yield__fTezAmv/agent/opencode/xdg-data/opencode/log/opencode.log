timestamp=2026-11-09T10:12:56.151Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# Quick sanity check on FARM_F's maintenance filtering\nimport os, sys\nsys.path.insert(0, '/app')\nfrom answer import read_production_robust, farms_cal, find_value_column, parse_num_smart, farm_id_to_meta, build_spike_intervals, is_in_maintenance_window, maintenance_windows, in_spike, REPORT_START_UTC, REPORT_END_UTC\nimport pandas as pd\nfrom zoneinfo import ZoneInfo\nimport math\n\nDATA_DIR = '/app/dataset'\nfarm_id = 'FARM_F'\ndf = read_production_robust(os.path.join(DATA_DIR, f'production_{farm_id}.csv'))\ncal = farms_cal[farm_id]\nval = find_value_column(df, cal)\nmeta = farm_id_to_meta[farm_id]\ntz = ZoneInfo(meta['timezone'])\nspike = build_spike_intervals(df, tz)\ndf['ts'] = pd.to_datetime(df['timestamp'], errors='coerce', dayfirst=False)\nif df['ts'].dt.tz is None:\n    try: df['ts'] = df['ts'].dt.tz_localize(tz)\n    except: df['ts'] = df['ts'].dt.tz_localize(ZoneInfo('UTC'))\ndf['ts_utc'] = df['ts'].dt.tz_convert(ZoneInfo('UTC'))\n\n# check some timestamps around 11:00-13:00 UTC on 15th March\nfor i, (_, r) in enumerate(df.iterrows()):\n    ts = r['ts_utc']\n    if pd.isna(ts): continue\n    if ts.date() == REPORT_START_UTC.date():\n        # check hour\n        if ts.hour == 11 or ts.hour == 12:\n            print(ts, 'maint?', is_in_maintenance_window(ts, farm_id, maintenance_windows, farm_id_to_meta))\n            if i > 50: break\nPY" action.permission=* action.action=allow action.pattern=*
