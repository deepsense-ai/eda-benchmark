timestamp=2026-11-09T09:50:07.182Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\nimport os, sys\nsys.path.insert(0, '/app')\nfrom answer import read_production_robust, find_value_column, farms_cal, build_spike_intervals, farm_id_to_meta, is_in_maintenance_window, maintenance_windows, in_spike, REPORT_START_UTC, REPORT_END_UTC\nimport pandas as pd\nfrom zoneinfo import ZoneInfo\nfrom datetime import datetime\n\nDATA_DIR = '/app/dataset'\ndf = read_production_robust(os.path.join(DATA_DIR, 'production_FARM_B.csv'))\nfarm_id = 'FARM_B'\ncal_info = farms_cal[farm_id]\nval_col = find_value_column(df, cal_info)\nmeta = None\n# find meta\nfor k, m in farm_id_to_meta.items():\n    if k == farm_id:\n        meta = m; break\ntz = ZoneInfo(meta['timezone'])\nspike_intervals = build_spike_intervals(df, tz)\n# parse\ndf['ts'] = pd.to_datetime(df['timestamp'], errors='coerce')\nif df['ts'].dt.tz is None:\n    try:\n        df['ts'] = df['ts'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\n    except:\n        df['ts'] = df['ts'].dt.tz_localize(ZoneInfo('UTC'))\ndf['ts_utc'] = df['ts'].dt.tz_convert(ZoneInfo('UTC'))\ntotal = 0.0\ncount = 0\nfor _, row in df.iterrows():\n    ts_utc = row['ts_utc']\n    if pd.isna(ts_utc): continue\n    if ts_utc < REPORT_START_UTC or ts_utc >= REPORT_END_UTC: \n        continue\n    if is_in_maintenance_window(ts_utc, farm_id, maintenance_windows, farm_id_to_meta):\n        continue\n    if in_spike(ts_utc, spike_intervals):\n        continue\n    try:\n        val = float(row[val_col])\n    except:\n        continue\n    offset = float(cal_info['calibration_data'].get('calibration_offset', 0.0))\n    true_val = val - offset\n    if true_val < 0:\n        continue\n    # unit MwH, energy\n    energy_kwh = true_val * 1000.0\n    total += energy_kwh\n    count += 1\nprint('count=', count, 'total=', total)\nPY" action.permission=* action.action=allow action.pattern=*
