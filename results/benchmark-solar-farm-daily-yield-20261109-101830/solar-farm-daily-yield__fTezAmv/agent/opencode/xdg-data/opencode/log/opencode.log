timestamp=2026-11-09T09:43:30.537Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat >> /app/answer2.py << 'PY'\n\ndef answer():\n    result = {}\n    # Initialize all farms to 0\n    for fid in farm_id_to_meta.keys():\n        result[fid] = 0\n    # Also ensure all farms in registry appear\n    for fid in farm_registry.values():\n        if fid not in result:\n            result[fid] = 0\n\n    for fname, farm_id in file_to_farm.items():\n        fpath = os.path.join(DATA_DIR, fname)\n        df = read_production_robust(fpath)\n        if df.empty:\n            continue\n        meta = farm_id_to_meta.get(farm_id)\n        if not meta:\n            continue\n        cal_info = farms_cal.get(farm_id)\n        if not cal_info:\n            continue\n        tz_str = meta['timezone']\n        try:\n            tz = pytz.timezone(tz_str)\n        except Exception:\n            tz = pytz.UTC\n\n        val_col = find_value_column(df, cal_info)\n        if val_col is None:\n            continue\n\n        # Build spike intervals\n        spike_intervals = build_spike_intervals(df, tz)\n\n        # Parse timestamps\n        try:\n            df['ts'] = pd.to_datetime(df['timestamp'], errors='coerce')\n        except Exception:\n            df['ts'] = pd.to_datetime(df['timestamp'], errors='coerce')\n\n        if df['ts'].dt.tz is None:\n            try:\n                df['ts'] = df['ts'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\n            except Exception:\n                df['ts'] = df['ts'].dt.tz_localize(pytz.UTC)\n        df['ts_utc'] = df['ts'].dt.tz_convert(pytz.UTC)\n\n        # Apply filters and compute\n        total = 0.0\n        for _, row in df.iterrows():\n            ts_utc = row['ts_utc']\n            if pd.isna(ts_utc):\n                continue\n            # Must be in reporting window [2024-03-15 00:00:00 UTC, 2024-03-16 00:00:00 UTC)\n            if ts_utc < REPORT_START_UTC or ts_utc >= REPORT_END_UTC:\n                continue\n            # Ignore if during maintenance window (COMPLETED)\n            if is_in_maintenance_window(ts_utc, farm_id, maintenance_windows, farm_id_to_meta):\n                continue\n            # Ignore if in spike invalidation window (45 min after spike)\n            if in_spike(ts_utc, spike_intervals):\n                continue\n\n            # Get value\n            try:\n                val = float(row[val_col])\n            except Exception:\n                try:\n                    val = float(str(row[val_col]).strip())\n                except Exception:\n                    continue\n\n            # Apply calibration offset: recorded value - true value = offset; so true = recorded - offset?\n            # Domain rule says: \"The `calibration_offset` is defined as: (recorded value) - (true value).\"\n            # So true = recorded - offset\n            offset = float(cal_info['calibration_data'].get('calibration_offset', 0.0))\n            true_val = val - offset\n\n            # Any value that is negative must be dropped, this rule is valid only after the calibration offset is applied.\n            if true_val < 0:\n                continue\n\n            # Convert units to kWh as needed\n            unit = str(cal_info['sensor_info'].get('unit', '')).lower()\n            # Determine if energy or power? sensor_info has reading_type and unit\n            reading_type = str(cal_info['sensor_info'].get('reading_type', '')).lower()\n\n            energy_kwh = true_val\n            if unit in ['wh', 'watt-hour', 'watt hour', 'w h']:\n                energy_kwh = true_val / 1000.0\n            elif unit in ['mwh', 'megawatt-hour', 'megawatt hour']:\n                energy_kwh = true_val * 1000.0\n            elif unit in ['btu', 'british thermal unit']:\n                # Rough conversion? Common in energy contexts? Or maybe just as given? \n                # But the task says compute total real energy production in kWh - units from data; maybe BTU is a different unit. \n                # Convert BTU to kWh: 1 kWh = 3412.14163 BTU, so kWh = BTU / 3412.14163\n                energy_kwh = true_val / 3412.14163\n            elif unit in ['kwh', 'kw h', 'kilowatt-hour', 'kilowatt hour']:\n                energy_kwh = true_val\n            elif unit in ['kw', 'kilowatt']:\n                # Power reading - need to integrate over time interval to get energy?\n                # Readings are time series (likely half-hourly or 15-min intervals based on sampling). \n                # Common in solar data: power in kW measured at intervals; energy for interval = power * interval_hours\n                # Look at timestamps frequency - many files have 30-min intervals\n                energy_kwh = true_val * 0.5  # assume 30-minute intervals\n            else:\n                # Try to infer\n                if 'wh' in unit and 'm' in unit:  # mwh\n                    energy_kwh = true_val * 1000.0\n                elif 'wh' in unit and 'k' in unit:  # kwh\n                    energy_kwh = true_val\n                elif 'wh' in unit:\n                    energy_kwh = true_val / 1000.0\n                elif unit == 'kw' or 'kw' in unit:\n                    energy_kwh = true_val * 0.5\n                else:\n                    # default assume kWh-like\n                    energy_kwh = true_val\n\n            total += energy_kwh\n\n        # Round each per-farm total to the nearest integer with Python's round()\n        total_rounded = round(total)\n        result[farm_id] = int(total_rounded)\n\n    return result\nPY" action.permission=* action.action=allow action.pattern=*
