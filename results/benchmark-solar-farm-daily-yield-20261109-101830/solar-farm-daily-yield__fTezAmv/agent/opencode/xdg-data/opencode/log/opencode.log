timestamp=2026-11-09T09:34:43.407Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat > /tmp/readprod2.py << 'PY'\nimport re\nimport pandas as pd\nfrom io import StringIO\n\ndef read_production_robust(path):\n    for enc in ['utf-8', 'utf-16le', 'utf-16be', 'latin-1', 'cp1252']:\n        try:\n            with open(path, encoding=enc, errors='replace') as f:\n                text = f.read()\n        except Exception:\n            continue\n        lines = text.splitlines()\n        header_idx = None\n        for i, l in enumerate(lines[:30]):\n            if 'timestamp' in l.lower():\n                header_idx = i\n                break\n        if header_idx is None:\n            continue\n        header = lines[header_idx].strip()\n        header = header.replace('\\t', ',').replace(';', ',')\n        header = re.sub(r',+', ',', header)\n        header_cols = [c.strip() for c in header.split(',') if c.strip()]\n        # dedupe\n        seen = {}\n        new_cols = []\n        for c in header_cols:\n            if c in seen:\n                seen[c] += 1\n                new_cols.append(f\"{c}_{seen[c]}\")\n            else:\n                seen[c] = 0\n                new_cols.append(c)\n        header_cols = new_cols\n        data_lines = []\n        for i in range(header_idx + 1, len(lines)):\n            l = lines[i].strip()\n            if not l:\n                continue\n            l = l.replace('\\t', ',').replace(';', ',')\n            l = re.sub(r',+', ',', l)\n            data_lines.append(l)\n        if not data_lines:\n            continue\n        csv_data = '\\n'.join(data_lines)\n        try:\n            df = pd.read_csv(StringIO(csv_data), header=None, names=header_cols, on_bad_lines='skip')\n            df = df.dropna(how='all')\n            return df\n        except Exception:\n            continue\n    return pd.DataFrame()\nPY" action.permission=* action.action=allow action.pattern=*
