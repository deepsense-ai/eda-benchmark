timestamp=2026-11-09T10:00:12.490Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# Test cases\ntests = ['-50.000,0000', '1.234,56', '1,234.56', '29,0200', '290200']\nfor t in tests:\n    print(t, '->', end=' ')\n    try:\n        # simulate\n        s = t.strip().lower().replace(' ', '')\n        if ',' in s and '.' in s:\n            if s.rfind(',') > s.rfind('.'):\n                s = s.replace('.', '').replace(',', '.')\n            else:\n                s = s.replace(',', '')\n        elif ',' in s and '.' not in s:\n            parts = s.split(',')\n            if len(parts) == 2 and len(parts[1]) <= 3:\n                s = s.replace(',', '.')\n            else:\n                s = s.replace(',', '')\n        v = float(s)\n        print(v)\n    except Exception as e:\n        print(e)\nPY" action.permission=* action.action=allow action.pattern=*
