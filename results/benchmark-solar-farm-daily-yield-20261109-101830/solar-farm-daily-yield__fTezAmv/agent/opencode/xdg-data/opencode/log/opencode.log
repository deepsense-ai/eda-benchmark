timestamp=2026-11-09T09:53:32.316Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\nimport os, sys\nsys.path.insert(0, '/app')\nfrom answer import read_production_robust, find_value_column, farms_cal, build_spike_intervals, farm_id_to_meta, is_in_maintenance_window, maintenance_windows, in_spike, REPORT_START_UTC, REPORT_END_UTC\nimport pandas as pd\nfrom zoneinfo import ZoneInfo\nimport math\n\nDATA_DIR = '/app/dataset'\ndf = read_production_robust(os.path.join(DATA_DIR, 'production_FARM_C.csv'))\nfarm_id = 'FARM_C'\ncal_info = farms_cal[farm_id]\nval_col = find_value_column(df, cal_info)\nprint('val_col:', val_col, 'cal:', cal_info)\nmeta = farm_id_to_meta.get(farm_id)\ntz = ZoneInfo(meta['timezone']) if meta else ZoneInfo('UTC')\nspike_intervals = build_spike_intervals(df, tz)\ndf['ts'] = pd.to_datetime(df['timestamp'], errors='coerce', dayfirst=False)\nif df['ts'].dt.tz is None:\n    try: df['ts'] = df['ts'].dt.tz_localize(tz)\n    except: df['ts'] = df['ts'].dt.tz_localize(ZoneInfo('UTC'))\ndf['ts_utc'] = df['ts'].dt.tz_convert(ZoneInfo('UTC'))\nkept = []\nfor i, (_, row) in enumerate(df.iterrows()):\n    ts_utc = row['ts_utc']\n    if pd.isna(ts_utc): continue\n    if ts_utc < REPORT_START_UTC or ts_utc >= REPORT_END_UTC: continue\n    if is_in_maintenance_window(ts_utc, farm_id, maintenance_windows, farm_id_to_meta): continue\n    if in_spike(ts_utc, spike_intervals): continue\n    raw = row[val_col]\n    if pd.isna(raw): continue\n    s = str(raw).strip().lower()\n    if s in ('nan','nat','inf','-inf','offline','null','none',''): continue\n    try: val = float(raw)\n    except: continue\n    if math.isnan(val) or math.isinf(val): continue\n    offset = float(cal_info['calibration_data']['calibration_offset'])\n    true_val = val - offset\n    if true_val < 0: \n        #print('neg:', true_val, 'val=', val, 'offset=', offset)\n        continue\n    kept.append(true_val)\nprint('kept:', len(kept), 'first few:', kept[:3] if kept else [])\nPY" action.permission=* action.action=allow action.pattern=*
