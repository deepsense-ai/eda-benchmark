timestamp=2026-11-09T10:00:02.136Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# Let us write a helper to parse numbers with European/International formats\ndef parse_num(s):\n    if pd.isna(s): return float('nan')\n    s = str(s).strip()\n    s = s.lower()\n    if s in ('nan','nat','inf','-inf','offline','null','none',''): return float('nan')\n    # Try to detect: if there is comma and no dot, or both present\n    # Common patterns: 1.234,56 (comma as decimal) or 1,234.56 (comma as thousands, dot as decimal)\n    # Or just 1234,56\n    # Remove spaces\n    s = s.replace(' ', '')\n    # If both comma and dot exist, assume comma is thousands sep and dot is decimal? Or the other way?\n    # Check which comes last - European usually comma comes last as decimal. International comma comes as thousands before dot.\n    if ',' in s and '.' in s:\n        if s.rfind(',') > s.rfind('.'):\n            # comma is after dot? unlikely. Or comma is decimal (e.g., 1.234,56 -> comma after dot positionally? 1.234,56 means thousands sep is dot, decimal is comma - common in some countries)\n            s = s.replace('.', '').replace(',', '.')\n        else:\n            # dot is after comma -> comma as thousands, dot as decimal (US style)\n            s = s.replace(',', '')\n    elif ',' in s and '.' not in s:\n        # Only comma - could be decimal separator\n        # Heuristic: if comma appears once and there are 1-3 digits after it, likely decimal\n        # Also if multiple commas, likely thousands\n        parts = s.split(',')\n        if len(parts) == 2 and len(parts[1]) <= 3:\n            s = s.replace(',', '.')\n        else:\n            # multiple parts or more digits after comma - treat as thousands\n            s = s.replace(',', '')\n    # else just dot - fine\n    try:\n        return float(s)\n    except:\n        return float('nan')\nPY" action.permission=* action.action=allow action.pattern=*
