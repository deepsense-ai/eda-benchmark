timestamp=2026-11-09T09:32:29.812Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="python3 << 'PY'\n# The order can be reversed. Need to handle both.\nimport re\n\ndef parse_date(line):\n    m = re.search(r'on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+(?:of\\s+)?([A-Za-z]+)', line)\n    if m:\n        return int(m.group(1)), m.group(2)\n    m = re.search(r'on\\s+([A-Za-z]+)\\s+(\\d{1,2})(?:st|nd|rd|th)?,?', line)\n    if m:\n        return int(m.group(2)), m.group(1)\n    return None, None\n\ndef parse_times(line):\n    times = re.findall(r'(\\d{1,2}:\\d{2})', line)\n    return times\nPY" action.permission=* action.action=allow action.pattern=*
