timestamp=2026-11-09T09:27:58.353Z level=INFO run=ce357dcf message=evaluated permission=bash pattern="cat > /tmp/solve.py << 'PY'\nimport json\nimport os\nimport re\nfrom io import StringIO\n\nimport pandas as pd\n\nDATA_DIR = '/app/dataset'\n\n# Load calibration\nwith open(os.path.join(DATA_DIR, 'sensors_calibration.json')) as f:\n    cal = json.load(f)\n\nfarms_cal = cal['enterprise_platform']['deployment_environments']['system_config']['farms']\n\n# Load farm registry\nfarm_registry = {}\ndf_reg = pd.read_csv(os.path.join(DATA_DIR, 'farm_registry.csv'))\nfor _, row in df_reg.iterrows():\n    farm_name = str(row['farm_name']).strip().lower()\n    farm_id = str(row['farm_id']).strip()\n    farm_registry[farm_name] = farm_id\n\n# Load farms metadata\nfarms_meta = {}\ndf_farms = pd.read_csv(os.path.join(DATA_DIR, 'farms.csv'))\nfor _, row in df_farms.iterrows():\n    farm_name = str(row['farm_name']).strip().lower()\n    farms_meta[farm_name] = {\n        'timezone': str(row['timezone']).strip(),\n        'installed_capacity_kw': float(row['installed_capacity_kw']) if pd.notna(row['installed_capacity_kw']) else 0.0,\n    }\nPY" action.permission=* action.action=allow action.pattern=*
