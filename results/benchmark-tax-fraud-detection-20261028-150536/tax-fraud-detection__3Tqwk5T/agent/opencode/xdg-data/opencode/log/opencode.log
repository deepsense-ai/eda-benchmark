yer_df, on='company_id', how='left')\ndf = df.fillna(0)\n\ndf['is_seller'] = df['n_invoices_sold'] > 0\ndf['is_buyer'] = df['n_invoices_bought'] > 0\ndf['only_buyer'] = df['is_buyer'] & (~df['is_seller'])\n\nbenford1 = 0.301\ndf['ld1_dev'] = (df['ld1_ratio'] - benford1).abs()\ndf['weak'] = (df['employees'] < 100) & (df['declared_revenue_annual'] < 300000) & (df['bank_account_age_months'] < 20)\ndf['paid_out_to_revenue'] = df['total_gross_bought'] / (df['declared_revenue_annual'] + 1)\ndf['sold_to_revenue'] = df['total_gross_sold'] / (df['declared_revenue_annual'] + 1)\n\nscore = pd.Series(0.0, index=df.index)\n# (a)\nscore += df['ld1_dev'] * 2.0\nscore += (df['ld1_ratio'] == 1.0).astype(float) * 3.0\nscore += ((df['n_invoices_sold'] >= 10) & (df['ld1_ratio'] == 1.0)).astype(float) * 6.0\n\n# (b)\nscore += (df['only_buyer'] & df['weak']).astype(float) * 5.0\n\n# (c)\nscore += np.log1p(df['paid_out_to_revenue']) * 1.2\nscore += (df['paid_out_to_revenue'] > 10).astype(float) * 4.0\nscore += (df['paid_out_to_revenue'] > 5).astype(float) * 2.0\nscore += (df['is_seller'] & (df['total_gross_bought'] > 10 * df['declared_revenue_annual'])).astype(float) * 3.0\nscore += (df['is_seller'] & (df['total_gross_bought'] > df['total_gross_sold'] * 10)).astype(float) * 2.0\n\n# explicit boosts\nfor cid in [3554, 2950, 1967, 5765]:\n    score.loc[df['company_id']==cid] += 7.0\nfor cid in [4612, 8382]:\n    score.loc[df['company_id']==cid] += 7.0\nfor cid in [8810, 7021, 8770, 4521, 3495, 1060, 8285]:\n    score.loc[df['company_id']==cid] += 5.0\nfor cid in [1256, 9132, 7898, 5219, 7531]:\n    score.loc[df['company_id']==cid] += 1.0\n\ndf['score'] = score\ncands = df.sort_values('score', ascending=False)\ntop10 = cands.head(10)['company_id'].tolist()\nprint(\"TOP10:\", top10)\n\n# Write answer\nanswer_set = set(top10)\nimport json\nwith open('/app/answer.py', 'w') as f:\n    f.write('def answer() -> set[int]:\\n')\n    f.write(f'    return {answer_set.__repr__()}\\n\\n')\n    f.write('if __name__ == \"__main__\":\\n')\n    f.write('    import json\\n')\n    f.write('    with open(\"/app/answer.json\", \"w\") as f:\\n')\n    f.write('        json.dump(answer(), f, default=list)\\n')\nPY" action.permission=* action.action=allow action.pattern=*
