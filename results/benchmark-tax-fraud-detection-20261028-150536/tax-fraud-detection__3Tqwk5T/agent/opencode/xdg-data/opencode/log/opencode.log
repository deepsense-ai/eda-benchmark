timestamp=2026-10-28T14:10:22.228Z level=INFO run=abf8af11 message=evaluated permission=bash pattern="cat > /tmp/check.py << 'PY'\nimport pandas as pd\n\n# Check these companies\ncids = [3554, 3495, 8285, 8770, 2950, 7021, 4521, 1060, 8810, 1967]\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\nfor cid in cids:\n    c = companies[companies['company_id']==cid].iloc[0]\n    # roles\n    sold = invoices[invoices['seller_id']==cid]\n    bought = invoices[invoices['buyer_id']==cid]\n    print(f\"\\n{cid}: {c['industry']}, emp={c['employees']}, rev={c['declared_revenue_annual']:.2f}, bank_age={c['bank_account_age_months']}\")\n    print(f\"  seller: {len(sold)} invoices, sold_to={sold['buyer_id'].nunique()} buyers, total={sold['gross_amount'].sum():.2f}\")\n    print(f\"  buyer: {len(bought)} invoices, bought_from={bought['seller_id'].nunique()} sellers, total={bought['gross_amount'].sum():.2f}\")\nPY" action.permission=* action.action=allow action.pattern=*
