timestamp=2026-10-28T14:08:36.163Z level=INFO run=abf8af11 message=evaluated permission=bash pattern="cat > /tmp/analyze14.py << 'PY'\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Build more features\nseller_stats = []\nfor sid, group in invoices.groupby('seller_id'):\n    amounts = group['gross_amount']\n    total_gross = amounts.sum()\n    total_net = group['net_amount'].sum() if 'net_amount' in group else 0\n    n = len(amounts)\n    lds = amounts.apply(lambda x: int(str(abs(float(x))).lstrip('0')[0]) if str(abs(float(x))).lstrip('0') else 0)\n    ld1 = (lds == 1).sum() / n if n > 0 else 0\n    buyer_shares = group.groupby('buyer_id')['gross_amount'].sum()\n    top_conc = buyer_shares.max() / total_gross if total_gross > 0 else 0\n    # external recipients - maybe \"payments to external recipients\" means payments going out? \n    # In invoices, we see seller -> buyer. Maybe external recipients are buyers? Or maybe companies they pay (vendors)?\n    # The phrase: \"sellers whose payments to external recipients look outsized relative to their declared business footprint\"\n    # Another interpretation: amount paid out (to suppliers/others) vs what they report. But we don't see payments out, only invoices where they are seller (receiving?) or invoices where they are buyer (paying). If they're buyers, they pay invoices to sellers. Sellers receive payments. \n    # \"payments to external recipients\" - maybe total amount a seller paid out (as buyer) to others? Or total received as seller vs paid as buyer?\n    # Also \"companies that appear only as buyers despite having weak operating fundamentals\" - only in buyer role.\n    seller_stats.append({\n        'company_id': sid,\n        'n_invoices_sold': n,\n        'total_gross_sold': total_gross,\n        'total_net_sold': total_net,\n        'avg_gross_sold': total_gross / n if n > 0 else 0,\n        'ld1_ratio': ld1,\n        'n_buyers_sold_to': group['buyer_id'].nunique(),\n        'top_buyer_concentration': top_conc\n    })\nseller_df = pd.DataFrame(seller_stats)\n\nbuyer_stats = []\nfor bid, group in invoices.groupby('buyer_id'):\n    amounts = group['gross_amount']\n    total = amounts.sum()\n    n = len(amounts)\n    # as buyer, total paid out\n    buyer_stats.append({\n        'company_id': bid,\n        'n_invoices_bought': n,\n        'total_gross_bought': total,\n        'avg_gross_bought': total / n if n > 0 else 0,\n        'n_sellers_bought_from': group['seller_id'].nunique()\n    })\nbuyer_df = pd.DataFrame(buyer_stats)\n\ndf = companies.merge(seller_df, on='company_id', how='left')\ndf = df.merge(buyer_df, on='company_id', how='left')\ndf = df.fillna(0)\n\ndf['is_seller'] = df['n_invoices_sold'] > 0\ndf['is_buyer'] = df['n_invoices_bought'] > 0\ndf['only_buyer'] = df['is_buyer'] & (~df['is_seller'])\ndf['only_seller'] = df['is_seller'] & (~df['is_buyer'])\nprint(f\"Only buyer: {df['only_buyer'].sum()}, Only seller: {df['only_seller'].sum()}, Both: {(df['is_seller'] & df['is_buyer']).sum()}, Neither: {(~df['is_seller'] & ~df['is_buyer']).sum()}\")\nPY" action.permission=* action.action=allow action.pattern=*
