k some details\nfor cid in sellers_sorted.head(5)['company_id'].tolist():\n    print(f\"\\n=== {cid} ===\")\n    c = sellers[sellers['company_id']==cid].iloc[0]\n    print(f\"Revenue: {c['declared_revenue_annual']:.2f}, Employees: {c['employees']}, Total gross sold: {c['total_gross_sold']:.2f}\")\nPY" action.permission=* action.action=allow action.pattern=*
