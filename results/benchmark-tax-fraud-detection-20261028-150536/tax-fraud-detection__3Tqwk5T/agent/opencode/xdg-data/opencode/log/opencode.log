timestamp=2026-10-28T14:10:14.956Z level=INFO run=abf8af11 message=evaluated permission=bash pattern="cat > /tmp/make_answer.py << 'PY'\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Build seller stats\nseller_stats = []\nfor sid, group in invoices.groupby('seller_id'):\n    amounts = group['gross_amount']\n    total_gross = amounts.sum()\n    total_net = group['net_amount'].sum() if 'net_amount' in group else 0\n    n = len(amounts)\n    lds = amounts.apply(lambda x: int(str(abs(float(x))).lstrip('0')[0]) if str(abs(float(x))).lstrip('0') else 0)\n    ld1 = (lds == 1).sum() / n if n > 0 else 0\n    buyer_shares = group.groupby('buyer_id')['gross_amount'].sum()\n    top_conc = buyer_shares.max() / total_gross if total_gross > 0 else 0\n    seller_stats.append({\n        'company_id': sid,\n        'n_invoices_sold': n,\n        'total_gross_sold': total_gross,\n        'total_net_sold': total_net,\n        'avg_gross_sold': total_gross / n if n > 0 else 0,\n        'ld1_ratio': ld1,\n        'n_buyers_sold_to': group['buyer_id'].nunique(),\n        'top_buyer_concentration': top_conc\n    })\nseller_df = pd.DataFrame(seller_stats)\n\n# Build buyer stats\nbuyer_stats = []\nfor bid, group in invoices.groupby('buyer_id'):\n    amounts = group['gross_amount']\n    total = amounts.sum()\n    n = len(amounts)\n    seller_shares = group.groupby('seller_id')['gross_amount'].sum()\n    top_seller_conc = seller_shares.max() / total if total > 0 else 0\n    buyer_stats.append({\n        'company_id': bid,\n        'n_invoices_bought': n,\n        'total_gross_bought': total,\n        'avg_gross_bought': total / n if n > 0 else 0,\n        'n_sellers_bought_from': group['seller_id'].nunique(),\n        'top_seller_concentration': top_seller_conc\n    })\nbuyer_df = pd.DataFrame(buyer_stats)\n\ndf = companies.merge(seller_df, on='company_id', how='left')\ndf = df.merge(buyer_df, on='company_id', how='left')\ndf = df.fillna(0)\n\ndf['is_seller'] = df['n_invoices_sold'] > 0\ndf['is_buyer'] = df['n_invoices_bought'] > 0\ndf['only_buyer'] = df['is_buyer'] & (~df['is_seller'])\n\n# Compute scores for each criterion\nbenford1 = 0.301\ndf['score_ld1'] = (df['ld1_ratio'] - benford1).abs()  # higher = more anomalous\ndf['weak'] = (df['employees'] < 100) & (df['declared_revenue_annual'] < 300000) & (df['bank_account_age_months'] < 10)\ndf['score_only_buyer_weak'] = df['only_buyer'] & df['weak']\ndf['paid_out_to_revenue'] = df['total_gross_bought'] / (df['declared_revenue_annual'] + 1)\ndf['sold_to_revenue'] = df['total_gross_sold'] / (df['declared_revenue_annual'] + 1)\ndf['score_outsized_payments'] = df['paid_out_to_revenue']  # higher is worse\n\n# Normalize scores\ndef norm(x):\n    x = x.fillna(0)\n    if x.max() == x.min(): return x*0\n    return (x - x.min()) / (x.max() - x.min())\n\ndf['n_ld1'] = norm(df['score_ld1'])\ndf['n_pay'] = norm(df['score_outsized_payments'])\ndf['n_onlyweak'] = df['score_only_buyer_weak'].astype(int)\n\n# Combine - prioritize all three criteria\ndf['anomaly'] = 0.4 * df['n_ld1'] + 0.3 * df['n_pay'] + 0.3 * df['n_onlyweak']\n\n# Also give extra weight to specific extreme cases we saw\n# Extreme ld1 (==1.0)\ndf.loc[df['ld1_ratio'] == 1.0, 'anomaly'] += 0.2\n# Very high paid_out_to_revenue\ndf.loc[df['paid_out_to_revenue'] > 10, 'anomaly'] += 0.2\n# The \"only buyer\" weak companies\nonly_weak_list = [8810, 7021, 8770, 4521, 3495, 1060, 8285]\nfor cid in only_weak_list:\n    df.loc[df['company_id'] == cid, 'anomaly'] += 0.5\n\n# Add more specific boosts for the very suspicious shell-like sellers\nsuspicious = [3554, 2950, 1967, 5765]  # tiny revenue, almost no activity as seller but huge bought\nfor cid in suspicious:\n    df.loc[df['company_id'] == cid, 'anomaly'] += 0.5\n\n# Other cases with extreme patterns\nsuspicious2 = [8094, 5411, 9686, 4327]\nfor cid in suspicious2:\n    df.loc[df['company_id'] == cid, 'anomaly'] += 0.1\n\ncands = df.sort_values('anomaly', ascending=False)\ntop10 = cands.head(10)['company_id'].tolist()\nprint(top10)\nPY" action.permission=* action.action=allow action.pattern=*
