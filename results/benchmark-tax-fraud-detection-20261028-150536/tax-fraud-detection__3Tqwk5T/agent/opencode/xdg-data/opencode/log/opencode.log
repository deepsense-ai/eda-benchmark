timestamp=2026-10-28T14:06:53.236Z level=INFO run=abf8af11 message=evaluated permission=bash pattern="cat > /tmp/analyze5.py << 'PY'\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Benford's law expected\nbenford = {1:0.301,2:0.176,3:0.125,4:0.097,5:0.079,6:0.067,7:0.058,8:0.051,9:0.046}\ndef leading_digit(x):\n    if x <= 0: return 0\n    s = str(abs(float(x))).lstrip('0')\n    if not s: return 0\n    return int(s[0])\n\n# Per seller analysis\nseller_stats = []\nfor sid, group in invoices.groupby('seller_id'):\n    amounts = group['gross_amount']\n    total = amounts.sum()\n    n = len(amounts)\n    # leading digit distribution\n    lds = amounts.apply(leading_digit)\n    # count leading 1s\n    ld1 = (lds == 1).sum() / n if n > 0 else 0\n    # outflow to external? sellers sell to buyers; maybe large payments to \"external recipients\" - \n    # but we don't see who they pay. Maybe \"payments to external recipients look outsized relative to their declared business footprint\"\n    # Could be: sellers with very high gross amount relative to declared revenue, or many invoices to few buyers, etc.\n    seller_stats.append({\n        'seller_id': sid,\n        'n_invoices': n,\n        'total_gross': total,\n        'avg_gross': total / n if n > 0 else 0,\n        'ld1_ratio': ld1,\n        'n_buyers': group['buyer_id'].nunique(),\n        'median_delay': group['payment_delay_days'].median()\n    })\n\nseller_df = pd.DataFrame(seller_stats)\nprint(seller_df['ld1_ratio'].describe())\nPY" action.permission=* action.action=allow action.pattern=*
