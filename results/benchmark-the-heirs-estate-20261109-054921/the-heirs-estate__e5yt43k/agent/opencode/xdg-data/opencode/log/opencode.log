timestamp=2026-11-09T05:53:48.870Z level=INFO run=80bcc019 message=evaluated permission=bash pattern="cat > /tmp/find_parents.py << 'PY'\nimport re\n\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\n# Get Dawid\nfor i, l in enumerate(lines):\n    if 'Dawid Majtyka' in l:\n        drow, dcol = i, l.find('Dawid Majtyka')\n        break\n\n# Look up\nparents = []\nfor i in range(drow-1, max(0, drow-80), -1):\n    l = lines[i]\n    # check for names near dcol\n    for m in re.finditer(r'\\b([A-Z][a-ząęćłńóśźż]{2,}\\s+[A-Z][a-ząęćłńóśźż]{2,})\\b', l):\n        if abs(m.start() - dcol) < 40:\n            parents.append((i, m.start(), m.group(1)))\n            if len(parents) > 3:\n                break\n    if len(parents) > 3:\n        break\n\nprint(parents)\nPY" action.permission=* action.action=allow action.pattern=*
