timestamp=2026-11-06T09:03:09.493Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col, tol=80):\n    for r in range(row-1, -1, -1):\n        line = lines[r]\n        import re\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < tol:\n                connected = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    w = max(12, tol//2)\n                    for dc in range(-w, w+1):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            if l2[cc] in '|+':\n                                connected = True\n                                break\n                    if connected: break\n                if connected:\n                    return (r, ncol, m.group(0))\n    return None\n\n# build maps\nparent = {}\n# find parents for all nodes\nimport re\nnodes = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches:\n        nodes.append((i, m.start(), m.group(0)))\n# dedup\nunique = []\nseen = set()\nfor n in nodes:\n    k = (n[0], n[1], n[2])\n    if k not in seen:\n        seen.add(k); unique.append(n)\n\n# find parents\nfor n in unique:\n    r,c,name = n\n    # choose tol based on row depth? maybe just adaptive\n    tol = 80\n    p = find_parent(lines, r, c, tol)\n    if not p:\n        # try larger tol\n        for t in [120, 180, 250, 350]:\n            p = find_parent(lines, r, c, t)\n            if p: break\n    parent[(r,c,name)] = p\nPY" action.permission=* action.action=allow action.pattern=*
