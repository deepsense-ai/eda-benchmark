timestamp=2026-11-06T09:12:34.652Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\n# Do the full computation in one go\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col, tol=80):\n    for r in range(row-1, -1, -1):\n        import re\n        line = lines[r]\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < tol:\n                connected = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    w = max(15, tol//2)\n                    for dc in range(-w, w+1):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            if l2[cc] in '|+': connected=True; break\n                    if connected: break\n                if connected: return (r,ncol,m.group(0))\n    return None\n\nimport re\nfrom collections import defaultdict\nnodes = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches: nodes.append((i,m.start(),m.group(0)))\nunique = []\nseen=set()\nfor n in nodes:\n    k=(n[0],n[1],n[2])\n    if k not in seen: seen.add(k); unique.append(n)\nparent_map={}\nfor n in unique:\n    r,c,name=n\n    p=find_parent(lines,r,c,80)\n    if not p:\n        for t in [120,180,250,350,500]:\n            p=find_parent(lines,r,c,t)\n            if p: break\n    parent_map[n]=p\nchildren_map=defaultdict(list)\nfor child,par in parent_map.items():\n    if par: children_map[par].append(child)\n\n# find ggg\n# trace from Dawid to get GGG name/position\ndawid = next(n for n in unique if n[2]=='Dawid Majtyka')\n# trace up 4 gens\ncur = dawid\npath = []\nfor i in range(6):\n    path.append(cur)\n    cur = parent_map.get(cur)\n    if cur is None: break\n# path: 0:self(Dawid),1:parent(Juliusz),2:grandparent(Kazimierz),3:great-grandparent(Julita?), wait look back\n# from earlier: 0:Dawid,1:Juliusz,2:Kazimierz,3:Julita,4:Przemysław,5:Ewelina\nggg = path[4] if len(path) > 4 else path[-1]\nprint('GGG:', ggg)\nPY" action.permission=* action.action=allow action.pattern=*
