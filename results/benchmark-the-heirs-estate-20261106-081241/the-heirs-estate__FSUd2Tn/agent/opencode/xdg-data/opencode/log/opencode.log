timestamp=2026-11-06T09:03:43.557Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\n# Continue - actually run it\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col, tol=80):\n    for r in range(row-1, -1, -1):\n        line = lines[r]\n        import re\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < tol:\n                connected = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    w = max(15, tol//2)\n                    for dc in range(-w, w+1):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            if l2[cc] in '|+':\n                                connected = True\n                                break\n                    if connected: break\n                if connected:\n                    return (r, ncol, m.group(0))\n    return None\n\nimport re\nnodes = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches:\n        nodes.append((i, m.start(), m.group(0)))\nunique = []\nseen = set()\nfor n in nodes:\n    k = (n[0], n[1], n[2])\n    if k not in seen:\n        seen.add(k); unique.append(n)\n\nparent = {}\nfor i, n in enumerate(unique):\n    r,c,name = n\n    p = find_parent(lines, r, c, 80)\n    if not p:\n        for t in [120, 180, 250, 350, 500]:\n            p = find_parent(lines, r, c, t)\n            if p: break\n    parent[n] = p\n    if i % 50 == 0:\n        print(f'{i}/{len(unique)}')\n\n# count how many have parents\nhas_parent = sum(1 for k,v in parent.items() if v)\nprint(f'Has parent: {has_parent}/{len(parent)}')\nPY" action.permission=* action.action=allow action.pattern=*
