timestamp=2026-11-06T08:43:05.699Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\nimport re\n\n# build map of all name positions\nname_positions = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches:\n        name_positions.append((i, m.start(), m.group(0)))\n\n# create a set of (row, col, name) for quick lookup\nname_set = set((r, c, n) for r, c, n in name_positions)\nPY" action.permission=* action.action=allow action.pattern=*
