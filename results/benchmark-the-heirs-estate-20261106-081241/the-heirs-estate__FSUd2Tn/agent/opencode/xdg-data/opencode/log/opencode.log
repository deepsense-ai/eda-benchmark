timestamp=2026-11-06T08:44:07.997Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col):\n    for r in range(row-1, -1, -1):\n        line = lines[r]\n        import re\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < 60:  # looser\n                # look for vertical line down\n                for rr in range(r+1, row):\n                    if rr >= len(lines): break\n                    l2 = lines[rr]\n                    # check a small window around ncol\n                    for dc in range(-5, 6):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            ch = l2[cc]\n                            if ch == '|' or ch == '+':\n                                return (r, ncol, m.group(0))\n    return None\n\n# test on Dawid\nres = find_parent(lines, 92, 2952)\nprint(res)\nPY" action.permission=* action.action=allow action.pattern=*
