timestamp=2026-11-06T09:09:12.510Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\n# need to rebuild in same session - let us do it all at once\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col, tol=80):\n    for r in range(row-1, -1, -1):\n        import re\n        line = lines[r]\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < tol:\n                connected = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    w = max(15, tol//2)\n                    for dc in range(-w, w+1):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            if l2[cc] in '|+':\n                                connected = True; break\n                    if connected: break\n                if connected:\n                    return (r, ncol, m.group(0))\n    return None\n\nimport re\nfrom collections import defaultdict\nnodes = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches:\n        nodes.append((i, m.start(), m.group(0)))\nunique = []\nseen = set()\nfor n in nodes:\n    k = (n[0], n[1], n[2])\n    if k not in seen: seen.add(k); unique.append(n)\nparent_map = {}\nfor n in unique:\n    r,c,name = n\n    p = find_parent(lines, r, c, 80)\n    if not p:\n        for t in [120,180,250,350,500]:\n            p = find_parent(lines, r, c, t)\n            if p: break\n    parent_map[n] = p\nchildren_map = defaultdict(list)\nfor child, par in parent_map.items():\n    if par: children_map[par].append(child)\n\n# find przem\nprzem = None\nfor n in unique:\n    if n[2] == 'Przemysław Kurczab': przem = n; break\nprint('przem:', przem)\nfor c in children_map[przem]:\n    print(c[2])\nPY" action.permission=* action.action=allow action.pattern=*
