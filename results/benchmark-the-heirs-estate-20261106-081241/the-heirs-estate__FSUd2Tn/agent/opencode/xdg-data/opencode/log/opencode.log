timestamp=2026-11-06T08:43:40.089Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\n# For a given node at (row, col), find parent\n# Parent is the nearest name above (smaller row) such that there is a vertical connection\n# i.e. somewhere between parent row and current row, there's a | or branch structure connecting\ndef find_parent(lines, row, col):\n    # scan upwards\n    for r in range(row-1, -1, -1):\n        line = lines[r]\n        # look for names in this line\n        import re\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            # check if this name is vertically aligned to be parent of node at col\n            # parent is usually centered or aligned above the child branch\n            # allow some tolerance\n            if abs(ncol - col) < 40:  # in same general branch area\n                # check if there's vertical connection down from around ncol to row\n                # look for | in the column range between r and row-1\n                has_conn = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    if ncol < len(l2):\n                        c2 = l2[ncol] if ncol < len(l2) else ' '\n                        if c2 == '|' or c2 == '+' or c2 == '~' or c2 == '-':\n                            # check vertical line\n                            # simple heuristic: if there's | at ncol continuously\n                            has_conn = True\n                            break\n                if has_conn:\n                    return (r, ncol, m.group(0))\n    return None\nPY" action.permission=* action.action=allow action.pattern=*
