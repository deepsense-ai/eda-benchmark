timestamp=2026-11-06T09:02:35.495Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col, tol=80):\n    for r in range(row-1, -1, -1):\n        line = lines[r]\n        import re\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < tol:\n                connected = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    w = max(10, tol//2)\n                    for dc in range(-w, w+1):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            if l2[cc] in '|+':\n                                connected = True\n                                break\n                    if connected: break\n                if connected:\n                    return (r, ncol, m.group(0))\n    return None\n\n# get nodes\nimport re\nnodes = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches:\n        nodes.append((i, m.start(), m.group(0)))\nunique_nodes = []\nseen = set()\nfor n in nodes:\n    key = (n[0], n[1], n[2])\n    if key not in seen:\n        seen.add(key)\n        unique_nodes.append(n)\n\nprint('nodes:', len(unique_nodes))\nPY" action.permission=* action.action=allow action.pattern=*
