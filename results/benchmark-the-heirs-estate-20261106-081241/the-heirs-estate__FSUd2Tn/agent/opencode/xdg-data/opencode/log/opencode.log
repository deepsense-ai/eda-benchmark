timestamp=2026-11-06T09:14:21.355Z level=INFO run=694d77c8 message=evaluated permission=bash pattern="python3 << 'PY'\n# build everything\nwith open('/app/dataset/genealogy_trees.txt') as f:\n    lines = f.readlines()\n\ndef find_parent(lines, row, col, tol=80):\n    for r in range(row-1, -1, -1):\n        import re\n        line = lines[r]\n        matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n        for m in matches:\n            ncol = m.start()\n            if abs(ncol - col) < tol:\n                connected = False\n                for rr in range(r+1, row):\n                    l2 = lines[rr]\n                    w = max(15, tol//2)\n                    for dc in range(-w, w+1):\n                        cc = ncol + dc\n                        if 0 <= cc < len(l2):\n                            if l2[cc] in '|+': connected=True; break\n                    if connected: break\n                if connected: return (r,ncol,m.group(0))\n    return None\n\nimport re\nfrom collections import defaultdict\nnodes = []\nfor i, line in enumerate(lines):\n    matches = re.finditer(r'\\b[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźż]+\\b', line)\n    for m in matches: nodes.append((i,m.start(),m.group(0)))\nunique = []\nseen=set()\nfor n in nodes:\n    k=(n[0],n[1],n[2])\n    if k not in seen: seen.add(k); unique.append(n)\nparent_map={}\nfor n in unique:\n    r,c,name=n\n    p=find_parent(lines,r,c,80)\n    if not p:\n        for t in [120,180,250,350,500]:\n            p=find_parent(lines,r,c,t)\n            if p: break\n    parent_map[n]=p\nchildren_map=defaultdict(list)\nfor child,par in parent_map.items():\n    if par: children_map[par].append(child)\n\n# get ggg\ndawid = next(n for n in unique if n[2]=='Dawid Majtyka')\ncur = dawid; path=[]\nfor i in range(10):\n    path.append(cur)\n    cur = parent_map.get(cur)\n    if not cur: break\nggg = path[4] if len(path) > 4 else path[-1] if path else None\nprint('GGG:', ggg[2] if ggg else ggg)\n# children of ggg\nfor c in children_map.get(ggg, []):\n    # count grandchildren\n    gc = 0\n    for cc in children_map[c]:  # cc is child of c (grandchild of ggg through c)\n        gc += len(children_map[cc])\n    # also sometimes grandchildren are just direct children of cc? yes - each child of cc is a grandchild of c's parent (ggg)\n    # total count: sum of number of children of each of c's children? Or just count of cc nodes if they exist? Wait - grandchildren = children of children. So for each child Y of c, each child Z of Y is a grandchild of c. So total grandchildren of c = sum(len(children_map[Y]) for Y in children_map[c]). Also equivalently count of all Z with parent_map[Z] in children_map[c] and parent_map[parent_map[Z]] == c. But easier: total count of nodes whose grandparent is c? Or simply sum of children counts of c's children. That gives total number of grandchildren (each is a node). That is correct.\n    total_gc = sum(len(children_map[gcnode]) for gcnode in children_map[c])\n    print(f'  child={c[2]}: has {total_gc} grandchildren (children of his children)')\nPY" action.permission=* action.action=allow action.pattern=*
