timestamp=2026-11-04T09:13:28.112Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Look at invoices involving these internal only-buyers\nonly_buyers = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\ndf = invoices[(invoices['buyer_id'].isin(only_buyers)) | (invoices['seller_id'].isin(only_buyers))]\n# Group by seller\nfor sid, g in df.groupby('seller_id'):\n    if sid in only_buyers: continue  # skip if somehow seller is also in list (they're not, they don't sell)\n    # but actually they are only buyers - so they won't appear as seller. So look at sellers who sell TO them\n    pass\n\n# Better: find who sells to them, how much\nfor ob in only_buyers:\n    rel = invoices[invoices['buyer_id']==ob]\n    print(f'\\n=== {ob} ===')\n    print(f'Total invoices: {len(rel)}, Total gross: {rel[\"gross_amount\"].sum():.2f}')\n    print(f'Unique sellers: {rel[\"seller_id\"].nunique()}')\n    # show top sellers\n    top = rel.groupby('seller_id')['gross_amount'].agg(['sum','count']).sort_values('sum', ascending=False).head(3)\n    print(top)\nPY" action.permission=* action.action=allow action.pattern=*
