timestamp=2026-11-04T09:16:26.236Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Look at other high-MAD sellers with larger volumes? Or look for circular trading patterns\n# Also the \"companies that appear only as buyers despite having weak operating fundamentals\" - the internal only-buyers themselves are definitely suspicious. That’s 7 companies.\n# Plus sellers to external recipients with outsized amounts: 2029, 6453.\n# Plus sellers with extreme leading-digit anomalies: 4612, 8382 (and maybe others with MAD > 0.15, but volumes small? 4612/8382 have 25 invoices each of identical small amounts all starting with 9 - clear fabrication)\n# We need exactly 10 company IDs. So we must pick the 10 most anomalous.\n\nsuspicious = {1060, 2029, 3495, 4521, 4612, 4747, 5529, 6115, 6453, 6456, 7021, 8285, 8382, 8770, 8810, 8919, 9598, 6315, 3690, 4659, 7073}\n\n# Rank them by anomaly score\nrows = []\nfor sid in suspicious:\n    c = companies[companies['company_id']==sid]\n    if c.empty: continue\n    row = c.iloc[0]\n    sales = invoices[invoices['seller_id']==sid]['gross_amount'].sum()\n    purch = invoices[invoices['buyer_id']==sid]['gross_amount'].sum()\n    n_sell = len(invoices[invoices['seller_id']==sid])\n    n_buy = len(invoices[invoices['buyer_id']==sid])\n    rev_per_emp = row.declared_revenue_annual / row.employees if row.employees > 0 else float('inf')\n    # compute a rough score\n    score = 0\n    # only buyer (internal)\n    is_only_buyer = n_sell == 0 and sid in {1060,3495,4521,7021,8285,8770,8810}\n    if is_only_buyer:\n        score += 5  # strong signal (b)\n        # weak fundamentals\n        if row.bank_account_age_months <= 3: score += 1\n        if rev_per_emp < 10000: score += 1  # not exactly, but small\n        if row.employees < 40: score += 1\n    # external giant seller\n    if sid in (2029, 6453):\n        score += 5  # (c)\n        # massive external payments relative to footprint\n        if row.employees < 40: score += 2\n        if rev_per_emp < 5000: score += 2\n    # benford weirdos with repetitive amounts\n    if sid in (4612, 8382):\n        score += 4  # (a)\n        if n_sell == 25 and sales < 40000: score += 2  # very suspicious pattern\n    # high concentration to only-buyers\n    # check pct\n    only_buyers = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\n    rel_to_ob = invoices[(invoices['seller_id']==sid) & (invoices['buyer_id'].isin(only_buyers))]['gross_amount'].sum()\n    rel_all = invoices[invoices['seller_id']==sid]['gross_amount'].sum()\n    pct = rel_to_ob/rel_all if rel_all>0 else 0\n    if pct > 0.85: score += 3\n    # low rev_per_emp\n    if rev_per_emp < 300: score += 2\n    rows.append((sid, score, is_only_buyer, sid in (2029,6453), sid in (4612,8382), pct, rev_per_emp, row.employees, row.declared_revenue_annual, sales, purch))\nrows.sort(key=lambda x: x[1], reverse=True)\nfor r in rows[:15]:\n    print(r)\nPY" action.permission=* action.action=allow action.pattern=*
