timestamp=2026-11-04T09:14:45.488Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Look at the only-buyers themselves - they are internal companies with weak fundamentals\nonly_buyers = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\nfor cid in sorted(only_buyers):\n    c = companies[companies['company_id']==cid].iloc[0]\n    # get how much they received as seller? but they are only buyers - 0\n    sales = invoices[invoices['seller_id']==cid]['gross_amount'].sum()\n    purchases = invoices[invoices['buyer_id']==cid]['gross_amount'].sum()\n    print(f'{cid}: emp={c.employees}, rev={c.declared_revenue_annual:.0f}, bank={c.bank_account_age_months}, sales_as_seller={sales:.2f}, purchases={purchases:.2f}, ind={c.industry}')\nPY" action.permission=* action.action=allow action.pattern=*
