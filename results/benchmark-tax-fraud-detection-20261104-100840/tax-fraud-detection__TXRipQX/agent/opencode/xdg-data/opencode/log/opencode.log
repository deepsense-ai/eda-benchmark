timestamp=2026-11-04T09:13:03.248Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\ncomp_ids = set(companies['company_id'])\nbuyers = set(invoices['buyer_id'])\nsellers = set(invoices['seller_id'])\n\n# External buyers\nexternal_buyers = buyers - comp_ids\nprint(f'Buyer IDs not in companies.csv (external): {len(external_buyers)}')\nprint(f'Max external buyer id: {max(external_buyers) if external_buyers else \"N/A\"}')\nprint(f'Min external buyer id: {min(external_buyers) if external_buyers else \"N/A\"}')\n\n# Internal-only buyers (buyer is also a company in registry)\ninternal_buyers = buyers & comp_ids\nprint(f'\\nInternal buyers: {len(internal_buyers)}')\n\n# Only-buyers (never sell) - how many are internal vs external?\nonly_buyers = buyers - sellers\nprint(f'\\nOnly-buyers (never appear as seller): {len(only_buyers)}')\nprint(f'  ...that are internal (in companies): {len(only_buyers & comp_ids)}')\nprint(f'  ...that are external: {len(only_buyers - comp_ids)}')\nPY" action.permission=* action.action=allow action.pattern=*
