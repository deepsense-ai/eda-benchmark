timestamp=2026-11-04T09:14:08.130Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nfrom collections import Counter\nimport math\n\ndef benford_expected():\n    return {d: math.log10(1 + 1/d) for d in range(1,10)}\n\ndef benford_dist(series):\n    digits = []\n    for v in series:\n        s = str(abs(float(v))).lstrip('0')\n        if s:\n            d = int(s[0])\n            if 1<=d<=9: digits.append(d)\n    if len(digits)==0: return None\n    c = Counter(digits)\n    n = len(digits)\n    return {d: c[d]/n for d in range(1,10)}\n\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\ncompanies = pd.read_csv('/app/dataset/companies.csv')\n\n# compute chi-square-ish or just max diff? but task says \"unusual leading-digit behavior among active sellers\"\n# look across all sellers with sufficient counts\nexp = benford_expected()\nsellers = invoices.groupby('seller_id')\nfor sid, g in sellers:\n    n = len(g)\n    if n < 10: continue\n    dist = benford_dist(g['net_amount'])\n    if dist is None: continue\n    # compute mean abs deviation or max diff\n    mad = sum(abs(dist[d] - exp[d]) for d in range(1,10)) / 9\n    if mad > 0.2:  # quite unusual\n        print(f'{sid}: n={n}, mad={mad:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
