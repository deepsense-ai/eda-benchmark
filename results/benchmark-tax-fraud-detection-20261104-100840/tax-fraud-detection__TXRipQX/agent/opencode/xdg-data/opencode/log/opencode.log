timestamp=2026-11-04T09:15:06.902Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\ncompanies = pd.read_csv('/app/dataset/companies.csv')\n\n# (a) \"unusual leading-digit behavior among active sellers\"\n# Also check others for Benford anomalies, not just extreme MAD cases\nfrom collections import Counter\nimport math\n\nexp = {d: math.log10(1 + 1/d) for d in range(1,10)}\ndef benford_mad(series):\n    digits = []\n    for v in series:\n        s = str(abs(float(v))).lstrip('0')\n        if s:\n            d = int(s[0])\n            if 1<=d<=9: digits.append(d)\n    if len(digits)<5: return 0\n    c = Counter(digits); n=len(digits)\n    dist = {d: c[d]/n for d in range(1,10)}\n    return sum(abs(dist[d]-exp[d]) for d in range(1,10))/9\n\nsellers = invoices.groupby('seller_id')\nres = []\nfor sid, g in sellers:\n    mad = benford_mad(g['net_amount'])\n    if mad > 0:  # all have some\n        res.append((sid, mad, len(g), g['gross_amount'].sum()))\nres.sort(key=lambda x: x[1], reverse=True)\nfor r in res[:15]:\n    print(f'{r[0]}: mad={r[1]:.3f} n={r[2]} sum={r[3]:.0f}')\nPY" action.permission=* action.action=allow action.pattern=*
