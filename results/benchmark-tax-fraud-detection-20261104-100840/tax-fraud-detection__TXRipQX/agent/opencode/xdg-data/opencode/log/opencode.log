timestamp=2026-11-04T09:14:00.360Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# (a) Benford's Law for first digits of net_amount by seller - look for unusual distributions\ndef benford_first_digits(series):\n    # get first non-zero digit\n    digits = []\n    for v in series:\n        s = str(abs(float(v))).lstrip('0')\n        if s:\n            d = int(s[0])\n            if 1 <= d <= 9:\n                digits.append(d)\n    # return counts\n    import numpy as np\n    digits = np.array(digits)\n    if len(digits) == 0: return None\n    # benford expected\n    from collections import Counter\n    c = Counter(digits)\n    return c\n\n# Check sellers 2029, 6453 - they do big invoices to external buyers\nfor sid in [2029, 6453]:\n    rel = invoices[invoices['seller_id']==sid]['net_amount']\n    c = benford_first_digits(rel)\n    if c:\n        # show distribution\n        print(f'\\n=== {sid} (n={len(rel)}) ===')\n        for d in range(1,10):\n            print(f'{d}: {c[d]:3d}  ({c[d]/len(rel)*100:5.1f}%)')\nPY" action.permission=* action.action=allow action.pattern=*
