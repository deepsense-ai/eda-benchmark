timestamp=2026-11-04T09:14:13.554Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nfrom collections import Counter\nimport math\n\nexp = {d: math.log10(1 + 1/d) for d in range(1,10)}\ndef benford_dist(series):\n    digits = []\n    for v in series:\n        s = str(abs(float(v))).lstrip('0')\n        if s:\n            d = int(s[0]); \n            if 1<=d<=9: digits.append(d)\n    if len(digits)==0: return None\n    c = Counter(digits); n=len(digits)\n    return {d: c[d]/n for d in range(1,10)}\n\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\nfor sid in [4612, 8382]:\n    g = invoices[invoices['seller_id']==sid]\n    dist = benford_dist(g['net_amount'])\n    print(f'\\n=== {sid} n={len(g)} ===')\n    for d in range(1,10):\n        print(f'{d}: exp={exp[d]:.3f}  obs={dist[d]:.3f}  ({dist[d]-exp[d]:+.3f})')\nPY" action.permission=* action.action=allow action.pattern=*
