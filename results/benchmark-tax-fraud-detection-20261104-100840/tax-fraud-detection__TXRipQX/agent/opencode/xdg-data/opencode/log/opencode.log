timestamp=2026-11-04T09:15:58.584Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Let’s also look at the other side: who are the sellers to the only-buyers overall? Many of them are also suspicious - low revenue/emp patterns or odd structures\nonly_buyers = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\nsellers = invoices[invoices['buyer_id'].isin(only_buyers)]['seller_id'].unique()\nfor sid in sellers:\n    if sid in only_buyers: continue\n    c = companies[companies['company_id']==sid]\n    if c.empty: continue\n    row = c.iloc[0]\n    rel_all = invoices[invoices['seller_id']==sid]['gross_amount'].sum()\n    rel_to = invoices[(invoices['seller_id']==sid) & (invoices['buyer_id'].isin(only_buyers))]['gross_amount'].sum()\n    pct = rel_to/rel_all if rel_all>0 else 0\n    # flag if high pct or weird fundamentals\n    if pct > 0.6:\n        print(f'{sid}: pct={pct*100:.0f}%, emp={row.employees}, rev={row.declared_revenue_annual:.0f}, ind={row.industry}')\nPY" action.permission=* action.action=allow action.pattern=*
