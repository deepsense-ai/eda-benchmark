timestamp=2026-11-04T09:15:51.821Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Now consolidate all suspicious companies based on the three criteria\nsuspicious = set()\n\n# (a) Unusual leading-digit behavior among active sellers\n# Extreme MAD: 4612, 8382. Also 2931 had external payment + unusual pattern but MAD smaller.\nsuspicious.update([4612, 8382])\n\n# (b) Companies that appear only as buyers despite having weak operating fundamentals\n# Internal only-buyers: {8770, 1060, 3495, 4521, 8810, 7021, 8285} - all have tiny emp, low bank age, buy a lot\nsuspicious.update([8770, 1060, 3495, 4521, 8810, 7021, 8285])\n\n# (c) Sellers whose payments to external recipients look outsized relative to their declared business footprint\n# 2029 and 6453: huge external payments, tiny employees/revenue declared\nsuspicious.update([2029, 6453])\n\n# Also high-concentration sellers to those internal only-buyers - round-tripping/shell-like behavior\n# These are often part of the scheme\nhigh_conc = []\nonly_buyers_internal = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\nsellers_to_ob = invoices[invoices['buyer_id'].isin(only_buyers_internal)]['seller_id'].unique()\nfor sid in sellers_to_ob:\n    rel_to_ob = invoices[(invoices['seller_id']==sid) & (invoices['buyer_id'].isin(only_buyers_internal))]\n    rel_all = invoices[invoices['seller_id']==sid]\n    if rel_all['gross_amount'].sum() == 0: continue\n    pct = rel_to_ob['gross_amount'].sum() / rel_all['gross_amount'].sum()\n    if pct > 0.85:  # very high concentration\n        high_conc.append((sid, pct))\n        suspicious.add(sid)\nfor h in high_conc:\n    print(f'High conc: {h[0]} ({h[1]*100:.1f}%)')\nPY" action.permission=* action.action=allow action.pattern=*
