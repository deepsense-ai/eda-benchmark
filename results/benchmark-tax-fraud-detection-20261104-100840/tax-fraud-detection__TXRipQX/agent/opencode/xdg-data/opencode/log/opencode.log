timestamp=2026-11-04T09:14:39.725Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Also check sellers to internal only-buyers list again\nonly_buyers_internal = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\nsellers_to_ob = invoices[invoices['buyer_id'].isin(only_buyers_internal)]['seller_id'].unique()\n# For each, what are their total sales to only-buyers vs overall?\nfor sid in sorted(sellers_to_ob):\n    rel_to_ob = invoices[(invoices['seller_id']==sid) & (invoices['buyer_id'].isin(only_buyers_internal))]\n    rel_all = invoices[invoices['seller_id']==sid]\n    print(f'{sid}: to_OB_gross={rel_to_ob[\"gross_amount\"].sum():.2f} (n={len(rel_to_ob)}) / all_gross={rel_all[\"gross_amount\"].sum():.2f} (n={len(rel_all)})  pct={rel_to_ob[\"gross_amount\"].sum()/rel_all[\"gross_amount\"].sum()*100:.1f}%')\nPY" action.permission=* action.action=allow action.pattern=*
