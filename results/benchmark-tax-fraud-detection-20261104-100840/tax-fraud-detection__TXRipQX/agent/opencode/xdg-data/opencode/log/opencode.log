timestamp=2026-11-04T09:14:52.453Z level=INFO run=5322f89d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Now collect all suspicious candidates\n\ncands = set()\n\n# (b) Internal only-buyers with weak fundamentals\nonly_buyers_internal = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\ncands.update(only_buyers_internal)\n\n# (c) Sellers with large payments to external recipients - 2029, 6453\ncands.update([2029, 6453])\n\n# Also look at sellers heavily dependent on only-buyers (>80% of revenue) - many of them\nonly_buyers_internal = {8770, 1060, 3495, 4521, 8810, 7021, 8285}\nsellers_to_ob = invoices[invoices['buyer_id'].isin(only_buyers_internal)]['seller_id'].unique()\nfor sid in sellers_to_ob:\n    rel_to_ob = invoices[(invoices['seller_id']==sid) & (invoices['buyer_id'].isin(only_buyers_internal))]\n    rel_all = invoices[invoices['seller_id']==sid]\n    pct = rel_to_ob['gross_amount'].sum() / rel_all['gross_amount'].sum() if rel_all['gross_amount'].sum() > 0 else 0\n    if pct > 0.8:\n        cands.add(sid)\n        print(f'Added {sid} (pct={pct*100:.1f}%)')\n\n# (a) Benford weirdos\ncands.update([4612, 8382])\n\nprint(f'\\nTotal candidates so far: {len(cands)}')\nprint(sorted(cands))\nPY" action.permission=* action.action=allow action.pattern=*
