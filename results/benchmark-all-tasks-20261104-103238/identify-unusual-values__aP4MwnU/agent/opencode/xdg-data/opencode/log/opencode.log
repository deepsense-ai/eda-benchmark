timestamp=2026-11-04T09:47:00.970Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n\n# (1) technical noise\ntechnical_noise_mask = (\n    (df['age'] > 120) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800)\n)\ndf_work = df[~technical_noise_mask].copy()\ndf_work['orig_idx'] = df_work.index\n\n# (2) 3*IQR outliers for all numeric cols\nnumeric_cols = ['age', 'bmi', 'avg_glucose_level']\ncol_to_iqr_outs = {}\nfor col in numeric_cols:\n    Q1 = df_work[col].quantile(0.25)\n    Q3 = df_work[col].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    mask = (df_work[col] < lower) | (df_work[col] > upper)\n    outs = set(df_work[mask]['orig_idx'].tolist())\n    col_to_iqr_outs[col] = outs\n\n# Build final outlier set from 3*IQR, but with avg_glucose_level special handling\nfinal_iqr_outliers = set()\n# add age and bmi outliers as-is\nfinal_iqr_outliers.update(col_to_iqr_outs['age'])\nfinal_iqr_outliers.update(col_to_iqr_outs['bmi'])\n\n# handle avg_glucose_level\nag_outs = col_to_iqr_outs['avg_glucose_level']\nfor orig_idx in ag_outs:\n    row = df_work[df_work['orig_idx'] == orig_idx].iloc[0]\n    val = row['avg_glucose_level']\n    same = df_work[df_work['avg_glucose_level'] == val]\n    n_same = len(same)\n    n_stroke = (same['stroke'] == 1).sum()\n    pct = n_stroke / n_same if n_same > 0 else 0\n    if pct >= 0.5:\n        # not considered outliers - do NOT add to final outliers to remove\n        continue\n    elif pct > 0.2:\n        # apply base-2 logarithmic transformation and perform above check again\n        val_log = np.log2(val) if val > 0 else -np.inf\n        same_log = df_work[np.isclose(np.log2(df_work['avg_glucose_level']), val_log, atol=1e-10)]\n        n_same_l = len(same_log)\n        n_stroke_l = (same_log['stroke'] == 1).sum()\n        pct_l = n_stroke_l / n_same_l if n_same_l > 0 else 0\n        if pct_l >= 0.5:\n            # not considered outlier\n            continue\n        # after log2 check, if still not >= 0.5? what about if now pct_l > 0.2? only log2 mentioned once.\n        # if no other rule, treat as outlier? or keep as outlier (remove)\n        final_iqr_outliers.add(orig_idx)\n        continue\n    else:\n        # pct <= 0.2 -> remains an outlier, reject\n        final_iqr_outliers.add(orig_idx)\n\nprint('Final 3*IQR-based outliers to remove:', len(final_iqr_outliers))\nPY" action.permission=* action.action=allow action.pattern=*
