timestamp=2026-11-04T09:44:47.152Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n\n# (1)\ntechnical_noise_mask = (\n    (df['age'] > 120) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800)\n)\ndf_work = df[~technical_noise_mask].copy()\ndf_work['orig_idx'] = df_work.index\n\n# (2) 3*IQR\nnumeric_cols = ['age', 'bmi', 'avg_glucose_level']\ncol_to_iqr_outliers_orig = {}\nfor col in numeric_cols:\n    Q1 = df_work[col].quantile(0.25)\n    Q3 = df_work[col].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    mask = (df_work[col] < lower) | (df_work[col] > upper)\n    outs = set(df_work[mask]['orig_idx'].tolist())\n    col_to_iqr_outliers_orig[col] = outs\n\nag_outliers_orig = col_to_iqr_outliers_orig['avg_glucose_level']\n\n# (3) Verify each avg_glucose_level outlier\n# For each: get the value of avg_glucose_level (in df_work or in df)\n# \"If 50% or more of other observations sharing the same values correspond to stroke cases, they are not considered outliers.\"\n# \"If more than 20% of other observations sharing the same values correspond to stroke cases,\n# a base-2 logarithmic transformation should be applied and the above check should be performed again.\"\nreconsider = {}\nfor orig_idx in ag_outliers_orig:\n    # get value\n    row = df_work[df_work['orig_idx'] == orig_idx].iloc[0]\n    val = row['avg_glucose_level']\n    # find all observations in df_work (cleaned data context) sharing same value\n    same = df_work[df_work['avg_glucose_level'] == val]\n    n_same = len(same)\n    n_stroke = (same['stroke'] == 1).sum()\n    pct = n_stroke / n_same if n_same > 0 else 0\n    reconsider[orig_idx] = {'val': val, 'n_same': n_same, 'pct': pct, 'n_stroke': n_stroke}\n\n# Classify\ndo_not_remove = set()  # not considered outliers\nneed_log2_check = set()\nfor k, v in reconsider.items():\n    if v['pct'] >= 0.5:  # 50% or more\n        do_not_remove.add(k)\n    elif v['pct'] > 0.2:  # more than 20% -> log2 transform and above check again\n        need_log2_check.add(k)\n    else:\n        # <= 20% or == 20%? pct > 0.2 is \"more than 20%\". So if not >= 0.5 and not > 0.2, then pct <= 0.2 -> this remains an outlier? That means treat as outlier (remove).\n        pass\nprint('do_not_remove:', len(do_not_remove), 'need_log2_check:', len(need_log2_check))\nPY" action.permission=* action.action=allow action.pattern=*
