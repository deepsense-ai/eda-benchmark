timestamp=2026-11-04T09:39:37.717Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n\n# Apply technical noise filtering\nnoise_mask = (\n    (df['age'] > 120) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800)\n)\ndf_clean = df[~noise_mask].copy()\n\n# Find 3*IQR outliers for avg_glucose_level\ncol = 'avg_glucose_level'\nQ1 = df_clean[col].quantile(0.25)\nQ3 = df_clean[col].quantile(0.75)\nIQR = Q3 - Q1\nlower = Q1 - 3 * IQR\nupper = Q3 + 3 * IQR\nag_outliers_mask = (df_clean[col] < lower) | (df_clean[col] > upper)\nag_outliers = df_clean[ag_outliers_mask].copy()\n\n# Check the full set\n# For each outlier: check others with same value\nresults = []\nfor idx, row in ag_outliers.iterrows():\n    val = row[col]\n    same_val = df_clean[df_clean[col] == val]\n    n_same = len(same_val)\n    n_stroke = (same_val['stroke'] == 1).sum()\n    pct_stroke = n_stroke / n_same if n_same > 0 else 0\n    results.append({\n        'idx': idx,\n        'val': val,\n        'n_same': n_same,\n        'n_stroke': n_stroke,\n        'pct': pct_stroke\n    })\n\nres = pd.DataFrame(results)\n# Look at different cases\nprint('Cases where pct >= 0.5:', len(res[res['pct'] >= 0.5]))\nprint('Cases where 0.2 < pct < 0.5:', len(res[(res['pct'] > 0.2) & (res['pct'] < 0.5)]))\nprint('Cases where pct <= 0.2:', len(res[res['pct'] <= 0.2]))\nres.head(20)\nPY" action.permission=* action.action=allow action.pattern=*
