timestamp=2026-11-04T09:48:52.585Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="python << 'PY'\nimport numpy as np\nfrom scipy.stats import chi2\n\n# compute\nnp.random.seed(42)\nX = np.random.randn(100, 3)\nmu = np.mean(X, axis=0)\nS = np.cov(X, rowvar=False)\n# inverse\nSinv = np.linalg.inv(S)\n# for each point\nd2s = []\nfor i in range(X.shape[0]):\n    x = X[i]\n    d2 = (x-mu).T @ Sinv @ (x-mu)\n    d2s.append(d2)\n# threshold\ndf = X.shape[1]\nth = chi2.ppf(0.99, df)  # alpha 0.01\nprint('thresh 0.99:', th, 'count > thresh:', sum(1 for d in d2s if d > th))\nPY" action.permission=* action.action=allow action.pattern=*
