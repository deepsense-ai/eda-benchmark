timestamp=2026-11-04T09:38:23.588Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n# Check technical noise\ntech = set()\nfor idx, row in df.iterrows():\n    # age not exceeding 120\n    if row['age'] > 120 or row['age'] < 0:  # age must be positive and <=120\n        tech.add(idx)\n        continue\n    # bmi: 10–60\n    if row['bmi'] < 10 or row['bmi'] > 60:\n        tech.add(idx)\n        continue\n    # avg_glucose_level: 20–800\n    if row['avg_glucose_level'] < 20 or row['avg_glucose_level'] > 800:\n        tech.add(idx)\n        continue\nprint('Count:', len(tech))\n# Show some examples\nfor t in sorted(list(tech))[:15]:\n    r = df.iloc[t]\n    print(t, r['age'], r['bmi'], r['avg_glucose_level'], r['stroke'])\n\"" action.permission=* action.action=allow action.pattern=*
