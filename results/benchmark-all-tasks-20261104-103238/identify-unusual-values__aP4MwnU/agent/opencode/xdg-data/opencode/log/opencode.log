timestamp=2026-11-04T09:53:35.934Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n\n# Step 1: technical noise indices (values impossible in reality)\ntechnical_noise_mask = (\n    (df['age'] > 120) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800)\n)\ntechnical_noise_idx = set(df[technical_noise_mask].index.tolist())\n\n# Build working dataframe after removing technical noise (for subsequent calculations)\ndf_work = df[~technical_noise_mask].copy()\ndf_work['orig_idx'] = df_work.index  # original indices preserved\n\n# Step 2 & 3: 3*IQR outliers with avg_glucose_level special handling\nnumeric_cols = ['age', 'bmi', 'avg_glucose_level']\ncol_to_iqr_outs = {}\nfor col in numeric_cols:\n    Q1 = df_work[col].quantile(0.25)\n    Q3 = df_work[col].quantile(0.75)\n    IQR = Q3 - Q1\n    lower = Q1 - 3 * IQR\n    upper = Q3 + 3 * IQR\n    mask = (df_work[col] < lower) | (df_work[col] > upper)\n    outs = set(df_work[mask]['orig_idx'].tolist())\n    col_to_iqr_outs[col] = outs\n\nfinal_iqr_remove_orig = set()\nfinal_iqr_remove_orig.update(col_to_iqr_outs['age'])\nfinal_iqr_remove_orig.update(col_to_iqr_outs['bmi'])\n\nag_outs = col_to_iqr_outs['avg_glucose_level']\nfor orig_idx in ag_outs:\n    row = df_work[df_work['orig_idx'] == orig_idx].iloc[0]\n    val = row['avg_glucose_level']\n    same = df_work[df_work['avg_glucose_level'] == val]\n    n_same = len(same)\n    n_stroke = (same['stroke'] == 1).sum()\n    pct = n_stroke / n_same if n_same > 0 else 0\n    if pct >= 0.5:\n        continue  # not considered outlier\n    elif pct > 0.2:\n        val_log = np.log2(val) if val > 0 else -np.inf\n        same_log = df_work[np.isclose(np.log2(df_work['avg_glucose_level']), val_log, atol=1e-10)]\n        n_same_l = len(same_log)\n        n_stroke_l = (same_log['stroke'] == 1).sum()\n        pct_l = n_stroke_l / n_same_l if n_same_l > 0 else 0\n        if pct_l >= 0.5:\n            continue\n        final_iqr_remove_orig.add(orig_idx)\n    else:\n        final_iqr_remove_orig.add(orig_idx)\n\n# Step 4: remove standard outliers from data -> df_nostd\ndf_nostd = df_work[~df_work['orig_idx'].isin(final_iqr_remove_orig)].copy()\n\n# Step 5: create risk_proxy (just for completeness as instructed)\nrisk_features = ['age', 'bmi', 'avg_glucose_level']\nfor f in risk_features:\n    maxv = df_nostd[f].max()\n    df_nostd[f'{f}_norm'] = df_nostd[f] / maxv if maxv != 0 else 0\ndf_nostd['risk_proxy'] = df_nostd['age_norm'] * df_nostd['bmi_norm'] * df_nostd['avg_glucose_level_norm']\n\n# Step 6: Mahalanobis outliers in multidimensional space of numerical variables\nX = df_nostd[numeric_cols].values\nmu = X.mean(axis=0)\nS = np.cov(X, rowvar=False)\ntry:\n    Sinv = np.linalg.inv(S)\nexcept Exception:\n    Sinv = np.linalg.pinv(S)\nd2 = np.array([(x - mu).T @ Sinv @ (x - mu) for x in X])\ndf_chi = X.shape[1]\nalpha = 0.01\nth_mah = chi2.ppf(1 - alpha, df_chi)\nmahal_outlier_orig = set(df_nostd[d2 > th_mah]['orig_idx'].tolist())\n\n# Step 7: Categorical outliers\ncat_outlier_orig = set()\ntoddler_age_limit = 3\nchildren_age_limit = 14\n# toddlers that are students\ncat_outlier_orig.update(df[(df['age'] <= toddler_age_limit) & (df['work_type'] == 'student')].index.tolist())\n# toddlers with smoking\ncat_outlier_orig.update(df[(df['age'] <= toddler_age_limit) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))].index.tolist())\n# children (<=14) with smoking\ncat_outlier_orig.update(df[(df['age'] <= children_age_limit) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))].index.tolist())\n# work_type children with smoking\ncat_outlier_orig.update(df[(df['work_type'] == 'children') & (df['smoking_status'].isin(['smokes', 'formerly smoked']))].index.tolist())\ncat_outlier_orig = set(cat_outlier_orig)\n\n# Combine all outliers\nall_outliers = set()\nall_outliers.update(technical_noise_idx)        # impossible values\nall_outliers.update(final_iqr_remove_orig)     # standard outliers removed (3*IQR with special handling)\nall_outliers.update(mahal_outlier_orig)         # Mahalanobis outliers\nall_outliers.update(cat_outlier_orig)           # categorical outliers\n\n# Return as sorted list of indices (original matrix indexing)\nresult = sorted(list(all_outliers))\nprint('Total outliers:', len(result))\nPY" action.permission=* action.action=allow action.pattern=*
