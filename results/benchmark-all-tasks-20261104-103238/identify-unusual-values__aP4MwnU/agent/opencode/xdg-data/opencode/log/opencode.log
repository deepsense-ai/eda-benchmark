timestamp=2026-11-04T09:54:20.177Z level=INFO run=2e1ba946 message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import chi2\n\ndef answer() -> list[int]:\n    df = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n\n    # Step 1: Technical noise - values that could not possibly occur in reality\n    technical_noise_mask = (\n        (df['age'] > 120) |\n        (df['bmi'] < 10) | (df['bmi'] > 60) |\n        (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800)\n    )\n    technical_noise_idx = set(df[technical_noise_mask].index.tolist())\n\n    # Working dataframe after removing technical noise\n    df_work = df[~technical_noise_mask].copy()\n    df_work['orig_idx'] = df_work.index\n\n    # Step 2 & 3: 3*IQR outlier detection with avg_glucose_level special handling\n    numeric_cols = ['age', 'bmi', 'avg_glucose_level']\n    col_to_iqr_outs = {}\n    for col in numeric_cols:\n        Q1 = df_work[col].quantile(0.25)\n        Q3 = df_work[col].quantile(0.75)\n        IQR = Q3 - Q1\n        lower = Q1 - 3 * IQR\n        upper = Q3 + 3 * IQR\n        mask = (df_work[col] < lower) | (df_work[col] > upper)\n        outs = set(df_work[mask]['orig_idx'].tolist())\n        col_to_iqr_outs[col] = outs\n\n    final_iqr_remove_orig = set()\n    # age and bmi outliers from 3*IQR are removed as standard outliers\n    final_iqr_remove_orig.update(col_to_iqr_outs['age'])\n    final_iqr_remove_orig.update(col_to_iqr_outs['bmi'])\n\n    # avg_glucose_level outliers: apply special rules\n    ag_outs = col_to_iqr_outs['avg_glucose_level']\n    for orig_idx in ag_outs:\n        row = df_work[df_work['orig_idx'] == orig_idx].iloc[0]\n        val = row['avg_glucose_level']\n        same = df_work[df_work['avg_glucose_level'] == val]\n        n_same = len(same)\n        n_stroke = (same['stroke'] == 1).sum()\n        pct = n_stroke / n_same if n_same > 0 else 0\n        if pct >= 0.5:\n            # not considered outlier\n            continue\n        elif pct > 0.2:\n            # apply base-2 logarithmic transformation and check again\n            if val > 0:\n                val_log = np.log2(val)\n            else:\n                val_log = -np.inf\n            same_log = df_work[np.isclose(np.log2(df_work['avg_glucose_level']), val_log, atol=1e-10)]\n            n_same_l = len(same_log)\n            n_stroke_l = (same_log['stroke'] == 1).sum()\n            pct_l = n_stroke_l / n_same_l if n_same_l > 0 else 0\n            if pct_l >= 0.5:\n                # not considered outlier\n                continue\n            final_iqr_remove_orig.add(orig_idx)\n        else:\n            # pct <= 0.2\n            final_iqr_remove_orig.add(orig_idx)\n\n    # Step 4: remove standard outliers from data\n    df_nostd = df_work[~df_work['orig_idx'].isin(final_iqr_remove_orig)].copy()\n\n    # Step 5: create risk_proxy (as instructed)\n    risk_features = ['age', 'bmi', 'avg_glucose_level']\n    for f in risk_features:\n        maxv = df_nostd[f].max()\n        if maxv != 0:\n            df_nostd[f'{f}_norm'] = df_nostd[f] / maxv\n        else:\n            df_nostd[f'{f}_norm'] = 0\n    df_nostd['risk_proxy'] = (\n        df_nostd['age_norm'] * df_nostd['bmi_norm'] * df_nostd['avg_glucose_level_norm']\n    )\n\n    # Step 6: Mahalanobis distance outliers\n    X = df_nostd[numeric_cols].values\n    mu = X.mean(axis=0)\n    S = np.cov(X, rowvar=False)\n    try:\n        Sinv = np.linalg.inv(S)\n    except Exception:\n        Sinv = np.linalg.pinv(S)\n    d2 = np.array([(x - mu).T @ Sinv @ (x - mu) for x in X])\n    df_chi = X.shape[1]\n    alpha = 0.01\n    th_mah = chi2.ppf(1 - alpha, df_chi)\n    mahal_outlier_orig = set(df_nostd[d2 > th_mah]['orig_idx'].tolist())\n\n    # Step 7: Categorical outliers\n    cat_outlier_orig = set()\n    toddler_age_limit = 3\n    children_age_limit = 14\n    # toddlers that are students\n    cat_outlier_orig.update(\n        df[(df['age'] <= toddler_age_limit) & (df['work_type'] == 'student')].index.tolist()\n    )\n    # toddlers with smoking\n    cat_outlier_orig.update(\n        df[(df['age'] <= toddler_age_limit) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))].index.tolist()\n    )\n    # children (<=14) with smoking\n    cat_outlier_orig.update(\n        df[(df['age'] <= children_age_limit) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))].index.tolist()\n    )\n    # work_type children with smoking\n    cat_outlier_orig.update(\n        df[(df['work_type'] == 'children') & (df['smoking_status'].isin(['smokes', 'formerly smoked']))].index.tolist()\n    )\n\n    # Combine all outliers\n    all_outliers = set()\n    all_outliers.update(technical_noise_idx)\n    all_outliers.update(final_iqr_remove_orig)\n    all_outliers.update(mahal_outlier_orig)\n    all_outliers.update(cat_outlier_orig)\n\n    result = sorted(list(all_outliers))\n    return result\n\n\nif __name__ == '__main__':\n    res = answer()\n    with open('/app/answer.json', 'w') as f:\n        json.dump(res, f)\nPY" action.permission=* action.action=allow action.pattern=*
