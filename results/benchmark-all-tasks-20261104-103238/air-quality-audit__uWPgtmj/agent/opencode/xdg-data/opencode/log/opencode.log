timestamp=2026-11-04T09:47:04.145Z level=INFO run=714ca7dd message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\n\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\npm10 = readings[readings['pollutant']=='PM10'].pivot(\n    index='timestamp', columns='station_id', values='current_reading'\n)\n\nfor sid in pm10.columns:\n    s = pm10[sid].dropna()\n    if len(s) < 10: continue\n    others = pm10.drop(columns=[sid])\n    median_peer = others.median(axis=1).loc[s.index].dropna()\n    if len(median_peer) < 5: continue\n    cv_s = s.std() / (s.mean() + 1e-10)\n    cv_m = median_peer.std() / (median_peer.mean() + 1e-10)\n    print(f'{sid}: cv_s={cv_s:.3f}, cv_m={cv_m:.3f}, ratio={cv_s/cv_m:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
