timestamp=2026-11-04T09:52:35.925Z level=INFO run=714ca7dd message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import pearsonr\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nw_readings = pd.read_csv('/app/dataset/weather_readings.csv')\n\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nw_readings['timestamp'] = pd.to_datetime(w_readings['timestamp'])\n\npm25 = readings[readings['pollutant']=='PM25'].pivot(\n    index='timestamp', columns='station_id', values='current_reading'\n)\npm10 = readings[readings['pollutant']=='PM10'].pivot(\n    index='timestamp', columns='station_id', values='current_reading'\n)\nw = w_readings.groupby('timestamp')[['temperature_c', 'humidity_pct', 'wind_speed_m_s', 'rain_accumulation_mm']].mean()\n\n# Recheck each candidate carefully\ncands = {}\n# PM25 candidates\nfor sid in pm25.columns:\n    s = pm25[sid].dropna()\n    if len(s) < 10: continue\n    others_med = pm25.drop(columns=[sid]).median(axis=1)\n    idx0 = s.notna() & others_med.notna()\n    corr0 = pearsonr(s[idx0], others_med[idx0])[0] if idx0.sum() > 5 else np.nan\n    # best lag\n    best_corr = corr0\n    best_lag = 0\n    for lag in range(-4, 5):\n        s_shift = s.shift(lag)\n        idx = s_shift.notna() & others_med.notna()\n        if idx.sum() > 8:\n            c = pearsonr(s_shift[idx], others_med[idx])[0]\n            if c > best_corr:\n                best_corr = c\n                best_lag = lag\n    cv_s = s.std() / (s.mean() + 1e-10)\n    cv_m = others_med.loc[s.index].std() / (others_med.loc[s.index].mean() + 1e-10)\n    # resid correlation to weather\n    resid = s - others_med.loc[s.index]\n    max_resid_corr = 0\n    best_w = None\n    for wvar in w.columns:\n        wv = w.loc[s.index, wvar]\n        if wv.std() > 1e-10:\n            c = abs(pearsonr(resid, wv)[0])\n            if c > max_resid_corr:\n                max_resid_corr = c\n                best_w = wvar\n    cands[sid] = {'pollutant':'PM25','corr0':corr0,'best_corr':best_corr,'best_lag':best_lag,\n                  'cv_ratio':cv_s/cv_m,'max_resid_corr':max_resid_corr,'best_w':best_w,'n':len(s)}\nPY" action.permission=* action.action=allow action.pattern=*
