timestamp=2026-11-04T09:43:57.830Z level=INFO run=92c8de62 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\n# Look at all dispatches sorted - maybe the spoilage events are marked differently?\n# Like a special \"disposal\" product? Or negative quantities? Or weight discrepancies?\ndispatches = []\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        ts = datetime.strptime(row['timestamp'], '%Y-%m-%d %H:%M:%S')\n        dispatches.append(row | {'ts': ts})\n\n# Check for any unusual patterns\nfor d in dispatches:\n    pid = d['product_id']\n    qty = int(d['quantity'])\n    w = float(d['total_weight_kg'])\n    # look for very small quantities, zero, or large qty?\n    if qty < 1:\n        print('WEIRD qty:', d)\n    # weight per item vs expected?\nPY" action.permission=* action.action=allow action.pattern=*
