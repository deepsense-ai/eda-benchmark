timestamp=2026-11-04T09:42:51.653Z level=INFO run=92c8de62 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\n# Read all temps\ntemps = []\nwith open('/app/dataset/temperature_logs.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        tstr = row['temperature_c'].replace(',', '.')\n        z = row['zone'].strip().lower()\n        ts = datetime.strptime(row['timestamp'], '%Y-%m-%d %H:%M:%S')\n        temps.append((ts, z, float(tstr)))\n\n# Group by zone\nby_zone = {}\nfor ts, z, t in temps:\n    by_zone.setdefault(z, []).append((ts, t))\n\nfor z, lst in by_zone.items():\n    lst.sort(key=lambda x: x[0])\n    # look for excursions\n    bad = []\n    for ts, t in lst[:100]:  # sample\n        pass\n    # scan all\n    count_bad = 0\n    for ts, t in lst:\n        # define bad by common sense? compare to typical max\n        if z == 'frozen' and t > -10:\n            count_bad += 1\n            if count_bad <= 5:\n                print(f'{z} BAD at {ts}: {t}')\n            continue\n        if z in ('meat', 'dairy') and t > 6.0:  # generous\n            count_bad += 1\n            if count_bad <= 5:\n                print(f'{z} BAD at {ts}: {t}')\n            continue\n        if z == 'dry' and t > 35.0:\n            count_bad += 1\n            if count_bad <= 5:\n                print(f'{z} BAD at {ts}: {t}')\n            continue\n    if count_bad > 0:\n        print(f'=== {z}: {count_bad} bad readings ===')\nPY" action.permission=* action.action=allow action.pattern=*
