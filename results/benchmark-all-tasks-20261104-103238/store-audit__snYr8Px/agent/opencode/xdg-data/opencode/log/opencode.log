timestamp=2026-11-04T09:47:57.222Z level=INFO run=92c8de62 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\nproducts = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        pid = row['product_id']\n        ean = row['ean_code']\n        prod = {\n            'name': row['name'],\n            'price': float(row['unit_price'].replace(',', '.')),\n            'cat': row['storage_category'].strip().lower(),\n            'unit_weight': float(row['unit_weight_kg'].replace(',', '.')),\n        }\n        products[pid] = prod\n        products[ean] = prod\n\ndispatches = []\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        ts = datetime.strptime(row['timestamp'], '%Y-%m-%d %H:%M:%S')\n        pid = row['product_id']\n        prod = products.get(pid)\n        qty = int(row['quantity'])\n        w = float(row['total_weight_kg'])\n        dispatches.append({'ts': ts, 'pid': pid, 'qty': qty, 'prod': prod, 'w': w})\n\ntotal = 0\nfor d in dispatches:\n    if not d['prod']:\n        continue\n    # Exclude the disposal batch at 2023-07-18 03:17:00\n    if d['ts'] == datetime(2023, 7, 18, 3, 17, 0):\n        continue  # disposal - exclude\n    total += d['qty'] * d['prod']['price']\n\nprint(int(total) if total == int(total) else total)\nPY" action.permission=* action.action=allow action.pattern=*
