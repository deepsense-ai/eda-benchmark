timestamp=2026-11-04T09:44:05.613Z level=INFO run=92c8de62 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\nproducts = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        pid = row['product_id']\n        products[pid] = {\n            'name': row['name'],\n            'price': float(row['unit_price'].replace(',', '.')),\n            'category': row['storage_category'].strip().lower(),\n            'unit_weight': float(row['unit_weight_kg'].replace(',', '.')),\n            'max_safe_temp': float(str(row['max_safe_temp_c']).replace(',', '.')),\n        }\n\ndispatches = []\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        ts = datetime.strptime(row['timestamp'], '%Y-%m-%d %H:%M:%S')\n        pid = row['product_id']\n        qty = int(row['quantity'])\n        w = float(row['total_weight_kg'])\n        prod = products.get(pid)\n        if prod:\n            expected_w = qty * prod['unit_weight']\n            diff = abs(w - expected_w)\n            if diff > 0.01 * max(expected_w, 0.1):  # significant discrepancy\n                print(f'DIFF: {ts} {pid} {prod[\"name\"]} qty={qty} w={w} exp={expected_w:.3f} diff={diff:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
