timestamp=2026-11-04T09:43:51.173Z level=INFO run=92c8de62 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\n# Map products\nproducts = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        pid = row['product_id']\n        price_str = row['unit_price'].replace(',', '.')\n        weight_str = row['unit_weight_kg'].replace(',', '.')\n        max_t_str = row['max_safe_temp_c'].replace(',', '.')\n        products[pid] = {\n            'name': row['name'],\n            'price': float(price_str),\n            'category': row['storage_category'].strip().lower(),\n            'unit_weight': float(weight_str),\n            'max_safe_temp': float(max_t_str),\n        }\n\n# Map temps\ntemps = []\nwith open('/app/dataset/temperature_logs.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        z = row['zone'].strip().lower()\n        tstr = row['temperature_c'].replace(',', '.')\n        ts = datetime.strptime(row['timestamp'], '%Y-%m-%d %H:%M:%S')\n        temps.append((ts, z, float(tstr)))\n\n# Group temps by zone and sort\nby_zone = {}\nfor ts, z, t in temps:\n    by_zone.setdefault(z, []).append((ts, t))\nfor z in by_zone:\n    by_zone[z].sort(key=lambda x: x[0])\n\n# For each dispatch, check if temperature in the relevant zone was unsafe around that time?\n# Or during storage? \"Goods that were disposed of due to spoilage must not be counted as revenue.\"\n# Spoilage likely from temperature abuse. Also \"Disposal write-offs are rare and, when they occur, leave an unmistakable trace in the data.\"\n# Maybe some dispatches have unusual characteristics? Like very small quantity? Or specific products?\ndispatches = []\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        ts = datetime.strptime(row['timestamp'], '%Y-%m-%d %H:%M:%S')\n        pid = row['product_id']\n        qty = int(row['quantity'])\n        w = float(row['total_weight_kg'])\n        dispatches.append({\n            'ts': ts,\n            'pid': pid,\n            'qty': qty,\n            'w': w,\n            'prod': products.get(pid),\n        })\n\n# Look at dispatches after the temp excursion\nfor d in dispatches:\n    if d['ts'] > datetime(2023, 7, 18, 6, 0) and d['prod']:\n        cat = d['prod']['category']\n        # check if related to frozen or meat?\n        if cat in ('frozen', 'meat'):\n            print(d['ts'], cat, d['pid'], d['prod']['name'], d['qty'])\nPY" action.permission=* action.action=allow action.pattern=*
