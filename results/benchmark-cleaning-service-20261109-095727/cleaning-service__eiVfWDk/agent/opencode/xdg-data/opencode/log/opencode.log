timestamp=2026-11-09T09:02:18.953Z level=INFO run=7904429e message=evaluated permission=bash pattern="python3 << 'PY'\nfrom datetime import datetime\nimport csv\n\ntuesdays = [\n    datetime(2025,3,4),\n    datetime(2025,4,1),\n    datetime(2025,5,6),\n    datetime(2025,6,3),\n    datetime(2025,7,1),\n]\n\nby_period = {}\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        try:\n            d = datetime.strptime(row['date'], '%Y-%m-%d')\n        except:\n            continue\n        # assign to period\n        assigned = None\n        for i in range(len(tuesdays)-1):\n            if tuesdays[i] <= d < tuesdays[i+1]:\n                assigned = i\n                break\n        if assigned is None:\n            assigned = len(tuesdays)-2\n        by_period[assigned] = by_period.get(assigned, 0) + 1\n\nfor k, v in sorted(by_period.items()):\n    print(k, v, tuesdays[k].date(), '->', tuesdays[k+1].date())\nPY" action.permission=* action.action=allow action.pattern=*
