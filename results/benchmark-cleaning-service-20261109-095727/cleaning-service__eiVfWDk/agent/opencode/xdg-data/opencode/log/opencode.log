timestamp=2026-11-09T09:03:24.565Z level=INFO run=7904429e message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nimport csv\nimport ast\nfrom datetime import datetime\nfrom collections import defaultdict\n\nEMP_FIX = {\n    '15720759071': '75020759171',\n    '16102016795': '96102016751',\n    '62020111425': '65020111422',\n    '68011910138': '68011810139',\n    '84731091580': '87031491580',\n}\n\ndef parse_tasks_list(tasks_str):\n    \"\"\"Parse the tasks list from string, handling malformed formats.\"\"\"\n    if not tasks_str or tasks_str.strip() == '':\n        return []\n    tasks_str = tasks_str.strip()\n    # Try to fix common malformations\n    # Add missing closing bracket\n    if tasks_str.count('[') > tasks_str.count(']'):\n        tasks_str = tasks_str + ']' * (tasks_str.count('[') - tasks_str.count(']'))\n    # Add missing opening bracket\n    if tasks_str.count(']') > tasks_str.count('['):\n        tasks_str = '[' * (tasks_str.count(']') - tasks_str.count('[')) + tasks_str\n    # If no brackets at all but has comma-separated numbers, wrap in brackets\n    if '[' not in tasks_str and ']' not in tasks_str:\n        # Try to extract all integers\n        import re\n        numbers = re.findall(r'-?\\d+', tasks_str)\n        if numbers:\n            return [int(n) for n in numbers]\n    try:\n        result = ast.literal_eval(tasks_str)\n        if isinstance(result, list):\n            return result\n        elif isinstance(result, (int, str)):\n            return [result]\n        else:\n            return list(result) if result else []\n    except Exception:\n        # Last resort: regex\n        import re\n        numbers = re.findall(r'-?\\d+', tasks_str)\n        return [int(n) for n in numbers]\n\ndef get_billing_periods():\n    \"\"\"Return sorted list of billing period start dates (as datetime).\"\"\"\n    # Based on earliest record 2025-03-04 (Tuesday, weekday 1)\n    # Billing periods start on Tuesdays\n    tuesdays = [\n        datetime(2025, 3, 4),\n        datetime(2025, 4, 1),\n        datetime(2025, 5, 6),\n        datetime(2025, 6, 3),\n        datetime(2025, 7, 1),\n    ]\n    return tuesdays\n\ndef assign_to_billing_period(date, periods):\n    \"\"\"Assign a date to billing period index.\"\"\"\n    for i in range(len(periods) - 1):\n        if periods[i] <= date < periods[i + 1]:\n            return i\n    # If outside range, clamp\n    if date < periods[0]:\n        return 0\n    return len(periods) - 2\n\ndef answer():\n    # Load employees\n    employees = {}\n    with open('/app/dataset/employees.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            employees[row['PESEL']] = {\n                'hourly_rate': float(row['hourly_rate']),\n                'first_name': row['first_name'],\n                'last_name': row['last_name'],\n            }\n    \n    # Load tasks\n    tasks = {}\n    with open('/app/dataset/tasks.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            tasks[str(row['task_id'])] = {\n                'pay_per_completion': float(row['pay_per_completion']),\n            }\n    \n    periods = get_billing_periods()\n    \n    # Aggregate: (employee_id, period_idx) -> {hours, bonus_sum}\n    agg = defaultdict(lambda: {'hours': 0.0, 'bonus_sum': 0.0})\n    \n    with open('/app/dataset/timesheet.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            try:\n                eid = row['employee_id']\n                eid = EMP_FIX.get(eid, eid)\n                if eid not in employees:\n                    continue  # skip unresolvable\n                # Parse date\n                try:\n                    d = datetime.strptime(row['date'], '%Y-%m-%d')\n                except:\n                    continue\n                # Parse hours\n                try:\n                    hrs = float(row['hours_worked'])\n                except:\n                    continue\n                # Skip invalid hours\n                if hrs < 0 or hrs == 0:  # treat zero/negative as invalid/exclude\n                    # But zero hours means no contribution; excluding is simpler and cleaner\n                    if hrs != 0:\n                        continue\n                    else:\n                        # Include zero? No - adds nothing. But sometimes might be data entry. Exclude.\n                        pass  # let us still process - but it adds 0\n                # Parse tasks and bonuses\n                task_list = parse_tasks_list(row['performed_tasks'])\n                bonus_sum = 0.0\n                for t in task_list:\n                    tkey = str(t)\n                    if tkey in tasks:\n                        bonus_sum += tasks[tkey]['pay_per_completion']\n                # Assign to period\n                period_idx = assign_to_billing_period(d, periods)\n                agg[(eid, period_idx)]['hours'] += hrs\n                agg[(eid, period_idx)]['bonus_sum'] += bonus_sum\n            except Exception:\n                continue  # skip problematic rows\n    \n    # Compute salaries per employee per period\n    result = defaultdict(list)\n    # Get all (employee, period) combinations that exist\n    for (eid, period_idx), data in agg.items():\n        emp = employees.get(eid)\n        if not emp:\n            continue\n        hourly_rate = emp['hourly_rate']\n        total_salary = data['hours'] * hourly_rate + data['bonus_sum']\n        # Round to nearest integer using standard mathematical rounding\n        salary_int = round(total_salary)\n        result[eid].append((period_idx, salary_int))\n    \n    # Sort by period for each employee and extract salaries in order\n    final_result = {}\n    for eid, items in result.items():\n        # Sort by billing month (period_idx) ascending\n        items_sorted = sorted(items, key=lambda x: x[0])\n        salaries = [item[1] for item in items_sorted]\n        final_result[eid] = salaries\n    \n    # Also ensure employees with no entries don't appear? Or appear with empty list?\n    # The task says \"total monthly salary for each employee for every month\" - \n    # if they didn't work, maybe salary is 0? But no entries means no hours and no bonuses.\n    # That gives 0. But are there any months with no work at all for someone? Maybe.\n    # But we only created entries where agg has data. That’s correct as per data.\n    # Sort final_result by PESEL for consistency (optional)\n    final_result = dict(sorted(final_result.items()))\n    \n    return final_result\nPY" action.permission=* action.action=allow action.pattern=*
