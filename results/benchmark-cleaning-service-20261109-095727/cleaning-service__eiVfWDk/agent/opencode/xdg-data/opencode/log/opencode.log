timestamp=2026-11-09T09:05:59.759Z level=INFO run=7904429e message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nimport csv\nimport ast\nfrom datetime import datetime\nfrom collections import defaultdict\n\nEMP_FIX = {\n    '15720759071': '75020759171',\n    '16102016795': '96102016751',\n    '62020111425': '65020111422',\n    '68011910138': '68011810139',\n    '84731091580': '87031491580',\n}\n\n\ndef parse_tasks_list(tasks_str):\n    if not tasks_str or tasks_str.strip() == '':\n        return []\n    tasks_str = tasks_str.strip()\n    # Fix brackets\n    if tasks_str.count('[') > tasks_str.count(']'):\n        tasks_str = tasks_str + ']' * (tasks_str.count('[') - tasks_str.count(']'))\n    if tasks_str.count(']') > tasks_str.count('['):\n        tasks_str = '[' * (tasks_str.count(']') - tasks_str.count('[')) + tasks_str\n    if '[' not in tasks_str and ']' not in tasks_str:\n        import re\n        numbers = re.findall(r'-?\\d+', tasks_str)\n        if numbers:\n            return [int(n) for n in numbers]\n    try:\n        result = ast.literal_eval(tasks_str)\n        if isinstance(result, list):\n            return result\n        if isinstance(result, (int, str)):\n            return [result]\n        try:\n            return list(result) if result else []\n        except Exception:\n            return []\n    except Exception:\n        import re\n        numbers = re.findall(r'-?\\d+', tasks_str)\n        return [int(n) for n in numbers]\n\n\ndef get_billing_periods():\n    tuesdays = [\n        datetime(2025, 3, 4),\n        datetime(2025, 4, 1),\n        datetime(2025, 5, 6),\n        datetime(2025, 6, 3),\n        datetime(2025, 7, 1),\n    ]\n    return tuesdays\n\n\ndef assign_to_billing_period(date, periods):\n    for i in range(len(periods) - 1):\n        if periods[i] <= date < periods[i + 1]:\n            return i\n    if date < periods[0]:\n        return 0\n    return len(periods) - 2\n\n\ndef answer():\n    employees = {}\n    with open('/app/dataset/employees.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            employees[row['PESEL']] = {\n                'hourly_rate': float(row['hourly_rate']),\n            }\n\n    tasks = {}\n    with open('/app/dataset/tasks.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            tasks[str(row['task_id'])] = float(row['pay_per_completion'])\n\n    periods = get_billing_periods()\n    agg = defaultdict(lambda: {'hours': 0.0, 'bonus_sum': 0.0})\n\n    with open('/app/dataset/timesheet.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            try:\n                eid = row['employee_id']\n                eid = EMP_FIX.get(eid, eid)\n                if eid not in employees:\n                    continue\n                try:\n                    d = datetime.strptime(row['date'], '%Y-%m-%d')\n                except Exception:\n                    continue  # skip invalid dates\n                try:\n                    hrs = float(row['hours_worked'])\n                except Exception:\n                    continue\n                if hrs < 0:\n                    continue  # exclude invalid\n                # Parse tasks\n                task_list = parse_tasks_list(row['performed_tasks'])\n                bonus_sum = 0.0\n                for t in task_list:\n                    tkey = str(t)\n                    if tkey in tasks:\n                        bonus_sum += tasks[tkey]\n                period_idx = assign_to_billing_period(d, periods)\n                agg[(eid, period_idx)]['hours'] += hrs\n                agg[(eid, period_idx)]['bonus_sum'] += bonus_sum\n            except Exception:\n                continue\n\n    result = defaultdict(list)\n    for (eid, period_idx), data in agg.items():\n        emp = employees.get(eid)\n        if not emp:\n            continue\n        total_salary = data['hours'] * emp['hourly_rate'] + data['bonus_sum']\n        salary_int = round(total_salary)\n        result[eid].append((period_idx, salary_int))\n\n    final_result = {}\n    for eid, items in result.items():\n        items_sorted = sorted(items, key=lambda x: x[0])\n        salaries = [item[1] for item in items_sorted]\n        final_result[eid] = salaries\n\n    final_result = dict(sorted(final_result.items()))\n    return final_result\n\n\nif __name__ == \"__main__\":\n    with open(\"/app/answer.json\", \"w\") as f:\n        json.dump(answer(), f, default=list)\nPY" action.permission=* action.action=allow action.pattern=*
