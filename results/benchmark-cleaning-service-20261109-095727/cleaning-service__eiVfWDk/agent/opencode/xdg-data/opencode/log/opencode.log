timestamp=2026-11-09T09:07:40.833Z level=INFO run=7904429e message=evaluated permission=bash pattern="python3 << 'PY'\n# Looks correct. Let us also spot-check another one - e.g. 65020111422\nimport csv\nfrom datetime import datetime\nimport ast\nfrom collections import defaultdict\n\nemp_fix = {\n    '15720759071': '75020759171',\n    '16102016795': '96102016751',\n    '62020111425': '65020111422',\n    '68011910138': '68011810139',\n    '84731091580': '87031491580',\n}\n\ntasks = {}\nwith open('/app/dataset/tasks.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        tasks[str(row['task_id'])] = float(row['pay_per_completion'])\n\nperiods = [\n    datetime(2025, 3, 4),\n    datetime(2025, 4, 1),\n    datetime(2025, 5, 6),\n    datetime(2025, 6, 3),\n    datetime(2025, 7, 1),\n]\n\nby_p_hrs = defaultdict(float)\nby_p_b = defaultdict(float)\neid_target = '65020111422'\nwith open('/app/dataset/employees.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        if row['PESEL'] == eid_target:\n            rate = float(row['hourly_rate'])\n            break\n\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        eid = row['employee_id']\n        eid = emp_fix.get(eid, eid)\n        if eid != eid_target:\n            continue\n        try:\n            d = datetime.strptime(row['date'], '%Y-%m-%d')\n        except:\n            continue\n        try:\n            hrs = float(row['hours_worked'])\n        except:\n            continue\n        if hrs < 0:\n            continue\n        tstr = row['performed_tasks']\n        try:\n            tl = ast.literal_eval(tstr)\n        except:\n            tl = []\n        b = sum(tasks.get(str(t), 0) for t in tl)\n        # assign\n        for i in range(len(periods)-1):\n            if periods[i] <= d < periods[i+1]:\n                by_p_hrs[i] += hrs\n                by_p_b[i] += b\n                break\n\nfor i in range(4):\n    total = by_p_hrs[i]*rate + by_p_b[i]\n    print(f'p{i}: hrs={by_p_hrs[i]}, b={by_p_b[i]}, total={total}, round={round(total)}')\nPY" action.permission=* action.action=allow action.pattern=*
