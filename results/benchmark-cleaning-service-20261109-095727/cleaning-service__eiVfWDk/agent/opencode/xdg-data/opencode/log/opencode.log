timestamp=2026-11-09T09:00:15.876Z level=INFO run=7904429e message=evaluated permission=bash pattern="python3 << 'PY'\n# Look at a few cases where computed != recorded\nimport csv\nimport ast\n\nemployees = {}\nwith open('/app/dataset/employees.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        employees[row['PESEL']] = row\n\ntasks = {}\nwith open('/app/dataset/tasks.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        tasks[row['task_id']] = row\n\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for i, row in enumerate(reader):\n        eid = row['employee_id']\n        if eid not in employees:\n            continue\n        hrs = float(row['hours_worked'])\n        rate = float(employees[eid]['hourly_rate'])\n        try:\n            tlist = ast.literal_eval(row['performed_tasks'])\n        except:\n            tlist = []\n        bonus = sum(float(tasks.get(str(t), {}).get('pay_per_completion', 0)) for t in tlist)\n        computed = hrs * rate + bonus\n        recorded = float(row['salary_amount'])\n        if abs(computed - recorded) > 0.01:\n            print(f'{row[\"id\"]}: comp={computed} vs rec={recorded}, hrs={hrs}, rate={rate}, tasks={tlist}, rec_bonus={row[\"bonus\"]}')\n            if i > 20: break\nPY" action.permission=* action.action=allow action.pattern=*
