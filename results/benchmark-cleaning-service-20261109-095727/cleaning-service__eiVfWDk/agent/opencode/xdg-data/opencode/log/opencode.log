timestamp=2026-11-09T09:08:19.760Z level=INFO run=7904429e message=evaluated permission=bash pattern="python3 << 'PY'\n# Check rows with zero hours and see their impact on period 2 for 65020111422\nemp_fix = {\n    '15720759071': '75020759171',\n    '16102016795': '96102016751',\n    '62020111425': '65020111422',\n    '68011910138': '68011810139',\n    '84731091580': '87031491580',\n}\ntasks = {}\nimport csv\nwith open('/app/dataset/tasks.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        tasks[str(row['task_id'])] = float(row['pay_per_completion'])\n\nperiods = [\n    datetime(2025,3,4), datetime(2025,4,1), datetime(2025,5,6), datetime(2025,6,3), datetime(2025,7,1),\n]\nfrom datetime import datetime\nimport ast\n\neid_target = '65020111422'\nwith open('/app/dataset/employees.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        if row['PESEL'] == eid_target:\n            rate = float(row['hourly_rate'])\n            break\n\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        eid = row['employee_id']\n        eid = emp_fix.get(eid, eid)\n        if eid != eid_target:\n            continue\n        try:\n            d = datetime.strptime(row['date'], '%Y-%m-%d')\n        except:\n            continue\n        in_p2 = (periods[2] <= d < periods[3])\n        if not in_p2:\n            continue\n        try:\n            hrs = float(row['hours_worked'])\n        except:\n            continue\n        if hrs != 0:\n            continue  # look only zero hours in p2\n        tstr = row['performed_tasks']\n        try:\n            tl = ast.literal_eval(tstr)\n        except:\n            tl = []\n        b = sum(tasks.get(str(t), 0) for t in tl)\n        print(row['id'], d, hrs, tl, b)\nPY" action.permission=* action.action=allow action.pattern=*
