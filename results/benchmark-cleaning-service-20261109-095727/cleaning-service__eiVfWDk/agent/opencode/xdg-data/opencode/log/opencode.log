timestamp=2026-11-09T09:04:56.052Z level=INFO run=7904429e message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\nimport ast\n\nemp_fix = {\n    '15720759071': '75020759171',\n    '16102016795': '96102016751',\n    '62020111425': '65020111422',\n    '68011910138': '68011810139',\n    '84731091580': '87031491580',\n}\n\n# load tasks\ntasks = {}\nwith open('/app/dataset/tasks.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        tasks[str(row['task_id'])] = float(row['pay_per_completion'])\n\nperiods = [\n    datetime(2025, 3, 4),\n    datetime(2025, 4, 1),\n    datetime(2025, 5, 6),\n    datetime(2025, 6, 3),\n    datetime(2025, 7, 1),\n]\n\ntotal_hours = 0.0\ntotal_bonus = 0.0\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        eid = row['employee_id']\n        eid = emp_fix.get(eid, eid)\n        if eid != '79011320010':\n            continue\n        d = datetime.strptime(row['date'], '%Y-%m-%d')\n        # check period 0\n        if periods[0] <= d < periods[1]:\n            hrs = float(row['hours_worked'])\n            if hrs == 0:\n                pass  # skip as we did\n            total_hours += hrs\n            # parse tasks\n            tstr = row['performed_tasks']\n            # quick parse\n            try:\n                tl = ast.literal_eval(tstr)\n            except:\n                tl = []\n            b = sum(tasks.get(str(t), 0) for t in tl)\n            total_bonus += b\n            # print(d, hrs, tl, b)\n\nprint('hours:', total_hours, 'bonus:', total_bonus, 'total:', total_hours*37.0 + total_bonus)\nPY" action.permission=* action.action=allow action.pattern=*
