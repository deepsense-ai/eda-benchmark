timestamp=2026-11-09T09:00:36.610Z level=INFO run=7904429e message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nimport ast\n\nemployees = {}\nwith open('/app/dataset/employees.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        employees[row['PESEL']] = row\n\nemp_fix = {\n    '15720759071': '75020759171',\n    '16102016795': '96102016751',\n    '62020111425': '65020111422',\n    '68011910138': '68011810139',\n    '84731091580': '87031491580',\n}\n\ntasks = {}\nwith open('/app/dataset/tasks.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        tasks[row['task_id']] = row\n\nmismatches = []\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for i, row in enumerate(reader):\n        eid = row['employee_id']\n        eid = emp_fix.get(eid, eid)\n        if eid not in employees:\n            continue\n        try:\n            tlist = ast.literal_eval(row['performed_tasks'])\n        except:\n            tlist = []\n        bonus_sum = sum(float(tasks[str(t)]['pay_per_completion']) for t in tlist if str(t) in tasks)\n        rec_bonus = float(row['bonus'])\n        if abs(bonus_sum - rec_bonus) > 0.01:\n            mismatches.append((row['id'], bonus_sum, rec_bonus, tlist, row['salary_amount']))\n        if len(mismatches) > 15:\n            break\n\nfor m in mismatches:\n    print(m)\nPY" action.permission=* action.action=allow action.pattern=*
