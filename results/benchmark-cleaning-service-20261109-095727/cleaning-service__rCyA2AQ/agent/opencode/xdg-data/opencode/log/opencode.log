timestamp=2026-11-09T09:06:11.833Z level=INFO run=dc3d0a36 message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport csv\nimport json\nimport re\nfrom collections import defaultdict\nfrom datetime import datetime, timedelta\n\n\ndef get_billing_period_start(date_str, earliest_start):\n    \"\"\"Return the billing period start (as (year, month, day)) for a given date.\n    Billing periods start on the same day of week as earliest_start and are\n    28-day (4-week) periods.\n    \"\"\"\n    d = datetime.strptime(date_str, '%Y-%m-%d')\n    delta = (d - earliest_start).days\n    k = delta // 28\n    p_start = earliest_start + timedelta(days=k * 28)\n    return (p_start.year, p_start.month, p_start.day)\n\n\ndef answer():\n    # Load employees\n    with open('/app/dataset/employees.csv') as f:\n        emp = list(csv.DictReader(f))\n    emp_by_pesel = {e['PESEL']: e for e in emp}\n\n    # Fixes for known typos in timesheet employee ids\n    fix_emp = {\n        '16102016795': '96102016751',\n        '68011910138': '68011810139',\n        '62020111425': '65020111422',\n        '84731091580': '87031491580',\n        '15720759071': '75020759171',\n    }\n\n    # Load tasks\n    with open('/app/dataset/tasks.csv') as f:\n        tasks = list(csv.DictReader(f))\n    task_by_id = {int(x['task_id']): x for x in tasks}\n\n    # Load timesheet\n    with open('/app/dataset/timesheet.csv') as f:\n        ts = list(csv.DictReader(f))\n\n    # Determine earliest record date and billing period start\n    dates = []\n    for t in ts:\n        try:\n            dates.append(datetime.strptime(t['date'], '%Y-%m-%d'))\n        except Exception:\n            continue\n    dates.sort()\n    earliest = dates[0] if dates else datetime(2025, 3, 4)\n\n    # Aggregate hours and bonuses per employee per billing period\n    hours_by_emp_period = defaultdict(float)\n    bonus_by_emp_period = defaultdict(float)\n\n    for t in ts:\n        # Fix employee id\n        eid = t['employee_id']\n        eid = fix_emp.get(eid, eid)\n        if eid not in emp_by_pesel:\n            continue  # exclude invalid employee\n\n        # Parse date\n        try:\n            pk = get_billing_period_start(t['date'], earliest)\n        except Exception:\n            continue  # exclude invalid date\n\n        # Hours\n        try:\n            hours_by_emp_period[(eid, pk)] += float(t['hours_worked'])\n        except Exception:\n            pass  # skip bad hours data\n\n        # Bonuses from tasks\n        tasks_str = t['performed_tasks']\n        try:\n            nums = [int(n) for n in re.findall(r'-?\\d+', tasks_str)]\n        except Exception:\n            nums = []\n        for n in nums:\n            if n in task_by_id:\n                bonus_by_emp_period[(eid, pk)] += float(task_by_id[n]['pay_per_completion'])\n\n    # Compute salaries\n    result = defaultdict(list)\n    keys = set(hours_by_emp_period.keys()) | set(bonus_by_emp_period.keys())\n    for eid, pk in keys:\n        hr = float(emp_by_pesel[eid]['hourly_rate'])\n        total_hours = hours_by_emp_period.get((eid, pk), 0.0)\n        total_bonus = bonus_by_emp_period.get((eid, pk), 0.0)\n        salary = total_hours * hr + total_bonus\n        salary_rounded = round(salary)\n        result[eid].append((pk, salary_rounded))\n\n    # Sort by billing month\n    final = {}\n    for eid, items in result.items():\n        items.sort(key=lambda x: (x[0][0], x[0][1], x[0][2]))\n        final[eid] = [v for _, v in items]\n\n    return final\n\n\nif __name__ == '__main__':\n    with open('/app/answer.json', 'w') as f:\n        json.dump(answer(), f, default=list)\nPY" action.permission=* action.action=allow action.pattern=*
