timestamp=2026-11-09T09:05:00.557Z level=INFO run=dc3d0a36 message=evaluated permission=bash pattern="python3 << 'PY'\n# Let’s recompute more carefully for one specific employee to sanity check.\n# Pick an employee and manually sum for one period.\nimport csv\nimport re\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict\n\nwith open('/app/dataset/employees.csv') as f:\n    emp = list(csv.DictReader(f))\nemp_by_pesel = {e['PESEL']: e for e in emp}\nfix_emp = {\n    '16102016795': '96102016751',\n    '68011910138': '68011810139',\n    '62020111425': '65020111422',\n    '84731091580': '87031491580',\n    '15720759071': '75020759171',\n}\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = list(csv.DictReader(f))\ntask_by_id = {int(x['task_id']): x for x in tasks}\nwith open('/app/dataset/timesheet.csv') as f:\n    ts = list(csv.DictReader(f))\n\nstart = datetime(2025, 3, 4)\ndef get_period_key(d):\n    delta = (d - start).days\n    k = delta // 28\n    p_start = start + timedelta(days=k*28)\n    return (p_start.year, p_start.month, p_start.day)\n\n# Check 02270326116 for first period (2025,3,4)\neid = '02270326116'\nhr = float(emp_by_pesel[eid]['hourly_rate'])\ntotal_h = 0\ntotal_b = 0\nfor t in ts:\n    teid = t['employee_id']\n    teid = fix_emp.get(teid, teid)\n    if teid != eid: continue\n    d = datetime.strptime(t['date'], '%Y-%m-%d')\n    pk = get_period_key(d)\n    if pk != (2025, 3, 4): continue\n    total_h += float(t['hours_worked'])\n    nums = [int(n) for n in re.findall(r'-?\\d+', t['performed_tasks'])]\n    for n in nums:\n        if n in task_by_id:\n            total_b += float(task_by_id[n]['pay_per_completion'])\nprint('period (2025,3,4):', total_h, total_b, total_h*hr + total_b, round(total_h*hr+total_b))\nPY" action.permission=* action.action=allow action.pattern=*
