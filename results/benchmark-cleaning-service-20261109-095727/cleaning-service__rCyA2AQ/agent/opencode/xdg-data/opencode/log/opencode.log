timestamp=2026-11-09T09:02:41.707Z level=INFO run=dc3d0a36 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nimport re\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict\n\nwith open('/app/dataset/employees.csv') as f:\n    emp = list(csv.DictReader(f))\nemp_by_pesel = {e['PESEL']: e for e in emp}\nfix_emp = {\n    '16102016795': '96102016751',\n    '68011910138': '68011810139',\n    '62020111425': '65020111422',\n    '84731091580': '87031491580',\n    '15720759071': '75020759171',\n}\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = list(csv.DictReader(f))\ntask_by_id = {int(x['task_id']): x for x in tasks}\nwith open('/app/dataset/timesheet.csv') as f:\n    ts = list(csv.DictReader(f))\n\nstart = datetime(2025, 3, 4)\n\ndef get_period_key(d):\n    delta = (d - start).days\n    k = delta // 28\n    p_start = start + timedelta(days=k*28)\n    return (p_start.year, p_start.month, p_start.day)\n\n# Aggregate\nhours_by_emp_period = defaultdict(float)\nbonus_by_emp_period = defaultdict(float)\n\nfor t in ts:\n    # fix employee\n    eid = t['employee_id']\n    eid = fix_emp.get(eid, eid)\n    if eid not in emp_by_pesel:\n        continue  # exclude invalid employee\n    # parse date\n    try:\n        d = datetime.strptime(t['date'], '%Y-%m-%d')\n    except Exception:\n        continue  # exclude invalid date\n    pk = get_period_key(d)\n    # hours\n    try:\n        hours_by_emp_period[(eid, pk)] += float(t['hours_worked'])\n    except:\n        pass  # skip bad hours\n    # tasks bonuses\n    tasks_str = t['performed_tasks']\n    # extract all task ids (numbers)\n    nums = [int(n) for n in re.findall(r'-?\\d+', tasks_str)]\n    for n in nums:\n        if n in task_by_id:\n            bonus_by_emp_period[(eid, pk)] += float(task_by_id[n]['pay_per_completion'])\n        # else: skip invalid task id\nPY" action.permission=* action.action=allow action.pattern=*
