timestamp=2026-11-09T09:05:50.331Z level=INFO run=dc3d0a36 message=evaluated permission=bash pattern="python3 << 'PY'\n# Check periods per employee\nimport csv\nimport re\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict, Counter\n\nwith open('/app/dataset/employees.csv') as f:\n    emp = list(csv.DictReader(f))\nemp_by_pesel = {e['PESEL']: e for e in emp}\nfix_emp = {'16102016795': '96102016751','68011910138': '68011810139','62020111425': '65020111422','84731091580': '87031491580','15720759071': '75020759171'}\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = list(csv.DictReader(f))\ntask_by_id = {int(x['task_id']): x for x in tasks}\nwith open('/app/dataset/timesheet.csv') as f:\n    ts = list(csv.DictReader(f))\n\nstart = datetime(2025, 3, 4)\ndef get_period_key(d):\n    delta = (d - start).days; k = delta // 28; p_start = start + timedelta(days=k*28)\n    return (p_start.year, p_start.month, p_start.day)\n\n# recompute quickly\nhours_by_emp_period = defaultdict(float)\nbonus_by_emp_period = defaultdict(float)\nfor t in ts:\n    eid = fix_emp.get(t['employee_id'], t['employee_id'])\n    if eid not in emp_by_pesel: continue\n    try: d = datetime.strptime(t['date'], '%Y-%m-%d')\n    except: continue\n    pk = get_period_key(d)\n    try: hours_by_emp_period[(eid, pk)] += float(t['hours_worked'])\n    except: pass\n    nums = [int(n) for n in re.findall(r'-?\\d+', t['performed_tasks'])]\n    for n in nums:\n        if n in task_by_id: bonus_by_emp_period[(eid, pk)] += float(task_by_id[n]['pay_per_completion'])\n\n# count periods\ncnt = Counter()\nfor eid, pk in (set(hours_by_emp_period) | set(bonus_by_emp_period)):\n    cnt[eid] += 1\n\n# all periods\nall_pks = sorted(set(pk for _, pk in (set(hours_by_emp_period) | set(bonus_by_emp_period))))\nprint('All periods:', all_pks)\nprint('Periods per emp (min,max):', min(cnt.values()), max(cnt.values()))\nPY" action.permission=* action.action=allow action.pattern=*
