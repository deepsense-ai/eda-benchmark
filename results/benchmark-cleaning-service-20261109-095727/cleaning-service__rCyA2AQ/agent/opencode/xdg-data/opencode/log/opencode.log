timestamp=2026-11-09T09:01:01.847Z level=INFO run=dc3d0a36 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom collections import defaultdict\n\nwith open('/app/dataset/timesheet.csv') as f:\n    ts = list(csv.DictReader(f))\nwith open('/app/dataset/employees.csv') as f:\n    emp = list(csv.DictReader(f))\nemp_by_pesel = {e['PESEL']: e for e in emp}\nfix_emp = {\n    '16102016795': '96102016751',\n    '68011910138': '68011810139',\n    '62020111425': '65020111422',\n    '84731091580': '87031491580',\n    '15720759071': '75020759171',\n}\n\n# Try aggregating by month per employee using salary_amount directly\nby_emp_month = defaultdict(float)\nfor t in ts:\n    eid = fix_emp.get(t['employee_id'], t['employee_id'])\n    if eid not in emp_by_pesel:\n        continue  # skip\n    try:\n        d = t['date']\n        # get month\n        from datetime import datetime\n        dt = datetime.strptime(d, '%Y-%m-%d')\n        month_key = dt.replace(day=1)  # or just (year, month)\n    except:\n        continue\n    try:\n        sal = float(t['salary_amount'])\n    except:\n        sal = 0\n    by_emp_month[(eid, dt.year, dt.month)] += sal\n\n# look at a sample\nitems = sorted(by_emp_month.items())[:5]\nfor k, v in items:\n    print(k, v)\nPY" action.permission=* action.action=allow action.pattern=*
