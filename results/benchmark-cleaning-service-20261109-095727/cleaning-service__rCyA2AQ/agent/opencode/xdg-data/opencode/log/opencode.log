timestamp=2026-11-09T09:00:14.637Z level=INFO run=dc3d0a36 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nimport re\n\nwith open('/app/dataset/timesheet.csv') as f:\n    ts = list(csv.DictReader(f))\nwith open('/app/dataset/employees.csv') as f:\n    emp = list(csv.DictReader(f))\nemp_by_pesel = {e['PESEL']: e for e in emp}\n\nfix_emp = {\n    '16102016795': '96102016751',\n    '68011910138': '68011810139',\n    '62020111425': '65020111422',\n    '84731091580': '87031491580',\n    '15720759071': '75020759171',\n}\n\nfor t in ts[:10]:\n    eid = t['employee_id']\n    eid_fix = fix_emp.get(eid, eid)\n    if eid_fix in emp_by_pesel:\n        hr = float(emp_by_pesel[eid_fix]['hourly_rate'])\n        hw = float(t['hours_worked'])\n        bonus = float(t['bonus'])\n        sal = float(t['salary_amount'])\n        computed = hw * hr + bonus\n        print(abs(computed - sal) < 0.01, computed, sal, hw, hr, bonus)\nPY" action.permission=* action.action=allow action.pattern=*
