timestamp=2026-11-09T09:15:27.496Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\n# Let us simulate the Tuesday-aligned billing period grouping\nfrom datetime import datetime, timedelta\nimport csv\nimport json\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\n\nwith open('/app/dataset/employees.csv') as f:\n    emps_list = list(csv.DictReader(f))\nemps = {e['PESEL']: e for e in emps_list}\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {t['task_id']: t for t in csv.DictReader(f)}\n\ndef parse_tasks(s):\n    s = s.strip()\n    if s == '[]': return []\n    try:\n        parsed = json.loads(s)\n        return [str(x) for x in parsed]\n    except:\n        s2 = s.replace('[', '').replace(']', '')\n        return [x.strip() for x in s2.split(',') if x.strip()]\n\ndef parse_date(s):\n    try:\n        d = datetime.strptime(s, '%Y-%m-%d')\n        return d\n    except:\n        if s.endswith('-31') and ('-06-' in s or '-04-' in s):\n            return datetime.strptime(s.replace('-31', '-30'), '%Y-%m-%d')\n        return None\n\ndef correct_eid(eid):\n    if eid in emps: return eid\n    best = None; best_score = -1\n    for e in emps_list:\n        pid = e['PESEL']\n        sc = SequenceMatcher(None, eid, pid).ratio()\n        if sc > best_score:\n            best_score = sc; best = pid\n    if best_score >= 0.7: return best\n    return None\n\n# define billing periods anchored to earliest record's weekday\n# earliest is 2025-03-04 (Tue)\nstart = datetime(2025, 3, 4)\n# build periods - maybe month-long periods starting on Tue? Or 4-week blocks\nperiods = []\ncur = start\n# generate enough\nfor i in range(6):\n    pstart = cur\n    pend = cur + timedelta(days=28) - timedelta(days=1)  # 4-week periods\n    periods.append((pstart, pend))\n    cur = pend + timedelta(days=1)\n    if cur > datetime(2025, 12, 31):\n        break\n\n# assign function\ndef get_billing_period(d):\n    for i, (ps, pe) in enumerate(periods):\n        if ps <= d <= pe:\n            return i, ps  # return period index and start\n    # fallback: find by closest\n    return None, None\n\nresult = defaultdict(lambda: defaultdict(float))\nwith open('/app/dataset/timesheet.csv') as f:\n    for r in csv.DictReader(f):\n        d = parse_date(r['date'])\n        if not d: continue\n        ce = correct_eid(r['employee_id'])\n        if not ce: continue\n        try: h = float(r['hours_worked'])\n        except: continue\n        tlist = parse_tasks(r['performed_tasks'])\n        bonus = 0\n        for tid in tlist:\n            if tid in tasks:\n                try: bonus += float(tasks[tid]['pay_per_completion'])\n                except: pass\n        rate = float(emps[ce]['hourly_rate'])\n        total = h*rate + bonus\n        b = get_billing_period(d)\n        if b[0] is None: continue\n        pid = b[0]\n        result[ce][pid] += total\n\n# build\nfinal_b = {}\nfor eid in result:\n    pids = sorted(result[eid].keys())\n    salaries = []\n    for pid in pids:\n        val = result[eid][pid]\n        salaries.append(int(round(val)))\n    final_b[eid] = salaries\n\nprint('Num employees:', len(final_b))\nfor k, v in list(final_b.items())[:2]:\n    print(k, v)\nPY" action.permission=* action.action=allow action.pattern=*
