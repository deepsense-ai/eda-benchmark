timestamp=2026-11-09T09:11:31.138Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nimport json\nfrom collections import defaultdict\n\nwith open('/app/dataset/employees.csv') as f:\n    emps = {e['PESEL']: e for e in csv.DictReader(f)}\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {t['task_id']: t for t in csv.DictReader(f)}\nwith open('/app/dataset/timesheet.csv') as f:\n    timesheet = list(csv.DictReader(f))\n\n# Try aggregating by employee and month for a sample\n# Parse date\n# Check row 291: March 2025, employee 79011320010\n# Sum across month\nemp = '79011320010'\nmonth_key = None\n# collect\nentries = []\nfor r in timesheet:\n    if r['employee_id'] == emp:\n        # parse\n        from datetime import datetime\n        d = datetime.strptime(r['date'], '%Y-%m-%d')\n        mk = (d.year, d.month)\n        # parse tasks\n        pt = r['performed_tasks'].strip()\n        bonus = 0\n        try:\n            if pt == '[]':\n                parsed = []\n            else:\n                parsed = json.loads(pt)\n        except:\n            # try to fix\n            parsed = []\n        # compute bonus from parsed\n        for tid in parsed:\n            try:\n                bonus += float(tasks[str(tid)]['pay_per_completion'])\n            except:\n                pass\n        entries.append({\n            'date': r['date'],\n            'year': d.year,\n            'month': d.month,\n            'hours': float(r['hours_worked']),\n            'bonus': bonus,\n            'bonus_row': float(r['bonus']) if r['bonus'] else 0,\n            'salary_row': float(r['salary_amount']) if r['salary_amount'] else 0,\n        })\n\n# group by (year, month)\nby_m = defaultdict(lambda: {'hours': 0, 'bonus': 0, 'entries': []})\nfor e in entries:\n    by_m[(e['year'], e['month'])]['hours'] += e['hours']\n    by_m[(e['year'], e['month'])]['bonus'] += e['bonus']\n    by_m[(e['year'], e['month'])]['entries'].append(e)\n\nfor k, v in sorted(by_m.items()):\n    rate = float(emps[emp]['hourly_rate'])\n    total = v['hours'] * rate + v['bonus']\n    print(k, f'hours={v[\"hours\"]}', f'bonus={v[\"bonus\"]}', f'total={total}')\nPY" action.permission=* action.action=allow action.pattern=*
