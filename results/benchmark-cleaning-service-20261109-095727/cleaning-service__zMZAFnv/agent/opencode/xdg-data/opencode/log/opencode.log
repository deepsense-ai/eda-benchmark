timestamp=2026-11-09T09:16:51.674Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\n# Just display all results\nfrom datetime import datetime\nimport csv\nimport json\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\n\nwith open('/app/dataset/employees.csv') as f:\n    emps_list = list(csv.DictReader(f))\nemps = {e['PESEL']: e for e in emps_list}\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {t['task_id']: t for t in csv.DictReader(f)}\n\ndef correct_eid(eid):\n    if eid in emps: return eid\n    best=None; bests=-1\n    for e in emps_list:\n        pid=e['PESEL']; sc=SequenceMatcher(None,eid,pid).ratio()\n        if sc>bests: bests=sc; best=pid\n    if bests>=0.7: return best\n    return None\n\ndef parse_tasks(s):\n    s=s.strip()\n    if s=='[]': return []\n    try: return [str(x) for x in json.loads(s)]\n    except:\n        s2=s.replace('[','').replace(']','')\n        return [x.strip() for x in s2.split(',') if x.strip()]\n\ndef parse_date(s):\n    try: return datetime.strptime(s,'%Y-%m-%d')\n    except:\n        if s.endswith('-31'):\n            for m in ['-04-','-06-','-09-','-11-']:\n                if m in s:\n                    try: return datetime.strptime(s.replace('-31','-30'),'%Y-%m-%d')\n                    except: pass\n            try: return datetime.strptime(s.replace('-31','-28'),'%Y-%m-%d')\n            except: pass\n        return None\n\nres = defaultdict(lambda: defaultdict(float))\nwith open('/app/dataset/timesheet.csv') as f:\n    for r in csv.DictReader(f):\n        d=parse_date(r['date'])\n        if not d: continue\n        ce=correct_eid(r['employee_id'])\n        if not ce: continue\n        try: h=float(r['hours_worked'])\n        except: continue\n        b=0\n        for tid in parse_tasks(r['performed_tasks']):\n            if tid in tasks:\n                try: b+=float(tasks[tid]['pay_per_completion'])\n                except: pass\n        res[ce][(d.year,d.month)] += h*float(emps[ce]['hourly_rate']) + b\n\nfinal = {}\nfor eid in res:\n    months = sorted(res[eid].keys())\n    sal = [int(round(res[eid][m])) for m in months]\n    final[eid] = sal\n\n# show all\nfor k in sorted(final.keys()):\n    print(k, final[k])\nPY" action.permission=* action.action=allow action.pattern=*
