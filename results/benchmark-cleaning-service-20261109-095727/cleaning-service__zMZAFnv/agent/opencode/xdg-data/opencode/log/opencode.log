timestamp=2026-11-09T09:14:35.425Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\nfrom datetime import datetime\nimport csv\nimport json\nfrom collections import defaultdict\n\n# Build mappings\nwith open('/app/dataset/employees.csv') as f:\n    emps_list = list(csv.DictReader(f))\nemps = {e['PESEL']: e for e in emps_list}\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {t['task_id']: t for t in csv.DictReader(f)}\n\n# build correction\nfrom difflib import SequenceMatcher\ndef correct_eid(eid):\n    if eid in emps:\n        return eid\n    best = None\n    best_score = -1\n    for e in emps_list:\n        pid = e['PESEL']\n        score = SequenceMatcher(None, eid, pid).ratio()\n        if score > best_score:\n            best_score = score\n            best = pid\n    if best_score >= 0.7:\n        return best\n    return None\n\n# parse tasks string\ndef parse_tasks(s):\n    s = s.strip()\n    if s == '[]':\n        return []\n    try:\n        parsed = json.loads(s)\n        return [str(x) for x in parsed]\n    except:\n        # fix brackets\n        s2 = s.replace('[', '').replace(']', '')\n        parts = [x.strip() for x in s2.split(',') if x.strip()]\n        return parts\n\ndef parse_date(s):\n    # fix bad dates\n    try:\n        d = datetime.strptime(s, '%Y-%m-%d')\n        return d\n    except:\n        # try to fix common cases\n        if s.endswith('-31') and ('-06-' in s or '-04-' in s):\n            s2 = s.replace('-31', '-30')\n            try:\n                return datetime.strptime(s2, '%Y-%m-%d')\n            except:\n                pass\n        return None\nPY" action.permission=* action.action=allow action.pattern=*
