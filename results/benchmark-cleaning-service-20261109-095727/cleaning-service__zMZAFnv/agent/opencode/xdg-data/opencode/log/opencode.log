timestamp=2026-11-09T09:11:05.128Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\n\n# Build employee lookup\nwith open('/app/dataset/employees.csv') as f:\n    emps = {e['PESEL']: e for e in csv.DictReader(f)}\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {t['task_id']: t for t in csv.DictReader(f)}\n\nwith open('/app/dataset/timesheet.csv') as f:\n    timesheet = list(csv.DictReader(f))\n\n# Check a few rows where employee exists\ncount = 0\nfor r in timesheet:\n    eid = r['employee_id']\n    if eid not in emps: continue\n    if count > 10: break\n    h = float(r['hours_worked'])\n    rate = float(emps[eid]['hourly_rate'])\n    # compute bonus from tasks\n    pt = r['performed_tasks']\n    bonus = 0\n    try:\n        import json\n        if pt.strip() != '[]':\n            parsed = json.loads(pt.strip())\n            for tid in parsed:\n                if tid in tasks:\n                    bonus += float(tasks[str(tid)]['pay_per_completion'])\n                else:\n                    # try int\n                    pass\n    except:\n        pass\n    calc = h * rate + bonus\n    print(f'id={r[\"id\"]}: calc={calc:.2f}, sal={r[\"salary_amount\"]}, bonus_row={r[\"bonus\"]}, bonus_calc={bonus}, h={h}, rate={rate}')\n    count += 1\nPY" action.permission=* action.action=allow action.pattern=*
