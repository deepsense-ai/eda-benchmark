timestamp=2026-11-09T09:09:26.715Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nimport json\n\nwith open('/app/dataset/timesheet.csv') as f:\n    timesheet = list(csv.DictReader(f))\n\n# Also look for other inconsistencies\nbad_dates = []\nbad_hours = []\nbad_employee = []\nbad_salary = []\n\nemp_set = set()\nwith open('/app/dataset/employees.csv') as f2:\n    for e in csv.DictReader(f2):\n        emp_set.add(e['PESEL'])\n\nfor r in timesheet:\n    # date\n    try:\n        from datetime import datetime\n        datetime.strptime(r['date'], '%Y-%m-%d')\n    except:\n        bad_dates.append(r['id'])\n    # hours\n    try:\n        h = float(r['hours_worked'])\n        if h < 0:  # maybe zero? check\n            pass\n    except:\n        bad_hours.append(r['id'])\n    # employee\n    if r['employee_id'] not in emp_set:\n        bad_employee.append((r['id'], r['employee_id']))\n    # salary\n    try:\n        float(r['salary_amount'])\n    except:\n        bad_salary.append(r['id'])\n\nprint('bad_dates:', len(bad_dates))\nprint('bad_hours:', len(bad_hours))\nprint('bad_employee:', len(bad_employee))\nprint('bad_salary:', len(bad_salary))\nif bad_employee:\n    for b in bad_employee[:10]:\n        print(b)\nPY" action.permission=* action.action=allow action.pattern=*
