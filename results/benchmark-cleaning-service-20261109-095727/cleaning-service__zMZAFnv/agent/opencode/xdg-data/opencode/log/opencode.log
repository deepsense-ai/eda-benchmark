timestamp=2026-11-09T09:15:06.093Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\n# Check a few specific values to be sure\n# Let us look at one employee more closely - say 79011320010 (Jan Łukasz Sierpień, hourly_rate 37, Cleaning Equipment Technician)\n# For March (2025-03), let us sum manually with the same corrections\nfrom datetime import datetime\nimport csv\nimport json\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\n\nwith open('/app/dataset/employees.csv') as f:\n    emps = {e['PESEL']: e for e in csv.DictReader(f)}\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {t['task_id']: t for t in csv.DictReader(f)}\n\ndef parse_tasks(s):\n    s = s.strip()\n    if s == '[]': return []\n    try:\n        parsed = json.loads(s)\n        return [str(x) for x in parsed]\n    except:\n        s2 = s.replace('[', '').replace(']', '')\n        return [x.strip() for x in s2.split(',') if x.strip()]\n\ndef parse_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except:\n        if s.endswith('-31') and ('-06-' in s or '-04-' in s):\n            return datetime.strptime(s.replace('-31', '-30'), '%Y-%m-%d')\n        return None\n\ndef correct_eid(eid):\n    if eid in emps: return eid\n    best = None; best_score = -1\n    for pid in emps:\n        sc = SequenceMatcher(None, eid, pid).ratio()\n        if sc > best_score:\n            best_score = sc; best = pid\n    if best_score >= 0.7: return best\n    return None\n\neid = '79011320010'\ntotal_h = 0; total_b = 0\nwith open('/app/dataset/timesheet.csv') as f:\n    for r in csv.DictReader(f):\n        d = parse_date(r['date'])\n        if not d: continue\n        ce = correct_eid(r['employee_id'])\n        if ce != eid: continue\n        if d.year == 2025 and d.month == 3:\n            h = float(r['hours_worked'])\n            tlist = parse_tasks(r['performed_tasks'])\n            b = 0\n            for tid in tlist:\n                if tid in tasks:\n                    b += float(tasks[tid]['pay_per_completion'])\n            total_h += h; total_b += b\nrate = float(emps[eid]['hourly_rate'])\nprint('Mar:', total_h, total_b, total_h*rate+total_b, round(total_h*rate+total_b))\nPY" action.permission=* action.action=allow action.pattern=*
