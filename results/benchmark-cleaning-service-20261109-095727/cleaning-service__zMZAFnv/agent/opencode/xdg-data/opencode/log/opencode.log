timestamp=2026-11-09T09:17:08.163Z level=INFO run=e6571189 message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nfrom datetime import datetime\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\n\nimport csv\nimport os\n\nDATA_DIR = '/app/dataset'\n\n\ndef load_data():\n    emps_list = []\n    with open(os.path.join(DATA_DIR, 'employees.csv')) as f:\n        reader = csv.DictReader(f)\n        for r in reader:\n            emps_list.append(r)\n    emps = {e['PESEL']: e for e in emps_list}\n\n    tasks_list = []\n    with open(os.path.join(DATA_DIR, 'tasks.csv')) as f:\n        reader = csv.DictReader(f)\n        for r in reader:\n            tasks_list.append(r)\n    tasks = {t['task_id']: t for t in tasks_list}\n\n    return emps_list, emps, tasks\n\n\ndef correct_eid(eid, emps_list, emps):\n    if eid in emps:\n        return eid\n    best = None\n    best_score = -1\n    for e in emps_list:\n        pid = e['PESEL']\n        score = SequenceMatcher(None, eid, pid).ratio()\n        if score > best_score:\n            best_score = score\n            best = pid\n    if best_score >= 0.7:\n        return best\n    return None\n\n\ndef parse_tasks(s):\n    s = s.strip()\n    if s == '[]':\n        return []\n    try:\n        parsed = json.loads(s)\n        return [str(x) for x in parsed]\n    except:\n        s2 = s.replace('[', '').replace(']', '')\n        parts = []\n        for x in s2.split(','):\n            x = x.strip()\n            if x:\n                parts.append(x)\n        return parts\n\n\ndef parse_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except Exception:\n        if s.endswith('-31'):\n            # try common months with 30 days\n            for m in ['-04-', '-06-', '-09-', '-11-']:\n                if m in s:\n                    try:\n                        return datetime.strptime(s.replace('-31', '-30'), '%Y-%m-%d')\n                    except Exception:\n                        pass\n            try:\n                return datetime.strptime(s.replace('-31', '-28'), '%Y-%m-%d')\n            except Exception:\n                pass\n        return None\n\n\ndef answer() -> dict[str, list[int]]:\n    emps_list, emps, tasks = load_data()\n\n    result = defaultdict(lambda: defaultdict(float))  # eid -> (year, month) -> total\n\n    with open(os.path.join(DATA_DIR, 'timesheet.csv')) as f:\n        reader = csv.DictReader(f)\n        for r in reader:\n            d = parse_date(r['date'])\n            if not d:\n                continue\n            ce = correct_eid(r['employee_id'], emps_list, emps)\n            if not ce:\n                continue\n            try:\n                h = float(r['hours_worked'])\n            except Exception:\n                continue\n\n            bonus = 0.0\n            tlist = parse_tasks(r['performed_tasks'])\n            for tid in tlist:\n                if tid in tasks:\n                    try:\n                        bonus += float(tasks[tid]['pay_per_completion'])\n                    except Exception:\n                        pass\n\n            rate = float(emps[ce]['hourly_rate'])\n            total = h * rate + bonus\n            result[ce][(d.year, d.month)] += total\n\n    final = {}\n    for eid in result:\n        months = sorted(result[eid].keys())  # sorted by billing month ascending\n        salaries = []\n        for m in months:\n            val = result[eid][m]\n            salaries.append(int(round(val)))\n        final[eid] = salaries\n\n    return final\n\n\nif __name__ == '__main__':\n    with open('/app/answer.json', 'w') as f:\n        json.dump(answer(), f, default=list)\nPY" action.permission=* action.action=allow action.pattern=*
