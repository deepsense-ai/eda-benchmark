timestamp=2026-11-09T09:16:37.644Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\n# Build the complete, final computation\nfrom datetime import datetime\nimport csv\nimport json\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\n\nwith open('/app/dataset/employees.csv') as f:\n    emps_list = list(csv.DictReader(f))\nemps = {e['PESEL']: e for e in emps_list}\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks_list = list(csv.DictReader(f))\ntasks = {t['task_id']: t for t in tasks_list}\n\ndef correct_eid(eid):\n    if eid in emps:\n        return eid\n    best = None\n    best_score = -1\n    for e in emps_list:\n        pid = e['PESEL']\n        score = SequenceMatcher(None, eid, pid).ratio()\n        if score > best_score:\n            best_score = score\n            best = pid\n    if best_score >= 0.7:\n        return best\n    return None\n\ndef parse_tasks(s):\n    s = s.strip()\n    if s == '[]':\n        return []\n    try:\n        parsed = json.loads(s)\n        return [str(x) for x in parsed]\n    except:\n        s2 = s.replace('[', '').replace(']', '')\n        parts = []\n        for x in s2.split(','):\n            x = x.strip()\n            if x:\n                parts.append(x)\n        return parts\n\ndef parse_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except:\n        if s.endswith('-31'):\n            # fix months with 30 days\n            for m in ['-04-', '-06-', '-09-', '-11-']:\n                if m in s:\n                    s2 = s.replace('-31', '-30')\n                    try:\n                        return datetime.strptime(s2, '%Y-%m-%d')\n                    except:\n                        pass\n            # Feb? maybe not present, but just in case\n            s2 = s.replace('-31', '-28')\n            try:\n                return datetime.strptime(s2, '%Y-%m-%d')\n            except:\n                pass\n        return None\n\n# aggregate by calendar month (billing month as calendar month)\nresult = defaultdict(lambda: defaultdict(float))  # eid -> (year,month) -> total\n\nwith open('/app/dataset/timesheet.csv') as f:\n    for r in csv.DictReader(f):\n        d = parse_date(r['date'])\n        if not d:\n            continue  # exclude invalid dates we can't correct\n        ce = correct_eid(r['employee_id'])\n        if not ce:\n            continue  # exclude if cannot correct\n        try:\n            h = float(r['hours_worked'])\n        except:\n            continue  # exclude invalid hours\n        # compute bonus\n        bonus = 0.0\n        tlist = parse_tasks(r['performed_tasks'])\n        for tid in tlist:\n            if tid in tasks:\n                try:\n                    bonus += float(tasks[tid]['pay_per_completion'])\n                except:\n                    pass\n            # if tid not in tasks, ignore/exclude that task's bonus? invalid task id - exclude\n        rate = float(emps[ce]['hourly_rate'])\n        total = h * rate + bonus\n        result[ce][(d.year, d.month)] += total\n\n# build final dict\nfinal = {}\nfor eid in result:\n    months = sorted(result[eid].keys())  # sort by billing month (calendar month) ascending\n    salaries = []\n    for m in months:\n        val = result[eid][m]\n        salaries.append(int(round(val)))\n    final[eid] = salaries\n\nprint(len(final))\nPY" action.permission=* action.action=allow action.pattern=*
