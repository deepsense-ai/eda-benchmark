timestamp=2026-11-09T09:14:55.136Z level=INFO run=e6571189 message=evaluated permission=bash pattern="python3 << 'PY'\n# Compute monthly totals (calendar month)\nfrom datetime import datetime\nimport csv\nimport json\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\n\n# (repeat setup quickly)\nwith open('/app/dataset/employees.csv') as f:\n    emps_list = list(csv.DictReader(f))\nemps = {e['PESEL']: e for e in emps_list}\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks_list = list(csv.DictReader(f))\ntasks = {t['task_id']: t for t in tasks_list}\n\ndef correct_eid(eid):\n    if eid in emps: return eid\n    best = None; best_score = -1\n    for e in emps_list:\n        pid = e['PESEL']\n        sc = SequenceMatcher(None, eid, pid).ratio()\n        if sc > best_score:\n            best_score = sc; best = pid\n    if best_score >= 0.7: return best\n    return None\n\ndef parse_tasks(s):\n    s = s.strip()\n    if s == '[]': return []\n    try:\n        parsed = json.loads(s)\n        return [str(x) for x in parsed]\n    except:\n        s2 = s.replace('[', '').replace(']', '')\n        return [x.strip() for x in s2.split(',') if x.strip()]\n\ndef parse_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except:\n        if s.endswith('-31') and ('-06-' in s or '-04-' in s):\n            s2 = s.replace('-31', '-30')\n            try:\n                return datetime.strptime(s2, '%Y-%m-%d')\n            except: pass\n        return None\n\n# aggregate\nresult = defaultdict(lambda: defaultdict(float))  # emp -> (year,month) -> total salary\nresult_hours = defaultdict(lambda: defaultdict(float))\nresult_bonus = defaultdict(lambda: defaultdict(float))\n\nwith open('/app/dataset/timesheet.csv') as f:\n    for r in csv.DictReader(f):\n        d = parse_date(r['date'])\n        if not d: continue\n        eid = correct_eid(r['employee_id'])\n        if not eid: continue  # exclude\n        try:\n            h = float(r['hours_worked'])\n        except:\n            continue  # or treat as 0?\n        # bonus\n        tlist = parse_tasks(r['performed_tasks'])\n        bonus = 0.0\n        for tid in tlist:\n            if tid in tasks:\n                try:\n                    bonus += float(tasks[tid]['pay_per_completion'])\n                except:\n                    pass\n        # total\n        rate = float(emps[eid]['hourly_rate'])\n        total = h * rate + bonus\n        key = (d.year, d.month)\n        result[eid][key] += total\n        result_hours[eid][key] += h\n        result_bonus[eid][key] += bonus\n\n# build final structure\n# for each PESEL, list of salaries sorted by billing month ascending\nfinal = {}\nfor eid in result:\n    # get sorted months\n    months = sorted(result[eid].keys())\n    salaries = []\n    for m in months:\n        val = result[eid][m]\n        # round to nearest integer using standard mathematical rounding\n        sal_rounded = round(val)\n        salaries.append(int(sal_rounded))\n    final[eid] = salaries\n\n# print summary\nprint('Num employees:', len(final))\nfor k, v in list(final.items())[:3]:\n    print(k, v)\nPY" action.permission=* action.action=allow action.pattern=*
