timestamp=2026-11-04T13:12:13.081Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\ndf = df[mask_valid].copy()\n\n# Compute IQR for numerical columns\ndef detect_iqr_outliers(series):\n    q1 = series.quantile(0.25)\n    q3 = series.quantile(0.75)\n    iqr = q3 - q1\n    lower = q1 - 3*iqr\n    upper = q3 + 3*iqr\n    return series[(series < lower) | (series > upper)]\n\n# For each numeric var, find outliers\nfor col in ['age', 'bmi', 'avg_glucose_level']:\n    out = detect_iqr_outliers(df[col])\n    print(f'{col}: {len(out)} outliers')\nPY" action.permission=* action.action=allow action.pattern=*
