timestamp=2026-11-04T13:25:17.997Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\n# Create risk proxy = product of all normalized numerical features\n# \"Variables used to create risk_proxy should be normalized by their maximum value\"\n# Numerical features - age, bmi, avg_glucose_level\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\ndf_valid = df[mask_valid].copy()\ndf_valid = df_valid.reset_index(drop=True)\n\n# build outliers to remove\noutliers_to_remove = set()\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    for idx in df_valid[(df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)].index:\n        outliers_to_remove.add(idx)\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nglc_out = df_valid[(df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)].index\nfor idx in glc_out:\n    v = df_valid.at[idx,col]\n    g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5:\n        continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        outliers_to_remove.add(idx)\n    else:\n        outliers_to_remove.add(idx)\n\ndf_clean = df_valid.drop(index=list(outliers_to_remove)).copy()\ndf_clean = df_clean.reset_index(drop=True)\n\n# normalize by max\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nfor c in num_cols:\n    df_clean[f'{c}_norm'] = df_clean[c] / df_clean[c].max()\n\n# risk proxy\ndf_clean['risk_proxy'] = df_clean['age_norm'] * df_clean['bmi_norm'] * df_clean['avg_glucose_level_norm']\nprint(df_clean['risk_proxy'].describe())\nPY" action.permission=* action.action=allow action.pattern=*
