timestamp=2026-11-04T13:45:44.043Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\n# So total: 560 + 45 + 66 + 19 = 690. But earlier we got 683. That means some outliers are being double-counted across categories? Or overlap exists. Let us check overlaps.\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nall_outliers = set()\n\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\nrange_out = set(df[~mask_valid].index)\nfor idx in range_out: all_outliers.add(idx)\n\ndf_valid = df[mask_valid].copy()\n# std iqr\nstd_iqr = set()\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index: std_iqr.add(idx)\nstd_glc = set()\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]; g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5: continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        std_glc.add(idx)\n    else: std_glc.add(idx)\nfor idx in std_iqr: all_outliers.add(idx)\nfor idx in std_glc: all_outliers.add(idx)\n\n# mah\ndf_clean_for_mah = df_valid.drop(index=[i for i in all_outliers if i in df_valid.index]).copy()\nmah = set()\nif len(df_clean_for_mah) > 0:\n    X = df_clean_for_mah[num_cols].values if False else df_clean_for_mah[['age','bmi','avg_glucose_level']].values\n    num_cols = ['age','bmi','avg_glucose_level']\n    X = df_clean_for_mah[num_cols].values\n    mean = np.mean(X, axis=0); cov = np.cov(X,rowvar=False); inv_cov = np.linalg.pinv(cov)\n    crit = chi2.ppf(1-0.01, df=len(num_cols))\n    for i in range(X.shape[0]):\n        diff = X[i]-mean; d2 = diff@inv_cov@diff\n        if d2 > crit: mah.add(df_clean_for_mah.index[i])\nfor idx in mah: all_outliers.add(idx)\n\n# cat\ncat = set()\nmask = (df['age'] <= 3) & (df['work_type'] == 'student')\nfor idx in df[mask].index: cat.add(idx)\nmask = (df['age'] <= 3) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))\nfor idx in df[mask].index: cat.add(idx)\nmask = (df['age'] <= 14) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))\nfor idx in df[mask].index: cat.add(idx)\nmask = (df['age'] <= 14) & (df['ever_married'] == True)\nfor idx in df[mask].index: cat.add(idx)\nfor idx in cat: all_outliers.add(idx)\n\nprint('total:', len(all_outliers))\nprint('overlaps - cat∩range:', len(cat & range_out))\nprint('overlaps - cat∩std_glc:', len(cat & std_glc))\nprint('overlaps - cat∩mah:', len(cat & mah))\nprint('overlaps - mah∩std_glc:', len(mah & std_glc))\nPY" action.permission=* action.action=allow action.pattern=*
