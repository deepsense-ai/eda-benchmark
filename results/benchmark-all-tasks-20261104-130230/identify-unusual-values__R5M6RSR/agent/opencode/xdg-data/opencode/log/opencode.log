timestamp=2026-11-04T13:28:42.495Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\n# Rebuild with original indices preserved\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n# work with a copy that keeps original index\ndf_work = df.copy()  # pandas index is 0-based as original matrix\n\n# range filter\nmask_valid = (df_work['avg_glucose_level'] >= 20) & (df_work['avg_glucose_level'] <= 800) & \\\n             (df_work['bmi'] >= 10) & (df_work['bmi'] <= 60) & \\\n             (df_work['age'] <= 120)\ndf_valid = df_work[mask_valid].copy()  # keep original indices\n\n# standard outliers to remove (by index in df_valid/original index)\noutliers_to_remove_std = set()\n# age, bmi\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index:\n        outliers_to_remove_std.add(idx)\n# glucose\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]\n    g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5:\n        continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        outliers_to_remove_std.add(idx)\n    else:\n        outliers_to_remove_std.add(idx)\n\ndf_clean = df_valid.drop(index=list(outliers_to_remove_std)).copy()\nPY" action.permission=* action.action=allow action.pattern=*
