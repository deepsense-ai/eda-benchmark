timestamp=2026-11-04T13:44:28.184Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\n# Add categorical outliers - check on full original df\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf_work = df.copy()\nall_outliers = set()\n\n# First, range violations - impossible numeric values that were \"discarded\"\nmask_valid = (df_work['avg_glucose_level'] >= 20) & (df_work['avg_glucose_level'] <= 800) & \\\n             (df_work['bmi'] >= 10) & (df_work['bmi'] <= 60) & \\\n             (df_work['age'] <= 120)\ninvalid = df_work[~mask_valid]\nfor idx in invalid.index:\n    all_outliers.add(idx)\n\n# Now proceed on valid subset for other outliers? But we need to track original indices - yes, indices are preserved.\ndf_valid = df_work[mask_valid].copy()\n\n# standard IQR\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index:\n        all_outliers.add(idx)\n\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]\n    g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5:\n        continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        all_outliers.add(idx)\n    else:\n        all_outliers.add(idx)\n\n# mah on clean\nstd_out_so_far = set(all_outliers)\ndf_clean_for_mah = df_valid.drop(index=[i for i in std_out_so_far if i in df_valid.index]).copy()\n# simpler: just drop those that are in df_valid and are in all_outliers? easier to recompute\n# or just get remaining\nremaining = df_valid.drop(index=list(all_outliers & set(df_valid.index)), errors='ignore').copy()\n# better approach\npass\nPY" action.permission=* action.action=allow action.pattern=*
