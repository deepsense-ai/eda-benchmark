timestamp=2026-11-04T13:43:34.018Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf_work = df.copy()\n\n# range filter\nmask_valid = (df_work['avg_glucose_level'] >= 20) & (df_work['avg_glucose_level'] <= 800) & \\\n             (df_work['bmi'] >= 10) & (df_work['bmi'] <= 60) & \\\n             (df_work['age'] <= 120)\ndf_valid = df_work[mask_valid].copy()\n\nall_outliers = set()\n\n# standard IQR outliers (with glucose rule)\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index:\n        all_outliers.add(idx)\n\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]\n    g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5:\n        continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        all_outliers.add(idx)\n    else:\n        all_outliers.add(idx)\n\n# Mahalanobis outliers - computed on data after removing standard outliers\ndf_clean_for_mah = df_valid.drop(index=list(all_outliers)).copy()  # standard outliers removed\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nX = df_clean_for_mah[num_cols].values\nmean = np.mean(X, axis=0)\ncov = np.cov(X, rowvar=False)\ninv_cov = np.linalg.pinv(cov)\nfor i in range(X.shape[0]):\n    diff = X[i]-mean\n    d2 = diff@inv_cov@diff\n    if d2 > chi2.ppf(1-0.01, df=len(num_cols)):\n        all_outliers.add(df_clean_for_mah.index[i])\n\nprint('after mah:', len(all_outliers))\nPY" action.permission=* action.action=allow action.pattern=*
