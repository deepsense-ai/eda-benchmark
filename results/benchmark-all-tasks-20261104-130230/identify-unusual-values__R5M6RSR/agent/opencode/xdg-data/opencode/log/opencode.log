timestamp=2026-11-04T13:27:01.731Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\ndf_valid = df[mask_valid].copy()\ndf_valid = df_valid.reset_index(drop=True)\n\n# remove std outliers\noutliers_to_remove_std = set()\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index: outliers_to_remove_std.add(idx)\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]; g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5: continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        outliers_to_remove_std.add(idx)\n    else:\n        outliers_to_remove_std.add(idx)\n\ndf_clean = df_valid.drop(index=list(outliers_to_remove_std)).copy()\ndf_clean = df_clean.reset_index(drop=True)\n\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nX = df_clean[num_cols].values\nmean = np.mean(X, axis=0)\ncov = np.cov(X, rowvar=False)\ninv_cov = np.linalg.pinv(cov)\nmahal_d2 = []\nfor i in range(X.shape[0]):\n    diff = X[i]-mean\n    d2 = diff@inv_cov@diff\n    mahal_d2.append(d2)\nmahal_d2 = np.array(mahal_d2)\n\nalpha = 0.01\ncrit = chi2.ppf(1-alpha, df=len(num_cols))\nprint('crit:', crit)\nprint('n outliers by Mahalanobis:', (mahal_d2 > crit).sum())\nPY" action.permission=* action.action=allow action.pattern=*
