timestamp=2026-11-04T13:31:19.890Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\n# continue Mahalanobis on df_clean (with original indices)\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf_work = df.copy()\n\nmask_valid = (df_work['avg_glucose_level'] >= 20) & (df_work['avg_glucose_level'] <= 800) & \\\n             (df_work['bmi'] >= 10) & (df_work['bmi'] <= 60) & \\\n             (df_work['age'] <= 120)\ndf_valid = df_work[mask_valid].copy()\n\noutliers_to_remove_std = set()\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index: outliers_to_remove_std.add(idx)\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]; g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5: continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        outliers_to_remove_std.add(idx)\n    else: outliers_to_remove_std.add(idx)\n\ndf_clean = df_valid.drop(index=list(outliers_to_remove_std)).copy()\n\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nX = df_clean[num_cols].values\nmean = np.mean(X, axis=0)\ncov = np.cov(X, rowvar=False)\ninv_cov = np.linalg.pinv(cov)\nmahal_d2_list = []\nfor i in range(X.shape[0]):\n    diff = X[i]-mean\n    d2 = diff@inv_cov@diff\n    mahal_d2_list.append(d2)\nmahal_d2 = np.array(mahal_d2_list)\ncrit = chi2.ppf(1-0.01, df=len(num_cols))\nmah_out_mask = mahal_d2 > crit\nmah_out_indices = df_clean[mah_out_mask].index.tolist()  # these are original indices\nprint(len(mah_out_indices), mah_out_indices[:10])\nPY" action.permission=* action.action=allow action.pattern=*
