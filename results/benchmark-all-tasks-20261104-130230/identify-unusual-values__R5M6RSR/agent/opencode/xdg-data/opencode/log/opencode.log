timestamp=2026-11-04T13:23:39.712Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\n# Now, handle outliers from other variables (age, bmi)? They are just outliers by 3*IQR, no special rule mentioned.\n# \"Before making a final decision to reject outliers based on avg_glucose_level, verify whether this condition...\" - special handling only for avg_glucose_level.\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\ndf_valid = df[mask_valid].copy()\ndf_valid = df_valid.reset_index(drop=True)\n\noutliers_to_remove = set()\n\n# age\ncol = 'age'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nfor idx in df_valid[(df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)].index:\n    outliers_to_remove.add(idx)\n\n# bmi\ncol = 'bmi'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nfor idx in df_valid[(df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)].index:\n    outliers_to_remove.add(idx)\n\n# avg glucose - apply special rule\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nglc_out = df_valid[(df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)].index\nfor idx in glc_out:\n    v = df_valid.at[idx,col]\n    g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5:\n        # not considered outliers - do not remove\n        continue\n    elif p > 0.2:\n        # according to our earlier check, no such case. But just in case, follow rule\n        # after log2 and recheck above condition (>=50%) - still same p\n        # if still not >= 0.5, remain outlier? So remove\n        if p >= 0.5:\n            continue\n        else:\n            outliers_to_remove.add(idx)\n    else:\n        outliers_to_remove.add(idx)\n\nprint(len(outliers_to_remove))\nPY" action.permission=* action.action=allow action.pattern=*
