timestamp=2026-11-04T13:44:40.674Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nall_outliers = set()\n\n# range violations\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\nfor idx in df[~mask_valid].index:\n    all_outliers.add(idx)\n\ndf_valid = df[mask_valid].copy()\n\n# standard IQR\nfor col in ['age', 'bmi']:\n    q1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\n    m = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\n    for idx in df_valid[m].index:\n        all_outliers.add(idx)\n\ncol = 'avg_glucose_level'\nq1 = df_valid[col].quantile(0.25); q3 = df_valid[col].quantile(0.75); iqr=q3-q1\nm = (df_valid[col]<q1-3*iqr)|(df_valid[col]>q3+3*iqr)\nfor idx in df_valid[m].index:\n    v = df_valid.at[idx,col]\n    g = df_valid[df_valid[col]==v]\n    p = g['stroke'].mean()\n    if p >= 0.5:\n        continue\n    elif p > 0.2:\n        if p >= 0.5: continue\n        all_outliers.add(idx)\n    else:\n        all_outliers.add(idx)\n\n# mah\ndf_clean_for_mah = df_valid.drop(index=[i for i in all_outliers if i in df_valid.index]).copy()\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nif len(df_clean_for_mah) > 0:\n    X = df_clean_for_mah[num_cols].values\n    mean = np.mean(X, axis=0)\n    cov = np.cov(X, rowvar=False)\n    inv_cov = np.linalg.pinv(cov)\n    crit = chi2.ppf(1-0.01, df=len(num_cols))\n    for i in range(X.shape[0]):\n        diff = X[i]-mean\n        d2 = diff@inv_cov@diff\n        if d2 > crit:\n            all_outliers.add(df_clean_for_mah.index[i])\n\n# categorical\n# toddlers student\nmask = (df['age'] <= 3) & (df['work_type'] == 'student')\nfor idx in df[mask].index: all_outliers.add(idx)\n# toddlers smoking\nmask = (df['age'] <= 3) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))\nfor idx in df[mask].index: all_outliers.add(idx)\n# children smoking\nmask = (df['age'] <= 14) & (df['smoking_status'].isin(['smokes', 'formerly smoked']))\nfor idx in df[mask].index: all_outliers.add(idx)\n# children married\nmask = (df['age'] <= 14) & (df['ever_married'] == True)\nfor idx in df[mask].index: all_outliers.add(idx)\n\nprint(len(all_outliers))\nPY" action.permission=* action.action=allow action.pattern=*
