timestamp=2026-11-04T13:13:56.916Z level=INFO run=f66adc04 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\nmask_valid = (df['avg_glucose_level'] >= 20) & (df['avg_glucose_level'] <= 800) & \\\n             (df['bmi'] >= 10) & (df['bmi'] <= 60) & \\\n             (df['age'] <= 120)\ndf = df[mask_valid].copy()\n\n# find all values of avg_glucose_level in the full df_clean and their stroke prop\ncol = 'avg_glucose_level'\nq1 = df[col].quantile(0.25)\nq3 = df[col].quantile(0.75)\niqr = q3 - q1\nlower = q1 - 3*iqr\nupper = q3 + 3*iqr\nout_mask = (df[col] < lower) | (df[col] > upper)\nout_df = df[out_mask].copy()\n\n# for each outlier value, check rule\nresults = []\nfor v, g in out_df.groupby(col):\n    # find all observations in df_clean with this exact value\n    all_same = df[df[col] == v]\n    n_same = len(all_same)\n    n_stroke_same = (all_same['stroke']==1).sum()\n    stroke_prop_same = n_stroke_same / n_same if n_same > 0 else 0\n    results.append((v, n_same, stroke_prop_same, len(g), (g['stroke']==1).sum()))\n\nfor r in results:\n    print(r)\nPY" action.permission=* action.action=allow action.pattern=*
