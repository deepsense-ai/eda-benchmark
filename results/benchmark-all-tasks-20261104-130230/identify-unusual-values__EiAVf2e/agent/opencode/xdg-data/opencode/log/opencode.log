timestamp=2026-11-04T12:24:16.408Z level=INFO run=6f824f8b message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import chi2\n\ndef answer() -> list[int]:\n    df = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n    df['orig_idx'] = df.index\n\n    outlier_set = set()\n\n    # 1. Impossible numeric values (technical noise)\n    for _, row in df.iterrows():\n        idx = int(row['orig_idx'])\n        age = row['age']\n        bmi = row['bmi']\n        avg = row['avg_glucose_level']\n        if pd.isna(age) or pd.isna(bmi) or pd.isna(avg):\n            outlier_set.add(idx)\n            continue\n        if age > 120:\n            outlier_set.add(idx)\n        if bmi < 10 or bmi > 60:\n            outlier_set.add(idx)\n        if avg < 20 or avg > 800:\n            outlier_set.add(idx)\n\n    # 2. 3*IQR\n    for col in ['age', 'bmi', 'avg_glucose_level']:\n        s = df[col]\n        q1 = s.quantile(0.25)\n        q3 = s.quantile(0.75)\n        iqr = q3 - q1\n        if iqr == 0:\n            continue\n        lo = q1 - 3 * iqr\n        hi = q3 + 3 * iqr\n        mask = (s < lo) | (s > hi)\n        for _, row in df[mask].iterrows():\n            idx = int(row['orig_idx'])\n            if col == 'avg_glucose_level':\n                val = row['avg_glucose_level']\n                same = df[df['avg_glucose_level'] == val]\n                total = len(same)\n                sc = (same['stroke'] == 1).sum()\n                pct = sc / total if total > 0 else 0\n                if pct >= 0.5:\n                    continue  # not outlier\n                # if pct > 0.2 and < 0.5, log transform recheck needed - but no such cases found\n                outlier_set.add(idx)\n            else:\n                outlier_set.add(idx)\n\n    # 3 & 4. Mahalanobis on numerical variables\n    df_clean = df[~df['orig_idx'].isin(outlier_set)].copy()\n    num_cols = ['age', 'bmi', 'avg_glucose_level']\n    for c in num_cols:\n        mx = df_clean[c].max()\n        if mx != 0:\n            df_clean[c + '_norm'] = df_clean[c] / mx\n        else:\n            df_clean[c + '_norm'] = 0\n    df_clean['risk_proxy'] = df_clean['age_norm'] * df_clean['bmi_norm'] * df_clean['avg_glucose_level_norm']\n\n    data = df_clean[['age', 'bmi', 'avg_glucose_level']].values\n    cov = np.cov(data.T)\n    mean = np.mean(data, axis=0)\n    try:\n        inv_cov = np.linalg.inv(cov)\n    except Exception:\n        inv_cov = np.linalg.pinv(cov)\n    d2 = np.array([(x - mean).T @ inv_cov @ (x - mean) for x in data])\n    df_vars = data.shape[1]\n    crit = chi2.ppf(0.99, df_vars)\n    mask_out = d2 > crit\n    for idx in df_clean[mask_out]['orig_idx']:\n        outlier_set.add(int(idx))\n\n    # 5. Categorical variables\n    for _, row in df.iterrows():\n        idx = int(row['orig_idx'])\n        age = row['age']\n        work_type = row['work_type']\n        smoking_status = row['smoking_status']\n        # toddlers (age <= 3) who are students\n        if age <= 3 and work_type == 'student':\n            outlier_set.add(idx)\n            continue\n        # children (age <= 14) who smoke or formerly smoked\n        if age <= 14 and smoking_status in ('smokes', 'formerly smoked'):\n            outlier_set.add(idx)\n            continue\n        # work_type 'children' but age > 14\n        if work_type == 'children' and age > 14:\n            outlier_set.add(idx)\n            continue\n\n    result = sorted(list(outlier_set))\n    return result\n\nif __name__ == '__main__':\n    res = answer()\n    with open('/app/answer.json', 'w') as f:\n        json.dump(res, f)\nPY" action.permission=* action.action=allow action.pattern=*
