timestamp=2026-11-04T12:19:19.262Z level=INFO run=6f824f8b message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf['orig_idx'] = df.index\n\n# run partial\noutlier_set = set()\nfor _, row in df.iterrows():\n    idx = int(row['orig_idx'])\n    age = row['age']; bmi = row['bmi']; avg = row['avg_glucose_level']\n    if pd.isna(age) or pd.isna(bmi) or pd.isna(avg):\n        outlier_set.add(idx); continue\n    if age > 120: outlier_set.add(idx)\n    if bmi < 10 or bmi > 60: outlier_set.add(idx)\n    if avg < 20 or avg > 800: outlier_set.add(idx)\n\nfor col in ['age', 'bmi', 'avg_glucose_level']:\n    s = df[col]\n    q1 = s.quantile(0.25); q3 = s.quantile(0.75)\n    iqr = q3-q1\n    if iqr == 0: continue\n    lo = q1-3*iqr; hi = q3+3*iqr\n    mask = (s<lo)|(s>hi)\n    for _, row in df[mask].iterrows():\n        idx = int(row['orig_idx'])\n        if col == 'avg_glucose_level':\n            val = row['avg_glucose_level']\n            same = df[df['avg_glucose_level']==val]\n            total = len(same); sc = (same['stroke']==1).sum()\n            pct = sc/total if total else 0\n            if pct >= 0.5: continue\n            outlier_set.add(idx)\n        else:\n            outlier_set.add(idx)\n\ndf_clean = df[~df['orig_idx'].isin(outlier_set)].copy()\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nfor c in num_cols:\n    mx = df_clean[c].max()\n    df_clean[c+'_norm'] = df_clean[c]/mx if mx!=0 else 0\ndf_clean['risk_proxy'] = df_clean['age_norm']*df_clean['bmi_norm']*df_clean['avg_glucose_level_norm']\n\ndata = df_clean[['age','bmi','avg_glucose_level']].values\ncov = np.cov(data.T)\nmean = np.mean(data,axis=0)\ninv_cov = np.linalg.inv(cov)\nd2 = np.array([(x-mean).T@inv_cov@(x-mean) for x in data])\ndf_vars = data.shape[1]\ncrit1 = chi2.ppf(0.99, df_vars)\ncrit2 = 0.01  # as stated\nprint('with 0.99 crit:', (d2>crit1).sum(), 'with crit==0.01:', (d2>crit2).sum())\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
