timestamp=2026-11-04T12:22:19.925Z level=INFO run=6f824f8b message=evaluated permission=bash pattern="cat > /tmp/full.py << 'PY'\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import chi2\n\ndef answer() -> list[int]:\n    df = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n    df['orig_idx'] = df.index\n\n    outlier_set = set()\n\n    # 1. Impossible numeric values (technical noise)\n    for _, row in df.iterrows():\n        idx = int(row['orig_idx'])\n        age = row['age']\n        bmi = row['bmi']\n        avg = row['avg_glucose_level']\n        if pd.isna(age) or pd.isna(bmi) or pd.isna(avg):\n            outlier_set.add(idx)\n            continue\n        if age > 120:\n            outlier_set.add(idx)\n        if bmi < 10 or bmi > 60:\n            outlier_set.add(idx)\n        if avg < 20 or avg > 800:\n            outlier_set.add(idx)\n\n    # 2. 3*IQR\n    for col in ['age', 'bmi', 'avg_glucose_level']:\n        s = df[col]\n        q1 = s.quantile(0.25)\n        q3 = s.quantile(0.75)\n        iqr = q3 - q1\n        if iqr == 0:\n            continue\n        lo = q1 - 3 * iqr\n        hi = q3 + 3 * iqr\n        mask = (s < lo) | (s > hi)\n        for _, row in df[mask].iterrows():\n            idx = int(row['orig_idx'])\n            if col == 'avg_glucose_level':\n                val = row['avg_glucose_level']\n                same = df[df['avg_glucose_level'] == val]\n                total = len(same)\n                sc = (same['stroke'] == 1).sum()\n                pct = sc / total if total > 0 else 0\n                if pct >= 0.5:\n                    continue  # not outlier\n                outlier_set.add(idx)\n            else:\n                outlier_set.add(idx)\n\n    # 3 & 4. Create risk_proxy on cleaned data, then Mahalanobis\n    df_clean = df[~df['orig_idx'].isin(outlier_set)].copy()\n    num_cols = ['age', 'bmi', 'avg_glucose_level']\n    for c in num_cols:\n        mx = df_clean[c].max()\n        df_clean[c + '_norm'] = df_clean[c] / mx if mx != 0 else 0\n    df_clean['risk_proxy'] = df_clean['age_norm'] * df_clean['bmi_norm'] * df_clean['avg_glucose_level_norm']\n\n    # Mahalanobis on numerical variables\n    data = df_clean[['age', 'bmi', 'avg_glucose_level']].values\n    cov = np.cov(data.T)\n    mean = np.mean(data, axis=0)\n    try:\n        inv_cov = np.linalg.inv(cov)\n    except:\n        inv_cov = np.linalg.pinv(cov)\n    d2 = np.array([(x - mean).T @ inv_cov @ (x - mean) for x in data])\n    df_vars = data.shape[1]\n    crit = chi2.ppf(0.99, df_vars)  # alpha=0.01\n    mask_out = d2 > crit\n    for idx in df_clean[mask_out]['orig_idx']:\n        outlier_set.add(int(idx))\n\n    # 5. Categorical variable checks\n    # Definitions\n    # - age of children <= 14\n    # - age of toddlers <= 3\n    # - toddlers (age <= 3) who are students -> outliers\n    # - children (age <= 14) who are smokers or formerly smoked -> outliers (based on examples given)\n    # Also the example text: “smoker” or “formerly smoked” / person working in children\n    for _, row in df.iterrows():\n        idx = int(row['orig_idx'])\n        age = row['age']\n        work_type = row['work_type']\n        smoking_status = row['smoking_status']\n\n        # toddlers (age <= 3) that are students\n        if age <= 3 and work_type == 'student':\n            outlier_set.add(idx)\n            continue\n\n        # children (age <= 14) who smoke or formerly smoked\n        if age <= 14 and smoking_status in ('smokes', 'formerly smoked'):\n            outlier_set.add(idx)\n            continue\n\n        # Also check inconsistencies mentioned: toddler but not matching work_type? Or other cases\n        # e.g. toddler (age <= 3) but work_type is not 'children' and not plausible? we saw one case: age 1.8, student - already caught above\n        # Also maybe flag if work_type is 'children' but age > 14? The instruction says \"age of children should be set to no more than 14\" for outlier detection in categorical vars - suggests mismatch is suspicious\n        if work_type == 'children' and age > 14:\n            outlier_set.add(idx)\n            continue\n\n    # Return list of all outlier indices\n    result = sorted(list(outlier_set))\n    return result\n\nif __name__ == '__main__':\n    res = answer()\n    with open('/app/answer.json', 'w') as f:\n        json.dump(res, f)\nPY" action.permission=* action.action=allow action.pattern=*
