timestamp=2026-11-04T16:07:35.353Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\nexec(open('/tmp/build.py').read())\nresults = []\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    stats = group_stats.get(key, {'med': 0, 'mad': 0})\n    med = stats['med']; mad = stats['mad']\n    if mad == 0:\n        rz = 0.0\n    else:\n        rz = 0.6745 * (r['net'] - med) / mad\n    items = r['notes'].get('items')\n    if items is None or items == '':\n        items_eff = 1\n    else:\n        try: items_eff = int(items)\n        except: items_eff = 1\n    if items_eff < 1: items_eff = 1\n    anomaly_score = abs(rz) * math.log1p(items_eff)\n    results.append({\n        'rid': r['rid'],\n        'et': r['et'],\n        'abs_rz': abs(rz),\n        'anomaly_score': anomaly_score,\n    })\n# rank: by anomaly_score desc, then abs(robust_z) desc, then event_time desc, then record_id asc using mergesort\nresults_sorted = sorted(results, key=lambda x: (-x['anomaly_score'], -x['abs_rz'], -x['et'].timestamp() if x['et'] else 0, x['rid']))\nfor i in range(min(10, len(results_sorted))):\n    print(i+1, results_sorted[i]['rid'], results_sorted[i]['anomaly_score'], results_sorted[i]['abs_rz'])\nPY" action.permission=* action.action=allow action.pattern=*
