timestamp=2026-11-04T15:55:03.203Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\nimport re\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str)\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    if 'CR' in s.upper():\n        is_negative = True\n    if '(' in s and ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'[a-zA-Z\\s]', '', s)\n    s = s.replace('(', '').replace(')', '')\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    if len(commas) == 0 and len(dots) == 0:\n        if s == '':\n            return float('nan')\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    if len(commas) == 0 and len(dots) > 0:\n        last_dot = dots[-1]\n        after = len(s) - last_dot - 1\n        if after == 2:  # decimal\n            try:\n                val = float(s)\n                return -val if is_negative else val\n            except:\n                pass\n        s_clean = s.replace('.', '')\n        try:\n            val = float(s_clean) if s_clean else float('nan')\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    if len(dots) == 0 and len(commas) > 0:\n        last_comma = commas[-1]\n        after = len(s) - last_comma - 1\n        if after == 2:\n            s_clean = s.replace(',', '.')\n            try:\n                val = float(s_clean)\n                return -val if is_negative else val\n            except:\n                return float('nan')\n        else:\n            s_clean = s.replace(',', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    # both\n    if commas[-1] > dots[-1]:\n        s_clean = s.replace('.', '')\n        s_clean = s_clean.replace(',', '.')\n    else:\n        s_clean = s.replace(',', '')\n    try:\n        val = float(s_clean) if s_clean else float('nan')\n        return -val if is_negative else val\n    except:\n        return float('nan')\n\n# test\ncases = [\n    \"(1,128)\",\n    \"80,87 C2\",\n    \"(-81.45)\",\n    \"105.16\",\n    \"113 , 61 C2) \",\n    \"C1 245.07\",\n    \"124\",\n    \"97,20 C2\",\n    \"121,43 C2 \",\n    \"C1 118.59 CR\",\n    \"128,31 C2\",\n    \"51\",\n    \"56 \",\n    \"84.64\",\n    \"158,87 C2\",\n    \"C1 294\",\n    \"107.908\",\n    \"163.48 C1\",\n    \"78,59 C2\",\n    \"862.018\",\n    \"C1 1.000\",  # from data\n    \"(105 C2)\",\n    \"808.824\",\n    \" 80 , 14 C2\",\n    \"99,89 C2\",\n]\nfor c in cases:\n    print(c, '->', parse_amount(c))\nPY" action.permission=* action.action=allow action.pattern=*
