timestamp=2026-11-04T15:54:02.060Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/parse.py << 'PY'\nimport csv\nimport re\nfrom datetime import datetime\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str).strip()\n    if s == '':\n        return float('nan')\n    \n    # Check for negative indicators\n    is_negative = False\n    if 'CR' in s.upper():\n        is_negative = True\n    if '(' in s and ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    \n    # Remove tokens C1, C2 (case-insensitive)\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    \n    # Remove letters and spaces, keep only digits, comma, dot\n    s = re.sub(r'[a-zA-Z\\s]', '', s)\n    \n    # Determine decimal separator using last-separator rule\n    # Find all commas and dots\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    \n    if len(commas) == 0 and len(dots) == 0:\n        if s == '':\n            return float('nan')\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    \n    # If only one type of separator exists\n    if len(commas) == 0 and len(dots) > 0:\n        # Only dots - treat as decimal if exactly 2 digits follow last occurrence\n        last_dot = dots[-1]\n        after = len(s) - last_dot - 1\n        if after == 2:\n            # decimal separator\n            try:\n                val = float(s)\n                return -val if is_negative else val\n            except:\n                return float('nan')\n        else:\n            # thousands separator or just dot - remove dots\n            s_clean = s.replace('.', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    elif len(dots) == 0 and len(commas) > 0:\n        last_comma = commas[-1]\n        after = len(s) - last_comma - 1\n        if after == 2:\n            s_clean = s.replace(',', '.')\n            try:\n                val = float(s_clean)\n                return -val if is_negative else val\n            except:\n                return float('nan')\n        else:\n            s_clean = s.replace(',', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    else:\n        # Both exist - last-separator rule: the one that appears later is decimal\n        if commas[-1] > dots[-1]:\n            # comma is last -> comma is decimal\n            s_clean = s.replace('.', '')  # remove thousand dots\n            s_clean = s_clean.replace(',', '.')  # comma to dot\n        else:\n            # dot is last -> dot is decimal\n            s_clean = s.replace(',', '')  # remove thousand commas\n        try:\n            val = float(s_clean) if s_clean else float('nan')\n            return -val if is_negative else val\n        except:\n            return float('nan')\n\nPY" action.permission=* action.action=allow action.pattern=*
