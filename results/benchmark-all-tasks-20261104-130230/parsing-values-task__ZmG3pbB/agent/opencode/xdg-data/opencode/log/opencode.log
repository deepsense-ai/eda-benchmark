timestamp=2026-11-04T16:07:21.221Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\nexec(open('/tmp/build.py').read())\n\n# now compute robust z and scores\nresults = []\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    stats = group_stats.get(key, {'med': 0, 'mad': 0})\n    med = stats['med']\n    mad = stats['mad']\n    if mad == 0:\n        rz = 0.0\n    else:\n        rz = 0.6745 * (r['net'] - med) / mad\n    # items_eff: items if present else 1 (clamped to at least 1)\n    items = r['notes'].get('items')\n    if items is None or items == '':\n        items_eff = 1\n    else:\n        try:\n            items_eff = int(items)\n        except:\n            items_eff = 1\n    if items_eff < 1:\n        items_eff = 1\n    anomaly_score = abs(rz) * math.log1p(items_eff)\n    results.append({\n        'rid': r['rid'],\n        'et': r['et'],\n        'rz': rz,\n        'abs_rz': abs(rz),\n        'items_eff': items_eff,\n        'anomaly_score': anomaly_score,\n    })\nprint(len(results))\nPY" action.permission=* action.action=allow action.pattern=*
