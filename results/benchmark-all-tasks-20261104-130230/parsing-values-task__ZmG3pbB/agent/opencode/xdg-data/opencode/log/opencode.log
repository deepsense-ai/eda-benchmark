timestamp=2026-11-04T15:59:23.819Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\nexec(open('/tmp/amount.py').read())\n# test problematic cases\ntests = [\n    \"(142\",  # from R00231\n    \"124)\",  # R00285\n    \"1,000 C2\",\n    \"1.000,00 C2\",\n    \"C1 1,000.00\",\n    \"808.824\",\n    \"107.908\",\n    \"862.018\",\n    \"113 , 61 C2) \",\n    \"(1,128)\",\n    \"80,87 C2\",\n    \"(-81.45)\",\n    \"C1 1.000\",\n]\nfor t in tests:\n    print(t, '->', parse_amount(t))\nPY" action.permission=* action.action=allow action.pattern=*
