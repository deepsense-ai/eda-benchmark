timestamp=2026-11-04T15:56:33.832Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/parse_notes.py << 'PY'\nimport re\n\ndef parse_notes(notes):\n    result = {\n        'items': None,\n        'adj_pct': 0.0,\n        'fee': 0.0,\n        'waive': False\n    }\n    if not notes or notes.strip() == '':\n        return result\n    \n    s = str(notes)\n    # parse items from items=<int>\n    m = re.search(r'items\\s*=\\s*(-?\\d+)', s, re.IGNORECASE)\n    if m:\n        try:\n            result['items'] = int(m.group(1))\n        except:\n            result['items'] = None\n    # parse adj_pct from adj=<signed number>% \n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.IGNORECASE)\n    if m:\n        try:\n            result['adj_pct'] = float(m.group(1))\n        except:\n            result['adj_pct'] = 0.0\n    # parse fee from fee=<signed number> (can be float)\n    m = re.search(r'fee\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, re.IGNORECASE)\n    if m:\n        try:\n            result['fee'] = float(m.group(1))\n        except:\n            result['fee'] = 0.0\n    # waive from waive=true (case-insensitive)\n    m = re.search(r'waive\\s*=\\s*(true|false)', s, re.IGNORECASE)\n    if m:\n        val = m.group(1).lower()\n        result['waive'] = (val == 'true')\n    else:\n        result['waive'] = False\n    return result\n\nPY" action.permission=* action.action=allow action.pattern=*
