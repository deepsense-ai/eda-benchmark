timestamp=2026-11-04T16:03:48.780Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/parse_dt.py << 'PY'\nfrom datetime import datetime\n\ndef parse_event_time(s):\n    if not s or s.strip() == '':\n        return None\n    s = s.strip()\n    # Try multiple formats\n    fmts = [\n        '%Y-%m-%dT%H:%M:%SZ',\n        '%Y-%m-%dT%H:%M:%S.%fZ',\n        '%Y-%m-%dT%H:%M:%S',\n        '%Y-%m-%dT%H:%M:%S.%f',\n        '%Y-%m-%d %H:%M:%S',\n        '%Y-%m-%d %H:%M:%S.%f',\n    ]\n    for fmt in fmts:\n        try:\n            dt = datetime.strptime(s, fmt)\n            return dt\n        except:\n            continue\n    try:\n        if s.endswith('Z'):\n            s = s[:-1]\n        dt = datetime.fromisoformat(s)\n        return dt\n    except:\n        return None\nPY" action.permission=* action.action=allow action.pattern=*
