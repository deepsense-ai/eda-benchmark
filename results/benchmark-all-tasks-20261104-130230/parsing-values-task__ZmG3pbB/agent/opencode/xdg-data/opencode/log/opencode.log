timestamp=2026-11-04T16:10:31.464Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/process_fix.py << 'PY'\nimport re\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str).strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    su = s.upper()\n    if 'CR' in su:\n        is_negative = True\n    if '(' in s or ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'[A-Za-z\\s]', '', s)\n    s = s.replace('(', '').replace(')', '')\n    # remove explicit minus sign\n    s = s.replace('-', '')\n    if s == '':\n        return float('nan')\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    if len(commas) == 0 and len(dots) == 0:\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    if len(commas) > 0 and len(dots) == 0:\n        last = commas[-1]; after = len(s) - last - 1\n        if after == 2:\n            s_clean = s.replace(',', '.')\n        else:\n            s_clean = s.replace(',', '')\n        try:\n            return -float(s_clean) if is_negative else float(s_clean)\n        except:\n            return float('nan')\n    if len(dots) > 0 and len(commas) == 0:\n        last = dots[-1]; after = len(s) - last - 1\n        if after == 2:\n            s_clean = s\n        else:\n            s_clean = s.replace('.', '')\n        try:\n            return -float(s_clean) if is_negative else float(s_clean)\n        except:\n            return float('nan')\n    if commas[-1] > dots[-1]:\n        s_clean = s.replace('.', '')\n        s_clean = s_clean.replace(',', '.')\n    else:\n        s_clean = s.replace(',', '')\n    try:\n        return -float(s_clean) if is_negative else float(s_clean)\n    except:\n        return float('nan')\nPY" action.permission=* action.action=allow action.pattern=*
