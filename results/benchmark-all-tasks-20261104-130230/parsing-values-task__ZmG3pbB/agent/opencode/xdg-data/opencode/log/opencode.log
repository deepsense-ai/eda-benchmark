timestamp=2026-11-04T15:59:20.032Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/amount.py << 'PY'\nimport re\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str)\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    su = s.upper()\n    if 'CR' in su:\n        is_negative = True\n    if '(' in s or ')' in s:  # presence of parens\n        is_negative = True\n    if '-' in s:  # contains minus sign\n        is_negative = True\n    # Remove tokens C1 and C2\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    # Strip out all letters and spaces, keeping only digits, comma, dot\n    s = re.sub(r'[A-Za-z\\s]', '', s)\n    # Also remove parentheses chars\n    s = s.replace('(', '').replace(')', '')\n    if s == '':\n        return float('nan')\n    # Find separators\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    if len(commas) == 0 and len(dots) == 0:\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    # Determine decimal separator using last-separator rule\n    if len(commas) > 0 and len(dots) == 0:\n        # only comma\n        last = commas[-1]\n        after = len(s) - last - 1\n        if after == 2:\n            # comma is decimal\n            s_clean = s.replace(',', '.')\n            try:\n                return -float(s_clean) if is_negative else float(s_clean)\n            except:\n                return float('nan')\n        else:\n            s_clean = s.replace(',', '')\n            try:\n                return -float(s_clean) if is_negative else float(s_clean)\n            except:\n                return float('nan')\n    if len(dots) > 0 and len(commas) == 0:\n        last = dots[-1]\n        after = len(s) - last - 1\n        if after == 2:\n            try:\n                return -float(s) if is_negative else float(s)\n            except:\n                s_clean = s.replace('.', '')\n                try:\n                    return -float(s_clean) if is_negative else float(s_clean)\n                except:\n                    return float('nan')\n        else:\n            s_clean = s.replace('.', '')\n            try:\n                return -float(s_clean) if is_negative else float(s_clean)\n            except:\n                return float('nan')\n    # both exist\n    if commas[-1] > dots[-1]:\n        # comma is last -> decimal separator\n        s_clean = s.replace('.', '')\n        s_clean = s_clean.replace(',', '.')\n    else:\n        # dot is last -> decimal\n        s_clean = s.replace(',', '')\n    try:\n        return -float(s_clean) if is_negative else float(s_clean)\n    except:\n        return float('nan')\nPY" action.permission=* action.action=allow action.pattern=*
