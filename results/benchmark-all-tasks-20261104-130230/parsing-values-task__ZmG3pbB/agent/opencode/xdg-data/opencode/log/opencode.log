timestamp=2026-11-04T15:56:00.351Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/parse_amount2.py << 'PY'\nimport re\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str)\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    if 'CR' in s.upper():\n        is_negative = True\n    if '(' in s and ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'[a-zA-Z\\s]', '', s)\n    s = s.replace('(', '').replace(')', '')\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    if len(commas) == 0 and len(dots) == 0:\n        if s == '':\n            return float('nan')\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    # Check last-separator rule\n    if len(commas) > 0 and len(dots) > 0:\n        if commas[-1] > dots[-1]:\n            # comma is last -> decimal\n            s_clean = s.replace('.', '')\n            s_clean = s_clean.replace(',', '.')\n        else:\n            # dot is last -> decimal\n            s_clean = s.replace(',', '')\n        try:\n            val = float(s_clean) if s_clean else float('nan')\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    # Only one type exists\n    if len(commas) > 0 and len(dots) == 0:\n        last_comma = commas[-1]\n        after = len(s) - last_comma - 1\n        if after == 2:\n            # treat as decimal\n            s_clean = s.replace(',', '.')\n            try:\n                val = float(s_clean)\n                return -val if is_negative else val\n            except:\n                return float('nan')\n        else:\n            s_clean = s.replace(',', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    if len(dots) > 0 and len(commas) == 0:\n        last_dot = dots[-1]\n        after = len(s) - last_dot - 1\n        if after == 2:\n            try:\n                val = float(s)\n                return -val if is_negative else val\n            except:\n                s_clean = s.replace('.', '')\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n        else:\n            s_clean = s.replace('.', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    return float('nan') if s == '' else float(s) * (-1 if is_negative else 1)\nPY" action.permission=* action.action=allow action.pattern=*
