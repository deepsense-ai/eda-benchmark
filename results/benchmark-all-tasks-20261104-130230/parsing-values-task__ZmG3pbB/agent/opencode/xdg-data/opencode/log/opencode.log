timestamp=2026-11-04T16:12:17.212Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\nexec(open('/tmp/process_final.py').read())\nexec(open('/tmp/dedup.py').read())\nimport csv\nimport math\nimport statistics\nfrom collections import defaultdict\nfrom datetime import datetime\n\nrows = []\nwith open('/app/dataset/data.csv') as f:\n    reader = csv.DictReader(f)\n    for idx, row in enumerate(reader):\n        rid = row['record_id']\n        et = parse_event_time(row['event_time'])\n        region = row['region']\n        channel = row['channel']\n        amount = parse_amount(row['amount_str'])\n        notes = parse_notes(row['notes'])\n        if math.isnan(amount):\n            net = float('nan')\n        else:\n            if notes['waive']: net = 0.0\n            else: net = amount * (1.0 + notes['adj_pct']) + notes['fee']\n        rows.append({'rid': rid, 'et': et, 'region': region, 'channel': channel, 'net': net, 'notes': notes, 'file_order': idx})\n\nby_rid = defaultdict(list)\nfor r in rows: by_rid[r['rid']].append(r)\ndeduped = []\nfor lst in by_rid.values(): deduped.append(choose_best(lst))\n\nstart = datetime(2025, 10, 1, 0, 0, 0); end = datetime(2025, 12, 31, 23, 59, 59)\nfiltered = []\nfor r in deduped:\n    if r['et'] is None: continue\n    if r['et'] < start or r['et'] > end: continue\n    ch = r['channel']\n    if ch and ch.strip().lower() == 'phone': continue\n    if math.isnan(r['net']) or math.isinf(r['net']): continue\n    filtered.append(r)\n\ngroups = defaultdict(list)\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    groups[key].append(r['net'])\ngroup_stats = {}\nfor key, values in groups.items():\n    med = statistics.median(values)\n    abs_dev = [abs(v - med) for v in values]\n    mad = statistics.median(abs_dev)\n    group_stats[key] = {'med': med, 'mad': mad}\n\nresults = []\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    stats = group_stats.get(key, {'med': 0, 'mad': 0})\n    med = stats['med']; mad = stats['mad']\n    if mad == 0: rz = 0.0\n    else: rz = 0.6745 * (r['net'] - med) / mad\n    items = r['notes'].get('items')\n    if items is None or items == '': items_eff = 1\n    else:\n        try: items_eff = int(items)\n        except: items_eff = 1\n    if items_eff < 1: items_eff = 1\n    anomaly_score = abs(rz) * math.log1p(items_eff)\n    results.append({'rid': r['rid'], 'et': r['et'], 'abs_rz': abs(rz), 'anomaly_score': anomaly_score})\n\nresults_sorted = sorted(results, key=lambda x: (-x['anomaly_score'], -x['abs_rz'], -x['et'].timestamp() if x['et'] else 0, x['rid']))\ntop10 = [results_sorted[i]['rid'] for i in range(min(10, len(results_sorted)))]\nprint(top10)\nPY" action.permission=* action.action=allow action.pattern=*
