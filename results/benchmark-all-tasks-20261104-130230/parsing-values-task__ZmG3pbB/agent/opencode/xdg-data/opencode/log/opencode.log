timestamp=2026-11-04T16:06:08.721Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\nexec(open('/tmp/process_full.py').read())\nexec(open('/tmp/dedup.py').read())\nimport csv\nimport math\nfrom collections import defaultdict\nfrom datetime import datetime\n\nrows = []\nwith open('/app/dataset/data.csv') as f:\n    reader = csv.DictReader(f)\n    for idx, row in enumerate(reader):\n        rid = row['record_id']\n        et = parse_event_time(row['event_time'])\n        region = row['region']\n        channel = row['channel']\n        amount = parse_amount(row['amount_str'])\n        notes = parse_notes(row['notes'])\n        if math.isnan(amount):\n            net = float('nan')\n        else:\n            if notes['waive']:\n                net = 0.0\n            else:\n                net = amount * (1.0 + notes['adj_pct']) + notes['fee']\n        rows.append({\n            'rid': rid,\n            'et': et,\n            'region': region,\n            'channel': channel,\n            'net': net,\n            'notes': notes,\n            'file_order': idx,\n        })\n\nby_rid = defaultdict(list)\nfor r in rows:\n    by_rid[r['rid']].append(r)\ndeduped = []\nfor rid, lst in by_rid.items():\n    best = choose_best(lst)\n    deduped.append(best)\n\nstart = datetime(2025, 10, 1, 0, 0, 0)\nend = datetime(2025, 12, 31, 23, 59, 59)\n\nfiltered = []\nfor r in deduped:\n    if r['et'] is None:\n        continue\n    if r['et'] < start or r['et'] > end:\n        continue\n    # channel != \"phone\" (case-insensitive)\n    if r['channel'] and r['channel'].strip().lower() == 'phone':\n        continue\n    # finite net\n    if math.isnan(r['net']) or math.isinf(r['net']):\n        continue\n    filtered.append(r)\n\nprint(len(filtered))\nPY" action.permission=* action.action=allow action.pattern=*
