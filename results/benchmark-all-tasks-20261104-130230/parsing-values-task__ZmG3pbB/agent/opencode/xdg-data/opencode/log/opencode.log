timestamp=2026-11-04T16:11:40.460Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/process_final.py << 'PY'\nimport re\nfrom datetime import datetime\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str).strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    su = s.upper()\n    if 'CR' in su:\n        is_negative = True\n    if '(' in s or ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'[A-Za-z\\s]', '', s)\n    s = s.replace('(', '').replace(')', '')\n    s = s.replace('-', '')\n    if s == '':\n        return float('nan')\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    if len(commas) == 0 and len(dots) == 0:\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    if len(commas) > 0 and len(dots) == 0:\n        last = commas[-1]; after = len(s) - last - 1\n        if after == 2:\n            s_clean = s.replace(',', '.')\n        else:\n            s_clean = s.replace(',', '')\n        try:\n            return -float(s_clean) if is_negative else float(s_clean)\n        except:\n            return float('nan')\n    if len(dots) > 0 and len(commas) == 0:\n        last = dots[-1]; after = len(s) - last - 1\n        if after == 2:\n            s_clean = s\n        else:\n            s_clean = s.replace('.', '')\n        try:\n            return -float(s_clean) if is_negative else float(s_clean)\n        except:\n            return float('nan')\n    if commas[-1] > dots[-1]:\n        s_clean = s.replace('.', '')\n        s_clean = s_clean.replace(',', '.')\n    else:\n        s_clean = s.replace(',', '')\n    try:\n        return -float(s_clean) if is_negative else float(s_clean)\n    except:\n        return float('nan')\n\ndef parse_notes(notes):\n    res = {'items': None, 'adj_pct': 0.0, 'fee': 0.0, 'waive': False}\n    if not notes: return res\n    s = str(notes)\n    m = re.search(r'items\\s*=\\s*(-?\\d+)', s, re.IGNORECASE)\n    if m:\n        try: res['items'] = int(m.group(1))\n        except: res['items'] = None\n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.IGNORECASE)\n    if m:\n        try: res['adj_pct'] = float(m.group(1)) / 100.0\n        except: res['adj_pct'] = 0.0\n    else:\n        res['adj_pct'] = 0.0\n    m = re.search(r'fee\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, re.IGNORECASE)\n    if m:\n        try: res['fee'] = float(m.group(1))\n        except: res['fee'] = 0.0\n    m = re.search(r'waive\\s*=\\s*(true|false)', s, re.IGNORECASE)\n    if m:\n        res['waive'] = (m.group(1).lower() == 'true')\n    else:\n        res['waive'] = False\n    return res\n\ndef parse_event_time(s):\n    if not s or s.strip() == '':\n        return None\n    s = s.strip()\n    fmts = [\n        '%Y-%m-%dT%H:%M:%SZ',\n        '%Y-%m-%dT%H:%M:%S.%fZ',\n        '%Y-%m-%dT%H:%M:%S',\n        '%Y-%m-%dT%H:%M:%S.%f',\n        '%Y-%m-%d %H:%M:%S',\n        '%Y-%m-%d %H:%M:%S.%f',\n    ]\n    for fmt in fmts:\n        try:\n            return datetime.strptime(s, fmt)\n        except:\n            continue\n    try:\n        if s.endswith('Z'): s = s[:-1]\n        return datetime.fromisoformat(s)\n    except:\n        return None\nPY" action.permission=* action.action=allow action.pattern=*
