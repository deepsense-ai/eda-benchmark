timestamp=2026-11-04T16:07:15.691Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/build.py << 'PY'\nexec(open('/tmp/process_full.py').read())\nexec(open('/tmp/dedup.py').read())\nimport csv\nimport math\nimport statistics\nfrom collections import defaultdict\nfrom datetime import datetime\n\nrows = []\nwith open('/app/dataset/data.csv') as f:\n    reader = csv.DictReader(f)\n    for idx, row in enumerate(reader):\n        rid = row['record_id']\n        et = parse_event_time(row['event_time'])\n        region = row['region']\n        channel = row['channel']\n        amount = parse_amount(row['amount_str'])\n        notes = parse_notes(row['notes'])\n        if math.isnan(amount):\n            net = float('nan')\n        else:\n            if notes['waive']:\n                net = 0.0\n            else:\n                net = amount * (1.0 + notes['adj_pct']) + notes['fee']\n        rows.append({\n            'rid': rid,\n            'et': et,\n            'region': region,\n            'channel': channel,\n            'net': net,\n            'notes': notes,\n            'file_order': idx,\n        })\n\nby_rid = defaultdict(list)\nfor r in rows: by_rid[r['rid']].append(r)\ndeduped = []\nfor lst in by_rid.values():\n    deduped.append(choose_best(lst))\n\nstart = datetime(2025, 10, 1, 0, 0, 0)\nend = datetime(2025, 12, 31, 23, 59, 59)\nfiltered = []\nfor r in deduped:\n    if r['et'] is None: continue\n    if r['et'] < start or r['et'] > end: continue\n    ch = r['channel']\n    if ch and ch.strip().lower() == 'phone': continue\n    if math.isnan(r['net']) or math.isinf(r['net']): continue\n    filtered.append(r)\n\n# group\ngroups = defaultdict(list)\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    groups[key].append(r['net'])\n\n# compute stats per group\ngroup_stats = {}\nfor key, values in groups.items():\n    if len(values) == 0:\n        group_stats[key] = {'med': 0, 'mad': 0}\n        continue\n    med = statistics.median(values)\n    abs_dev = [abs(v - med) for v in values]\n    mad = statistics.median(abs_dev)\n    group_stats[key] = {'med': med, 'mad': mad}\nPY" action.permission=* action.action=allow action.pattern=*
