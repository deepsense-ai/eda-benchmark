timestamp=2026-11-04T15:54:28.797Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/parse_amount.py << 'PY'\nimport re\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str).strip()\n    if s == '':\n        return float('nan')\n    \n    is_negative = False\n    s_upper = s.upper()\n    if 'CR' in s_upper:\n        is_negative = True\n    if '(' in s and ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    \n    # Remove tokens C1, C2 (case-insensitive)\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    \n    # Remove letters and spaces\n    s = re.sub(r'[a-zA-Z\\s]', '', s)\n    \n    # Also remove parentheses if they exist\n    s = s.replace('(', '').replace(')', '')\n    \n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    \n    if len(commas) == 0 and len(dots) == 0:\n        if s == '':\n            return float('nan')\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    \n    if len(commas) == 0 and len(dots) > 0:\n        last_dot = dots[-1]\n        after = len(s) - last_dot - 1\n        if after == 2 and len(dots) <= 1:  # typically decimal has 2 digits and appears once in decimals < 1000? Or just check count - rule says \"exactly two digits follow its last occurrence\"\n            try:\n                val = float(s)\n                return -val if is_negative else val\n            except:\n                # fallback\n                s_clean = s.replace('.', '')\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n        else:\n            # maybe thousands separators (e.g., 1.000 in some locales?) or multiple dots? Or just treat as decimal if exactly 2 digits follow last - but what if multiple dots?\n            if after == 2:\n                try:\n                    val = float(s)\n                    return -val if is_negative else val\n                except:\n                    pass\n            s_clean = s.replace('.', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    elif len(dots) == 0 and len(commas) > 0:\n        last_comma = commas[-1]\n        after = len(s) - last_comma - 1\n        if after == 2:\n            s_clean = s.replace(',', '.')\n            try:\n                val = float(s_clean)\n                return -val if is_negative else val\n            except:\n                return float('nan')\n        else:\n            s_clean = s.replace(',', '')\n            try:\n                val = float(s_clean) if s_clean else float('nan')\n                return -val if is_negative else val\n            except:\n                return float('nan')\n    else:\n        # both exist\n        if commas[-1] > dots[-1]:\n            s_clean = s.replace('.', '')\n            s_clean = s_clean.replace(',', '.')\n        else:\n            s_clean = s.replace(',', '')\n        try:\n            val = float(s_clean) if s_clean else float('nan')\n            return -val if is_negative else val\n        except:\n            return float('nan')\nPY" action.permission=* action.action=allow action.pattern=*
