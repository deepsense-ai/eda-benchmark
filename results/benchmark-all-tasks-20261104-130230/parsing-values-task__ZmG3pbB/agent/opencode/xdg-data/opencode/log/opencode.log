timestamp=2026-11-04T16:00:59.978Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="cat > /tmp/process.py << 'PY'\nimport csv\nimport re\nfrom datetime import datetime\nimport math\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str)\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    su = s.upper()\n    if 'CR' in su:\n        is_negative = True\n    if '(' in s or ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    s = re.sub(r'C1', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'C2', '', s, flags=re.IGNORECASE)\n    s = re.sub(r'[A-Za-z\\s]', '', s)\n    s = s.replace('(', '').replace(')', '')\n    if s == '':\n        return float('nan')\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    if len(commas) == 0 and len(dots) == 0:\n        try:\n            val = float(s)\n            return -val if is_negative else val\n        except:\n            return float('nan')\n    if len(commas) > 0 and len(dots) == 0:\n        last = commas[-1]\n        after = len(s) - last - 1\n        if after == 2:\n            s_clean = s.replace(',', '.')\n            try:\n                return -float(s_clean) if is_negative else float(s_clean)\n            except:\n                return float('nan')\n        else:\n            s_clean = s.replace(',', '')\n            try:\n                return -float(s_clean) if is_negative else float(s_clean)\n            except:\n                return float('nan')\n    if len(dots) > 0 and len(commas) == 0:\n        last = dots[-1]\n        after = len(s) - last - 1\n        if after == 2:\n            try:\n                return -float(s) if is_negative else float(s)\n            except:\n                s_clean = s.replace('.', '')\n                try:\n                    return -float(s_clean) if is_negative else float(s_clean)\n                except:\n                    return float('nan')\n        else:\n            s_clean = s.replace('.', '')\n            try:\n                return -float(s_clean) if is_negative else float(s_clean)\n            except:\n                return float('nan')\n    # both\n    if commas[-1] > dots[-1]:\n        s_clean = s.replace('.', '')\n        s_clean = s_clean.replace(',', '.')\n    else:\n        s_clean = s.replace(',', '')\n    try:\n        return -float(s_clean) if is_negative else float(s_clean)\n    except:\n        return float('nan')\n\ndef parse_notes(notes):\n    result = {'items': None, 'adj_pct': 0.0, 'fee': 0.0, 'waive': False}\n    if not notes:\n        return result\n    s = str(notes)\n    m = re.search(r'items\\s*=\\s*(-?\\d+)', s, re.IGNORECASE)\n    if m:\n        try:\n            result['items'] = int(m.group(1))\n        except:\n            result['items'] = None\n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.IGNORECASE)\n    if m:\n        try:\n            result['adj_pct'] = float(m.group(1)) / 100.0 if m else 0.0  # wait - adj_pct is the percentage value? e.g., -5.62% means adj_pct is -5.62? Then in net = base_amount * (1 + adj_pct) + fee, so if adj_pct is -5.62, that's -0.0562? Or is adj_pct stored as -5.62 (percentage)? The task says \"adj_pct from adj=<signed number>% (missing -> 0)\". Then later \"compute net = base_amount * (1 + adj_pct) + fee\" - so adj_pct is likely a fraction (e.g., -0.0562). But the parsed number is -5.62 from the string. That means we need to divide by 100.\n        except:\n            pass\n    # better handle\n    if m:\n        try:\n            result['adj_pct'] = float(m.group(1)) / 100.0\n        except:\n            result['adj_pct'] = 0.0\n    else:\n        result['adj_pct'] = 0.0\n    m = re.search(r'fee\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, re.IGNORECASE)\n    if m:\n        try:\n            result['fee'] = float(m.group(1))\n        except:\n            result['fee'] = 0.0\n    m = re.search(r'waive\\s*=\\s*(true|false)', s, re.IGNORECASE)\n    if m:\n        result['waive'] = (m.group(1).lower() == 'true')\n    else:\n        result['waive'] = False\n    return result\nPY" action.permission=* action.action=allow action.pattern=*
