timestamp=2026-11-04T16:11:51.737Z level=INFO run=e9a56b16 message=evaluated permission=bash pattern="python3 << 'PY'\n# Recompute everything with the fixed parser\nexec(open('/tmp/process_final.py').read())\nexec(open('/tmp/dedup.py').read())\nimport csv\nimport math\nimport statistics\nfrom collections import defaultdict\nfrom datetime import datetime\n\nrows = []\nwith open('/app/dataset/data.csv') as f:\n    reader = csv.DictReader(f)\n    for idx, row in enumerate(reader):\n        rid = row['record_id']\n        et = parse_event_time(row['event_time'])\n        region = row['region']\n        channel = row['channel']\n        amount = parse_amount(row['amount_str'])\n        notes = parse_notes(row['notes'])\n        if math.isnan(amount):\n            net = float('nan')\n        else:\n            if notes['waive']:\n                net = 0.0\n            else:\n                net = amount * (1.0 + notes['adj_pct']) + notes['fee']\n        rows.append({\n            'rid': rid,\n            'et': et,\n            'region': region,\n            'channel': channel,\n            'net': net,\n            'notes': notes,\n            'file_order': idx,\n        })\n\nby_rid = defaultdict(list)\nfor r in rows: by_rid[r['rid']].append(r)\ndeduped = []\nfor lst in by_rid.values():\n    deduped.append(choose_best(lst))\n\nstart = datetime(2025, 10, 1, 0, 0, 0)\nend = datetime(2025, 12, 31, 23, 59, 59)\nfiltered = []\nfor r in deduped:\n    if r['et'] is None: continue\n    if r['et'] < start or r['et'] > end: continue\n    ch = r['channel']\n    if ch and ch.strip().lower() == 'phone': continue\n    if math.isnan(r['net']) or math.isinf(r['net']): continue\n    filtered.append(r)\n\n# groups\ngroups = defaultdict(list)\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    groups[key].append(r['net'])\ngroup_stats = {}\nfor key, values in groups.items():\n    med = statistics.median(values)\n    abs_dev = [abs(v - med) for v in values]\n    mad = statistics.median(abs_dev)\n    group_stats[key] = {'med': med, 'mad': mad}\n\nresults = []\nfor r in filtered:\n    month = r['et'].strftime('%Y-%m')\n    key = (r['region'], month)\n    stats = group_stats.get(key, {'med': 0, 'mad': 0})\n    med = stats['med']; mad = stats['mad']\n    if mad == 0:\n        rz = 0.0\n    else:\n        rz = 0.6745 * (r['net'] - med) / mad\n    items = r['notes'].get('items')\n    if items is None or items == '':\n        items_eff = 1\n    else:\n        try: items_eff = int(items)\n        except: items_eff = 1\n    if items_eff < 1: items_eff = 1\n    anomaly_score = abs(rz) * math.log1p(items_eff)\n    results.append({\n        'rid': r['rid'],\n        'et': r['et'],\n        'abs_rz': abs(rz),\n        'anomaly_score': anomaly_score,\n    })\n\nresults_sorted = sorted(results, key=lambda x: (-x['anomaly_score'], -x['abs_rz'], -x['et'].timestamp() if x['et'] else 0, x['rid']))\nfor i in range(min(10, len(results_sorted))):\n    print(i+1, results_sorted[i]['rid'], results_sorted[i]['anomaly_score'], results_sorted[i]['abs_rz'])\nPY" action.permission=* action.action=allow action.pattern=*
