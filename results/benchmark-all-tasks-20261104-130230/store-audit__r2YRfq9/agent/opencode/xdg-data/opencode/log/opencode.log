timestamp=2026-11-04T16:13:46.089Z level=INFO run=4cbc268f message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom collections import defaultdict\n\ndef parse_temp(s):\n    s = s.strip()\n    if ',' in s: s = s.replace(',', '.')\n    return float(s)\ndef norm_zone(z):\n    z = z.strip().lower()\n    if z == 'frozen': return 'Frozen'\n    if z == 'meat': return 'Meat'\n    if z == 'dairy': return 'Dairy'\n    if z == 'dry': return 'Dry'\n    return z.capitalize()\n\n# Map zone -> max safe\nzone_max = {\n    'Frozen': -10.0,\n    'Meat': 4.0,\n    'Dairy': 6.0,\n    'Dry': 35.0,\n}\n\n# find violations: any reading above max_safe_temp_c? \"above\" meaning temp > max_safe?\nviol = defaultdict(int)\ntotal = defaultdict(int)\nwith open('/app/dataset/temperature_logs.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        nz = norm_zone(row['zone'])\n        t = parse_temp(row['temperature_c'])\n        total[nz] += 1\n        if nz in zone_max:\n            if t > zone_max[nz]:\n                viol[nz] += 1\n        else:\n            pass\n\nfor k in zone_max:\n    print(k, 'violations=', viol[k], 'of', total[k])\nPY" action.permission=* action.action=allow action.pattern=*
