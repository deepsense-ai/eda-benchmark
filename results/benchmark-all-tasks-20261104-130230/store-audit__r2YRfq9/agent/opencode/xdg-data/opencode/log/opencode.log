timestamp=2026-11-04T16:13:34.928Z level=INFO run=4cbc268f message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom collections import defaultdict\n\ndef parse_temp(s):\n    s = s.strip()\n    if ',' in s:\n        s = s.replace(',', '.')\n    return float(s)\n\ndef norm_zone(z):\n    z = z.strip().lower()\n    if z == 'frozen': return 'Frozen'\n    if z == 'meat': return 'Meat'\n    if z == 'dairy': return 'Dairy'\n    if z == 'dry': return 'Dry'\n    return z.capitalize()\n\n# check ranges per zone\ntemps_by_zone = defaultdict(list)\nwith open('/app/dataset/temperature_logs.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        nz = norm_zone(row['zone'])\n        t = parse_temp(row['temperature_c'])\n        temps_by_zone[nz].append(t)\n\nfor k, v in temps_by_zone.items():\n    v_sorted = sorted(v)\n    print(k, 'count=', len(v), 'min=', min(v), 'max=', max(v), 'median~=', v_sorted[len(v_sorted)//2])\nPY" action.permission=* action.action=allow action.pattern=*
