timestamp=2026-11-04T16:13:40.558Z level=INFO run=4cbc268f message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom collections import defaultdict\n\ndef parse_temp(s):\n    s = s.strip()\n    if ',' in s: s = s.replace(',', '.')\n    return float(s)\ndef norm_zone(z):\n    z = z.strip().lower()\n    if z == 'frozen': return 'Frozen'\n    if z == 'meat': return 'Meat'\n    if z == 'dairy': return 'Dairy'\n    if z == 'dry': return 'Dry'\n    return z.capitalize()\n\n# count how many readings are above max_safe for each category\ncatalog = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        cat = row['storage_category']\n        try:\n            maxs = float(row['max_safe_temp_c'])\n        except:\n            maxs = None\n        # store per product? maybe multiple, but same cat has same max? check\n        pid = row['product_id']\n        catalog[pid] = {\n            'cat': cat,\n            'maxs': maxs,\n            'price': float(row['unit_price'].replace(',', '.')),\n        }\n\n# see maxs per category\nby_cat_max = defaultdict(set)\nfor pid, info in catalog.items():\n    by_cat_max[info['cat']].add(info['maxs'])\nfor k,v in by_cat_max.items():\n    print(k, v)\nPY" action.permission=* action.action=allow action.pattern=*
