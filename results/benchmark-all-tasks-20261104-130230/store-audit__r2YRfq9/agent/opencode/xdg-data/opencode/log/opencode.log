timestamp=2026-11-04T16:13:30.113Z level=INFO run=4cbc268f message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom collections import defaultdict\n\n# Normalize\ndef parse_temp(s):\n    s = s.strip()\n    if ',' in s and '.' not in s:\n        s = s.replace(',', '.')\n    return float(s)\n\ndef norm_zone(z):\n    z = z.strip().lower()\n    # frozen, meat, dairy, dry\n    if z == 'frozen':\n        return 'Frozen'\n    if z == 'meat':\n        return 'Meat'\n    if z == 'dairy':\n        return 'Dairy'\n    if z == 'dry':\n        return 'Dry'\n    # try to map\n    return z.capitalize()\nPY" action.permission=* action.action=allow action.pattern=*
