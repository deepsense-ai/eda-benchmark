timestamp=2026-11-04T15:48:00.985Z level=INFO run=7dbbc1d1 message=evaluated permission=bash pattern="cat > /tmp/build_records.py << 'PY'\nimport pandas as pd\nimport ast\nfrom datetime import datetime\n\nemployees = pd.read_csv('/app/dataset/employees.csv')\ntimesheet = pd.read_csv('/app/dataset/timesheet.csv')\ntasks = pd.read_csv('/app/dataset/tasks.csv')\n\ntask_lookup = {int(t['task_id']): t for _, t in tasks.iterrows()}\nemp_map = {\n  62020111425: 65020111422,\n  68011910138: 68011810139,\n  16102016795: 96102016751,\n  84731091580: 87031491580,\n  15720759071: 75020759171,\n}\nemp_rates = {int(e['PESEL']): float(e['hourly_rate']) for _, e in employees.iterrows()}\n\ndef parse_date(d):\n    if pd.isna(d):\n        return None\n    try:\n        return datetime.strptime(str(d), '%Y-%m-%d').date()\n    except:\n        return None\n\nrecords = []\nfor _, row in timesheet.iterrows():\n    dt = parse_date(row['date'])\n    if not dt:\n        continue\n    emp_id = int(row['employee_id']) if pd.notna(row['employee_id']) else None\n    if emp_id in emp_map:\n        emp_id = emp_map[emp_id]\n    if emp_id not in emp_rates:\n        continue\n    try:\n        pt = ast.literal_eval(row['performed_tasks']) if isinstance(row['performed_tasks'], str) else row['performed_tasks']\n    except:\n        pt = []\n    if pt is None: pt = []\n    valid_tasks = []\n    for tid in pt:\n        try:\n            tid = int(tid)\n        except:\n            continue\n        if tid in task_lookup:\n            valid_tasks.append(tid)\n    bonus = sum(task_lookup[tid]['pay_per_completion'] for tid in valid_tasks)\n    hours = float(row['hours_worked']) if pd.notna(row['hours_worked']) else 0.0\n    rate = emp_rates[emp_id]\n    total = hours * rate + bonus\n    records.append((emp_id, dt, total))\nPY" action.permission=* action.action=allow action.pattern=*
