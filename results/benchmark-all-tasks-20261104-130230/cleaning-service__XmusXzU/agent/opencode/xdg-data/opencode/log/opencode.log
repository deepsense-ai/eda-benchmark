timestamp=2026-11-04T15:33:33.141Z level=INFO run=7dbbc1d1 message=evaluated permission=bash pattern="python3 << 'PY'\n# Look at the actual bad rows to understand what to fix\nimport pandas as pd\nimport ast\n\nemployees = pd.read_csv('/app/dataset/employees.csv')\ntimesheet = pd.read_csv('/app/dataset/timesheet.csv')\ntasks = pd.read_csv('/app/dataset/tasks.csv')\ntask_lookup = {t['task_id']: t for _, t in tasks.iterrows()}\n\ncount = 0\nfor i, row in timesheet.iterrows():\n    if count >= 20:\n        break\n    emp_id = row['employee_id']\n    issues = []\n    if emp_id not in employees['PESEL'].values:\n        issues.append('bad_emp')\n    try:\n        pt = ast.literal_eval(row['performed_tasks']) if isinstance(row['performed_tasks'], str) else row['performed_tasks']\n    except:\n        issues.append('bad_parse')\n        pt = []\n    if 'bad_emp' in issues or 'bad_parse' in issues:\n        print(i, issues, emp_id)\n        count += 1\n        continue\n    if pt is None: pt = []\n    for tid in pt:\n        if tid not in task_lookup:\n            issues.append(f'bad_tid_{tid}')\n            break\n    bonus_calc = sum(task_lookup.get(tid, {}).get('pay_per_completion', 0) for tid in pt)\n    if abs(bonus_calc - row['bonus']) > 1e-6:\n        issues.append(f'bonus_mismatch({bonus_calc}!= {row[\"bonus\"]})')\n    if issues:\n        print(i, issues, emp_id, pt)\n        count += 1\nPY" action.permission=* action.action=allow action.pattern=*
