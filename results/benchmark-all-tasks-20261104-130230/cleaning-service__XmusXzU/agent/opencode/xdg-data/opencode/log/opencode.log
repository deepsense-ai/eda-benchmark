timestamp=2026-11-04T15:41:31.253Z level=INFO run=7dbbc1d1 message=evaluated permission=bash pattern="python3 << 'PY'\n# Look at all bonus mismatches\nimport pandas as pd\nimport ast\n\nemployees = pd.read_csv('/app/dataset/employees.csv')\ntimesheet = pd.read_csv('/app/dataset/timesheet.csv')\ntasks = pd.read_csv('/app/dataset/tasks.csv')\ntask_lookup = {t['task_id']: t for _, t in tasks.iterrows()}\n\nfor i, row in timesheet.iterrows():\n    emp_id = row['employee_id']\n    if emp_id not in employees['PESEL'].values:\n        continue\n    try:\n        pt = ast.literal_eval(row['performed_tasks']) if isinstance(row['performed_tasks'], str) else row['performed_tasks']\n    except:\n        continue\n    if pt is None: pt = []\n    # find invalid tasks\n    valid_tasks = [tid for tid in pt if tid in task_lookup]\n    invalid = [tid for tid in pt if tid not in task_lookup]\n    bonus_calc_valid = sum(task_lookup[tid]['pay_per_completion'] for tid in valid_tasks)\n    if invalid or abs(bonus_calc_valid - row['bonus']) > 1e-6:\n        print(f\"{i}: pt={pt}, invalid={invalid}, bonus_row={row['bonus']}, bonus_valid={bonus_calc_valid}\")\nPY" action.permission=* action.action=allow action.pattern=*
