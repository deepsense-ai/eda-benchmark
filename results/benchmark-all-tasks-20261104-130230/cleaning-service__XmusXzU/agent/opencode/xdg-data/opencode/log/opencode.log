timestamp=2026-11-04T15:49:43.710Z level=INFO run=7dbbc1d1 message=evaluated permission=bash pattern="python3 << 'PY'\n# Now group by billing month. Let us try calendar month first\nfrom collections import defaultdict\nimport math\n\n# Group by (year, month) as billing month\nby_emp = defaultdict(list)\nfor emp_id, dt, total in records:\n    by_emp[emp_id].append((dt.year, dt.month, total))\n\n# Aggregate totals per (year,month) for each emp\nresult = defaultdict(list)\nfor emp_id, items in by_emp.items():\n    # sum totals per month\n    month_totals = defaultdict(float)\n    for y, m, t in items:\n        month_totals[(y,m)] += t\n    # get sorted months\n    for (y,m) in sorted(month_totals.keys()):\n        val = month_totals[(y,m)]\n        # round to nearest integer\n        rounded = int(round(val))\n        result[emp_id].append(rounded)\n\n# convert keys to str (PESELs are strings in output format)\nfinal = {}\nfor emp_id, lst in result.items():\n    final[str(emp_id)] = lst\n\nprint(final)\nPY" action.permission=* action.action=allow action.pattern=*
