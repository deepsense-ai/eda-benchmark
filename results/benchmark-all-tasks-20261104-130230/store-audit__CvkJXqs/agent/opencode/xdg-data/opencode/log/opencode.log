timestamp=2026-11-04T12:41:53.289Z level=INFO run=56dc2648 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\n# Build full catalog lookup by both pid and ean\ncatalog = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        pid = row['product_id']\n        ean = row['ean_code']\n        try:\n            price = float(row['unit_price'].replace(',', '.'))\n        except:\n            price = float(row['unit_price'])\n        catalog[pid] = {'price': price}\n        catalog[ean] = {'price': price}\n\n# Now calculate\nspoil_batch_time = '2023-07-18 03:17:00'\ntotal_revenue = 0\nexcluded = 0\n\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        dt = row['timestamp']\n        pid = row['product_id']\n        qty = int(float(row['quantity']))\n        c = catalog.get(pid)\n        if c is None:\n            raise ValueError(f'Unknown product: {pid}')\n        revenue = qty * c['price']\n        if dt == spoil_batch_time:\n            excluded += revenue\n            continue\n        total_revenue += revenue\n\nprint(f'Included: {total_revenue}')\nprint(f'Excluded: {excluded}')\nPY" action.permission=* action.action=allow action.pattern=*
