timestamp=2026-11-04T12:43:24.891Z level=INFO run=56dc2648 message=evaluated permission=bash pattern="python3 << 'PY'\n# Let us compute it precisely\nimport csv\n\ncatalog = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        pid = row['product_id']\n        ean = row['ean_code']\n        try:\n            price = float(row['unit_price'].replace(',', '.'))\n        except:\n            price = float(row['unit_price'])\n        cat = row['storage_category']\n        catalog[pid] = {'price': price, 'cat': cat}\n        catalog[ean] = {'price': price, 'cat': cat}\n\nexcluded_batch_time = '2023-07-18 03:17:00'\ntotal_revenue = 0\nexcluded = 0\n\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        dt = row['timestamp']\n        pid = row['product_id']\n        qty = int(float(row['quantity']))\n        c = catalog.get(pid, catalog.get(row['product_id']))\n        if 'price' not in locals():\n            pass\n        # better lookup\n        c = catalog.get(pid)\n        if c is None:\n            c = catalog.get(row['product_id'])\n        if c is None:\n            # try by original\n            c = {'price': 0}\n        revenue = qty * c['price']\n        if dt == excluded_batch_time:\n            excluded += revenue\n        else:\n            total_revenue += revenue\n\nprint(total_revenue)\nPY" action.permission=* action.action=allow action.pattern=*
