timestamp=2026-11-04T12:36:01.245Z level=INFO run=56dc2648 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\n\nproducts = {}\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        pid = row['product_id']\n        try:\n            w = float(row['unit_weight_kg'])\n        except:\n            w = float(row['unit_weight_kg'].replace(',', '.'))\n        products[pid] = w\n\n# Check the batch at 2023-07-18 03:17:00\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        if row['timestamp'] == '2023-07-18 03:17:00':\n            pid = row['product_id']\n            qty = float(row['quantity'])\n            tw = float(row['total_weight_kg'])\n            expected = qty * products.get(pid, 0)\n            print(f\"{pid}: qty={qty} w={products.get(pid)} exp={expected} got={tw} diff={abs(tw-expected):.4f}\")\nPY" action.permission=* action.action=allow action.pattern=*
