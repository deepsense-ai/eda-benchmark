timestamp=2026-11-04T12:46:55.570Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\ncands = set()\n\n# (a)\nseller_metrics = []\ndef fd(x):\n    try:\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return 0\n        return int(s[0])\n    except:\n        return 0\nbenford = {1:0.301,2:0.176,3:0.125,4:0.097,5:0.079,6:0.067,7:0.058,8:0.051,9:0.046}\nfor sid, group in inv.groupby('seller_id'):\n    cnt = group['gross_amount'].apply(fd).value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    seller_metrics.append((sid, dev))\nseller_metrics.sort(key=lambda x: x[1], reverse=True)\nfor sid, dev in seller_metrics[:15]:\n    cands.add(sid)\n\n# (b) buyer-only companies with weak fundamentals\nsellers = set(inv['seller_id'].unique())\nbuyers = set(inv['buyer_id'].unique())\nbuyer_only = buyers - sellers\nbo = comp[comp['company_id'].isin(buyer_only)]\n# weak: small employees, low revenue, new/young bank account, recent registration\nbo_weak = bo.sort_values(['employees', 'declared_revenue_annual', 'bank_account_age_months'])\nfor _, row in bo_weak.iterrows():\n    cands.add(row['company_id'])\n\n# (c) sellers with outsized payments to external recipients relative to footprint\nfor sid, group in inv.groupby('seller_id'):\n    c = comp[comp['company_id']==sid]\n    if len(c)==0: continue\n    c = c.iloc[0]\n    total_gross = group['gross_amount'].sum()\n    # count payments to external buyers (not in companies?)\n    ext = group[~group['buyer_id'].isin(comp['company_id'])]['gross_amount'].sum()\n    if ext == 0: continue\n    ratio_ext_rev = ext / c['declared_revenue_annual'] if c['declared_revenue_annual'] > 0 else 0\n    if ratio_ext_rev > 1.0 or ext > 100000:  # threshold\n        cands.add(sid)\n\nprint('total cands:', len(cands))\nPY" action.permission=* action.action=allow action.pattern=*
