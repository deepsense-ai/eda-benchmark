timestamp=2026-11-04T12:44:02.471Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\n# Also check for benford extreme with small n? but large total gross? or other patterns\nseller_metrics = []\nbenford = {1:0.301, 2:0.176, 3:0.125, 4:0.097, 5:0.079, 6:0.067, 7:0.058, 8:0.051, 9:0.046}\n\ndef fd(x):\n    try:\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return 0\n        return int(s[0])\n    except:\n        return 0\n\nfor sid, group in inv.groupby('seller_id'):\n    c = comp[comp['company_id']==sid]\n    if len(c) == 0: continue\n    c = c.iloc[0]\n    cnt = group['gross_amount'].apply(fd).value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    seller_metrics.append({\n        'company_id': sid,\n        'employees': c['employees'],\n        'rev': c['declared_revenue_annual'],\n        'total_gross': group['gross_amount'].sum(),\n        'n_invoices': len(group),\n        'n_buyers': group['buyer_id'].nunique(),\n        'benford_chi2': dev\n    })\ndf = pd.DataFrame(seller_metrics)\ndf = df.sort_values('benford_chi2', ascending=False)\nprint(df.head(10).to_string())\nPY" action.permission=* action.action=allow action.pattern=*
