timestamp=2026-11-04T12:36:44.601Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\ndef first_digit(x):\n    try:\n        if pd.isna(x): return np.nan\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return np.nan\n        return int(s[0])\n    except Exception:\n        return np.nan\n\n# For each seller, get first digits of gross/net amounts\ninv['fd_gross'] = inv['gross_amount'].apply(first_digit)\ninv['fd_net'] = inv['net_amount'].apply(first_digit)\n\n# Benford distribution\nbenford = {1:0.301, 2:0.176, 3:0.125, 4:0.097, 5:0.079, 6:0.067, 7:0.058, 8:0.051, 9:0.046}\n\n# Compute chi-square or just deviation per seller\nseller_stats = []\nfor sid, group in inv.groupby('seller_id'):\n    cnt = group['fd_gross'].dropna().value_counts().sort_index()\n    total = cnt.sum() if cnt.sum() > 0 else 0\n    # build dist\n    dev = 0\n    for d in range(1, 10):\n        obs = cnt.get(d, 0)\n        exp = total * benford[d]\n        if exp > 0:\n            dev += (obs - exp)**2 / exp\n    seller_stats.append({'seller_id': sid, 'n_invoices': len(group), 'benford_chi2_gross': dev, 'total_gross': group['gross_amount'].sum()})\n\nss = pd.DataFrame(seller_stats)\nss = ss.sort_values('benford_chi2_gross', ascending=False)\nprint(ss.head(15))\nPY" action.permission=* action.action=allow action.pattern=*
