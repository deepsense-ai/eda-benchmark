timestamp=2026-11-04T12:45:28.317Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\n# Now let us collect all candidates based on the three patterns from task:\n# a) unusual leading-digit behavior among active sellers (e.g., 8382, 4612, 3915, 6453 all had notable benford issues?)\n# b) companies that appear only as buyers despite having weak operating fundamentals (buyer-only companies) - e.g., 8810, 8285, 7021, 3495, 8770, 1060, 4521 (all small, new-ish)\n# c) sellers whose payments to external recipients look outsized relative to their declared business footprint (6453, 2029 send large amounts to external buyers 12345679/80; also very high ratio_out_rev)\n\ncands = set()\n# From (a): top benford deviants\nseller_metrics = []\ndef fd(x):\n    try:\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return 0\n        return int(s[0])\n    except:\n        return 0\nbenford = {1:0.301, 2:0.176, 3:0.125, 4:0.097, 5:0.079, 6:0.067, 7:0.058, 8:0.051, 9:0.046}\nfor sid, group in inv.groupby('seller_id'):\n    cnt = group['gross_amount'].apply(fd).value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    seller_metrics.append((sid, dev, len(group), group['gross_amount'].sum()))\nseller_metrics.sort(key=lambda x: x[1], reverse=True)\nfor sid, dev, n, tot in seller_metrics[:15]:\n    cands.add(sid)\nPY" action.permission=* action.action=allow action.pattern=*
