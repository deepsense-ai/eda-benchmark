timestamp=2026-11-04T12:47:26.700Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\n# Build ranking score for candidates\ncands = []\n\n# gather all candidate ids from signals\n# signals\nsellers = set(inv['seller_id'].unique())\nbuyers = set(inv['buyer_id'].unique())\n\n# benford\ndef fd(x):\n    try:\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return 0\n        return int(s[0])\n    except:\n        return 0\nbenford = {1:0.301,2:0.176,3:0.125,4:0.097,5:0.079,6:0.067,7:0.058,8:0.051,9:0.046}\nbenford_map = {}\nfor sid, group in inv.groupby('seller_id'):\n    cnt = group['gross_amount'].apply(fd).value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    benford_map[sid] = dev\n\n# all companies involved in anything\nall_ids = set(comp['company_id'].unique()) | sellers | buyers\n\nresult = []\nfor cid in all_ids:\n    is_seller = cid in sellers\n    is_buyer_only = (cid in buyers) and (cid not in sellers)\n    c = comp[comp['company_id']==cid]\n    comp_row = c.iloc[0] if len(c) else None\n    score = 0\n\n    # (b) buyer-only with weak fundamentals\n    if is_buyer_only:\n        score += 10\n        if comp_row is not None:\n            if comp_row['employees'] < 50: score += 5\n            if comp_row['declared_revenue_annual'] < 300000: score += 2\n            if comp_row['bank_account_age_months'] < 6: score += 5\n            if pd.isna(comp_row['region']): score += 1\n\n    # (a) seller benford\n    if is_seller and cid in benford_map:\n        dev = benford_map[cid]\n        if dev > 40: score += 8\n        elif dev > 20: score += 4\n        elif dev > 10: score += 2\n\n    # (c) seller with external outflows\n    if is_seller:\n        g = inv[inv['seller_id']==cid]\n        if comp_row is not None:\n            total = g['gross_amount'].sum()\n            rev = comp_row['declared_revenue_annual'] if comp_row['declared_revenue_annual'] > 0 else 1\n            score += min(5, (total/rev))  # cap\n            # external\n            ext = g[~g['buyer_id'].isin(comp['company_id'])]['gross_amount'].sum()\n            if ext > 0:\n                score += 5\n                score += min(5, ext/rev)\n            # few buyers, high concentration\n            if g['buyer_id'].nunique() < 3:\n                score += 3\n    result.append((cid, score, is_buyer_only, is_seller))\n\nresult.sort(key=lambda x: x[1], reverse=True)\ntop = result[:15]\nfor cid, sc, bo, se in top:\n    print(cid, f'score={sc:.2f}', 'BO' if bo else ('S' if se else '?'))\nPY" action.permission=* action.action=allow action.pattern=*
