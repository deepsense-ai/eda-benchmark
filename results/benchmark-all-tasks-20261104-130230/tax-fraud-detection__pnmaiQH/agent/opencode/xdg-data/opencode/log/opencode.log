timestamp=2026-11-04T12:47:09.294Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\ncands = set()\n\n# (a)\nseller_metrics = []\ndef fd(x):\n    try:\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return 0\n        return int(s[0])\n    except:\n        return 0\nbenford = {1:0.301,2:0.176,3:0.125,4:0.097,5:0.079,6:0.067,7:0.058,8:0.051,9:0.046}\nfor sid, group in inv.groupby('seller_id'):\n    cnt = group['gross_amount'].apply(fd).value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    seller_metrics.append((sid, dev))\nseller_metrics.sort(key=lambda x: x[1], reverse=True)\nfor sid, dev in seller_metrics[:15]:\n    cands.add(sid)\n\n# (b)\nsellers = set(inv['seller_id'].unique())\nbuyers = set(inv['buyer_id'].unique())\nbuyer_only = buyers - sellers\nfor cid in buyer_only:\n    cands.add(cid)\n\n# (c)\nfor sid, group in inv.groupby('seller_id'):\n    c = comp[comp['company_id']==sid]\n    if len(c)==0: continue\n    c = c.iloc[0]\n    ext = group[~group['buyer_id'].isin(comp['company_id'])]['gross_amount'].sum()\n    if ext == 0: continue\n    rev = c['declared_revenue_annual'] if c['declared_revenue_annual'] > 0 else 1\n    if ext / rev > 0.5 or ext > 50000:\n        cands.add(sid)\n\n# also add those with very high ratio outflow to rev regardless\nfor sid, group in inv.groupby('seller_id'):\n    c = comp[comp['company_id']==sid]\n    if len(c)==0: continue\n    c = c.iloc[0]\n    total = group['gross_amount'].sum()\n    rev = c['declared_revenue_annual'] if c['declared_revenue_annual'] > 0 else 1\n    if total/rev > 2:\n        cands.add(sid)\n\nprint('total cands:', len(cands))\nPY" action.permission=* action.action=allow action.pattern=*
