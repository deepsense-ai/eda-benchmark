timestamp=2026-11-04T12:40:22.339Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\n# Build seller profile\nsellers = inv['seller_id'].unique()\nseller_metrics = []\n\ndef first_digit(x):\n    try:\n        if pd.isna(x): return np.nan\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return np.nan\n        return int(s[0])\n    except Exception:\n        return np.nan\n\ninv['fd_gross'] = inv['gross_amount'].apply(first_digit)\nbenford = {1:0.301, 2:0.176, 3:0.125, 4:0.097, 5:0.079, 6:0.067, 7:0.058, 8:0.051, 9:0.046}\n\nfor sid, group in inv.groupby('seller_id'):\n    comp_row = comp[comp['company_id'] == sid]\n    employees = comp_row['employees'].iloc[0] if len(comp_row) else np.nan\n    rev = comp_row['declared_revenue_annual'].iloc[0] if len(comp_row) else np.nan\n    total_out = group['gross_amount'].sum()\n    total_net = group['net_amount'].sum()\n    n_invoices = len(group)\n    n_buyers = group['buyer_id'].nunique()\n    # benford\n    cnt = group['fd_gross'].dropna().value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    seller_metrics.append({\n        'company_id': sid,\n        'employees': employees,\n        'declared_revenue_annual': rev,\n        'total_outflow_gross': total_out,\n        'total_outflow_net': total_net,\n        'n_invoices': n_invoices,\n        'n_buyers': n_buyers,\n        'benford_chi2': dev\n    })\n\ndf = pd.DataFrame(seller_metrics)\ndf = df.sort_values(['benford_chi2', 'total_outflow_gross'], ascending=[False, False])\nprint(df.head(15).to_string())\nPY" action.permission=* action.action=allow action.pattern=*
