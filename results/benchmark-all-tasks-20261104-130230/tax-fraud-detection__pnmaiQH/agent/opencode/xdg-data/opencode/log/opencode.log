timestamp=2026-11-04T12:42:55.222Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\n# Find sellers with small footprint but large outflows, or many payments to few buyers, etc.\nseller_metrics = []\nfor sid, group in inv.groupby('seller_id'):\n    c = comp[comp['company_id']==sid]\n    if len(c) == 0: continue\n    c = c.iloc[0]\n    total_gross = group['gross_amount'].sum()\n    total_net = group['net_amount'].sum()\n    seller_metrics.append({\n        'company_id': sid,\n        'employees': c['employees'],\n        'rev': c['declared_revenue_annual'],\n        'total_gross': total_gross,\n        'total_net': total_net,\n        'n_invoices': len(group),\n        'n_buyers': group['buyer_id'].nunique(),\n        'ratio_out_rev': total_gross / c['declared_revenue_annual'] if c['declared_revenue_annual'] > 0 else 0,\n        'out_per_emp': total_gross / c['employees'] if c['employees'] > 0 else 0,\n    })\n\ndf = pd.DataFrame(seller_metrics)\ndf = df.sort_values('ratio_out_rev', ascending=False)\nprint(df.head(15).to_string())\nPY" action.permission=* action.action=allow action.pattern=*
