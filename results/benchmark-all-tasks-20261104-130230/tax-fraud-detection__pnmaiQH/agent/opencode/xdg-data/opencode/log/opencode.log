timestamp=2026-11-04T12:43:49.266Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\n# Look at other high ratio sellers\nseller_metrics = []\nfor sid, group in inv.groupby('seller_id'):\n    c = comp[comp['company_id']==sid]\n    if len(c) == 0: continue\n    c = c.iloc[0]\n    total_gross = group['gross_amount'].sum()\n    ratio = total_gross / c['declared_revenue_annual'] if c['declared_revenue_annual'] > 0 else 0\n    seller_metrics.append({\n        'company_id': sid,\n        'employees': c['employees'],\n        'rev': c['declared_revenue_annual'],\n        'total_gross': total_gross,\n        'n_invoices': len(group),\n        'n_buyers': group['buyer_id'].nunique(),\n        'ratio_out_rev': ratio,\n    })\ndf = pd.DataFrame(seller_metrics)\ndf = df.sort_values('ratio_out_rev', ascending=False)\n# show those with few buyers and high ratio\nprint(df[(df['n_buyers'] < 5) & (df['ratio_out_rev'] > 1)].head(10).to_string())\nPY" action.permission=* action.action=allow action.pattern=*
