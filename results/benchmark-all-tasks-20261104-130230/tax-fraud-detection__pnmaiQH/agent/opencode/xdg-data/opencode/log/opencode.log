timestamp=2026-11-04T12:48:50.394Z level=INFO run=3476ed77 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ncomp = pd.read_csv('/app/dataset/companies.csv')\ninv = pd.read_csv('/app/dataset/invoices.csv')\n\nsellers = set(inv['seller_id'].unique())\nbuyers = set(inv['buyer_id'].unique())\nall_comp_ids = set(comp['company_id'].unique())\n\n# benford\ndef fd(x):\n    try:\n        s = str(abs(float(x))).lstrip('0')\n        if s == '': return 0\n        return int(s[0])\n    except:\n        return 0\nbenford = {1:0.301,2:0.176,3:0.125,4:0.097,5:0.079,6:0.067,7:0.058,8:0.051,9:0.046}\nbenford_map = {}\nfor sid, group in inv.groupby('seller_id'):\n    cnt = group['gross_amount'].apply(fd).value_counts().sort_index()\n    total = cnt.sum()\n    dev = 0\n    for d in range(1,10):\n        obs = cnt.get(d,0); exp = total*benford[d]\n        if exp>0: dev += (obs-exp)**2/exp\n    benford_map[sid] = dev\n\nresult = []\nfor cid in all_comp_ids:\n    is_seller = cid in sellers\n    is_buyer_only = (cid in buyers) and (cid not in sellers)\n    c = comp[comp['company_id']==cid]\n    comp_row = c.iloc[0]\n    score = 0\n\n    # (b) buyer-only with weak fundamentals\n    if is_buyer_only:\n        score += 10\n        if comp_row['employees'] < 50: score += 6\n        if comp_row['declared_revenue_annual'] < 250000: score += 3\n        if comp_row['bank_account_age_months'] < 6: score += 6\n        if pd.isna(comp_row['region']): score += 2\n        # very young/new registration?\n        reg = pd.to_datetime(comp_row['registration_date'])\n        if reg > pd.to_datetime('2019-09-01'): score += 3  # very recent\n\n    # (a) seller benford\n    if is_seller and cid in benford_map:\n        dev = benford_map[cid]\n        if dev > 40: score += 9\n        elif dev > 20: score += 5\n        elif dev > 10: score += 2\n        # all same digit case\n        g = inv[inv['seller_id']==cid]\n        fds = g['gross_amount'].apply(fd)\n        if fds.nunique() == 1: score += 10\n\n    # (c) seller with external outflows and footprint mismatch\n    if is_seller:\n        g = inv[inv['seller_id']==cid]\n        total = g['gross_amount'].sum()\n        rev = comp_row['declared_revenue_annual'] if comp_row['declared_revenue_annual'] > 0 else 1\n        emp = comp_row['employees'] if comp_row['employees'] > 0 else 1\n        score += min(6, total/rev)\n        ext = g[~g['buyer_id'].isin(all_comp_ids)]['gross_amount'].sum()\n        if ext > 0:\n            score += 6\n            score += min(6, ext/rev)\n        if g['buyer_id'].nunique() < 3: score += 4\n        if total > 3*rev: score += 5\n        if total > 100000 and emp < 50: score += 4\n\n    result.append((cid, score))\n\nresult.sort(key=lambda x: x[1], reverse=True)\nfor cid, sc in result[:20]:\n    print(cid, f'{sc:.2f}')\nPY" action.permission=* action.action=allow action.pattern=*
