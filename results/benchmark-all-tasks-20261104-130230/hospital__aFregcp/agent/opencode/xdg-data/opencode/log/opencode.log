timestamp=2026-11-04T15:41:47.102Z level=INFO run=258c00cc message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom collections import defaultdict\n\nwith open('/app/dataset/hospital_compensation_registry.csv') as f:\n    rows = list(csv.DictReader(f))\n\n# build maps\npatient_has_claim = {}\nfor r in rows:\n    pid = r['patient_id']\n    if r['record_date'].strip():\n        patient_has_claim[pid] = True\nfor r in rows:\n    pid = r['patient_id']\n    if pid not in patient_has_claim:\n        patient_has_claim[pid] = False\n\n# who are ECs for patients WITH claims? sometimes claims are for serious things\n# look at claim reasons for patients who appear as EC for no-claim patients\nec_of = defaultdict(list)  # ec -> list of (patient, patient_row)\nfor r in rows:\n    ec = r['emergency_contact_patient_id']\n    pid = r['patient_id']\n    if ec:\n        ec_of[ec].append((pid, r))\n\n# look at cases where a no-claim patient has EC that has claims - what are those claims?\nno_claim = [k for k,v in patient_has_claim.items() if not v]\ncands = []\nfor pid in no_claim:\n    # get their row\n    rlist = [x for x in rows if x['patient_id'] == pid]\n    if not rlist: continue\n    r = rlist[0]\n    ec = r['emergency_contact_patient_id']\n    # find claims by ec?\n    ec_claim_reasons = []\n    for rr in rows:\n        if rr['patient_id'] == ec and rr['record_date'].strip():\n            ec_claim_reasons.append(rr['compensation_reason'])\n    score = 0\n    # serious reasons when EC files? might indicate patient is deceased or incapacitated\n    serious = {'bereavement compensation', 'life event claim', 'family support adjustment'}\n    if any(cr in serious for cr in ec_claim_reasons):\n        score += 5\n    # or vehicle crash / workplace injury might mean patient is the subject but couldn't file?\n    # but the patient themselves has no claim record. That suggests someone else filed on their behalf for something that affects them\n    trauma = {'vehicle crash injury', 'workplace fall injury', 'burn injury'}\n    if any(cr in trauma for cr in ec_claim_reasons):\n        score += 2\n    cands.append((pid, score, ec, ec_claim_reasons[:2]))\n\ncands.sort(key=lambda x: x[1], reverse=True)\nfor c in cands[:15]:\n    print(c)\nPY" action.permission=* action.action=allow action.pattern=*
