timestamp=2026-11-04T13:12:56.276Z level=INFO run=0bcc9aed message=evaluated permission=bash pattern="cat > /app/parse_and_score.py << 'PY'\nimport csv\nimport json\nimport re\nfrom collections import defaultdict\nfrom datetime import datetime\n\ndef parse_datetime(s):\n    if s is None:\n        return None\n    s = s.strip()\n    if s == '':\n        return None\n    try:\n        # Handle Z suffix\n        if s.endswith('Z'):\n            s = s.replace('Z', '+00:00')\n        # Parse\n        dt = datetime.fromisoformat(s.replace('+00:00', ''))\n        return dt\n    except Exception:\n        try:\n            # Fallback common formats\n            for fmt in ['%Y-%m-%d %H:%M:%S', '%Y-%m-%dT%H:%M:%SZ', '%Y-%m-%dT%H:%M:%S']:\n                try:\n                    return datetime.strptime(s, fmt)\n                except:\n                    pass\n        except:\n            pass\n    return None\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str).strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    sl = s.lower()\n    if 'cr' in sl:\n        is_negative = True\n    if '(' in s and ')' in s:\n        is_negative = True\n    if '-' in s and not ('e-' in s or 'e+' in s):  # crude check\n        # minus sign might be sign; also inside numbers with separators? but usually prefix\n        # check if it's a leading sign or just char\n        # look for minus not part of scientific notation\n        pass\n    # check minus as sign\n    # simple: if minus appears and is not immediately after digit in some cases? easier: count\n    # but better: see if it appears before digits (ignoring spaces)\n    s2 = s\n    # detect minus sign\n    if re.search(r'(?<!\\d)-', s2) or re.search(r'-(?=\\d)', s2):\n        # treat presence of minus as negative indicator per rule 3\n        is_negative = True\n    # also parens\n    # remove tokens C1 and C2 (case-insensitive)\n    s3 = re.sub(r'(?i)\\bC1\\b', ' ', s2)\n    s3 = re.sub(r'(?i)\\bC2\\b', ' ', s3)\n    # strip out all letters and spaces\n    s4 = re.sub(r'[A-Za-z\\s]', '', s3)\n    # keep only digits , and .\n    s5 = re.sub(r'[^0-9,\\.]', '', s4)\n    if s5 == '':\n        return float('nan')\n    # determine decimal separator using last-separator rule\n    comma_count = s5.count(',')\n    dot_count = s5.count('.')\n    if comma_count > 0 and dot_count > 0:\n        # mixed: last-separator rule\n        last_comma = s5.rfind(',')\n        last_dot = s5.rfind('.')\n        if last_comma > last_dot:\n            dec_sep = ','\n        else:\n            dec_sep = '.'\n    elif comma_count > 0 and dot_count == 0:\n        dec_sep = ','\n    elif dot_count > 0 and comma_count == 0:\n        dec_sep = '.'\n    else:\n        dec_sep = None\n    # rule 6: if only one type exists, treat as decimal sep only when exactly two digits follow its last occurrence\n    if comma_count == 0 and dot_count == 1:\n        if len(s5) - s5.rfind('.') - 1 == 2:\n            dec_sep = '.'\n        else:\n            dec_sep = None  # thousands style? or just decimal - treat as decimal if 2 digits follow; sometimes 4 digits might mean thousands? but rule says \"exactly two digits follow its last occurrence\"\n    if comma_count == 1 and dot_count == 0:\n        if len(s5) - s5.rfind(',') - 1 == 2:\n            dec_sep = ','\n        else:\n            dec_sep = None\n    # apply normalization\n    num = s5\n    if dec_sep == ',':\n        # replace comma with dot as decimal\n        # thousand separators in european style could be dots? but mixed case handled\n        # for comma-decimal, thousands might be dots or spaces - but we've stripped spaces; dots might appear as thousands? in mixed we handled by last; in comma-only, maybe no thousands. But just normalize\n        num_norm = num.replace('.', '').replace(',', '.')\n    elif dec_sep == '.':\n        num_norm = num.replace(',', '')\n    else:\n        # no separator - just digits\n        num_norm = num\n    try:\n        val = float(num_norm)\n    except:\n        return float('nan')\n    if is_negative:\n        val = -abs(val)\n    return val\n\ndef parse_notes(notes):\n    res = {\n        'items': None,\n        'adj_pct': 0.0,\n        'fee': 0.0,\n        'waive': False,\n    }\n    if notes is None:\n        return res\n    s = str(notes)\n    # items\n    m = re.search(r'items\\s*=\\s*(\\d+)', s, re.I)\n    if m:\n        try:\n            res['items'] = int(m.group(1))\n        except:\n            res['items'] = None\n    # adj_pct: adj=<signed number>% (missing -> 0)\n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.I)\n    if m:\n        try:\n            res['adj_pct'] = float(m.group(1)) / 100.0 if False else float(m.group(1)) / 100.0  # keep as pct value? wait: adj_pct from adj=<signed number>%, so e.g. -5.62% -> adj_pct is -5.62% or -0.0562? The rule says \"adj_pct from adj=<signed number>% (missing -> 0)\". Probably store as decimal fraction (e.g., -0.0562) or just the numeric value as given in percentage context. Look at how it's used: compute net = base_amount * (1 + adj_pct) + fee. So adj_pct is -5.62% means adj_pct = -0.0562. So we need to store as fraction, or the percentage divided by 100.\n        except:\n            pass\n    # better handle\n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.I)\n    if m:\n        try:\n            res['adj_pct'] = float(m.group(1)) / 100.0\n        except:\n            res['adj_pct'] = 0.0\n    # fee: fee=<signed number>\n    m = re.search(r'fee\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, re.I)\n    if m:\n        try:\n            res['fee'] = float(m.group(1))\n        except:\n            res['fee'] = 0.0\n    # waive: waive=true (case-insensitive, otherwise false)\n    m = re.search(r'waive\\s*=\\s*(true|false)', s, re.I)\n    if m:\n        if m.group(1).lower() == 'true':\n            res['waive'] = True\n        else:\n            res['waive'] = False\n    else:\n        res['waive'] = False\n    return res\nPY" action.permission=* action.action=allow action.pattern=*
