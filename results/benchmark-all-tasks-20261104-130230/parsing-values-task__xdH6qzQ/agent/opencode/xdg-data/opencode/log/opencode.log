timestamp=2026-11-04T13:14:05.318Z level=INFO run=0bcc9aed message=evaluated permission=bash pattern="cat > /app/process.py << 'PY'\nimport csv\nimport json\nfrom collections import defaultdict\nfrom datetime import datetime\nimport math\nimport re\n\ndef parse_datetime(s):\n    if s is None:\n        return None\n    s = str(s).strip()\n    if s == '':\n        return None\n    try:\n        if s.endswith('Z'):\n            # Try simple replace\n            s2 = s[:-1]\n            # parse without timezone\n            try:\n                return datetime.strptime(s2, '%Y-%m-%dT%H:%M:%S')\n            except:\n                pass\n            try:\n                return datetime.strptime(s2.split('.')[0], '%Y-%m-%dT%H:%M:%S')\n            except:\n                pass\n        # try fromisoformat like\n        try:\n            dt = datetime.fromisoformat(s.replace('Z', ''))\n            return dt\n        except:\n            pass\n        for fmt in ['%Y-%m-%d %H:%M:%S', '%Y-%m-%dT%H:%M:%S', '%Y-%m-%d']:\n            try:\n                return datetime.strptime(s.split('.')[0].split('+')[0], fmt)\n            except:\n                continue\n    except Exception as e:\n        pass\n    return None\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str).strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    sl = s.lower()\n    if 'cr' in sl:\n        is_negative = True\n    # parens\n    if '(' in s and ')' in s:\n        is_negative = True\n    # minus\n    if '-' in s:\n        is_negative = True\n    # remove tokens C1 and C2\n    s3 = re.sub(r'(?i)\\bC1\\b', ' ', s)\n    s3 = re.sub(r'(?i)\\bC2\\b', ' ', s3)\n    # strip letters and spaces\n    s4 = re.sub(r'[A-Za-z\\s]', '', s3)\n    # keep only digits , .\n    s5 = re.sub(r'[^0-9,\\.]', '', s4)\n    if s5 == '':\n        return float('nan')\n    comma_count = s5.count(',')\n    dot_count = s5.count('.')\n    dec_sep = None\n    if comma_count > 0 and dot_count > 0:\n        last_comma = s5.rfind(',')\n        last_dot = s5.rfind('.')\n        if last_comma > last_dot:\n            dec_sep = ','\n        else:\n            dec_sep = '.'\n    elif comma_count > 0 and dot_count == 0:\n        # check if exactly two digits follow last comma\n        if s5.rfind(',') >= 0 and len(s5) - s5.rfind(',') - 1 == 2:\n            dec_sep = ','\n        else:\n            # could be thousands? but rule says decimal if exactly 2 digits follow last occurrence\n            # in practice sometimes european uses comma as decimal\n            dec_sep = ',' if (len(s5) - s5.rfind(',') - 1 == 2) else None\n            if dec_sep is None:\n                # maybe still treat as decimal per rule? if only one type exists, treat as decimal sep only when exactly two digits follow last occurrence\n                dec_sep = None  # let us follow precisely\n    elif dot_count > 0 and comma_count == 0:\n        if s5.rfind('.') >= 0 and len(s5) - s5.rfind('.') - 1 == 2:\n            dec_sep = '.'\n        else:\n            dec_sep = None\n    # reapply precise rule\n    if comma_count > 0 and dot_count == 0:\n        if len(s5) - s5.rfind(',') - 1 == 2:\n            dec_sep = ','\n        else:\n            dec_sep = None\n    if dot_count > 0 and comma_count == 0:\n        if len(s5) - s5.rfind('.') - 1 == 2:\n            dec_sep = '.'\n        else:\n            dec_sep = None\n    # if mixed already handled; if neither, dec_sep remains None\n    if dec_sep == ',':\n        num_norm = s5.replace('.', '').replace(',', '.')\n    elif dec_sep == '.':\n        num_norm = s5.replace(',', '')\n    else:\n        num_norm = s5\n    try:\n        val = float(num_norm)\n    except:\n        return float('nan')\n    if is_negative:\n        val = -abs(val)\n    return val\n\ndef parse_notes(notes):\n    res = {\n        'items': None,\n        'adj_pct': 0.0,  # as fraction\n        'fee': 0.0,\n        'waive': False,\n    }\n    if notes is None:\n        return res\n    s = str(notes)\n    m = re.search(r'items\\s*=\\s*(\\d+)', s, re.I)\n    if m:\n        try:\n            res['items'] = int(m.group(1))\n        except:\n            res['items'] = None\n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.I)\n    if m:\n        try:\n            res['adj_pct'] = float(m.group(1)) / 100.0\n        except:\n            res['adj_pct'] = 0.0\n    m = re.search(r'fee\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, re.I)\n    if m:\n        try:\n            res['fee'] = float(m.group(1))\n        except:\n            res['fee'] = 0.0\n    m = re.search(r'waive\\s*=\\s*(true|false)', s, re.I)\n    if m:\n        if m.group(1).lower() == 'true':\n            res['waive'] = True\n    else:\n        res['waive'] = False\n    return res\nPY" action.permission=* action.action=allow action.pattern=*
