timestamp=2026-11-04T13:30:45.380Z level=INFO run=0bcc9aed message=evaluated permission=bash pattern="cat > /app/main.py << 'PY'\nimport csv\nimport json\nimport math\nfrom collections import defaultdict\nfrom datetime import datetime\n\nfrom solve import parse_datetime, parse_amount, parse_notes\n\nQ4_START = datetime(2025, 10, 1, 0, 0, 0)\nQ4_END = datetime(2025, 12, 31, 23, 59, 59)\n\ndef is_finite(v):\n    return isinstance(v, float) and math.isfinite(v)\n\ndef median_mad(values):\n    if not values:\n        return 0.0, 0.0\n    s = sorted(values)\n    n = len(s)\n    if n % 2 == 1:\n        med = s[n // 2]\n    else:\n        med = (s[n // 2 - 1] + s[n // 2]) / 2.0\n    absdev = [abs(x - med) for x in s]\n    absdev.sort()\n    an = len(absdev)\n    if an % 2 == 1:\n        mad = absdev[an // 2]\n    else:\n        mad = (absdev[an // 2 - 1] + absdev[an // 2]) / 2.0\n    return med, mad\n\ndef robust_z(net, med, mad):\n    if mad == 0 or mad == 0.0:\n        return 0.0\n    return 0.6745 * (net - med) / mad\n\ndef main():\n    rows = []\n    with open('/app/dataset/data.csv', newline='', encoding='utf-8') as f:\n        reader = csv.DictReader(f)\n        for i, r in enumerate(reader):\n            record_id = (r.get('record_id') or '').strip()\n            event_time_raw = r.get('event_time')\n            region = (r.get('region') or '').strip()\n            channel = (r.get('channel') or '').strip()\n            amount_str = r.get('amount_str')\n            notes = r.get('notes')\n            dt = parse_datetime(event_time_raw)\n            amt = parse_amount(amount_str)\n            n = parse_notes(notes)\n            base_amount = amt\n            items = n['items']\n            adj_pct = n['adj_pct']\n            fee = n['fee']\n            waive = n['waive']\n            net = float('nan')\n            if not math.isnan(base_amount):\n                net = base_amount * (1.0 + adj_pct) + fee\n            if waive:\n                net = 0.0\n            rows.append({\n                'record_id': record_id,\n                'dt': dt,\n                'region': region,\n                'channel': channel,\n                'base_amount': base_amount,\n                'items': items,\n                'adj_pct': adj_pct,\n                'fee': fee,\n                'waive': waive,\n                'net': net,\n                'file_order': i,\n            })\n    best = {}\n    for r in rows:\n        rid = r['record_id']\n        if rid == '':\n            continue\n        if rid not in best:\n            best[rid] = r\n            continue\n        cur = best[rid]\n        dt_cur = cur['dt']\n        dt_new = r['dt']\n        better = False\n        if dt_new is not None and dt_cur is None:\n            better = True\n        elif dt_new is not None and dt_cur is not None:\n            if dt_new > dt_cur:\n                better = True\n            elif dt_new == dt_cur:\n                cur_has_real = is_finite(cur['net'])\n                new_has_real = is_finite(r['net'])\n                if new_has_real and not cur_has_real:\n                    better = True\n                elif new_has_real == cur_has_real:\n                    if r['file_order'] < cur['file_order']:\n                        better = True\n        if better:\n            best[rid] = r\n    kept = list(best.values())\n    filtered = []\n    for r in kept:\n        dt = r['dt']\n        if dt is None:\n            continue\n        if dt < Q4_START or dt > Q4_END:\n            continue\n        ch = r['channel'] or ''\n        if ch.lower() == 'phone':\n            continue\n        net = r['net']\n        if not is_finite(net):\n            continue\n        filtered.append(r)\n    groups = defaultdict(list)\n    for r in filtered:\n        dt = r['dt']\n        month = dt.strftime('%Y-%m')\n        key = (r['region'], month)\n        groups[key].append(r)\n    group_stats = {}\n    for k, lst in groups.items():\n        nets = [x['net'] for x in lst if is_finite(x['net'])]\n        med, mad = median_mad(nets)\n        group_stats[k] = (med, mad)\n    scored = []\n    for r in filtered:\n        dt = r['dt']\n        month = dt.strftime('%Y-%m')\n        key = (r['region'], month)\n        med, mad = group_stats.get(key, (0.0, 0.0))\n        rz = robust_z(r['net'], med, mad)\n        items = r['items']\n        if items is None:\n            items_eff = 1\n        else:\n            items_eff = int(items)\n        if items_eff < 1:\n            items_eff = 1\n        anom = abs(rz) * math.log1p(items_eff)\n        scored.append({\n            'record_id': r['record_id'],\n            'dt': r['dt'],\n            'abs_rz': abs(rz),\n            'anom': anom,\n        })\n    scored.sort(key=lambda x: (-x['anom'], -x['abs_rz'], -x['dt'].timestamp() if x['dt'] else 0, x['record_id']))\n    top = scored[:10]\n    return [t['record_id'] for t in top]\n\nif __name__ == '__main__':\n    res = main()\n    print(res)\nPY" action.permission=* action.action=allow action.pattern=*
