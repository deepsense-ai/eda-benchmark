timestamp=2026-11-04T13:16:00.107Z level=INFO run=0bcc9aed message=evaluated permission=bash pattern="cat > /app/solve.py << 'PY'\nimport csv\nimport json\nimport math\nimport re\nfrom collections import defaultdict\nfrom datetime import datetime\n\nQ4_START = datetime(2025, 10, 1, 0, 0, 0)\nQ4_END = datetime(2025, 12, 31, 23, 59, 59)\n\ndef parse_datetime(s):\n    if s is None:\n        return None\n    s = str(s).strip()\n    if s == '':\n        return None\n    try:\n        # try common formats\n        for fmt in [\n            '%Y-%m-%dT%H:%M:%SZ',\n            '%Y-%m-%dT%H:%M:%S.%fZ',\n            '%Y-%m-%dT%H:%M:%S',\n            '%Y-%m-%dT%H:%M:%S.%f',\n            '%Y-%m-%d %H:%M:%S',\n            '%Y-%m-%d %H:%M:%S.%f',\n        ]:\n            try:\n                dt = datetime.strptime(s, fmt)\n                return dt\n            except:\n                continue\n        # handle Z suffix generically\n        if s.endswith('Z'):\n            s2 = s[:-1]\n            for fmt in ['%Y-%m-%dT%H:%M:%S', '%Y-%m-%dT%H:%M:%S.%f']:\n                try:\n                    return datetime.strptime(s2, fmt)\n                except:\n                    continue\n    except Exception:\n        pass\n    return None\n\ndef parse_amount(amount_str):\n    if amount_str is None:\n        return float('nan')\n    s = str(amount_str)\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    is_negative = False\n    # check indicators\n    if 'cr' in s.lower():\n        is_negative = True\n    if '(' in s and ')' in s:\n        is_negative = True\n    if '-' in s:\n        is_negative = True\n    # remove tokens C1, C2\n    s2 = re.sub(r'(?i)\\bC1\\b', ' ', s)\n    s2 = re.sub(r'(?i)\\bC2\\b', ' ', s2)\n    # remove letters and spaces\n    s3 = re.sub(r'[A-Za-z\\s]', '', s2)\n    # keep digits , .\n    s4 = re.sub(r'[^0-9,\\.]', '', s3)\n    if s4 == '':\n        return float('nan')\n    comma_count = s4.count(',')\n    dot_count = s4.count('.')\n    dec_sep = None\n    if comma_count > 0 and dot_count > 0:\n        # last separator rule\n        if s4.rfind(',') > s4.rfind('.'):\n            dec_sep = ','\n        else:\n            dec_sep = '.'\n    elif comma_count > 0 and dot_count == 0:\n        # only comma; treat as decimal only if exactly two digits follow last occurrence\n        if len(s4) - s4.rfind(',') - 1 == 2:\n            dec_sep = ','\n        else:\n            dec_sep = None\n    elif dot_count > 0 and comma_count == 0:\n        if len(s4) - s4.rfind('.') - 1 == 2:\n            dec_sep = '.'\n        else:\n            dec_sep = None\n    else:\n        dec_sep = None\n    # normalize\n    if dec_sep == ',':\n        num_norm = s4.replace('.', '').replace(',', '.')\n    elif dec_sep == '.':\n        num_norm = s4.replace(',', '')\n    else:\n        num_norm = s4\n    try:\n        val = float(num_norm)\n    except Exception:\n        return float('nan')\n    if is_negative:\n        val = -abs(val)\n    return val\n\ndef parse_notes(notes):\n    res = {'items': None, 'adj_pct': 0.0, 'fee': 0.0, 'waive': False}\n    if notes is None:\n        return res\n    s = str(notes)\n    m = re.search(r'items\\s*=\\s*(\\d+)', s, re.I)\n    if m:\n        try:\n            res['items'] = int(m.group(1))\n        except:\n            res['items'] = None\n    m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)\\s*%', s, re.I)\n    if m:\n        try:\n            res['adj_pct'] = float(m.group(1)) / 100.0\n        except:\n            res['adj_pct'] = 0.0\n    m = re.search(r'fee\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, re.I)\n    if m:\n        try:\n            res['fee'] = float(m.group(1))\n        except:\n            res['fee'] = 0.0\n    m = re.search(r'waive\\s*=\\s*(true|false)', s, re.I)\n    if m:\n        if m.group(1).lower() == 'true':\n            res['waive'] = True\n    return res\nPY" action.permission=* action.action=allow action.pattern=*
