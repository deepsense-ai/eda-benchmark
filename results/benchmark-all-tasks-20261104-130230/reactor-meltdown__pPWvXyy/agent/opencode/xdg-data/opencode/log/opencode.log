timestamp=2026-11-04T15:59:23.221Z level=INFO run=b196681e message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# Look at the raw values for these early ones to understand context\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nmeta = meta.set_index('sensor_id')\n\nfor name in ['TURB_OUTPUT_01', 'STEAM_PRES_01', 'COOLING_PRES_01']:\n    df = None\n    # find which file\n    for d in [df1, df2, df3]:\n        if name in d['sensor_id'].values:\n            df = d.copy()\n            break\n    df['timestamp'] = pd.to_datetime(df['timestamp']).dt.tz_localize(None)\n    df = df[df['sensor_id']==name].sort_values('timestamp')\n    m = meta.loc[name]\n    # look around the first obs time\n    first_obs = pd.Timestamp('2024-01-15 17:00:00') if name == 'TURB_OUTPUT_01' else \\\n                (pd.Timestamp('2024-01-15 22:00:00') if name == 'STEAM_PRES_01' else pd.Timestamp('2024-01-16 00:10:00'))\n    # adjust first_obs based on what we saw\n    if name == 'TURB_OUTPUT_01': first_obs = pd.Timestamp('2024-01-15 17:00:00')\n    if name == 'STEAM_PRES_01': first_obs = pd.Timestamp('2024-01-15 22:00:00')\n    if name == 'COOLING_PRES_01': first_obs = pd.Timestamp('2024-01-16 00:10:00')\n    window = df[(df['timestamp'] >= first_obs - pd.Timedelta(hours=1)) & \n                (df['timestamp'] <= first_obs + pd.Timedelta(hours=1))]\n    print(f'=== {name} ===')\n    print('norm:', m['normal_min'], m['normal_max'])\n    print(window.head(5).to_string(index=False))\n    print('...')\n    print(window.tail(5).to_string(index=False))\n    print()\nPY" action.permission=* action.action=allow action.pattern=*
