timestamp=2026-11-04T16:02:04.900Z level=INFO run=b196681e message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# Let us examine more closely what happens at/around each subsystem's onset\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nmeta = meta.set_index('sensor_id')\n\ndf1['timestamp'] = pd.to_datetime(df1['timestamp']).dt.tz_localize(None)\ndf2['timestamp'] = pd.to_datetime(df2['timestamp']).dt.tz_localize(None)\ndf3['timestamp'] = pd.to_datetime(df3['timestamp']).dt.tz_localize(None)\ndf = pd.concat([df1, df2, df3], ignore_index=True)\n\n# Compute per-subsystem onset\n# Recompute\ndef is_deviating(row):\n    sid = row['sensor_id']\n    v = row['value']\n    m = meta.loc[sid]\n    return (v < m['normal_min']) or (v > m['normal_max'])\n\ndf_sorted = df.sort_values(['sensor_id', 'timestamp']).reset_index(drop=True)\ndf_sorted['deviating'] = df_sorted.apply(is_deviating, axis=1)\nresults = []\nfor sid, g in df_sorted.groupby('sensor_id'):\n    g = g.sort_values('timestamp').copy()\n    devi_idx = g.index[g['deviating'] == True]\n    if len(devi_idx) == 0:\n        continue\n    first_obs = g.loc[devi_idx[0], 'timestamp']\n    m = meta.loc[sid]\n    delay = pd.Timedelta(minutes=float(m['response_delay_minutes']))\n    first_phys = first_obs - delay\n    results.append({\n        'sensor_id': sid,\n        'subsystem': m['subsystem'],\n        'first_obs_deviation': first_obs,\n        'first_phys_deviation': first_phys,\n        'metric': m['metric']\n    })\nres = pd.DataFrame(results)\nsubsys = res.groupby('subsystem')['first_phys_deviation'].min().sort_values()\nprint('Subsys onset:', subsys.to_dict())\nprint()\n# look at all sensors in each subsystem and their first phys\nfor subs, onset in subsys.items():\n    print(f'=== {subs} (onset {onset}) ===')\n    for _, r in res[res['subsystem']==subs].sort_values('first_phys_deviation').iterrows():\n        print(f'  {r[\"sensor_id\"]}({r[\"metric\"]}): phys={r[\"first_phys_deviation\"]} (obs={r[\"first_obs_deviation\"]})')\n    print()\nPY" action.permission=* action.action=allow action.pattern=*
