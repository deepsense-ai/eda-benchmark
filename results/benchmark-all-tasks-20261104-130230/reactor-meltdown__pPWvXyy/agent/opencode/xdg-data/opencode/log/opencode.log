timestamp=2026-11-04T16:00:30.800Z level=INFO run=b196681e message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# TURB_OUTPUT drops sharply at 17:00 (observed) from ~909 to 770. That’s the first observed deviation. Physical onset = 17:00 - 2min = 16:58. That means the turbine/generator output physically started deviating at 16:58.\n# But we need to understand the full picture of cascade. Also look at other sensors at/around 16:58. Are there any other sensors showing deviation starting at physical times near 16:58?\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nmeta = meta.set_index('sensor_id')\n\ndf1['timestamp'] = pd.to_datetime(df1['timestamp']).dt.tz_localize(None)\ndf2['timestamp'] = pd.to_datetime(df2['timestamp']).dt.tz_localize(None)\ndf3['timestamp'] = pd.to_datetime(df3['timestamp']).dt.tz_localize(None)\ndf = pd.concat([df1, df2, df3], ignore_index=True)\ndf = df.sort_values(['sensor_id', 'timestamp']).reset_index(drop=True)\n\n# recompute with same logic\ndef is_deviating(row):\n    sid = row['sensor_id']\n    v = row['value']\n    m = meta.loc[sid]\n    return (v < m['normal_min']) or (v > m['normal_max'])\n\ndf['deviating'] = df.apply(is_deviating, axis=1)\nresults = []\nfor sid, g in df.groupby('sensor_id'):\n    g = g.sort_values('timestamp').copy()\n    devi_idx = g.index[g['deviating'] == True]\n    if len(devi_idx) == 0:\n        continue\n    first_obs = g.loc[devi_idx[0], 'timestamp']\n    m = meta.loc[sid]\n    delay = pd.Timedelta(minutes=float(m['response_delay_minutes']))\n    first_phys = first_obs - delay\n    results.append({\n        'sensor_id': sid,\n        'subsystem': m['subsystem'],\n        'first_obs_deviation': first_obs,\n        'response_delay_min': m['response_delay_minutes'],\n        'first_phys_deviation': first_phys\n    })\nres = pd.DataFrame(results)\nres = res.sort_values('first_phys_deviation')\n# look for physical onset times close to 16:58\nprint(res[res['first_phys_deviation'] <= pd.Timestamp('2024-01-16 03:00:00')].to_string(index=False))\nPY" action.permission=* action.action=allow action.pattern=*
