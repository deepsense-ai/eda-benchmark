timestamp=2026-11-04T16:04:10.856Z level=INFO run=b196681e message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# Recompute everything with UTC\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nalarms = pd.read_csv('/app/dataset/alarms.csv')\nops = pd.read_csv('/app/dataset/operator_actions.csv')\n\ndf1['timestamp'] = pd.to_datetime(df1['timestamp']).dt.tz_localize(None)\ndf2['timestamp'] = pd.to_datetime(df2['timestamp']).dt.tz_localize(None)\ndf3['timestamp'] = pd.to_datetime(df3['timestamp']).dt.tz_localize(None)\nalarms['timestamp'] = pd.to_datetime(alarms['timestamp']).dt.tz_convert(None)\nops['timestamp'] = pd.to_datetime(ops['timestamp']).dt.tz_convert(None)\n\ndf = pd.concat([df1, df2, df3], ignore_index=True)\nmeta = meta.set_index('sensor_id')\ndf['offset_h'] = df['sensor_id'].map(lambda s: meta.loc[s, 'logger_utc_offset_hours'])\ndf['timestamp_utc'] = df['timestamp'] - pd.to_timedelta(df['offset_h'], unit='h')\n\n# use timestamp_utc for analysis\ndef is_deviating(row):\n    sid = row['sensor_id']\n    v = row['value']\n    m = meta.loc[sid]\n    return (v < m['normal_min']) or (v > m['normal_max'])\n\ndf_sorted = df.sort_values(['sensor_id', 'timestamp_utc']).reset_index(drop=True)\ndf_sorted['deviating'] = df_sorted.apply(is_deviating, axis=1)\n\nresults = []\nfor sid, g in df_sorted.groupby('sensor_id'):\n    g = g.sort_values('timestamp_utc').copy()\n    devi_idx = g.index[g['deviating'] == True]\n    if len(devi_idx) == 0:\n        continue\n    first_obs_utc = g.loc[devi_idx[0], 'timestamp_utc']\n    m = meta.loc[sid]\n    delay = pd.Timedelta(minutes=float(m['response_delay_minutes']))\n    first_phys_utc = first_obs_utc - delay\n    results.append({\n        'sensor_id': sid,\n        'subsystem': m['subsystem'],\n        'first_obs_utc': first_obs_utc,\n        'first_phys_utc': first_phys_utc,\n    })\nres = pd.DataFrame(results)\nsubsys = res.groupby('subsystem')['first_phys_utc'].min().sort_values()\nprint(subsys.to_string())\nPY" action.permission=* action.action=allow action.pattern=*
