timestamp=2026-11-04T16:06:39.000Z level=INFO run=b196681e message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# Look at when alarms start per subsystem\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nalarms = pd.read_csv('/app/dataset/alarms.csv')\nops = pd.read_csv('/app/dataset/operator_actions.csv')\n\nmeta = meta.set_index('sensor_id')\nalarms['timestamp'] = pd.to_datetime(alarms['timestamp']).dt.tz_convert(None)\n# map alarms to subsystem\nalarms['subsystem'] = alarms['sensor_id'].map(lambda s: meta.loc[s, 'subsystem'] if s in meta.index else 'UNKNOWN')\n# first alarm per subsystem\nfirst_alarm = alarms.groupby('subsystem')['timestamp'].min().sort_values()\nprint('First alarms by subsystem:')\nprint(first_alarm.to_string())\nprint('\\n--- Operators ---')\nops['timestamp'] = pd.to_datetime(ops['timestamp']).dt.tz_convert(None)\nprint(ops.sort_values('timestamp').to_string(index=False))\nPY" action.permission=* action.action=allow action.pattern=*
