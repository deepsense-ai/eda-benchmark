timestamp=2026-11-04T13:43:39.044Z level=INFO run=84fbf363 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\ndf = pd.concat([df1, df2, df3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf['timestamp'] = pd.to_datetime(df['timestamp'])\ndfm = df.merge(meta, on='sensor_id', how='left')\ndfm['physical_time'] = dfm['timestamp'] - pd.to_timedelta(dfm['response_delay_minutes'], unit='m')\n\n# Focus on key sensors\nsids = ['TURB_OUTPUT_01', 'STEAM_PRES_01', 'PRIMARY_PRES_01', 'PRIMARY_TEMP_01', 'CORE_FUEL_01', 'CORE_FLUX_01', 'COOLING_TEMP_01', 'COOLING_PRES_01']\nfor sid in sids:\n    g = dfm[dfm['sensor_id']==sid].sort_values('physical_time')\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    # show first few outside range\n    dev = g[(g['value'] < m['normal_min']) | (g['value'] > m['normal_max'])]\n    print(f'\\n=== {sid} ===')\n    print(f'first physical dev: {dev.iloc[0].physical_time} (val={dev.iloc[0].value:.4f}, norm=[{m.normal_min},{m.normal_max}])')\n    # show values around that time\n    t0 = dev.iloc[0].physical_time\n    window = g[(g['physical_time'] >= t0 - pd.Timedelta(hours=2)) & (g['physical_time'] <= t0 + pd.Timedelta(hours=2))]\n    # just print a few\n    for _, r in window.head(3).iterrows():\n        print(f'  {r.physical_time}: {r.value:.4f}')\nPY" action.permission=* action.action=allow action.pattern=*
