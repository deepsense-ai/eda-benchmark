timestamp=2026-11-04T13:44:31.972Z level=INFO run=84fbf363 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\ndf = pd.concat([df1, df2, df3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf['timestamp'] = pd.to_datetime(df['timestamp'])\ndfm = df.merge(meta, on='sensor_id', how='left')\ndfm['physical_time'] = dfm['timestamp'] - pd.to_timedelta(dfm['response_delay_minutes'], unit='m')\n\n# Check physical deviation times at subsystem level\n# First deviation for any sensor in subsystem\nsubs = ['TURBINE', 'STEAM_GEN', 'PRIMARY_LOOP', 'CORE', 'COOLING']\nfor sub in subs:\n    g = dfm[dfm['subsystem']==sub].copy()\n    res = []\n    for sid, sg in g.groupby('sensor_id'):\n        m = meta[meta['sensor_id']==sid].iloc[0]\n        sg = sg.sort_values('physical_time')\n        dev = sg[(sg['value'] < m['normal_min']) | (sg['value'] > m['normal_max'])]\n        if len(dev) > 0:\n            res.append(dev.iloc[0]['physical_time'])\n    if res:\n        print(f'{sub}: first sensor dev at {min(res)}')\n    else:\n        print(f'{sub}: NO dev found')\nPY" action.permission=* action.action=allow action.pattern=*
