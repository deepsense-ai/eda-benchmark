timestamp=2026-11-04T13:38:32.473Z level=INFO run=84fbf363 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\n# Load all data\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\ndf = pd.concat([df1, df2, df3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\n\n# Parse timestamps\ndf['timestamp'] = pd.to_datetime(df['timestamp'])\n\n# Merge metadata\ndfm = df.merge(meta, on='sensor_id', how='left')\n\n# Compute physical time\ndfm['physical_time'] = dfm['timestamp'] - pd.to_timedelta(dfm['response_delay_minutes'], unit='m')\n\n# For each sensor, find first physical_time when value is outside normal range\nresults = []\nfor sid, g in dfm.groupby('sensor_id'):\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    nmin, nmax = m['normal_min'], m['normal_max']\n    # look for deviations\n    g = g.sort_values('physical_time')\n    # find first row where outside\n    dev = g[(g['value'] < nmin) | (g['value'] > nmax)]\n    if len(dev) > 0:\n        first = dev.iloc[0]\n        results.append({\n            'sensor_id': sid,\n            'subsystem': m['subsystem'],\n            'first_physical_deviation': first['physical_time'],\n            'first_observed_at': first['timestamp'],\n            'delay': m['response_delay_minutes'],\n            'value_at_dev': first['value'],\n            'normal_min': nmin,\n            'normal_max': nmax\n        })\n    else:\n        results.append({\n            'sensor_id': sid,\n            'subsystem': m['subsystem'],\n            'first_physical_deviation': pd.NaT,\n            'delay': m['response_delay_minutes']\n        })\n\nres = pd.DataFrame(results).sort_values('first_physical_deviation')\nprint(res[['sensor_id', 'subsystem', 'first_physical_deviation', 'delay', 'value_at_dev', 'normal_min', 'normal_max']].to_string())\nPY" action.permission=* action.action=allow action.pattern=*
