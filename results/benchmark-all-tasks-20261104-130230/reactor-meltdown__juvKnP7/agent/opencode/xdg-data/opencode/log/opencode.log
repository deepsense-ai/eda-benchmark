timestamp=2026-11-04T13:44:16.309Z level=INFO run=84fbf363 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\ndf = pd.concat([df1, df2, df3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf['timestamp'] = pd.to_datetime(df['timestamp'])\ndfm = df.merge(meta, on='sensor_id', how='left')\ndfm['physical_time'] = dfm['timestamp'] - pd.to_timedelta(dfm['response_delay_minutes'], unit='m')\n\n# Look around TURB_OUTPUT first deviation\nturb_t0 = pd.to_datetime('2024-01-15 16:58:00')\n# get physical times around it\nfor sid in ['TURB_OUTPUT_01', 'TURB_SPEED_01', 'STEAM_PRES_01', 'STEAM_FLOW_01' if False else None]:\n    pass\n\n# better list\nsensors = ['TURB_OUTPUT_01', 'TURB_SPEED_01', 'STEAM_PRES_01', 'STEAM_TEMP_01', 'STEAM_FEED_01', 'PRIMARY_PRES_01', 'PRIMARY_TEMP_01', 'CORE_FLUX_01']\nfor sid in sensors:\n    g = dfm[dfm['sensor_id']==sid].sort_values('physical_time')\n    # find closest to turb_t0\n    g['diff'] = abs(g['physical_time'] - turb_t0)\n    closest = g.iloc[g['diff'].idxmin()]\n    print(f'{sid}: phys={closest.physical_time} val={closest.value:.4f}')\nPY" action.permission=* action.action=allow action.pattern=*
