timestamp=2026-11-04T13:46:06.891Z level=INFO run=84fbf363 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\n\n# Compare physical deviation times by subsystem\ndf1 = pd.read_csv('/app/dataset/sensors_01.csv')\ndf2 = pd.read_csv('/app/dataset/sensors_02.csv')\ndf3 = pd.read_csv('/app/dataset/sensors_03.csv')\ndf = pd.concat([df1, df2, df3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf['timestamp'] = pd.to_datetime(df['timestamp'])\ndfm = df.merge(meta, on='sensor_id', how='left')\ndfm['physical_time'] = dfm['timestamp'] - pd.to_timedelta(dfm['response_delay_minutes'], unit='m')\n\n# For each subsystem, find earliest physical deviation time among its sensors\nsubs = []\nfor sub in ['COOLING', 'PRIMARY_LOOP', 'CORE', 'STEAM_GEN', 'TURBINE']:\n    times = []\n    for sid, sg in dfm[dfm['subsystem']==sub].groupby('sensor_id'):\n        m = meta[meta['sensor_id']==sid].iloc[0]\n        sg = sg.sort_values('physical_time')\n        dev = sg[(sg['value'] < m['normal_min']) | (sg['value'] > m['normal_max'])]\n        if len(dev) > 0:\n            times.append(dev.iloc[0]['physical_time'])\n    if times:\n        subs.append((sub, min(times)))\n    else:\n        subs.append((sub, None))\n\nsubs.sort(key=lambda x: x[1] if x[1] is not None else pd.Timestamp.max)\nfor s, t in subs:\n    print(f'{s}: {t}')\nPY" action.permission=* action.action=allow action.pattern=*
