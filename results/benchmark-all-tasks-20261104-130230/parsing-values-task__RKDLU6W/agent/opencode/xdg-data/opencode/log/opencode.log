timestamp=2026-11-04T12:22:40.000Z level=INFO run=aa77685c message=evaluated permission=bash pattern="python -c \"\n# Test dedup for R00277\nfrom process_data import process_all\nfrom dedup import dedup_and_filter\nimport math\n\nrows = process_all()\nby_rec = {}\nfor r in rows:\n    by_rec.setdefault(r['record_id'], []).append(r)\n\nrecs = by_rec['R00277']\n# Simulate\nbest = None\nfor r in recs:\n    if best is None:\n        best = r\n        continue\n    best_et = best['event_time']\n    r_et = r['event_time']\n    if r_et is not None and best_et is not None:\n        if r_et > best_et:\n            best = r; continue\n        elif r_et < best_et:\n            continue\n    elif r_et is not None and best_et is None:\n        best = r; continue\n    elif r_et is None and best_et is not None:\n        continue\n    # tie\n    best_has_real_net = not math.isnan(best['net'])\n    r_has_real_net = not math.isnan(r['net'])\n    if r_has_real_net and not best_has_real_net:\n        best = r; continue\n    elif best_has_real_net and not r_has_real_net:\n        continue\n    if r['row_order'] < best['row_order']:\n        best = r; continue\nprint(best['event_time'], best['row_order'])\n\"" action.permission=* action.action=allow action.pattern=*
