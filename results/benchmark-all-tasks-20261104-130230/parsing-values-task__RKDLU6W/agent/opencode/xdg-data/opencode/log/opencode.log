timestamp=2026-11-04T12:21:29.869Z level=INFO run=aa77685c message=evaluated permission=bash pattern="python -c \"\n# Check the ranking logic on the top few from full computation\nfrom compute import compute_final\nfrom process_data import process_all\nfrom dedup import dedup_and_filter\nfrom time_utils import robust_z_score, compute_mad\nimport math\nfrom datetime import datetime\nfrom collections import defaultdict\nfrom statistics import median\n\nrows = process_all()\ndeduped = dedup_and_filter(rows)\nstart = datetime(2025, 10, 1, 0, 0, 0)\nend = datetime(2025, 12, 31, 23, 59, 59)\nfiltered = []\nfor r in deduped:\n    et = r['event_time']\n    if et is None: continue\n    if et < start or et > end: continue\n    if (r['channel'] or '').lower() == 'phone': continue\n    net = r['net']\n    if math.isnan(net) or math.isinf(net): continue\n    filtered.append(r)\n\n# group\ngroup_to_nets = defaultdict(list)\nfor r in filtered:\n    month = r['event_time'].strftime('%Y-%m')\n    group_to_nets[(r['region'], month)].append(r['net'])\n\nfor r in filtered:\n    month = r['event_time'].strftime('%Y-%m')\n    key = (r['region'], month)\n    z = robust_z_score(r['net'], group_to_nets[key])\n    r['robust_z'] = z\n    r['abs_z'] = abs(z)\n    items = r['items']\n    if items is None: items_eff = 1\n    else: items_eff = items if items >= 1 else 1\n    r['items_eff'] = items_eff\n    r['anomaly_score'] = r['abs_z'] * math.log1p(items_eff)\n\nfiltered.sort(key=lambda x: (\n    -x['anomaly_score'],\n    -x['abs_z'],\n    -x['event_time'].timestamp(),\n    x['record_id']\n))\ntop = filtered[:3]\nfor t in top:\n    print(t['record_id'], t['anomaly_score'], t['abs_z'], t['event_time'], t['region'])\n\"" action.permission=* action.action=allow action.pattern=*
