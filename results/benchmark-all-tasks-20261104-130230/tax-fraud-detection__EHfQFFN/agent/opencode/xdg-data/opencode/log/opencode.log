timestamp=2026-11-04T16:25:30.168Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Now point c: \"sellers whose payments to external recipients look outsized relative to their declared business footprint\"\n# Need to identify sellers who make large payments to external recipients? External to what?\n# Or payments to other parties that are large relative to their declared footprint (revenue, employees)\n# Also look at purchase behavior of sellers - sellers also buy things. Maybe they make payments to other entities (buyers of others? or just large purchases)\n# Or \"outsized payments to external recipients\" - could mean total purchases (spending) by seller companies is large relative to their declared revenue/size\n\n# Look at sellers: compare purch_net_sum vs declared_revenue_annual, employees, etc.\n# Also compare sales vs purchases - some may have high purchases but low sales? round-tripping?\n\nstats = {}\nfor sid in invoices['seller_id'].unique():\n    invs_sell = invoices[invoices['seller_id'] == sid]  # sales\n    invs_buy = invoices[invoices['buyer_id'] == sid]   # purchases\n    c = companies[companies['company_id'] == sid]\n    row = c.iloc[0] if not c.empty else None\n    stats[sid] = {\n        'sales_net': invs_sell['net_amount'].sum(),\n        'purch_net': invs_buy['net_amount'].sum(),\n        'sales_count': len(invs_sell),\n        'purch_count': len(invs_buy),\n        'rev': row['declared_revenue_annual'] if row is not None else 0,\n        'emp': row['employees'] if row is not None else 0,\n    }\n\ndf = pd.DataFrame.from_dict(stats, orient='index')\ndf['purch_to_rev'] = df.apply(lambda x: x['purch_net'] / x['rev'] if x['rev'] > 0 else 9999, axis=1)\ndf['purch_per_emp'] = df.apply(lambda x: x['purch_net'] / x['emp'] if x['emp'] > 0 else 9999, axis=1)\ndf['sales_to_rev'] = df.apply(lambda x: x['sales_net'] / x['rev'] if x['rev'] > 0 else 9999, axis=1)\ndf.sort_values('purch_to_rev', ascending=False).head(10)\nPY" action.permission=* action.action=allow action.pattern=*
