timestamp=2026-11-04T16:35:27.757Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\nonly_buyers_not_in_comp = (set(invoices['buyer_id'].unique()) - set(invoices['seller_id'].unique())) - set(companies['company_id'].unique())\n# For each seller, how much do they sell to external-only-buyers (not in companies) vs total?\n# Or total payments to external recipients\nexternal = only_buyers_not_in_comp\nseller_payments_to_external = {}\nfor sid in companies['company_id'].unique():  # only company sellers that are in registry?\n    invs = invoices[invoices['seller_id'] == sid]\n    if len(invs) == 0:\n        seller_payments_to_external[sid] = 0\n        continue\n    # sum net amount where buyer is external\n    to_ext = invs[invs['buyer_id'].isin(external)]['net_amount'].sum()\n    seller_payments_to_external[sid] = float(to_ext)\n\n# get top\nsorted_items = sorted(seller_payments_to_external.items(), key=lambda x: x[1], reverse=True)\nfor sid, amt in sorted_items[:10]:\n    c = companies[companies['company_id'] == sid]\n    if not c.empty:\n        row = c.iloc[0]\n        print(f'{sid}: {amt:.2f} to external (rev={row[\"declared_revenue_annual\"]}, emp={row[\"employees\"]})')\nPY" action.permission=* action.action=allow action.pattern=*
