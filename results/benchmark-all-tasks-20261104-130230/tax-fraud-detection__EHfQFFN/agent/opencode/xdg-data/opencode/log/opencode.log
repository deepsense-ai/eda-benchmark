timestamp=2026-11-04T16:20:53.283Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\nBENFORD = {1:0.301, 2:0.176, 3:0.125, 4:0.097, 5:0.079, 6:0.067, 7:0.058, 8:0.051, 9:0.046}\n\ndef leading_digit(x):\n    try:\n        x = abs(float(x))\n        if x == 0: return None\n        while x < 1: x *= 10\n        while x >= 10: x //= 10\n        return int(x)\n    except:\n        return None\n\nsellers = invoices['seller_id'].unique()\nresults = []\nfor sid in sellers:\n    invs = invoices[invoices['seller_id'] == sid]\n    digits = invs['net_amount'].apply(leading_digit).dropna()\n    total = len(digits)\n    if total < 5:\n        continue\n    counts = digits.value_counts().to_dict()\n    max_dev = 0\n    for d in range(1,10):\n        obs = counts.get(d, 0) / total\n        dev = abs(obs - BENFORD[d])\n        if dev > max_dev: max_dev = dev\n    results.append((sid, total, max_dev))\n\nresults.sort(key=lambda x: x[2], reverse=True)\nfor r in results[:10]:\n    print(r)\nPY" action.permission=* action.action=allow action.pattern=*
