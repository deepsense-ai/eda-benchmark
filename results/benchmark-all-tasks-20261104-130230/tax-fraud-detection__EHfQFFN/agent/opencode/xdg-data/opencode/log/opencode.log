timestamp=2026-11-04T16:27:08.472Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Compute directly\nresult = []\nfor _, row in companies.iterrows():\n    sid = int(row['company_id'])\n    rev = float(row['declared_revenue_annual'])\n    purch = float(invoices[invoices['buyer_id'] == sid]['net_amount'].sum())\n    sales = float(invoices[invoices['seller_id'] == sid]['net_amount'].sum())\n    ptr = purch / rev if rev > 0 else float('inf')\n    result.append((sid, purch, sales, rev, ptr))\n\nresult.sort(key=lambda x: x[-1], reverse=True)\nfor r in result[:10]:\n    print(r)\nPY" action.permission=* action.action=allow action.pattern=*
