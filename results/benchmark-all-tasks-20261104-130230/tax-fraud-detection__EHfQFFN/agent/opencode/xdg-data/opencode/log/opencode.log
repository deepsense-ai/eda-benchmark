timestamp=2026-11-04T16:19:22.326Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# a) unusual leading-digit behavior among active sellers\n\n# Build transaction set of all invoices where seller is active? define active seller - maybe has sales_count > 0\n# Get net amounts per seller for all invoices? Or just look at amounts\n\n# Benford's law: expected frequencies for digits 1-9: 1: 0.301, 2: 0.176, 3: 0.125, 4: 0.097, 5: 0.079, 6: 0.067, 7: 0.058, 8: 0.051, 9: 0.046\nBENFORD = [0.301, 0.176, 0.125, 0.097, 0.079, 0.067, 0.058, 0.051, 0.046]\n\ndef leading_digit(x):\n    if x <= 0: return None\n    # get first non-zero digit\n    s = str(abs(float(x))).strip()\n    # remove scientific notation if any\n    try:\n        # normalize\n        val = abs(float(x))\n        if val == 0: return None\n        d = int(str(val).lstrip('0')[0]) if '.' not in str(val) else int(str(val).replace('.', '').lstrip('0')[0]) if str(val).replace('.', '').lstrip('0') else None\n        # easier: take log10\n        import math\n        if val < 1: \n            # small numbers\n            m = str(val).split('.')\n            if len(m) == 2:\n                # count leading zeros after decimal\n                frac = m[1]\n                # leading zero count\n                nz = len(frac) - len(frac.lstrip('0')) if frac else 0\n                # find first non-zero\n                for c in frac:\n                    if c != '0': return int(c)\n                return None\n        else:\n            return int(str(int(val))[0]) if int(val) > 0 else None\n    except:\n        pass\n    return None\n\n# simpler robust way\ndef leading_digit_simple(x):\n    try:\n        x = abs(float(x))\n        if x == 0: return None\n        while x < 1:\n            x *= 10\n        while x >= 10:\n            x //= 10\n        return int(x)\n    except:\n        return None\n\n# test\nprint(leading_digit_simple(19510.81))\nprint(leading_digit_simple(0.023))\nPY" action.permission=* action.action=allow action.pattern=*
