timestamp=2026-11-04T16:20:18.674Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom math import log10\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\nBENFORD = {1:0.301, 2:0.176, 3:0.125, 4:0.097, 5:0.079, 6:0.067, 7:0.058, 8:0.051, 9:0.046}\n\ndef leading_digit(x):\n    try:\n        x = abs(float(x))\n        if x == 0: return None\n        while x < 1:\n            x *= 10\n        while x >= 10:\n            x //= 10\n        return int(x)\n    except:\n        return None\n\n# For each active seller (has sales), look at distribution of leading digits of invoice net amounts\n# Also consider if only few invoices, stats less reliable? maybe weight by count\nsellers = invoices['seller_id'].unique()\nresults = []\nfor sid in sellers[:10]:  # test\n    invs = invoices[invoices['seller_id'] == sid]\n    if len(invs) == 0: continue\n    digits = invs['net_amount'].apply(leading_digit)\n    digits = digits.dropna()\n    if len(digits) == 0: continue\n    # compute chi-square-like score or just max diff?\n    counts = digits.value_counts().to_dict()\n    total = len(digits)\n    # get deviations\n    max_dev = 0\n    for d in range(1,10):\n        obs = counts.get(d, 0) / total if total > 0 else 0\n        exp = BENFORD[d]\n        dev = abs(obs - exp)\n        if dev > max_dev: max_dev = dev\n    results.append((sid, len(invs), max_dev))\n\nresults.sort(key=lambda x: x[2], reverse=True)\nresults\nPY" action.permission=* action.action=allow action.pattern=*
