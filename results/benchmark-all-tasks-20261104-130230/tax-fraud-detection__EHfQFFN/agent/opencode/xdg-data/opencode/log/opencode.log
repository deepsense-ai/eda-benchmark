timestamp=2026-11-04T16:18:41.192Z level=INFO run=cbaab588 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Per company stats\ncompany_stats = companies.set_index('company_id')\n\n# Sales as seller\nsales = invoices.groupby('seller_id').agg(\n    sales_count=('invoice_id', 'count'),\n    sales_net_sum=('net_amount', 'sum'),\n    sales_gross_sum=('gross_amount', 'sum'),\n    sales_avg_net=('net_amount', 'mean'),\n    sales_max_net=('net_amount', 'max'),\n    buyers_distinct=('buyer_id', 'nunique'),\n).rename_axis('company_id')\n\n# Purchases as buyer\npurchases = invoices.groupby('buyer_id').agg(\n    purch_count=('invoice_id', 'count'),\n    purch_net_sum=('net_amount', 'sum'),\n    purch_gross_sum=('gross_amount', 'sum'),\n    purch_avg_net=('net_amount', 'mean'),\n    purch_max_net=('net_amount', 'max'),\n    sellers_distinct=('seller_id', 'nunique'),\n).rename_axis('company_id')\n\nstats = company_stats.join(sales, how='left').join(purchases, how='left')\nstats = stats.fillna(0)\nstats.head(3)\nPY" action.permission=* action.action=allow action.pattern=*
