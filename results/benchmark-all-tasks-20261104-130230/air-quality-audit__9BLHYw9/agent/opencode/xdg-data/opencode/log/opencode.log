timestamp=2026-11-04T13:10:18.562Z level=INFO run=46ac6859 message=evaluated permission=bash pattern="cat > /tmp/inspect4.py << 'PY'\nimport sys\nsys.path = [p for p in sys.path if 'tmp' not in p]\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nw_st = pd.read_csv('/app/dataset/weather_stations.csv')\nw_rd = pd.read_csv('/app/dataset/weather_readings.csv')\n\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nw_rd['timestamp'] = pd.to_datetime(w_rd['timestamp'])\n\nwide = readings.pivot_table(index='timestamp', columns='station_id', values='current_reading')\nwide = wide.sort_index()\nwide_f = wide.interpolate(limit_direction='both')\ndistricts = stations.set_index('station_id')['district'].to_dict()\n\n# variance\nresv = []\nfor sid in wide_f.columns:\n    d = districts[sid]\n    peers = [c for c in wide_f.columns if c != sid and districts[c] == d]\n    if len(peers) == 0: continue\n    s_var = wide_f[sid].var(skipna=True)\n    p_vars = [wide_f[p].var(skipna=True) for p in peers]\n    p_med = np.median(p_vars)\n    if p_med > 0:\n        resv.append((sid, s_var/p_med))\nvdf = pd.DataFrame(resv, columns=['station_id','var_ratio'])\n\n# lag\ndef analyze_lag(sid):\n    d = districts[sid]\n    peers = [c for c in wide_f.columns if c != sid and districts[c] == d]\n    if len(peers) == 0: return None\n    s = wide_f[sid].values\n    c0s = []\n    best = -np.inf; best_l = 0\n    for p in peers:\n        pvals = wide_f[p].values\n        try:\n            c = np.corrcoef(s, pvals)[0,1]\n            if not np.isnan(c): \n                c0s.append(c)\n        except:\n            pass\n    for p in peers:\n        pvals = wide_f[p].values\n        for l in (0,-1,1,-2,2,-3,3):\n            try:\n                if l == 0: continue\n                elif l > 0:\n                    if l >= len(s): continue\n                    c = np.corrcoef(s[l:], pvals[:-l])[0,1]\n                else:\n                    lneg = -l\n                    if lneg >= len(s): continue\n                    c = np.corrcoef(s[:-lneg], pvals[lneg:])[0,1]\n                if not np.isnan(c) and c > best: best = c; best_l = l\n            except:\n                continue\n    if len(c0s) == 0: return None\n    return {'station_id': sid, 'c0_med': np.median(c0s), 'c0_max_peer': np.max(c0s), 'c_best_lag': best_l if best != -np.inf else 0, 'c_best': best if best != -np.inf else np.median(c0s), 'gain': (best - np.median(c0s)) if best != -np.inf else 0}\nresl = []\nfor sid in wide_f.columns:\n    r = analyze_lag(sid)\n    if r: resl.append(r)\nldf = pd.DataFrame(resl)\n\n# weather\nw_agg = w_rd.groupby('timestamp').agg({\n    'temperature_c': 'mean',\n    'humidity_pct': 'mean',\n    'wind_speed_m_s': 'mean',\n    'rain_accumulation_mm': 'mean'\n})\ncommon = wide_f.index.intersection(w_agg.index)\nX = w_agg.loc[common]\nY = wide_f.loc[common]\nweather = []\nfor sid in Y.columns:\n    best = 0; best_var = None\n    for c in X.columns:\n        try:\n            corr = np.corrcoef(Y[sid].values, X[c].values)[0,1]\n            if not np.isnan(corr):\n                if abs(corr) > abs(best):\n                    best = corr; best_var = c\n        except:\n            pass\n    weather.append((sid, best, best_var, abs(best)))\nwdf = pd.DataFrame(weather, columns=['station_id','w_best','w_var','w_abs'])\n\ndf = stations.merge(vdf, on='station_id', how='left')\ndf = df.merge(ldf, on='station_id', how='left')\ndf = df.merge(wdf, on='station_id', how='left')\n\n# now look for the 3 cases\n# 1. \"One problematic station broadly follows local patterns, but not with the same rhythm as its peers.\"\n#    -> high c0 with peers when lagged? or c_best_lag != 0 and gain large, meaning at lag 0 correlation is weaker but strong at some lag\n#    Look at top gain with non-zero lag and reasonable c_best\ndf_laggy = df.sort_values('gain', ascending=False)\nprint('=== LAGGY (gain high) ===')\nprint(df_laggy[['station_id','district','c0_med','c_best','c_best_lag','gain']].head(10).to_string())\n\n# 2. \"Another looks plausible point-by-point yet its swings are unusually muted compared with comparable local stations.\"\n#    -> var_ratio very low (much smaller variance than peers)\ndf_muted = df.sort_values('var_ratio')\nprint('\\n=== MUTED (var_ratio low) ===')\nprint(df_muted[['station_id','district','var_ratio']].head(10).to_string())\n\n# 3. \"A third appears ordinary in aggregate, but its remaining deviations line up a bit too neatly with one environmental driver.\"\n#    -> high abs correlation with some weather var (w_abs high) but otherwise maybe normal variance/corr?\ndf_env = df.sort_values('w_abs', ascending=False)\nprint('\\n=== ENV-DRIVEN (w_abs high) ===')\nprint(df_env[['station_id','district','w_best','w_var','w_abs','var_ratio','c0_med']].head(10).to_string())\nPY" action.permission=* action.action=allow action.pattern=*
