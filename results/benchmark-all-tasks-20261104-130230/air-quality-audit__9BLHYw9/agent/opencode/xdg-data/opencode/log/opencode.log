timestamp=2026-11-04T13:04:07.779Z level=INFO run=46ac6859 message=evaluated permission=bash pattern="cat > /tmp/lag_scan4.py << 'PY'\nimport sys\nsys.path = [p for p in sys.path if 'tmp' not in p]\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\n\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nwide = readings.pivot_table(index='timestamp', columns='station_id', values='current_reading')\nwide = wide.sort_index()\ndistricts = stations.set_index('station_id')['district'].to_dict()\nwide_f = wide.interpolate(limit_direction='both')\n\ndef analyze(sid, lags=(0,-1,1,-2,2)):\n    d = districts[sid]\n    peers = [c for c in wide_f.columns if c != sid and districts[c] == d]\n    if len(peers) == 0: return (np.nan, np.nan, 0, 0)\n    s = wide_f[sid].values\n    best = -np.inf; best_l = 0; c0_list = []\n    for p in peers:\n        pvals = wide_f[p].values\n        try:\n            c0 = np.corrcoef(s, pvals)[0,1]\n            if not np.isnan(c0): c0_list.append(c0)\n        except:\n            pass\n        for l in lags:\n            try:\n                if l == 0: continue\n                elif l > 0:\n                    if l >= len(s): continue\n                    c = np.corrcoef(s[l:], pvals[:-l])[0,1]\n                else:\n                    lneg = -l\n                    if lneg >= len(s): continue\n                    c = np.corrcoef(s[:-lneg], pvals[lneg:])[0,1]\n                if not np.isnan(c) and c > best:\n                    best = c; best_l = l\n            except:\n                continue\n    c0_med = np.median(c0_list) if c0_list else np.nan\n    if best == -np.inf: best = np.nan\n    return c0_med, best, best_l, len(peers)\n\nres = []\nfor sid in wide_f.columns:\n    r = analyze(sid)\n    res.append((sid, r[0], r[1], r[2], r[3]))\ndf = pd.DataFrame(res, columns=['sid','c0_med','c_best','c_best_lag','n_peers'])\n# look for stations where best lagged corr is much higher than c0_med, or best_lag != 0 with large gain?\ndf['gain'] = df['c_best'] - df['c0_med']\ndf_sorted = df.sort_values('gain', ascending=False)\nprint(df_sorted.head(10))\nPY" action.permission=* action.action=allow action.pattern=*
