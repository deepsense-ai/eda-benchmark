timestamp=2026-11-04T13:00:18.519Z level=INFO run=46ac6859 message=evaluated permission=bash pattern="cat > /tmp/lag_corr3.py << 'PY'\nimport sys\nsys.path = [p for p in sys.path if 'tmp' not in p]\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\n\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nwide = readings.pivot_table(index='timestamp', columns='station_id', values='current_reading')\nwide = wide.sort_index()\ndistricts = stations.set_index('station_id')['district'].to_dict()\nwide_f = wide.interpolate(limit_direction='both')\n\ndef max_corr_with_peers(sid, lags=(0,-1,1,-2,2)):\n    d = districts[sid]\n    peers = [c for c in wide_f.columns if c != sid and districts[c] == d]\n    if len(peers) == 0: return 0, 0\n    s = wide_f[sid].values\n    best = 0; best_l = 0\n    for p in peers:\n        pvals = wide_f[p].values\n        for l in lags:\n            if l == 0:\n                c = np.corrcoef(s, pvals)[0,1] if np.std(s)>0 and np.std(pvals)>0 else 0\n            elif l > 0:\n                c = np.corrcoef(s[l:], pvals[:-l])[0,1] if (l < len(s)) else 0\n            else:\n                lneg = -l\n                c = np.corrcoef(s[:-lneg], pvals[lneg:])[0,1] if (lneg < len(s)) else 0\n            if not np.isnan(c) and abs(c) > abs(best):\n                best = c; best_l = l\n            elif not np.isnan(c) and abs(c) == abs(best) and best == 0:\n                pass\n    return best, best_l\n\n# test on a few\nPY" action.permission=* action.action=allow action.pattern=*
