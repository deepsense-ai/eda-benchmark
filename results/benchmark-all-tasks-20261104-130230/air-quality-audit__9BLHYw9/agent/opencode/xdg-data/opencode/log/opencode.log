timestamp=2026-11-04T13:04:53.423Z level=INFO run=46ac6859 message=evaluated permission=bash pattern="cat > /tmp/lag_best.py << 'PY'\nimport sys\nsys.path = [p for p in sys.path if 'tmp' not in p]\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\n\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nwide = readings.pivot_table(index='timestamp', columns='station_id', values='current_reading')\nwide = wide.sort_index()\ndistricts = stations.set_index('station_id')['district'].to_dict()\nwide_f = wide.interpolate(limit_direction='both')\n\ndef analyze(sid):\n    d = districts[sid]\n    peers = [c for c in wide_f.columns if c != sid and districts[c] == d]\n    if len(peers) == 0: return None\n    s = wide_f[sid].values\n    # check c0 with each peer\n    c0s = []\n    for p in peers:\n        pvals = wide_f[p].values\n        try:\n            c = np.corrcoef(s, pvals)[0,1]\n            if not np.isnan(c): c0s.append(c)\n        except:\n            pass\n    if len(c0s) == 0: return None\n    return {'sid': sid, 'c0_med': np.median(c0s), 'c0_mean': np.mean(c0s), 'c0_max': np.max(c0s), 'c0_min': np.min(c0s), 'n_peers': len(peers)}\n\nres = []\nfor sid in wide_f.columns:\n    r = analyze(sid)\n    if r: res.append(r)\ndf = pd.DataFrame(res)\n# look for station where c0 with all peers is very high? or where it has very low c0 with peers but high max? or the opposite\ndf = df.sort_values('c0_med')\nprint(df.head(10).to_string())\nprint('---')\ndf = df.sort_values('c0_med', ascending=False)\nprint(df.head(10).to_string())\nPY" action.permission=* action.action=allow action.pattern=*
