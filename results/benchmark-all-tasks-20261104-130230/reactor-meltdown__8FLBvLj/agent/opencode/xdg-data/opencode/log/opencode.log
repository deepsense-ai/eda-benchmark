timestamp=2026-11-04T12:17:38.745Z level=INFO run=cafa9534 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nmeta_map = {}\nfor _, r in meta.iterrows():\n    meta_map[r['sensor_id']] = {\n        'subsystem': r['subsystem'],\n        'delay': float(r['response_delay_minutes']),\n        'offset': float(r['logger_utc_offset_hours']),\n        'norm_min': float(r['normal_min']),\n        'norm_max': float(r['normal_max']),\n    }\n\ndfs = []\nfor f in ['/app/dataset/sensors_01.csv', '/app/dataset/sensors_02.csv', '/app/dataset/sensors_03.csv']:\n    d = pd.read_csv(f)\n    dfs.append(d)\ns = pd.concat(dfs, ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\nrows = []\nfor _, r in s.iterrows():\n    sid = r['sensor_id']\n    m = meta_map.get(sid, {})\n    t_obs = r['timestamp']\n    t_obs_utc = t_obs - pd.Timedelta(hours=m.get('offset', 0))\n    t_phys = t_obs_utc - pd.Timedelta(minutes=m.get('delay', 0))\n    v = float(r['value'])\n    rows.append({\n        't_phys': t_phys,\n        'sensor_id': sid,\n        'subsystem': m['subsystem'],\n        'value': v,\n        'norm_min': m['norm_min'],\n        'norm_max': m['norm_max'],\n    })\ndf = pd.DataFrame(rows)\n\n# For each sensor, find when it first deviates from normal (physical state time)\n# Onset time = when physical state first began to deviate from normal\nfirst_devs = []\nfor sid, g in df.groupby('sensor_id'):\n    g = g.sort_values('t_phys')\n    # find first row where value < norm_min or value > norm_max\n    dev = g[(g['value'] < g['norm_min']) | (g['value'] > g['norm_max'])]\n    if len(dev) > 0:\n        first = dev.iloc[0]\n        first_devs.append({\n            'sensor_id': sid,\n            'subsystem': first['subsystem'],\n            't_dev_phys': first['t_phys'],\n            'value_at_dev': first['value'],\n            'norm_min': first['norm_min'],\n            'norm_max': first['norm_max'],\n        })\nres = pd.DataFrame(first_devs).sort_values('t_dev_phys')\nprint(res.to_string(index=False))\nPY" action.permission=* action.action=allow action.pattern=*
