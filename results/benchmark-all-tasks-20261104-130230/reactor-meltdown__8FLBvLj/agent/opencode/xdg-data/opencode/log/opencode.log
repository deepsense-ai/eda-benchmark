timestamp=2026-11-04T12:20:35.187Z level=INFO run=cafa9534 message=evaluated permission=bash pattern="python << 'PY'\n# Cross-verify a couple of early sensors more carefully\nimport pandas as pd\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nmeta_map = {}\nfor _, r in meta.iterrows():\n    meta_map[r['sensor_id']] = {\n        'subsystem': r['subsystem'],\n        'delay': float(r['response_delay_minutes']),\n        'offset': float(r['logger_utc_offset_hours']),\n        'norm_min': float(r['normal_min']),\n        'norm_max': float(r['normal_max']),\n    }\n\ndfs = []\nfor f in ['/app/dataset/sensors_01.csv', '/app/dataset/sensors_02.csv', '/app/dataset/sensors_03.csv']:\n    d = pd.read_csv(f)\n    dfs.append(d)\ns = pd.concat(dfs, ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Check TURBINE sensors collectively\nrows = []\nfor _, r in s.iterrows():\n    sid = r['sensor_id']\n    m = meta_map.get(sid, {})\n    if m['subsystem'] != 'TURBINE': continue\n    t_obs = r['timestamp']\n    t_obs_utc = t_obs - pd.Timedelta(hours=m['offset'])\n    t_phys = t_obs_utc - pd.Timedelta(minutes=m['delay'])\n    v = float(r['value'])\n    dev = (v < m['norm_min'] - 1e-9) or (v > m['norm_max'] + 1e-9)\n    rows.append((sid, t_phys, v, m['norm_min'], m['norm_max'], dev))\ndf = pd.DataFrame(rows, columns=['sid','t_phys','v','nmin','nmax','dev'])\ndf = df.sort_values('t_phys')\n# first deviations in turbine\nfor sid, g in df.groupby('sid'):\n    d = g[g['dev']]\n    if len(d) > 0:\n        print(sid, d.iloc[0]['t_phys'], d.iloc[0]['v'], '[', d.iloc[0]['nmin'], ',', d.iloc[0]['nmax'], ']')\nPY" action.permission=* action.action=allow action.pattern=*
