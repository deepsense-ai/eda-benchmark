timestamp=2026-11-04T12:17:04.841Z level=INFO run=cafa9534 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\nmeta_map = {}\nfor _, r in meta.iterrows():\n    meta_map[r['sensor_id']] = {\n        'subsystem': r['subsystem'],\n        'delay': float(r['response_delay_minutes']),\n        'offset': float(r['logger_utc_offset_hours']),\n        'norm_min': float(r['normal_min']),\n        'norm_max': float(r['normal_max']),\n    }\n\n# Load sensors\ndfs = []\nfor f in ['/app/dataset/sensors_01.csv', '/app/dataset/sensors_02.csv', '/app/dataset/sensors_03.csv']:\n    d = pd.read_csv(f)\n    dfs.append(d)\ns = pd.concat(dfs, ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n# For each reading, compute physical time\n# \"the observed reading at time T reflects the physical state as of time T minus the response delay\"\n# Also logger offsets? e.g. offset -1 means logger clock is 1 hour behind UTC? or ahead? \n# \"logger_utc_offset_hours\" - we need to interpret consistently. But compared to alarms/actions with Z (UTC), \n# and sensor timestamps in files - we need to align. Let us check example: sensors_03 ends ~2024-01-16T22:59:00, \n# alarms start around 2024-01-15T18:00:00Z (UTC). Operator actions at 2024-01-16T02:52:00Z etc.\n# So sensor timestamps are probably in logger-local time; but to compare to UTC events we need to adjust by offset?\n# Or maybe physical time is T_obs - delay (in same time basis as given). Also offset is given per sensor/logger? \n# The metadata says \"logger_utc_offset_hours\" per sensor. That affects how we interpret T_obs. \n# So observed timestamp T_obs is in that logger's local clock; physical state at UTC time (T_obs - offset_h) corresponds to the observation? \n# Or maybe physical time of state is T_obs_utc_equivalent - delay. We need to normalize.\n# Another interpretation: the logger recorded at its local time T_local = T_utc + offset_hours (if offset is logger's offset from UTC). \n# And the reading at T_local reflects physical state as of (T_local - delay_minutes), also in the same time basis? Or in physical absolute time?\n# Since alarms are in UTC (Z), easier to convert everything to UTC.\n# Let us assume T_obs is in logger's local time, offset is hours from UTC (logger_utc_offset_hours). So T_obs_utc = T_obs - pd.Timedelta(hours=offset). \n# Then physical state occurred at time (T_obs_utc - pd.Timedelta(minutes=delay)).\n# That fits \"observed reading at time T reflects the physical state as of time T minus the response delay\".\n# So \"T\" is the observation timestamp in some consistent frame; but combined with logger offsets, normalizing to UTC is sensible.\nrows = []\nfor _, r in s.iterrows():\n    sid = r['sensor_id']\n    m = meta_map.get(sid, {})\n    t_obs = r['timestamp']\n    if pd.isna(t_obs): continue\n    t_obs_utc = t_obs - pd.Timedelta(hours=m.get('offset', 0))\n    t_phys = t_obs_utc - pd.Timedelta(minutes=m.get('delay', 0))\n    rows.append({\n        'timestamp_obs_utc': t_obs_utc,\n        'timestamp_phys': t_phys,\n        'sensor_id': sid,\n        'subsystem': m.get('subsystem'),\n        'value': float(r['value']),\n        'norm_min': m.get('norm_min'),\n        'norm_max': m.get('norm_max'),\n    })\ndf = pd.DataFrame(rows)\nprint(df.head())\nPY" action.permission=* action.action=allow action.pattern=*
