timestamp=2026-11-04T12:10:41.465Z level=INFO run=b7b1a579 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nreadings['current_reading'] = pd.to_numeric(readings['current_reading'], errors='coerce')\ndf = readings.merge(stations, on='station_id', how='left')\n\nw_r = pd.read_csv('/app/dataset/weather_readings.csv')\nw_r['timestamp'] = pd.to_datetime(w_r['timestamp'])\nweather_agg = w_r.groupby(['district', 'timestamp']).agg({\n    'temperature_c': 'mean',\n    'humidity_pct': 'mean',\n    'wind_speed_m_s': 'mean',\n    'rain_accumulation_mm': 'mean',\n}).reset_index()\ndf = df.merge(weather_agg, on=['district', 'timestamp'], how='left')\n\nts_map = {}\nmeta = {}\nfor sid, g in df.groupby('station_id'):\n    g = g.sort_values('timestamp').copy()\n    ts_map[sid] = g.set_index('timestamp')['current_reading']\n    meta[sid] = {'district': g['district'].iloc[0], 'pollutant': g['pollutant'].iloc[0]}\n\n# Clue 1: different rhythm as peers - maybe still correlated but lower max cross-corr or lagged?\nresults = []\nfor sid in ts_map:\n    dist = meta[sid]['district']\n    pol = meta[sid]['pollutant']\n    peers = [p for p in ts_map if meta[p]['district']==dist and meta[p]['pollutant']==pol and p != sid]\n    if len(peers) == 0: continue\n    s = ts_map[sid].dropna()\n    lag0_corrs = []\n    max_corrs = []  # max over small lags?\n    for p in peers:\n        p_s = ts_map[p].dropna()\n        common = s.index.intersection(p_s.index)\n        if len(common) > 10:\n            lag0 = s.loc[common].corr(p_s.loc[common])\n            lag0_corrs.append(lag0)\n            # check small lags\n            c = []\n            for lag in [-2,-1,0,1,2]:\n                if lag < 0:\n                    sa, pb = s.loc[common], p_s.loc[common].shift(-lag)\n                elif lag > 0:\n                    sa, pb = s.loc[common].shift(lag), p_s.loc[common]\n                else:\n                    sa, pb = s.loc[common], p_s.loc[common]\n                cm = pd.concat([sa, pb], axis=1).dropna()\n                if len(cm) > 5:\n                    c.append(cm.iloc[:,0].corr(cm.iloc[:,1]))\n            if c: max_corrs.append(np.max(c))\n            else: max_corrs.append(lag0)\n    if lag0_corrs and max_corrs:\n        results.append((sid, dist, pol, np.median(lag0_corrs), np.median(max_corrs), np.median(max_corrs)-np.median(lag0_corrs)))\n\nres = pd.DataFrame(results, columns=['sid','dist','pol','lag0_med','max_med','diff'])\nres = res.sort_values('diff', ascending=False)\nprint(res.head(15))\nPY" action.permission=* action.action=allow action.pattern=*
