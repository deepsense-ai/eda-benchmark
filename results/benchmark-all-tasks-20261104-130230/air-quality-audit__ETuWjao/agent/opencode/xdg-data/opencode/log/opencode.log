timestamp=2026-11-04T12:12:56.348Z level=INFO run=b7b1a579 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\nreadings['current_reading'] = pd.to_numeric(readings['current_reading'], errors='coerce')\ndf = readings.merge(stations, on='station_id', how='left')\n\nw_r = pd.read_csv('/app/dataset/weather_readings.csv')\nw_r['timestamp'] = pd.to_datetime(w_r['timestamp'])\nweather_agg = w_r.groupby(['district', 'timestamp']).agg({\n    'temperature_c': 'mean',\n    'humidity_pct': 'mean',\n    'wind_speed_m_s': 'mean',\n    'rain_accumulation_mm': 'mean',\n}).reset_index()\ndf = df.merge(weather_agg, on=['district', 'timestamp'], how='left')\n\nts_map = {}\nmeta = {}\nfor sid, g in df.groupby('station_id'):\n    g = g.sort_values('timestamp').copy()\n    ts_map[sid] = g.set_index('timestamp')['current_reading']\n    meta[sid] = {'district': g['district'].iloc[0], 'pollutant': g['pollutant'].iloc[0]}\n\n# Look at ST060 time series and its peers\nsid = 'ST060'\ndist = meta[sid]['district']\npol = meta[sid]['pollutant']\npeers = [p for p in ts_map if meta[p]['district']==dist and meta[p]['pollutant']==pol and p != sid]\nprint(f'{sid} peers: {peers}')\ns = ts_map[sid]\npeer_stack = []\nfor p in peers: peer_stack.append(ts_map[p])\npeer_df = pd.concat(peer_stack, axis=1)\npeer_med = peer_df.median(axis=1, skipna=True)\ncommon = s.dropna().index.intersection(peer_med.dropna().index)\nfor i, t in enumerate(common[:12]):\n    rain = df[df['timestamp']==t]['rain_accumulation_mm'].iloc[0] if not df[df['timestamp']==t]['rain_accumulation_mm'].empty else np.nan\n    print(f'{i}: {t}  {sid}={s.loc[t]:5.1f}  med={peer_med.loc[t]:5.1f}  resid={s.loc[t]-peer_med.loc[t]:5.1f}  rain={rain:4.2f}')\nPY" action.permission=* action.action=allow action.pattern=*
