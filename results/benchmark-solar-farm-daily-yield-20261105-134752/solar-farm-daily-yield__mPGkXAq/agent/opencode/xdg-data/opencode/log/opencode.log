timestamp=2026-11-05T12:59:37.892Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="python3 << 'PY'\n# Build a full picture of each farm's file characteristics\nfiles = [\n 'FARM_A', 'FARM_B', 'FARM_C', 'FARM_D', 'FARM_E', 'FARM_F', 'FARM_G', 'FARM_H', 'FARM_I', 'FARM_J',\n 'FARM_K', 'FARM_L', 'FARM_M', 'FARM_N', 'FARM_O', 'FARM_P', 'FARM_Q', 'FARM_R', 'FARM_S', 'FARM_T',\n 'FARM_U', 'FARM_V', 'FARM_W', 'FARM_X',\n]\nfor fid in files[:8]:\n    path = f'/app/dataset/production_{fid}.csv'\n    with open(path, 'rb') as f:\n        b = f.read(2)\n    enc = 'utf-16le' if b == b'\\xff\\xfe' else 'utf-8'\n    with open(path, 'r', encoding=enc, errors='replace') as f:\n        for i, line in enumerate(f):\n            if i == 4:\n                # check delimiter style\n                line = line\n                has_semicolon = ';' in line\n                has_comma_decimal = ',' in line and any(c.isdigit() for c in line) and line.count(',') > line.count('.')  # rough\n                # or just look for pattern like ,0000 or ,1700\n                print(f'{fid}: enc={enc}, semicolon={has_semicolon}')\n                break\nPY" action.permission=* action.action=allow action.pattern=*
