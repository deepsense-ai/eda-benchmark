timestamp=2026-11-05T13:40:03.503Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom dateutil import parser\nfrom zoneinfo import ZoneInfo\nimport csv\nimport json\nimport os\n\nDATASET = '/app/dataset'\nfid = 'FARM_T'\n\n# mappings\nname2id = {}\nwith open(f'{DATASET}/farm_registry.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        name2id[row['farm_name'].strip().lower()] = row['farm_id']\nid2tz = {}\nwith open(f'{DATASET}/farms.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        name = row['farm_name'].strip().lower()\n        tz = row['timezone'].strip()\n        fidm = name2id.get(name)\n        if fidm:\n            id2tz[fidm] = tz\n\n# load\npath = f'{DATASET}/production_{fid}.csv'\nwith open(path, 'rb') as f:\n    b = f.read(2)\nenc = 'utf-16le' if b == b'\\xff\\xfe' else 'utf-8'\nsep = ','\nwith open(path, 'r', encoding=enc, errors='replace') as f:\n    for i, line in enumerate(f):\n        if i == 4:\n            sep = ';' if ';' in line else ','\n            break\ndf = pd.read_csv(path, encoding=enc, sep=sep, skiprows=3, engine='python')\ndf.columns = [str(c).strip().replace('\\t', '') for c in df.columns]\ncols = pd.Series(df.columns)\nfor dup in cols[cols.duplicated()].unique():\n    cnt = 0\n    for i, c in enumerate(cols):\n        if c == dup:\n            cnt += 1\n            if cnt > 1:\n                cols.iloc[i] = f\"{dup}_{cnt}\"\ndf.columns = cols\ndef safe_parse(x):\n    try:\n        return parser.parse(str(x))\n    except:\n        return pd.NaT\ndf['timestamp'] = df['timestamp'].apply(safe_parse)\ndf = df[df['timestamp'].notna()]\n# tz\ntz = id2tz.get(fid)\nif tz:\n    if df['timestamp'].dt.tz is None:\n        df['timestamp_utc'] = df['timestamp'].dt.tz_localize(ZoneInfo(tz)).dt.tz_convert('UTC')\n    else:\n        df['timestamp_utc'] = df['timestamp'].dt.tz_convert('UTC')\n\n# calib\nwith open(f'{DATASET}/sensors_calibration.json') as f:\n    c = json.load(f)\ncalib = c['enterprise_platform']['deployment_environments']['system_config']['farms'][fid]\nvalcol = calib['calibration_data']['value_column_name'].strip()\n# find\nfor col in df.columns:\n    if col.strip() == valcol or col.strip().replace(' ', '') == valcol.replace(' ', ''):\n        valcol_used = col\n        break\nelse:\n    valcol_used = valcol\n\n# euro to float\ndef euro_to_float(s):\n    if isinstance(s, (int, float)) and not pd.isna(s):\n        return float(s)\n    s = str(s).strip()\n    if '.' in s and ',' in s:\n        s = s.replace('.', '').replace(',', '.')\n    elif ',' in s and '.' not in s:\n        s = s.replace(',', '.')\n    try:\n        return float(s)\n    except:\n        return float('nan')\n\ndf['value_raw'] = df[valcol_used].apply(euro_to_float)\noffset = float(calib['calibration_data']['calibration_offset'])\ndf['value_true'] = df['value_raw'] - offset\ndf = df[df['value_true'] >= 0]\nprint('len', len(df))\nprint(df['value_true'].describe())\nPY" action.permission=* action.action=allow action.pattern=*
