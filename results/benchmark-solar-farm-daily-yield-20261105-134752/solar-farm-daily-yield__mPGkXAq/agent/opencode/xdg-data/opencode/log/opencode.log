timestamp=2026-11-05T13:06:17.207Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\nDATASET = '/app/dataset'\nfid = 'FARM_C'\npath = f'{DATASET}/production_{fid}.csv'\nwith open(path, 'rb') as f:\n    b = f.read(2)\nenc = 'utf-16le' if b == b'\\xff\\xfe' else 'utf-8'\n# sep\nwith open(path, 'r', encoding=enc, errors='replace') as f:\n    for i, line in enumerate(f):\n        if i == 4:\n            sep = ';' if ';' in line else ','\n            break\ndf = pd.read_csv(path, encoding=enc, sep=sep, skiprows=3)\ndf.columns = [c.strip().replace('\\t', '') for c in df.columns]\n\n# Try European number parsing for columns that are numeric\n# Convert by replacing . and , appropriately\ndef euro_to_float(s):\n    if isinstance(s, (int, float)) and not pd.isna(s):\n        return float(s)\n    s = str(s).strip()\n    # Handle format like 18.000,0000 or 35,1700\n    # If there are both . and , and comma is after dot positions (thousands then decimal), common is . as thousands, , as decimal\n    if '.' in s and ',' in s:\n        # assume . is thousands sep, , is decimal\n        s = s.replace('.', '').replace(',', '.')\n    elif ',' in s and '.' not in s:\n        # comma as decimal\n        s = s.replace(',', '.')\n    # else dot as decimal, leave\n    try:\n        return float(s)\n    except:\n        return np.nan\n\nimport numpy as np\n# test\nprint(euro_to_float('18.000,0000'), euro_to_float('35,1700'), euro_to_float('0,0000'))\nPY" action.permission=* action.action=allow action.pattern=*
