timestamp=2026-11-05T13:09:19.460Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef parse_maintenance_windows():\n    # parse maintenance notes\n    windows = []  # (farm_id, start_utc, end_utc, completed)\n    path = os.path.join(DATASET, 'maintenance_notes.txt')\n    with open(path) as f:\n        content = f.read()\n    # look for patterns\n    # Examples:\n    # \"System firmware update on Sakura Energy Site on the 16th of March from 08:00 to 12:00 local time. Status: COMPLETED.\"\n    # \"Panel inspection on Sakura Energy Site on March 15th from 09:00 to 11:00 local time. CANCELLED...\"\n    # \"Scheduled cleaning at Vistula Photovoltaics on March 15, starting at 12:00 and finishing at 14:00 local time. Status: COMPLETED.\"\n    # try to extract\n    lines = content.splitlines()\n    for line in lines:\n        line_lower = line.lower()\n        if 'status:' not in line_lower:\n            continue\n        # extract status\n        mstatus = None\n        if 'completed' in line_lower:\n            mstatus = 'completed'\n        elif 'cancelled' in line_lower or 'canceled' in line_lower:\n            mstatus = 'cancelled'\n        else:\n            continue\n        # extract farm name - look for common patterns\n        # after \"on\" or \"at\"\n        # find time range\n        # look for from HH:MM to HH:MM\n        import re\n        # time\n        mt = re.search(r'from\\s+(\\d{1,2}):(\\d{2})\\s+to\\s+(\\d{1,2}):(\\d{2})', line_lower)\n        if not mt:\n            # try \"starting at ... finishing at\"\n            mt = re.search(r'starting at\\s+(\\d{1,2}):(\\d{2}).*finishing at\\s+(\\d{1,2}):(\\d{2})', line_lower)\n        if not mt:\n            # try just \"from ... to ...\" with different format\n            mt = re.search(r'(\\d{1,2}):(\\d{2})\\s+to\\s+(\\d{1,2}):(\\d{2})', line_lower)\n        if not mt:\n            continue\n        h1, m1, h2, m2 = int(mt.group(1)), int(mt.group(2)), int(mt.group(3)), int(mt.group(4))\n        # date\n        # look for 16th of March, March 15th, March 15\n        mdate = re.search(r'(\\d{1,2})(?:st|nd|rd|th)?\\s+of\\s+(january|february|march|april|may|june|july|august|september|october|november|december)', line_lower)\n        if not mdate:\n            mdate = re.search(r'(january|february|march|april|may|june|july|august|september|october|november|december)\\s+(\\d{1,2})(?:st|nd|rd|th)?', line_lower)\n        if not mdate:\n            continue\n        if len(mdate.groups()) == 2:\n            # month first\n            month_str = mdate.group(1)\n            day = int(mdate.group(2))\n        else:\n            day = int(mdate.group(1))\n            month_str = mdate.group(2)\n        month_map = {'january':1,'february':2,'march':3,'april':4,'may':5,'june':6,'july':7,'august':8,'september':9,'october':10,'november':11,'december':12}\n        month = month_map.get(month_str)\n        if month is None:\n            continue\n        year = 2024\n        # find farm name\n        farm_id = None\n        # map by known names\n        if 'sakura' in line_lower:\n            farm_id = 'FARM_C'\n        elif 'vistula' in line_lower:\n            farm_id = 'FARM_F'\n        if farm_id is None:\n            continue\n        # build local start/end\n        tz = id2tz.get(farm_id)\n        if tz is None:\n            continue\n        try:\n            start_local = datetime(year, month, day, h1, m1, tzinfo=ZoneInfo(tz))\n            end_local = datetime(year, month, day, h2, m2, tzinfo=ZoneInfo(tz))\n        except Exception:\n            continue\n        # if end is before start (e.g., overnight) unlikely here, but just in case\n        start_utc = start_local.astimezone(ZoneInfo('UTC'))\n        end_utc = end_local.astimezone(ZoneInfo('UTC'))\n        windows.append({\n            'farm_id': farm_id,\n            'start_utc': start_utc,\n            'end_utc': end_utc,\n            'completed': (mstatus == 'completed')\n        })\n    return windows\nPY" action.permission=* action.action=allow action.pattern=*
