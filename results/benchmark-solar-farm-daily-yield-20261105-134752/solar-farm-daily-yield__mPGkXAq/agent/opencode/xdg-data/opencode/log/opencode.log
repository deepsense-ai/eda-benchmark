timestamp=2026-11-05T13:09:00.309Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef apply_safety_protocols(df, fid):\n    # \"If inverter_temperature_C exceeds 85.0C, the unit enters emergency shutdown. Readings for the 45 minutes immediately following such a spike must be invalidated.\"\n    if 'inverter_temperature_C' not in df.columns:\n        return df\n    # find spikes where temp > 85.0\n    df = df.sort_values('timestamp').reset_index(drop=True)\n    to_invalidate = pd.Series([False] * len(df), index=df.index)\n    # look for spikes\n    temps = df['inverter_temperature_C'].apply(lambda x: euro_to_float(x) if pd.notna(x) else np.nan)\n    for i in range(len(df)):\n        tval = temps.iloc[i]\n        if pd.notna(tval) and tval > 85.0:\n            # invalidate next 45 minutes\n            spike_time = df['timestamp'].iloc[i]\n            end_time = spike_time + timedelta(minutes=45)\n            # mark all rows with timestamp > spike_time and timestamp <= end_time? or >= spike_time+small step?\n            # \"readings for the 45 minutes immediately following such a spike must be invalidated\"\n            mask = (df['timestamp'] > spike_time) & (df['timestamp'] <= end_time)\n            to_invalidate = to_invalidate | mask\n    df = df[~to_invalidate]\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
