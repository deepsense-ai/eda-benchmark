timestamp=2026-11-05T12:51:33.337Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\n\n# Build name->id\nname2id = {}\nwith open('/app/dataset/farm_registry.csv') as f:\n    reader = csv.DictReader(f)\n    for r in reader:\n        name2id[r['farm_name'].strip().lower()] = r['farm_id']\n\n# Build id->tz\nid2tz = {}\nwith open('/app/dataset/farms.csv') as f:\n    reader = csv.DictReader(f)\n    for r in reader:\n        name = r['farm_name'].strip().lower()\n        tz = r['timezone'].strip()\n        fid = name2id.get(name)\n        if fid:\n            id2tz[fid] = tz\n        else:\n            print('no match for', name)\nPY" action.permission=* action.action=allow action.pattern=*
