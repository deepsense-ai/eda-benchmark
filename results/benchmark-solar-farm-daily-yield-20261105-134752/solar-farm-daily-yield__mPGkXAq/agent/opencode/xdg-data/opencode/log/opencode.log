timestamp=2026-11-05T13:39:29.506Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom dateutil import parser\nfrom zoneinfo import ZoneInfo\n\nDATASET = '/app/dataset'\nfid = 'FARM_T'\n\n# load like we do\npath = f'{DATASET}/production_{fid}.csv'\nwith open(path, 'rb') as f:\n    b = f.read(2)\nenc = 'utf-16le' if b == b'\\xff\\xfe' else 'utf-8'\nsep = ','\nwith open(path, 'r', encoding=enc, errors='replace') as f:\n    for i, line in enumerate(f):\n        if i == 4:\n            sep = ';' if ';' in line else ','\n            break\ndf = pd.read_csv(path, encoding=enc, sep=sep, skiprows=3, engine='python')\ndf.columns = [str(c).strip().replace('\\t', '') for c in df.columns]\n# dedup\ncols = pd.Series(df.columns)\nfor dup in cols[cols.duplicated()].unique():\n    cnt = 0\n    for i, c in enumerate(cols):\n        if c == dup:\n            cnt += 1\n            if cnt > 1:\n                cols.iloc[i] = f\"{dup}_{cnt}\"\ndf.columns = cols\n# parse ts\ndef safe_parse(x):\n    try:\n        return parser.parse(str(x))\n    except:\n        return pd.NaT\ndf['timestamp'] = df['timestamp'].apply(safe_parse)\ndf = df[df['timestamp'].notna()]\n# tz\nfrom zoneinfo import ZoneInfo\n# get tz\n# quick\nid2tz = {'FARM_T': 'Asia/Kolkata'}  # approximate from earlier? Ganges Solar is Asia/Kolkata - let us check\npass\nPY" action.permission=* action.action=allow action.pattern=*
