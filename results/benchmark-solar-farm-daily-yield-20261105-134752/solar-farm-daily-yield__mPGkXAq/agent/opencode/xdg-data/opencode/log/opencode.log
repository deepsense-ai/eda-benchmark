timestamp=2026-11-05T13:11:22.855Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef parse_maintenance_windows():\n    windows = []\n    path = os.path.join(DATASET, 'maintenance_notes.txt')\n    if not os.path.exists(path):\n        return windows\n    with open(path) as f:\n        content = f.read()\n    lines = content.splitlines()\n    for line in lines:\n        line_lower = line.lower()\n        if 'status:' not in line_lower:\n            continue\n        if 'completed' in line_lower:\n            mstatus = 'completed'\n        elif 'cancelled' in line_lower or 'canceled' in line_lower:\n            mstatus = 'cancelled'\n        else:\n            continue\n        mt = None\n        m = re.search(r'from\\s+(\\d{1,2}):(\\d{2})\\s+to\\s+(\\d{1,2}):(\\d{2})', line_lower)\n        if m:\n            mt = m\n        else:\n            m = re.search(r'starting at\\s+(\\d{1,2}):(\\d{2}).*finishing at\\s+(\\d{1,2}):(\\d{2})', line_lower)\n            if m:\n                mt = m\n            else:\n                m = re.search(r'(\\d{1,2}):(\\d{2})\\s+to\\s+(\\d{1,2}):(\\d{2})', line_lower)\n                if m:\n                    mt = m\n        if not mt:\n            continue\n        h1, m1, h2, m2 = int(mt.group(1)), int(mt.group(2)), int(mt.group(3)), int(mt.group(4))\n        mdate = re.search(r'(\\d{1,2})(?:st|nd|rd|th)?\\s+of\\s+(january|february|march|april|may|june|july|august|september|october|november|december)', line_lower)\n        if not mdate:\n            mdate = re.search(r'(january|february|march|april|may|june|july|august|september|october|november|december)\\s+(\\d{1,2})(?:st|nd|rd|th)?', line_lower)\n        if not mdate:\n            continue\n        if len(mdate.groups()) == 2 and mdate.group(1).isdigit():\n            day = int(mdate.group(1))\n            month_str = mdate.group(2)\n        else:\n            # month first\n            month_str = mdate.group(1)\n            day = int(mdate.group(2))\n        month_map = {'january':1,'february':2,'march':3,'april':4,'may':5,'june':6,'july':7,'august':8,'september':9,'october':10,'november':11,'december':12}\n        month = month_map.get(month_str)\n        if month is None:\n            continue\n        year = 2024\n        farm_id = None\n        if 'sakura' in line_lower:\n            farm_id = 'FARM_C'\n        elif 'vistula' in line_lower:\n            farm_id = 'FARM_F'\n        if farm_id is None:\n            continue\n        tz = id2tz.get(farm_id)\n        if tz is None:\n            continue\n        try:\n            start_local = datetime(year, month, day, h1, m1, tzinfo=ZoneInfo(tz))\n            end_local = datetime(year, month, day, h2, m2, tzinfo=ZoneInfo(tz))\n        except Exception:\n            continue\n        start_utc = start_local.astimezone(ZoneInfo('UTC'))\n        end_utc = end_local.astimezone(ZoneInfo('UTC'))\n        windows.append({\n            'farm_id': farm_id,\n            'start_utc': start_utc,\n            'end_utc': end_utc,\n            'completed': (mstatus == 'completed')\n        })\n    return windows\nPY" action.permission=* action.action=allow action.pattern=*
