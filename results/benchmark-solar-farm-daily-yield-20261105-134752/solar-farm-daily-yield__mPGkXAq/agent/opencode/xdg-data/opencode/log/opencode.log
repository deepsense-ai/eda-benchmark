timestamp=2026-11-05T13:16:03.650Z level=INFO run=e7dc0897 message=evaluated permission=bash pattern="cat > /tmp/load_fix.py << 'PY'\ncode = r\"\"\"\ndef load_production(fid):\n    path = os.path.join(DATASET, f'production_{fid}.csv')\n    if not os.path.exists(path):\n        return None\n    with open(path, 'rb') as f:\n        b = f.read(2)\n    enc = 'utf-16le' if b == b'\\xff\\xfe' else 'utf-8'\n    sep = ','\n    with open(path, 'r', encoding=enc, errors='replace') as f:\n        for i, line in enumerate(f):\n            if i == 4:\n                sep = ';' if ';' in line else ','\n                break\n    try:\n        df = pd.read_csv(path, encoding=enc, sep=sep, skiprows=3, engine='python')\n    except Exception:\n        df = pd.read_csv(path, encoding=enc, skiprows=3, engine='python')\n    df.columns = [str(c).strip().replace('\\t', '') for c in df.columns]\n    if 'timestamp' not in df.columns:\n        for c in df.columns:\n            if 'timestamp' in c.lower():\n                df = df.rename(columns={c: 'timestamp'})\n                break\n    def safe_parse(x):\n        try:\n            return dateparser.parse(str(x))\n        except Exception:\n            return pd.NaT\n    df['timestamp'] = df['timestamp'].apply(safe_parse)\n    df = df[df['timestamp'].notna()]\n    return df\n\"\"\"\nprint('ok')\nPY" action.permission=* action.action=allow action.pattern=*
