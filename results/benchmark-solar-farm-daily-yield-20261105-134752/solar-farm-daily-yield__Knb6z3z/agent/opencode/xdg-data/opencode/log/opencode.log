timestamp=2026-11-05T12:54:53.528Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# test with FARM_B\nfrom io import StringIO\nimport pandas as pd\n\ndef read_prod(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    enc = 'utf-16le' if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff') else 'utf-8'\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    header = lines[3].strip().replace('\\ufeff', '').replace('\\t', ' ').strip()\n    data = '\\n'.join(l.strip() for l in lines[4:] if l.strip())\n    for sep in [',', ';', '\\t', '|']:\n        try:\n            df = pd.read_csv(StringIO(header + '\\n' + data), sep=sep)\n            if df.shape[1] > 1:\n                df.columns = [c.strip() for c in df.columns]\n                return df\n        except:\n            continue\n    df = pd.read_csv(StringIO(header + '\\n' + data), sep=None, engine='python')\n    df.columns = [c.strip() for c in df.columns]\n    return df\n\ndf = read_prod('/app/dataset/production_FARM_B.csv')\nprint(df.columns)\nPY" action.permission=* action.action=allow action.pattern=*
