timestamp=2026-11-05T13:28:20.223Z level=INFO run=3351243d message=evaluated permission=bash pattern="cat >> /tmp/answer_final.py << 'PY'\n\ndef load_all_info():\n    farm_id_to_name = {}\n    with open('/app/dataset/farm_registry.csv') as f:\n        r = csv.DictReader(f)\n        for row in r:\n            farm_id_to_name[row['farm_id']] = row['farm_name'].strip()\n    farm_meta = {}\n    with open('/app/dataset/farms.csv') as f:\n        r = csv.DictReader(f)\n        for row in r:\n            farm_meta[row['farm_name'].strip().lower()] = row['timezone'].strip()\n    with open('/app/dataset/sensors_calibration.json') as f:\n        calib = json.load(f)\n    farms_cal = calib['enterprise_platform']['deployment_environments']['system_config']['farms']\n    return farm_id_to_name, farm_meta, farms_cal\n\ndef load_maintenance_windows():\n    text = open('/app/dataset/maintenance_notes.txt').read()\n    wins = []\n    for line in text.splitlines():\n        if 'completed' not in line.lower():\n            continue\n        m = re.search(r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+of\\s+(\\w+)[^\\d]*(?:from\\s+)?(\\d{1,2}:\\d{2})[^\\d]*(?:to|and finishing at|until)\\s+(\\d{1,2}:\\d{2})', line, re.I)\n        if m:\n            site, day, mon, t1, t2 = m.groups()\n            wins.append((site.strip(), int(day), mon.strip(), t1, t2)); continue\n        m = re.search(r'at\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d{1,2})(?:,|\\b)[^\\d]*(\\d{1,2}:\\d{2})[^\\d]*(?:to|and finishing at|until)\\s+(\\d{1,2}:\\d{2})', line, re.I)\n        if m:\n            site, mon, day, t1, t2 = m.groups()\n            wins.append((site.strip(), int(day), mon.strip(), t1, t2)); continue\n    months = {m:i for i,m in enumerate(['January','February','March','April','May','June','July','August','September','October','November','December'], 1)}\n    farm_id_to_name, farm_meta, _ = load_all_info()\n    name_to_fid = {v.lower(): k for k,v in farm_id_to_name.items()}\n    windows = []\n    for site, day, mon, t1, t2 in wins:\n        fid = name_to_fid.get(site.lower())\n        tz = farm_meta.get(site.lower())\n        if not fid: continue\n        start = datetime(2024, months[mon], day, int(t1.split(':')[0]), int(t1.split(':')[1]))\n        end = datetime(2024, months[mon], day, int(t2.split(':')[0]), int(t2.split(':')[1]))\n        windows.append({'farm_id': fid, 'tz': tz, 'start_local': start, 'end_local': end})\n    return windows\nPY" action.permission=* action.action=allow action.pattern=*
