timestamp=2026-11-05T13:05:15.530Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# Now actually run for FARM_A with all rules\nimport json, csv, os, re\nfrom io import StringIO\nimport pandas as pd\nfrom datetime import datetime, timedelta\nfrom zoneinfo import ZoneInfo\n\n# defs\ndef norm_num(x):\n    if pd.isna(x): return pd.NA\n    if isinstance(x, (int, float)): return float(x)\n    s = str(x).strip()\n    if s == '': return pd.NA\n    if '.' in s and ',' in s:\n        s = s.replace('.', '').replace(',', '.')\n    elif ',' in s and '.' not in s:\n        s = s.replace(',', '.')\n    try: return float(s)\n    except: return pd.NA\ndef norm_dt(x):\n    if pd.isna(x): return pd.NaT\n    s = str(x).strip()\n    for kwargs in [{}, {'dayfirst': True}]:\n        try:\n            dt = pd.to_datetime(s, errors='coerce', **kwargs)\n            if pd.notna(dt): return dt\n        except: pass\n    return pd.NaT\ndef read_prod_robust(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    enc = 'utf-16le' if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff') else 'utf-8'\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    header_idx = None\n    for i, l in enumerate(lines[:15]):\n        ll = l.lower()\n        if 'timestamp' in ll:\n            header_idx = i; break\n    if header_idx is None:\n        for i, l in enumerate(lines[:15]):\n            sc = sum(l.count(c) for c in [',',';','\\t','|'])\n            if sc > 5: header_idx = i; break\n    if header_idx is None: header_idx = 3\n    header = lines[header_idx].strip().replace('\\ufeff','')\n    header = re.sub(r'[\\t\\r\\n]+',' ', header)\n    best_sep = ','; best = -1\n    for sep in [',',';','\\t','|']:\n        c = header.count(sep)\n        if c > best: best=c; best_sep=sep\n    data = '\\n'.join(l.strip() for l in lines[header_idx+1:] if l.strip() and not l.strip().startswith('#'))\n    try:\n        df = pd.read_csv(StringIO(header + '\\n' + data), sep=best_sep, engine='python')\n    except:\n        df = pd.read_csv(StringIO(header + '\\n' + data), sep=None, engine='python')\n    df.columns = [c.strip() for c in df.columns]\n    df.columns = [re.sub(r'[^a-zA-Z0-9_]', '_', c) for c in df.columns]\n    df.columns = [re.sub(r'_+', '_', c).strip('_') for c in df.columns]\n    return df\n\n# load info\nfarm_id_to_name = {}\nwith open('/app/dataset/farm_registry.csv') as f:\n    r = csv.DictReader(f)\n    for row in r: farm_id_to_name[row['farm_id']] = row['farm_name'].strip()\nfarm_meta = {}\nwith open('/app/dataset/farms.csv') as f:\n    r = csv.DictReader(f)\n    for row in r: farm_meta[row['farm_name'].strip().lower()] = row['timezone'].strip()\nwith open('/app/dataset/sensors_calibration.json') as f:\n    calib = json.load(f)\nfarms_cal = calib['enterprise_platform']['deployment_environments']['system_config']['farms']\n\nfid = 'FARM_A'\nname = farm_id_to_name[fid]\ntz_str = farm_meta[name.lower()]\nc = farms_cal[fid]\ninfo = {\n  'tz': tz_str,\n  'value_col': c['calibration_data']['value_column_name'].strip(),\n  'calib_offset': float(c['calibration_data']['calibration_offset'] or 0),\n}\n\ndf = read_prod_robust(f'/app/dataset/production_{fid}.csv')\ndf['timestamp'] = df['timestamp'].apply(norm_dt)\n# find vc\nvc = info['value_col']\n# normalize vc match\nvc_clean = re.sub(r'[^a-zA-Z0-9_]', '_', vc)\nvc_clean = re.sub(r'_+', '_', vc_clean).strip('_')\nif vc_clean not in df.columns and vc not in df.columns:\n    # search\n    for col in df.columns:\n        if col.lower() == vc.lower() or col.lower() == vc_clean.lower():\n            vc_use = col; break\n    else:\n        candidates = [c for c in df.columns if 'read' in c.lower() or 'value' in c.lower() or 'yield' in c.lower() or 'power' in c.lower() or 'output' in c.lower()]\n        vc_use = candidates[0] if candidates else df.columns[-1]\nelse:\n    vc_use = vc_clean if vc_clean in df.columns else vc\n\ndf['value_raw'] = df[vc_use].apply(norm_num)\ndf = df.dropna(subset=['timestamp', 'value_raw'])\n# duplicates\ndf = df.drop_duplicates()\n\n# parse timestamps as UTC/local? Timestamps in files - we need to interpret them correctly. The maintenance windows are given in local civil time. The reporting window for answer is UTC: [2024-03-15 00:00:00 UTC, 2024-03-16 00:00:00 UTC). So to filter readings belonging to that UTC day, we must convert each reading's timestamp to UTC. What timezone are the reading timestamps recorded in? Usually production data timestamps are in local time unless stated; but the answer window is specified in UTC. Also maintenance is local. That means we need to treat reading timestamps as local times in the farm's timezone, convert to UTC for filtering the reporting window, and also for comparing with maintenance windows (maintenance windows are also local).\nprint('tz', tz_str, 'rows', len(df))\nPY" action.permission=* action.action=allow action.pattern=*
