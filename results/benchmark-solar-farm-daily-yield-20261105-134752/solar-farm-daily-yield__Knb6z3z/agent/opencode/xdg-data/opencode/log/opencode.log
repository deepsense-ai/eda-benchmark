timestamp=2026-11-05T13:38:00.625Z level=INFO run=3351243d message=evaluated permission=bash pattern="cat >> /tmp/answer_final2.py << 'PY'\n\ndef compute_farm_total(farm_id, farm_id_to_name, farm_meta, farms_cal, windows):\n    name = farm_id_to_name.get(farm_id)\n    if not name: return 0\n    tz_str = farm_meta.get(name.lower(), 'UTC')\n    c = farms_cal.get(farm_id, {})\n    vc_spec = c.get('calibration_data', {}).get('value_column_name', 'value')\n    calib_off = float(c.get('calibration_data', {}).get('calibration_offset') or 0)\n    prod_path = f'/app/dataset/production_{farm_id}.csv'\n    try:\n        df = read_prod_robust(prod_path)\n    except Exception:\n        return 0\n    if df.empty: return 0\n    df['timestamp'] = df['timestamp'].apply(norm_dt)\n    vc_use = str(vc_spec).strip()\n    vc_cand = re.sub(r'[^a-zA-Z0-9_]', '_', vc_use).strip('_')\n    found = None\n    for col in df.columns:\n        cl = col.lower()\n        if cl == vc_use.lower(): found = col; break\n        if cl == vc_cand.lower(): found = col; break\n        if vc_use and vc_use.replace(' ', '_').lower() == cl: found = col; break\n    if found is None:\n        cands = [c for c in df.columns if any(k in c.lower() for k in ['read', 'value', 'yield', 'power', 'output', 'energy', 'wh', 'kwh', 'mwh'])]\n        found = cands[0] if cands else None\n    if found is None: return 0\n    df = df.reset_index(drop=True)\n    df['value_raw'] = pd.Series([norm_num(x) for x in df[found].values], index=df.index)\n    df = df.dropna(subset=['timestamp', 'value_raw'])\n    df = df.drop_duplicates()\n    if df.empty: return 0\n    try: tz = ZoneInfo(tz_str)\n    except Exception: tz = ZoneInfo('UTC')\n    df['ts_local'] = df['timestamp'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\n    df['ts_utc'] = df['ts_local'].dt.tz_convert('UTC')\n    df['value_true'] = df['value_raw'] - calib_off\n    df = df[df['value_true'] >= 0]\n    start_utc = pd.Timestamp('2024-03-15 00:00:00', tz='UTC')\n    end_utc = pd.Timestamp('2024-03-16 00:00:00', tz='UTC')\n    df_day = df[(df['ts_utc'] >= start_utc) & (df['ts_utc'] < end_utc)].copy()\n    if df_day.empty: return 0\n    farm_windows = [w for w in windows if w['farm_id'] == farm_id]\n    if farm_windows:\n        mask = pd.Series([True]*len(df_day), index=df_day.index)\n        for w in farm_windows:\n            try: wtz = ZoneInfo(w['tz']) if w['tz'] else tz\n            except Exception: wtz = tz\n            wstart = w['start_local']; wend = w['end_local']\n            if getattr(wstart,'tzinfo',None) is None: wstart_local = wstart.replace(tzinfo=wtz)\n            else: wstart_local = wstart\n            if getattr(wend,'tzinfo',None) is None: wend_local = wend.replace(tzinfo=wtz)\n            else: wend_local = wend\n            excl = (df_day['ts_local'] >= wstart_local) & (df_day['ts_local'] < wend_local)\n            mask = mask & (~excl)\n        df_day = df_day[mask].copy()\n    if df_day.empty: return 0\n    unit = (c.get('sensor_info',{}).get('unit') or '').strip().lower()\n    rtype = (c.get('sensor_info',{}).get('reading_type') or '').strip().lower()\n    total = float(df_day['value_true'].sum())\n    if rtype == 'energy':\n        if unit in ('kwh','kw h'): total_kwh = total\n        elif unit == 'mwh': total_kwh = total*1000.0\n        elif unit == 'wh': total_kwh = total/1000.0\n        elif unit in ('btu','btus'): total_kwh = total/3412.141633127942\n        else: total_kwh = total\n    elif rtype == 'power':\n        if len(df_day)>=2:\n            intervals = df_day['ts_utc'].sort_values().diff().dropna()\n            med = intervals.median() if not intervals.empty else pd.Timedelta(minutes=30)\n            hours = med.total_seconds()/3600.0\n            if hours<=0: hours=0.5\n        else: hours=0.5\n        if unit == 'kw': total_kwh = total*hours\n        elif unit == 'mw': total_kwh = total*hours*1000.0\n        elif unit == 'w': total_kwh = total*hours/1000.0\n        else: total_kwh = total*hours\n    else:\n        total_kwh = total\n    return total_kwh\nPY" action.permission=* action.action=allow action.pattern=*
