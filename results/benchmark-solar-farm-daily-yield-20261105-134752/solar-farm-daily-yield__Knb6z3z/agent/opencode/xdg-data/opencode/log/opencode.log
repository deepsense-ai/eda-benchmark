timestamp=2026-11-05T13:15:08.551Z level=INFO run=3351243d message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef compute_farm_total(farm_id, farm_id_to_name, farm_meta, farms_cal, windows):\n    name = farm_id_to_name.get(farm_id)\n    if not name:\n        return 0\n    tz_str = farm_meta.get(name.lower())\n    if not tz_str:\n        tz_str = 'UTC'\n    c = farms_cal.get(farm_id, {})\n    vc_spec = c.get('calibration_data', {}).get('value_column_name', 'value')\n    calib_off = float(c.get('calibration_data', {}).get('calibration_offset') or 0)\n    prod_path = f'/app/dataset/production_{farm_id}.csv'\n    try:\n        df = read_prod_robust(prod_path)\n    except Exception:\n        return 0\n    if df.empty:\n        return 0\n    # normalize timestamp\n    df['timestamp'] = df['timestamp'].apply(norm_dt)\n    # resolve value col\n    vc_use = vc_spec\n    vc_cand = re.sub(r'[^a-zA-Z0-9_]', '_', str(vc_spec)).strip('_')\n    if vc_use not in df.columns and vc_cand not in df.columns:\n        # search\n        for col in df.columns:\n            cl = col.lower()\n            vs = str(vc_spec).lower()\n            vcn = vc_cand.lower()\n            if cl == vs or cl == vcn:\n                vc_use = col; break\n        else:\n            cands = [c for c in df.columns if any(k in c.lower() for k in ['read', 'value', 'yield', 'power', 'output', 'energy', 'wh', 'kwh', 'mwh'])]\n            if cands:\n                vc_use = cands[0]\n            else:\n                return 0\n    else:\n        if vc_cand in df.columns:\n            vc_use = vc_cand\n    df['value_raw'] = df[vc_use].apply(norm_num)\n    df = df.dropna(subset=['timestamp', 'value_raw'])\n    df = df.drop_duplicates()\n    if df.empty:\n        return 0\n    # localize and convert to utc\n    try:\n        tz = ZoneInfo(tz_str)\n    except Exception:\n        tz = ZoneInfo('UTC')\n    df['ts_local'] = df['timestamp'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\n    df['ts_utc'] = df['ts_local'].dt.tz_convert('UTC')\n    # apply calibration\n    df['value_true'] = df['value_raw'] - calib_off\n    # drop negatives\n    df = df[df['value_true'] >= 0]\n    # filter to utc day\n    start_utc = pd.Timestamp('2024-03-15 00:00:00', tz='UTC')\n    end_utc = pd.Timestamp('2024-03-16 00:00:00', tz='UTC')\n    df_day = df[(df['ts_utc'] >= start_utc) & (df['ts_utc'] < end_utc)].copy()\n    if df_day.empty:\n        return 0\n    # exclude maintenance windows for this farm\n    # find windows\n    farm_windows = [w for w in windows if w['farm_id'] == farm_id]\n    if farm_windows:\n        mask = pd.Series([True] * len(df_day), index=df_day.index)\n        for w in farm_windows:\n            try:\n                wtz = ZoneInfo(w['tz']) if w['tz'] else tz\n            except Exception:\n                wtz = tz\n            wstart = w['start_local']\n            wend = w['end_local']\n            if hasattr(wstart, 'tzinfo') and wstart.tzinfo is None:\n                wstart_local = wstart.replace(tzinfo=wtz)\n            else:\n                wstart_local = wstart if wstart.tzinfo else wstart.replace(tzinfo=wtz)\n            if hasattr(wend, 'tzinfo') and wend.tzinfo is None:\n                wend_local = wend.replace(tzinfo=wtz)\n            else:\n                wend_local = wend if wend.tzinfo else wend.replace(tzinfo=wtz)\n            # exclude where ts_local >= wstart_local and ts_local < wend_local\n            excl = (df_day['ts_local'] >= wstart_local) & (df_day['ts_local'] < wend_local)\n            mask = mask & (~excl)\n        df_day = df_day[mask].copy()\n    # sum energy for the day - values are readings representing energy produced in that interval? Or power?\n    # units given vary; but task says \"total real energy production in kilowatt-hours (kWh)\"\n    # we need to convert to kWh as appropriate based on unit. Also some farms report power (kw) - e.g. FARM_D is power kw. Need to account for interval if readings are power. Typical: if reading is power (kW), energy over interval = power * time_hours. If reading is energy (kWh, Wh, MWh, BTU), sum appropriately.\n    unit = c.get('sensor_info', {}).get('unit', '').strip().lower()\n    rtype = c.get('sensor_info', {}).get('reading_type', '').strip().lower()\n    total = float(df_day['value_true'].sum()) if len(df_day) > 0 else 0.0\n    # convert to kWh\n    # handle energy units\n    if rtype == 'energy':\n        if unit in ('kwh', 'kw h'):\n            total_kwh = total\n        elif unit == 'mwh':\n            total_kwh = total * 1000.0\n        elif unit == 'wh':\n            total_kwh = total / 1000.0\n        elif unit in ('btu', 'btu', 'btus'):  # BTU to kWh approx? Or maybe as given - but standard is kWh; but dataset might give BTU as energy units? Just convert BTU to kWh: 1 kWh ~ 3412.14 BTU, so kWh = BTU / 3412.14. But the task states to compute total energy in kWh - units are as recorded; we must interpret correctly. But the sample units in calib include bTU/BTu - treat BTU as energy; convert to kWh using standard conversion.\n            total_kwh = total / 3412.141633127942\n        else:\n            # default assume kWh\n            total_kwh = total\n    elif rtype == 'power':\n        # power readings (kw) - integrate over time. Data is sampled every 30 min typically (interval seen). So energy per reading = power * 0.5 hours\n        # infer interval from timestamps\n        if len(df_day) >= 2:\n            intervals = df_day['ts_utc'].sort_values().diff().dropna()\n            med = intervals.median() if not intervals.empty else pd.Timedelta(minutes=30)\n            hours = med.total_seconds() / 3600.0 if hasattr(med, 'total_seconds') else 0.5\n            if hours <= 0: hours = 0.5\n        else:\n            hours = 0.5\n        if unit == 'kw':\n            total_kwh = total * hours\n        elif unit == 'mw':\n            total_kwh = total * hours * 1000.0\n        elif unit == 'w':\n            total_kwh = total * hours / 1000.0\n        else:\n            total_kwh = total * hours  # assume kW\n    else:\n        total_kwh = total  # default\n    return total_kwh\nPY" action.permission=* action.action=allow action.pattern=*
