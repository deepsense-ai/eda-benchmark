timestamp=2026-11-05T12:54:18.406Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\ndef read_prod(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff'):\n        enc = 'utf-16le'\n    else:\n        enc = 'utf-8'\n    # read full text to inspect\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    if len(lines) < 5:\n        return None\n    header = lines[3]\n    data = '\\n'.join(lines[4:])\n    # guess sep\n    # try common\n    for sep in [',', '\\t', ';', '|']:\n        try:\n            import io\n            df = pd.read_csv(io.StringIO(header + '\\n' + data), sep=sep)\n            if df.shape[1] > 1:\n                return df\n        except:\n            continue\n    return pd.read_csv(io.StringIO(header + '\\n' + data), sep=None, engine='python')\n\ndf = read_prod('/app/dataset/production_FARM_A.csv')\nprint(df.columns[:3], df.shape)\nPY" action.permission=* action.action=allow action.pattern=*
