timestamp=2026-11-05T12:59:46.805Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# test robust reader\nfrom io import StringIO\nimport re, pandas as pd\n\ndef read_prod_robust(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    enc = 'utf-16le' if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff') else 'utf-8'\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    header_idx = None\n    for i, l in enumerate(lines[:10]):\n        ll = l.lower()\n        if 'timestamp' in ll:\n            header_idx = i; break\n    if header_idx is None:\n        for i, l in enumerate(lines[:10]):\n            if sum([l.count(c) for c in [',',';','\\t','|']]) > 5:\n                header_idx = i; break\n    if header_idx is None: header_idx = 3\n    header = lines[header_idx].strip().replace('\\ufeff','')\n    header = re.sub(r'[\\t\\r\\n]+',' ', header)\n    # find sep\n    best_sep = ','; best = -1\n    for sep in [',',';','\\t','|']:\n        c = header.count(sep)\n        if c > best: best=c; best_sep=sep\n    data = '\\n'.join(l.strip() for l in lines[header_idx+1:] if l.strip() and not l.strip().startswith('#'))\n    df = pd.read_csv(StringIO(header + '\\n' + data), sep=best_sep)\n    df.columns = [c.strip() for c in df.columns]\n    return df\n\n# test\nfor p in ['/app/dataset/production_FARM_A.csv','/app/dataset/production_FARM_B.csv','/app/dataset/production_FARM_C.csv','/app/dataset/production_FARM_D.csv']:\n    try:\n        df = read_prod_robust(p)\n        print(os.path.basename(p), df.shape, df.columns[0])\n    except Exception as e:\n        print('ERR', e)\nPY" action.permission=* action.action=allow action.pattern=*
