timestamp=2026-11-05T12:55:40.220Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# Parse maintenance windows\nimport re\nfrom datetime import datetime\n\ntext = open('/app/dataset/maintenance_notes.txt').read()\n\n# Find completed maintenance windows\n# patterns\n# \"on <site> on <date> from <time> to <time> local time. Status: COMPLETED\"\n# \"at <site> on <date> starting at <time> and finishing at <time> local time. Status: COMPLETED\"\n\nwindows = []\n# try various formats\n# Example 1: \"System firmware update on Sakura Energy Site on the 16th of March from 08:00 to 12:00 local time. Status: COMPLETED.\"\n# Example 2: \"Scheduled cleaning at Vistula Photovoltaics on March 15, starting at 12:00 and finishing at 14:00 local time. Status: COMPLETED.\"\n\n# Case 1: ... on <site> on ... from HH:MM to HH:MM\npattern1 = r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+of\\s+(\\w+)(?:\\s+\\d{4})?\\s+from\\s+(\\d{1,2}:\\d{2})\\s+to\\s+(\\d{1,2}:\\d{2})\\b.*?Status:\\s*COMPLETED'\nfor m in re.finditer(pattern1, text, re.I):\n    site = m.group(1).strip()\n    day = int(m.group(2))\n    mon = m.group(3)\n    t1 = m.group(4)\n    t2 = m.group(5)\n    windows.append((site, day, mon, t1, t2))\nPY" action.permission=* action.action=allow action.pattern=*
