timestamp=2026-11-05T13:11:49.788Z level=INFO run=3351243d message=evaluated permission=bash pattern="cat > /tmp/process.py << 'PY'\nimport re, csv, json\nfrom io import StringIO\nimport pandas as pd\nfrom datetime import datetime\nfrom zoneinfo import ZoneInfo\n\ndef norm_num(x):\n    if pd.isna(x):\n        return pd.NA\n    try:\n        if isinstance(x, (int, float)) and not isinstance(x, bool):\n            return float(x)\n    except Exception:\n        pass\n    s = str(x).strip()\n    if s == '':\n        return pd.NA\n    if '.' in s and ',' in s:\n        s = s.replace('.', '').replace(',', '.')\n    elif ',' in s and '.' not in s:\n        s = s.replace(',', '.')\n    try:\n        return float(s)\n    except Exception:\n        return pd.NA\n\ndef norm_dt(x):\n    if pd.isna(x):\n        return pd.NaT\n    s = str(x).strip()\n    for kwargs in [{}, {'dayfirst': True}]:\n        try:\n            dt = pd.to_datetime(s, errors='coerce', **kwargs)\n            if pd.notna(dt):\n                return dt\n        except Exception:\n            pass\n    return pd.NaT\n\ndef read_prod_robust(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    enc = 'utf-16le' if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff') else 'utf-8'\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    header_idx = None\n    for i, l in enumerate(lines[:15]):\n        ll = l.lower()\n        if 'timestamp' in ll:\n            header_idx = i\n            break\n    if header_idx is None:\n        for i, l in enumerate(lines[:15]):\n            sc = sum(l.count(c) for c in [',', ';', '\\t', '|'])\n            if sc > 5:\n                header_idx = i\n                break\n    if header_idx is None:\n        header_idx = 3\n    header = lines[header_idx].strip().replace('\\ufeff', '')\n    header = re.sub(r'[\\t\\r\\n]+', ' ', header)\n    best_sep = ','; best = -1\n    for sep in [',', ';', '\\t', '|']:\n        c = header.count(sep)\n        if c > best:\n            best = c; best_sep = sep\n    data = '\\n'.join(l.strip() for l in lines[header_idx+1:] if l.strip() and not l.strip().startswith('#'))\n    try:\n        df = pd.read_csv(StringIO(header + '\\n' + data), sep=best_sep, engine='python')\n    except Exception:\n        df = pd.read_csv(StringIO(header + '\\n' + data), sep=None, engine='python')\n    df.columns = [c.strip() for c in df.columns]\n    df.columns = [re.sub(r'[^a-zA-Z0-9_]', '_', c) for c in df.columns]\n    df.columns = [re.sub(r'_+', '_', c).strip('_') for c in df.columns]\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
