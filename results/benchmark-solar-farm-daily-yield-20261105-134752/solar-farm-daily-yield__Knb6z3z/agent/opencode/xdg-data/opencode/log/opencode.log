timestamp=2026-11-05T12:51:11.019Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# which farm_ids from registry have production files?\nimport os, csv\nids = []\nwith open('/app/dataset/farm_registry.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        ids.append(row['farm_id'])\nprod = set()\nfor fn in os.listdir('/app/dataset'):\n    if fn.startswith('production_') and fn.endswith('.csv'):\n        # extract\n        fid = fn.replace('production_', '').replace('.csv', '')\n        prod.add(fid)\nfor i in ids:\n    if i not in prod:\n        print('MISSING', i)\nprint('ok')\nPY" action.permission=* action.action=allow action.pattern=*
