timestamp=2026-11-05T12:56:49.918Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\ntext = open('/app/dataset/maintenance_notes.txt').read()\n# parse each completed line\nimport re\nfrom datetime import datetime\n\nwindows = []\n# line 1: Sakura, 16th of March, from 08:00 to 12:00\n# line 2: Vistula, March 15, starting at 12:00 and finishing at 14:00\n\n# try patterns\npatterns = [\n  r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+(?:of\\s+)?(\\w+)[^\\d]*(\\d{1,2}:\\d{2})\\s+to\\s+(\\d{1,2}:\\d{2})',\n  r'at\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d{1,2})(?:,|\\b)[^\\d]*(\\d{1,2}:\\d{2})[^\\d]*(\\d{1,2}:\\d{2})',\n  r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d{1,2})(?:,|\\b)[^\\d]*(\\d{1,2}:\\d{2})\\s+to\\s+(\\d{1,2}:\\d{2})',\n  r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+of\\s+(\\w+)[^\\d]*(?:from\\s+)?(\\d{1,2}:\\d{2})[^\\d]*(?:to|and finishing at|until)\\s+(\\d{1,2}:\\d{2})',\n]\nfor line in text.splitlines():\n    if 'completed' not in line.lower():\n        continue\n    for p in patterns:\n        m = re.search(p, line, re.I)\n        if m:\n            # extract depending on pattern\n            groups = m.groups()\n            # normalize\n            print(groups)\n            break\nPY" action.permission=* action.action=allow action.pattern=*
