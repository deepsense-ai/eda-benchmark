timestamp=2026-11-05T13:01:39.857Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# build full lookup we had before\nimport csv, json, os\n\n# registry\nfarm_id_to_name = {}\nwith open('/app/dataset/farm_registry.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        farm_id_to_name[row['farm_id']] = row['farm_name'].strip()\nname_to_fid = {v.lower(): k for k,v in farm_id_to_name.items()}\n\n# farms\nfarm_meta = {}\nwith open('/app/dataset/farms.csv') as f:\n    r = csv.DictReader(f)\n    for row in r:\n        name = row['farm_name'].strip()\n        farm_meta[name.lower()] = row['timezone'].strip()\n\n# calib\nwith open('/app/dataset/sensors_calibration.json') as f:\n    calib = json.load(f)\nfarms_cal = calib['enterprise_platform']['deployment_environments']['system_config']['farms']\n\nprod_files = {}\nfor fn in os.listdir('/app/dataset'):\n    if fn.startswith('production_') and fn.endswith('.csv'):\n        fid = fn.replace('production_', '').replace('.csv', '')\n        prod_files[fid] = os.path.join('/app/dataset', fn)\n\ninfo = {}\nfor fid in sorted(farm_id_to_name):\n    name = farm_id_to_name[fid]\n    c = farms_cal.get(fid, {})\n    info[fid] = {\n        'name': name,\n        'timezone': farm_meta.get(name.lower()),\n        'prod_file': prod_files.get(fid),\n        'value_col': c.get('calibration_data', {}).get('value_column_name', '').strip(),\n        'calib_offset': float(c.get('calibration_data', {}).get('calibration_offset', 0)) if c.get('calibration_data', {}).get('calibration_offset') is not None else 0.0,\n        'reading_type': c.get('sensor_info', {}).get('reading_type'),\n        'unit': c.get('sensor_info', {}).get('unit'),\n    }\nPY" action.permission=* action.action=allow action.pattern=*
