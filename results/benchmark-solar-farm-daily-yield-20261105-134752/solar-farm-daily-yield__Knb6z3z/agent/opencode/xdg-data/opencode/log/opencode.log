timestamp=2026-11-05T12:59:17.822Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# Need a robust parser. Let us write one that detects sep, normalizes numbers, parses dates.\nimport io\nimport re\nimport pandas as pd\n\ndef read_prod_robust(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff'):\n        enc = 'utf-16le'\n    else:\n        enc = 'utf-8'\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    # find header line - skip first few\n    header_idx = None\n    for i, l in enumerate(lines[:10]):\n        l = l.lower()\n        if 'timestamp' in l and ('inverter' in l or 'reading' in l or 'power' in l or 'value' in l or 'yield' in l or 'energy' in l):\n            header_idx = i\n            break\n    if header_idx is None:\n        # look for any line with comma count > 5\n        for i, l in enumerate(lines[:10]):\n            if l.count(',') > 5 or l.count(';') > 5 or l.count('\\t') > 5:\n                header_idx = i\n                break\n    if header_idx is None:\n        header_idx = 3  # guess\n    header = lines[header_idx].strip().replace('\\ufeff', '')\n    header = re.sub(r'\\t+', ' ', header)\n    header = re.sub(r'\\s+', ' ', header)\n    data_lines = []\n    for i in range(header_idx + 1, len(lines)):\n        s = lines[i].strip()\n        if s and not s.startswith('#'):\n            data_lines.append(s)\n    data = '\\n'.join(data_lines)\n    # detect sep\n    candidates = [',', ';', '\\t', '|']\n    best_sep = ','\n    best = -1\n    for sep in candidates:\n        c = header.count(sep)\n        if c > best:\n            best = c\n            best_sep = sep\n    try:\n        df = pd.read_csv(io.StringIO(header + '\\n' + data), sep=best_sep, engine='python')\n    except Exception:\n        df = pd.read_csv(io.StringIO(header + '\\n' + data), sep=None, engine='python')\n    df.columns = [c.strip() for c in df.columns]\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
