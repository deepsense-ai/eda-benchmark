timestamp=2026-11-05T13:00:52.152Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# normalize numbers with European format and dates\nimport pandas as pd\nimport re\n\ns = pd.Series(['18.000,0000', '1.234,56', '123,45', '0,0', '0'])\n# replace thousands sep dot, then decimal comma to dot\ndef norm_num(x):\n    if pd.isna(x): return x\n    if isinstance(x, (int,float)): return x\n    x = str(x).strip()\n    # if has both dot and comma, dot is likely thousands sep\n    if '.' in x and ',' in x:\n        x = x.replace('.', '').replace(',', '.')\n    elif ',' in x and '.' not in x:\n        # comma as decimal sep\n        x = x.replace(',', '.')\n    # else keep as is\n    try:\n        return float(x)\n    except:\n        return pd.NA\n\nprint(norm_num('18.000,0000'))\nprint(norm_num('1.234,56'))\nprint(norm_num('0,0'))\nPY" action.permission=* action.action=allow action.pattern=*
