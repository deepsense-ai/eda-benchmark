timestamp=2026-11-05T12:53:14.199Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport os\n\ndef read_prod(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    encodings = []\n    if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff'):\n        encodings = ['utf-16le', 'utf-16be']\n    else:\n        encodings = ['utf-8', 'utf-16le', 'utf-16be', 'latin-1']\n    for enc in encodings:\n        try:\n            df = pd.read_csv(path, sep=None, engine='python', skiprows=3, encoding=enc)\n            return df, enc\n        except Exception:\n            continue\n    # fallback\n    df = pd.read_csv(path, sep=None, engine='python', skiprows=3, encoding='latin-1')\n    return df, 'latin-1'\n\n# sample\ndf, enc = read_prod('/app/dataset/production_FARM_B.csv')\nprint(enc, df.columns[:5])\nPY" action.permission=* action.action=allow action.pattern=*
