timestamp=2026-11-05T12:54:47.793Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\nimport io, pandas as pd\n\ndef read_prod(path):\n    with open(path, 'rb') as f:\n        raw = f.read(2)\n    if raw.startswith(b'\\xff\\xfe') or raw.startswith(b'\\xfe\\xff'):\n        enc = 'utf-16le'\n    else:\n        enc = 'utf-8'\n    with open(path, 'rb') as f:\n        text = f.read().decode(enc, errors='replace')\n    lines = text.splitlines()\n    if len(lines) < 5:\n        return pd.DataFrame()\n    header = lines[3].strip()\n    # clean header - remove BOM chars, tabs attached to names\n    header = header.replace('\\ufeff', '').replace('\\t', ' ').strip()\n    data_lines = []\n    for i in range(4, len(lines)):\n        if lines[i].strip():\n            data_lines.append(lines[i])\n    data = '\\n'.join(data_lines)\n    # try sep\n    for sep in [',', ';', '\\t', '|']:\n        try:\n            df = pd.read_csv(io.StringIO(header + '\\n' + data), sep=sep)\n            if df.shape[1] > 1:\n                df.columns = [c.strip() for c in df.columns]\n                return df\n        except Exception:\n            continue\n    df = pd.read_csv(io.StringIO(header + '\\n' + data), sep=None, engine='python')\n    df.columns = [c.strip() for c in df.columns]\n    return df\n\ndf = read_prod('/app/dataset/production_FARM_A.csv')\nprint(df.columns[:2])\nPY" action.permission=* action.action=allow action.pattern=*
