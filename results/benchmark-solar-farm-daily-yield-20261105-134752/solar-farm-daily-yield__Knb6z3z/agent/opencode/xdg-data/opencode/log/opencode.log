read_csv(StringIO(header + '\\n' + data), sep=best_sep, engine='python')\n    except:\n        df = pd.read_csv(StringIO(header + '\\n' + data), sep=None, engine='python')\n    df.columns = [c.strip() for c in df.columns]\n    df.columns = [re.sub(r'[^a-zA-Z0-9_]', '_', c) for c in df.columns]\n    df.columns = [re.sub(r'_+', '_', c).strip('_') for c in df.columns]\n    return df\n\n# info\nfarm_id_to_name = {}\nwith open('/app/dataset/farm_registry.csv') as f:\n    r = csv.DictReader(f)\n    for row in r: farm_id_to_name[row['farm_id']] = row['farm_name'].strip()\nfarm_meta = {}\nwith open('/app/dataset/farms.csv') as f:\n    r = csv.DictReader(f)\n    for row in r: farm_meta[row['farm_name'].strip().lower()] = row['timezone'].strip()\nwith open('/app/dataset/sensors_calibration.json') as f:\n    calib = json.load(f)\nfarms_cal = calib['enterprise_platform']['deployment_environments']['system_config']['farms']\n\nfid = 'FARM_A'\nname = farm_id_to_name[fid]\ntz_str = farm_meta[name.lower()]\nc = farms_cal[fid]\nvc_spec = c['calibration_data']['value_column_name'].strip()\ncalib_off = float(c['calibration_data']['calibration_offset'] or 0)\n\ndf = read_prod_robust(f'/app/dataset/production_{fid}.csv')\ndf['timestamp'] = df['timestamp'].apply(norm_dt)\n# vc\nvc_use = vc_spec\nvc_cand = re.sub(r'[^a-zA-Z0-9_]', '_', vc_spec).strip('_')\nif vc_use not in df.columns and vc_cand not in df.columns:\n    for col in df.columns:\n        if col.lower() == vc_spec.lower() or col.lower() == vc_cand.lower():\n            vc_use = col; break\n    else:\n        cands = [c for c in df.columns if any(k in c.lower() for k in ['read', 'value', 'yield', 'power', 'output', 'energy', 'wh', 'kwh', 'mwh'])]\n        vc_use = cands[0] if cands else df.columns[-1]\nelse:\n    vc_use = vc_cand if vc_cand in df.columns else vc_use\n\ndf['value_raw'] = df[vc_use].apply(norm_num)\ndf = df.dropna(subset=['timestamp', 'value_raw'])\ndf = df.drop_duplicates()\n\n# convert timestamps to UTC assuming they are in local tz\ntz = ZoneInfo(tz_str)\n# localize naive timestamps\ndf['ts_local'] = df['timestamp'].dt.tz_localize(tz, ambiguous='infer', nonexistent='shift_forward')\ndf['ts_utc'] = df['ts_local'].dt.tz_convert('UTC')\n\n# apply calibration offset: true value = recorded value - calibration_offset? Wait look at definition: \"The calibration_offset is defined as: (recorded value) - (true value).\"\n# So recorded - true = offset => true = recorded - offset\ndf['value_true'] = df['value_raw'] - calib_off\n\n# drop values that are negative AFTER calibration is applied\ndf = df[df['value_true'] >= 0]\n\n# filter to UTC reporting day 2024-03-15: [2024-03-15 00:00:00 UTC, 2024-03-16 00:00:00 UTC)\nstart_utc = pd.Timestamp('2024-03-15 00:00:00', tz='UTC')\nend_utc = pd.Timestamp('2024-03-16 00:00:00', tz='UTC')\ndf_day = df[(df['ts_utc'] >= start_utc) & (df['ts_utc'] < end_utc)].copy()\n\n# handle maintenance windows - for successfully conducted windows, exclude readings recorded during those windows\n# windows are in local time. Readings to exclude if their ts_local falls within [start_local, end_local) or overlaps? Or during the window - so if ts_local is >= start and < end (or <= end depending on definition). The text says \"from 12:00 and finishing at 14:00\" - so interval is inclusive? Usually half-open or closed; but with 30-min samples, treat as inclusive of start and exclusive of end? Or just exclude any reading whose local timestamp is between start_local and end_local (inclusive of boundaries as written)? Better to exclude any reading that occurs at or after start_local and at or before end_local? Or strictly within the window period. Let us look at example: 12:00 to 14:00 means readings at 12:00, 12:30, 13:00, 13:30 would be during maintenance. That matches typical half-hour intervals. So exclude if ts_local >= start_local and ts_local < end_local.\n# parse maintenance windows we found earlier\n# get windows\n# rebuild windows\npass\nPY" action.permission=* action.action=allow action.pattern=*
