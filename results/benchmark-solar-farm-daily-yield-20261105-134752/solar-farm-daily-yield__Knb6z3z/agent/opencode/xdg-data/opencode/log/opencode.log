timestamp=2026-11-05T12:57:27.639Z level=INFO run=3351243d message=evaluated permission=bash pattern="python3 << 'PY'\n# parse windows\ntext = open('/app/dataset/maintenance_notes.txt').read()\nwins = []\n# find completed\nfor line in text.splitlines():\n    if 'completed' not in line.lower(): continue\n    m = re.search(r'on\\s+([A-Za-z\\s]+?)\\s+on\\s+(?:the\\s+)?(\\d{1,2})(?:st|nd|rd|th)?\\s+of\\s+(\\w+)[^\\d]*(?:from\\s+)?(\\d{1,2}:\\d{2})[^\\d]*(?:to|and finishing at|until)\\s+(\\d{1,2}:\\d{2})', line, re.I)\n    if m:\n        site, day, mon, t1, t2 = m.groups()\n        wins.append((site.strip(), int(day), mon.strip(), t1, t2))\n        continue\n    m = re.search(r'at\\s+([A-Za-z\\s]+?)\\s+on\\s+(\\w+)\\s+(\\d{1,2})(?:,|\\b)[^\\d]*(\\d{1,2}:\\d{2})[^\\d]*(?:to|and finishing at|until)\\s+(\\d{1,2}:\\d{2})', line, re.I)\n    if m:\n        site, mon, day, t1, t2 = m.groups()\n        wins.append((site.strip(), int(day), mon.strip(), t1, t2))\n        continue\n\n# build\nyear = 2024\n# month map\nmonths = {m:i for i,m in enumerate(['January','February','March','April','May','June','July','August','September','October','November','December'], 1)}\nwindows = []\nfor site, day, mon, t1, t2 in wins:\n    fid = name_to_fid.get(site.lower())\n    tz = farm_meta.get(site.lower())\n    if not fid or not tz: \n        # try partial\n        pass\n    start = datetime(year, months[mon], day, int(t1.split(':')[0]), int(t1.split(':')[1]))\n    end = datetime(year, months[mon], day, int(t2.split(':')[0]), int(t2.split(':')[1]))\n    windows.append({'farm_id': fid, 'tz': tz, 'start_local': start, 'end_local': end, 'site': site})\nprint(windows)\nPY" action.permission=* action.action=allow action.pattern=*
