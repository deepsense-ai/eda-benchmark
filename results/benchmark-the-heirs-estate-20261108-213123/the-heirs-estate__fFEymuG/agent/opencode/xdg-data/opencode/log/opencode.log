timestamp=2026-11-08T22:42:05.164Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\nimport re\nnodes = []\nfor i, line in enumerate(lines):\n    for m in re.finditer(r'([A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*)', line):\n        name = m.group(1)\n        if 'FAMILY' in name:\n            continue\n        nodes.append((name, i, m.start(), m.end()))\n\nnode_dict = {}\nfor name, row, start, end in nodes:\n    if name not in node_dict:\n        node_dict[name] = (row, start, end)\n\n# Build edges with simpler logic\nedges = []\nfor name, (r, s, e) in node_dict.items():\n    c = (s + e) // 2\n    parent = None\n    # scan upward\n    for r_up in range(r-1, -1, -1):\n        # look for any other node at r_up horizontally aligned\n        for other, (orow, os, oe) in node_dict.items():\n            if orow != r_up:\n                continue\n            if other == name:\n                continue\n            oc = (os + oe) // 2\n            # check alignment and that orow is above\n            if orow < r and abs(oc - c) < 80:\n                if parent is None:\n                    parent = (other, orow)\n                else:\n                    # keep the closest (largest row number among those above? or smallest distance)\n                    if orow > parent[1]:  # closer to current\n                        parent = (other, orow)\n    if parent:\n        edges.append((parent[0], name))\n\n# remove duplicates\nedges_set = set((p, c) for p, c in edges)\nprint(len(edges_set))\nPY" action.permission=* action.action=allow action.pattern=*
