timestamp=2026-11-08T22:31:46.957Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\n# The tree is pure ASCII drawing. Parsing ASCII genealogy drawings is possible but a bit involved.\n# Let us look at another example from the same file to understand the convention.\n# For example, look for a simple case where parent has one child clearly.\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\n# Look for simple vertical line pattern: parent name, then | below aligned, then child\nfor i in range(len(lines)-2):\n    # check if line i+1 has just | or spaces and | at some position\n    l = lines[i]\n    l1 = lines[i+1]\n    l2 = lines[i+2]\n    # simple case: l has a name, l1 has | under it, l2 has another name\n    # crude check\n    if l1.strip().startswith('|') and len(l1.strip()) == 1:\n        # see if parent and child names exist\n        # extract potential names from l and l2\n        import re\n        names_l = re.findall(r'[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\']+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\']+', l)\n        names_l2 = re.findall(r'[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\']+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\']+', l2)\n        if len(names_l) == 1 and len(names_l2) == 1:\n            print(f'{i+1}: PARENT={names_l[0]} -> CHILD={names_l2[0]}')\n            break\nelse:\n    print('not found simple case')\nPY" action.permission=* action.action=allow action.pattern=*
