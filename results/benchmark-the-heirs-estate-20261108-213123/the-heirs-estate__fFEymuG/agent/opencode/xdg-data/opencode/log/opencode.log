timestamp=2026-11-08T22:32:10.739Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\n# Try to find other cases. Maybe look for patterns like: name followed by line with | and connectors\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\nfound = []\nfor i in range(len(lines)-1):\n    l = lines[i]\n    l1 = lines[i+1]\n    # if l contains a person name and l1 has '|' at a position near the name\n    import re\n    m = re.search(r'([A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\']+\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\']+)', l)\n    if m:\n        name = m.group(1)\n        start = m.start(1)\n        end = m.end(1)\n        # check if l1 has '|' in the range roughly aligned\n        # look in a window\n        if start < len(l1):\n            # check a few chars around\n            seg = l1[max(0,start-2):min(len(l1), end+2)]\n            if '|' in seg:\n                found.append((i+1, name))\n                if len(found) > 5:\n                    break\n\nfor f in found:\n    print(f)\nPY" action.permission=* action.action=allow action.pattern=*
