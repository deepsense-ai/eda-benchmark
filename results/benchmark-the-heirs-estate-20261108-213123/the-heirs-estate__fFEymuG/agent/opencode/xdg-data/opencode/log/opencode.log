timestamp=2026-11-08T22:46:31.204Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\n# Build full graph with a better heuristic: for each name, find the closest name above\n# such that the horizontal center of the ancestor is closest and vertically closest.\n# Also consider that branches merge - but parent is usually above.\n\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\nimport re\nnodes = []\nfor i, line in enumerate(lines):\n    for m in re.finditer(r'([A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*)', line):\n        name = m.group(1)\n        if 'FAMILY' in name:\n            continue\n        nodes.append((name, i, m.start(), m.end()))\n\n# dedup\nnode_dict = {}\nfor name, row, start, end in nodes:\n    if name not in node_dict:\n        node_dict[name] = (row, start, end)\n    # else keep first? usually first/topmost occurrence? or just keep\n\n# build edges\nfrom collections import defaultdict\nedges = []  # list of (parent, child)\nfor name, (r, s, e) in node_dict.items():\n    c = (s + e) // 2\n    candidates = []\n    for other, (orow, os, oe) in node_dict.items():\n        if other == name:\n            continue\n        if orow >= r:\n            continue  # must be above\n        oc = (os + oe) // 2\n        # vertical distance and horizontal alignment\n        vdist = r - orow\n        hdist = abs(oc - c)\n        candidates.append((other, orow, vdist, hdist))\n    if candidates:\n        # choose best: smallest hdist first, then smallest vdist\n        best = min(candidates, key=lambda x: (x[3], x[2], x[1]))\n        edges.append((best[0], name))\n\n# dedup\nedges_set = set((p, c) for p, c in edges)\nprint('edges:', len(edges_set))\nPY" action.permission=* action.action=allow action.pattern=*
