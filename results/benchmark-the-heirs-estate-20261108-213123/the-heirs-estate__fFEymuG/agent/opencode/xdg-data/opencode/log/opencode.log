timestamp=2026-11-08T22:35:39.207Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\n# build unique names\nimport re\npersons = []\nfor i, line in enumerate(lines):\n    for m in re.finditer(r'([A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*)', line):\n        name = m.group(1)\n        if 'FAMILY' in name or name == 'TREE GENERATOR':\n            continue\n        persons.append((i, m.start(), m.end(), name))\n\nunique = {}\nfor row, start, end, name in persons:\n    if name not in unique:\n        unique[name] = (row, start, end)\n\n# For each node, find parent by scanning upward for nearest connector that leads to another node\n# Look for vertical line above: in the row above, look around the horizontal span of the name\n# Or more generally, trace upward following | and junctions\n\ndef getch(r, c):\n    if 0 <= r < len(lines):\n        line = lines[r]\n        if 0 <= c < len(line):\n            return line[c]\n    return ' '\n\n# Try a simple heuristic: parent is the closest name above with horizontal position closest to this name's center\nedges = []\nfor name, (r, s, e) in unique.items():\n    center = (s + e) // 2\n    # look upward\n    best = None\n    best_dist = float('inf')\n    for other, (orow, os, oe) in unique.items():\n        if other == name:\n            continue\n        if orow < r:  # above\n            oc = (os + oe) // 2\n            dist = abs(oc - center) + (r - orow)  # prefer closer vertically and horizontally\n            if dist < best_dist:\n                best = other\n                best_dist = dist\n            elif dist == best_dist and best is not None:\n                # tie-breaker? keep first or compare\n                pass\n    if best is not None:\n        edges.append((best, name))\n\nprint('edges approx:', len(edges))\nPY" action.permission=* action.action=allow action.pattern=*
