timestamp=2026-11-08T22:49:10.130Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\nimport re\nfrom collections import defaultdict\n\nnodes = []\nfor i, line in enumerate(lines):\n    for m in re.finditer(r'([A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*)', line):\n        name = m.group(1)\n        if 'FAMILY' in name:\n            continue\n        nodes.append((name, i, m.start(), m.end()))\n\nnode_dict = {}\nfor name, row, start, end in nodes:\n    if name not in node_dict:\n        node_dict[name] = (row, start, end)\n\n# edges\nedges_set = set()\nfor name, (r, s, e) in node_dict.items():\n    c = (s + e) // 2\n    candidates = []\n    for other, (orow, os, oe) in node_dict.items():\n        if other == name or orow >= r:\n            continue\n        oc = (os + oe) // 2\n        vdist = r - orow\n        hdist = abs(oc - c)\n        candidates.append((other, orow, vdist, hdist))\n    if candidates:\n        best = min(candidates, key=lambda x: (x[3], x[2]))\n        edges_set.add((best[0], name))\n\nchildren_map = defaultdict(list)\nfor p, ch in edges_set:\n    children_map[p].append(ch)\n\n# get great-great-grandparent of Dawid\n# trace\nparent_map = {}\nfor p, ch in edges_set:\n    parent_map[ch] = p\n\ncur = 'Dawid Majtyka'\nchain = [cur]\nfor i in range(10):\n    if cur in parent_map:\n        cur = parent_map[cur]\n        chain.append(cur)\n    else:\n        break\ng2g = chain[4] if len(chain) > 4 else cur  # great-great-grandparent is 4 levels up from Dawid? Count: 0:Dawid,1:parent,2:grandparent,3:great-grandparent,4:great-great-grandparent -> yes index 4\nprint('g2g:', g2g)\n# children of g2g\nprint('children:', children_map[g2g])\nPY" action.permission=* action.action=allow action.pattern=*
