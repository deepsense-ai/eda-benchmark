timestamp=2026-11-08T22:36:04.705Z level=INFO run=50327b16 message=evaluated permission=bash pattern="python3 << 'PY'\npath = '/app/dataset/genealogy_trees.txt'\nwith open(path) as f:\n    lines = f.readlines()\n\n# Build unique names with positions\nimport re\npersons = []\nfor i, line in enumerate(lines):\n    for m in re.finditer(r'([A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*\\s+[A-ZĄĆĘŁŃÓŚŹŻ][a-ząćęłńóśźżA-ZĄĆĘŁŃÓŚŹŻ\\'-]*)', line):\n        name = m.group(1)\n        if 'FAMILY' in name:\n            continue\n        persons.append((i, m.start(), m.end(), name))\nunique = {}\nfor row, start, end, name in persons:\n    if name not in unique:\n        unique[name] = (row, start, end)\n\n# Build a mapping from name to parent using the drawing structure more carefully\n# Look for vertical lines above the name. Trace upward until we reach another name's row level\n# or junction.\nedges = []\nfor name, (r, s, e) in unique.items():\n    center = (s + e) // 2\n    # scan upward to find the first row that contains another name\n    # and also check if there's a connecting line (| or branch)\n    parent = None\n    # look up to, say, 100 rows above\n    for row in range(r-1, max(-1, r-200), -1):\n        # check if this row has any other person name\n        for other, (orow, os, oe) in unique.items():\n            if orow == row:\n                # check horizontal proximity - is this other name connected?\n                oc = (os + oe) // 2\n                # if connected through same branch, horizontal distance shouldn't be too large\n                # also check if there are connectors between\n                if abs(oc - center) < 40:  # loose alignment\n                    parent = other\n                    break\n        if parent:\n            break\n    if parent and parent != name:\n        edges.append((parent, name))\n\n# dedup edges\nedges_set = set(edges)\nprint(len(edges_set))\nPY" action.permission=* action.action=allow action.pattern=*
