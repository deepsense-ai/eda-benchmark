timestamp=2026-11-04T21:30:26.414Z level=INFO run=a39ae444 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# Also look at the broader picture - some other sensors have large delays (CORE_FUEL_01 has 8 min delay)\n# Let us compute first deviation time per subsystem by aggregating at subsystem level\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\nall_s = pd.concat([s1, s2, s3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf = all_s.merge(meta, on='sensor_id', how='left')\n\ndf['ts_recorded'] = pd.to_datetime(df['timestamp'], utc=False)\ndf['ts_utc_recorded'] = df['ts_recorded'] - pd.to_timedelta(df['logger_utc_offset_hours'], unit='h')\ndf['ts_phys'] = df['ts_utc_recorded'] - pd.to_timedelta(df['response_delay_minutes'], unit='m')\n\n# For each sensor, find first time outside range\nfirst_devs = []\nfor sid, g in df.groupby('sensor_id'):\n    g = g.sort_values('ts_phys')\n    mask = (g['value'] < g['normal_min']) | (g['value'] > g['normal_max'])\n    if mask.any():\n        first = g[mask].iloc[0]\n        first_devs.append((sid, first['subsystem'], first['ts_phys'], first['value'], first['normal_min'], first['normal_max'], first['response_delay_minutes']))\n\nfirst_devs = pd.DataFrame(first_devs, columns=['sensor_id','subsystem','ts_phys','value','normal_min','normal_max','resp'])\nfirst_devs = first_devs.sort_values('ts_phys')\nprint(first_devs.to_string(index=False))\nPY" action.permission=* action.action=allow action.pattern=*
