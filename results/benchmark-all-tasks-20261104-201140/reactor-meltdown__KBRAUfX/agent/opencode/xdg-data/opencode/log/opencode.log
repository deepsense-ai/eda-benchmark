timestamp=2026-11-04T21:33:11.404Z level=INFO run=a39ae444 message=evaluated permission=bash pattern="python3 << 'PY'\n# Now look at the first deviation per subsystem (earliest physical onset time across sensors in that subsystem)\nimport pandas as pd\n\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\nall_s = pd.concat([s1, s2, s3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf = all_s.merge(meta, on='sensor_id', how='left')\n\ndf['ts_recorded'] = pd.to_datetime(df['timestamp'], utc=False)\ndf['ts_utc_recorded'] = df['ts_recorded'] - pd.to_timedelta(df['logger_utc_offset_hours'], unit='h')\ndf['ts_phys'] = df['ts_utc_recorded'] - pd.to_timedelta(df['response_delay_minutes'], unit='m')\n\n# find first deviation per subsystem\nsubsys_first = []\nfor subsys, g in df.groupby('subsystem'):\n    # find earliest physical time any sensor in subsystem goes outside range\n    earliest = None\n    for sid, sg in g.groupby('sensor_id'):\n        sg = sg.sort_values('ts_phys')\n        mask = (sg['value'] < sg['normal_min']) | (sg['value'] > sg['normal_max'])\n        if mask.any():\n            first = sg[mask].iloc[0]\n            t = first['ts_phys']\n            if earliest is None or t < earliest:\n                earliest = t\n    subsys_first.append((subsys, earliest))\n\npd.DataFrame(subsys_first, columns=['subsystem','first_phys_deviation']).sort_values('first_phys_deviation')\nPY" action.permission=* action.action=allow action.pattern=*
