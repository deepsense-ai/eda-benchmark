timestamp=2026-11-04T21:18:50.957Z level=INFO run=a39ae444 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\n\n# Load all\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\nall_s = pd.concat([s1, s2, s3], ignore_index=True)\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ndf = all_s.merge(meta, on='sensor_id', how='left')\n\n# Compute times\ndf['ts_recorded'] = pd.to_datetime(df['timestamp'], utc=False)\ndf['ts_utc_recorded'] = df['ts_recorded'] - pd.to_timedelta(df['logger_utc_offset_hours'], unit='h')\ndf['ts_phys'] = df['ts_utc_recorded'] - pd.to_timedelta(df['response_delay_minutes'], unit='m')\n\n# Check for each sensor first time value goes outside normal range\nresults = []\nfor sid, g in df.groupby('sensor_id'):\n    g = g.sort_values('ts_phys')\n    # find deviations\n    mask = (g['value'] < g['normal_min']) | (g['value'] > g['normal_max'])\n    if mask.any():\n        first_idx = mask.idxmax()  # but better to find first True\n        first = g[mask].iloc[0]\n        results.append({\n            'sensor_id': sid,\n            'subsystem': first['subsystem'],\n            'first_phys': first['ts_phys'],\n            'first_val': first['value'],\n            'normal_min': first['normal_min'],\n            'normal_max': first['normal_max'],\n            'metric': first['metric'],\n        })\n    else:\n        results.append({\n            'sensor_id': sid,\n            'subsystem': g.iloc[0]['subsystem'],\n            'first_phys': None,\n            'first_val': None,\n            'normal_min': g.iloc[0]['normal_min'],\n            'normal_max': g.iloc[0]['normal_max'],\n            'metric': g.iloc[0]['metric'],\n        })\n\nres = pd.DataFrame(results).sort_values('first_phys')\nprint(res.to_string(index=False))\nPY" action.permission=* action.action=allow action.pattern=*
