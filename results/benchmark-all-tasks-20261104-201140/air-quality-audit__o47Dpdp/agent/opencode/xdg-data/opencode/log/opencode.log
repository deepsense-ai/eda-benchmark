timestamp=2026-11-04T19:14:42.492Z level=INFO run=b8e4cffa message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\n\npm25 = readings[readings['pollutant']=='PM25'].pivot(index='timestamp', columns='station_id', values='current_reading')\npm10 = readings[readings['pollutant']=='PM10'].pivot(index='timestamp', columns='station_id', values='current_reading')\nst2dist = dict(zip(stations['station_id'], stations['district']))\n\n# Look closer at: \"Another looks plausible point-by-point yet its swings are unusually muted compared with comparable local stations.\"\n# That means low amplitude (amp_ratio low) but possibly reasonable correlation? Or maybe timing off in some way?\n# Also \"One problematic station broadly follows local patterns, but not with the same rhythm as its peers.\"\n# \"not with the same rhythm as its peers\" - could be lagged? or different phase? Or lower correlation with peers/median?\n# Also \"A third appears ordinary in aggregate, but its remaining deviations line up a bit too neatly with one environmental driver.\"\n\n# Check candidates\ncands = []\nfor polmat, polname in [(pm25, 'PM25'), (pm10, 'PM10')]:\n    cols = polmat.columns\n    for st in cols:\n        dist = st2dist[st]\n        dist_sts = [s for s in stations[stations['district']==dist]['station_id'].tolist() if s in polmat.columns and s != st]\n        if len(dist_sts) == 0: continue\n        dmat = polmat[dist_sts]\n        dmed = dmat.median(axis=1)\n        corr = polmat[st].corr(dmed)\n        amp_ratio = polmat[st].std() / dmed.std() if dmed.std() > 0 else np.nan\n        # lag max corr\n        best_corr = corr\n        for lag in [-3,-2,-1,1,2,3]:\n            c = polmat[st].shift(lag).corr(dmed)\n            if c > best_corr: best_corr = c\n        cands.append((st, polname, dist, corr, best_corr, amp_ratio, polmat[st].std(), dmed.std()))\nPY" action.permission=* action.action=allow action.pattern=*
