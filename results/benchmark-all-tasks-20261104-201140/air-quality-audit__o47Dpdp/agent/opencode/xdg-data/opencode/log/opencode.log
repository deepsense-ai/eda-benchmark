timestamp=2026-11-04T19:14:31.321Z level=INFO run=b8e4cffa message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\n\npm25 = readings[readings['pollutant']=='PM25'].pivot(index='timestamp', columns='station_id', values='current_reading')\npm10 = readings[readings['pollutant']=='PM10'].pivot(index='timestamp', columns='station_id', values='current_reading')\n\nst2dist = dict(zip(stations['station_id'], stations['district']))\n\n# For each station, look at correlation with district median time series (excluding self?)\n# Also amplitude (variance/STD) compared to district\nfor polmat, polname in [(pm25, 'PM25'), (pm10, 'PM10')]:\n    print(f'\\n=== {polname} ===')\n    # Get districts\n    cols = polmat.columns\n    # group by district\n    for dist, dist_sts in stations.groupby('district'):\n        dist_sts = [s for s in dist_sts['station_id'].tolist() if s in polmat.columns]\n        if len(dist_sts) == 0: continue\n        distmat = polmat[dist_sts].copy()\n        # district median\n        dmed = distmat.median(axis=1)\n        for st in dist_sts:\n            s = distmat[st].dropna()\n            if len(s) < 10: continue\n            corr = distmat[st].corr(dmed, method='pearson')\n            # amplitude\n            amp_ratio = distmat[st].std() / dmed.std() if dmed.std() > 0 else np.nan\n            # lag correlation? max lag 1-2\n            print(f'  {st} ({dist}): corr={corr:.3f}, amp_ratio={amp_ratio:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
