timestamp=2026-11-04T19:15:35.407Z level=INFO run=b8e4cffa message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\n# Look at these stations in detail\nstations = pd.read_csv('/app/dataset/stations.csv')\nreadings = pd.read_csv('/app/dataset/readings.csv')\nreadings['timestamp'] = pd.to_datetime(readings['timestamp'])\npm25 = readings[readings['pollutant']=='PM25'].pivot(index='timestamp', columns='station_id', values='current_reading')\npm10 = readings[readings['pollutant']=='PM10'].pivot(index='timestamp', columns='station_id', values='current_reading')\nst2dist = dict(zip(stations['station_id'], stations['district']))\n\n# Check ST020 (PM10, PSIE_POLE)\nst = 'ST020'\ndist = st2dist[st]\npolmat = pm10 if st in pm10.columns else pm25\ndist_sts = [s for s in stations[stations['district']==dist]['station_id'].tolist() if s in polmat.columns and s != st]\ndmed = polmat[dist_sts].median(axis=1)\nprint('ST:', st, 'dist:', dist)\nfor lag in [0,1,-1,2,-2]:\n    c = polmat[st].shift(lag).corr(dmed)\n    print(f'  corr at lag {lag}: {c:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
