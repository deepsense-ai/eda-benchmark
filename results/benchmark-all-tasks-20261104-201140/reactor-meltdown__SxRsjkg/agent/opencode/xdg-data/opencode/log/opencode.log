bs - pd.Timedelta(minutes=m['response_delay_minutes'])\n            print(f'Early sustained drop around obs={t_obs}, phys={t_phys}, val={vals[i]:.2f}')\n            break\nPY" action.permission=* action.action=allow action.pattern=*
