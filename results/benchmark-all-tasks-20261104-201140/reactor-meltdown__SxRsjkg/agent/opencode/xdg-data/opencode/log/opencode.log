timestamp=2026-11-04T19:33:54.156Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Look at trends without plotting\nfor sid in ['TURB_OUTPUT_01', 'TURB_SPEED_01', 'TURB_VIB_01', 'CORE_FUEL_01', 'CORE_FLUX_01', 'CORE_ROD_01', 'PRIMARY_TEMP_01', 'PRIMARY_PRES_01', 'PRIMARY_FLOW_01', 'COOLING_TEMP_01', 'COOLING_FLOW_01', 'STEAM_PRES_01', 'STEAM_TEMP_01']:\n    g = s[s['sensor_id']==sid].sort_values('timestamp')\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    vals = g['value'].values\n    # check when it goes outside normal range\n    outside = (vals < m['normal_min']) | (vals > m['normal_max'])\n    first_out = np.where(outside)[0] if outside.any() else -1\n    if first_out >= 0:\n        t = g['timestamp'].iloc[first_out]\n        v = vals[first_out]\n        print(f'{sid} ({m[\"subsystem\"]}): first dev at {t} -> {v:.3f} (norm {m[\"normal_min\"]}-{m[\"normal_max\"]}, delay={m[\"response_delay_minutes\"]})')\n    else:\n        # check for big changes even if inside range? maybe anomalies\n        diff = np.abs(np.diff(vals))\n        if len(diff) > 0:\n            idx = np.argmax(diff)\n            print(f'{sid} ({m[\"subsystem\"]}): NO range breach, max dval at {g[\"timestamp\"].iloc[idx+1]} d={diff[idx]:.3f}')\nPY" action.permission=* action.action=allow action.pattern=*
