timestamp=2026-11-04T19:38:23.708Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndef detect_onset(ts, vals, min_size=100, k=3, h=5):\n    mu = np.mean(vals[:min_size])\n    std = np.std(vals[:min_size]) + 1e-10\n    s_pos = 0; s_neg = 0\n    for i in range(min_size, len(vals)):\n        s_pos = max(0, s_pos + (vals[i] - mu - k*std)/std)\n        s_neg = max(0, s_neg + (mu - k*std - vals[i])/std)\n        if s_pos > h or s_neg > h:\n            return i\n    return -1\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\nfor sid in meta['sensor_id'].tolist():\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    g = s[s['sensor_id']==sid].sort_values('timestamp').copy()\n    idx = detect_onset(g['timestamp'].values, g['value'].values)\n    if idx >= 0:\n        t_obs = g['timestamp'].iloc[idx]\n        t_phys = t_obs - pd.Timedelta(minutes=float(m['response_delay_minutes']))\n        print(f'{sid:20s} ({m[\"subsystem\"]:12s}): phys={t_phys}')\nPY" action.permission=* action.action=allow action.pattern=*
