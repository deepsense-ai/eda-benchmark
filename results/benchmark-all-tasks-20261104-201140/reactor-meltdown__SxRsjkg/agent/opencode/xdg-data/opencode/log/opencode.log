timestamp=2026-11-04T19:38:05.987Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Look at all sensors in TURBINE\nfor sid in meta[meta['subsystem']=='TURBINE']['sensor_id'].tolist():\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    g = s[s['sensor_id']==sid].sort_values('timestamp').copy()\n    vals = g['value'].values\n    baseline = np.median(vals[:200])\n    # find first sustained deviation\n    for i in range(200, min(1500, len(vals))):\n        if abs(vals[i] - baseline) > 0.01*abs(baseline) and abs(vals[i] - baseline) > 2*np.std(vals[:200]):\n            t_obs = g['timestamp'].iloc[i]\n            t_phys = t_obs - pd.Timedelta(minutes=m['response_delay_minutes'])\n            print(f'{sid}: early dev at phys={t_phys}, obs={t_obs}, val={vals[i]:.3f}')\n            break\nPY" action.permission=* action.action=allow action.pattern=*
