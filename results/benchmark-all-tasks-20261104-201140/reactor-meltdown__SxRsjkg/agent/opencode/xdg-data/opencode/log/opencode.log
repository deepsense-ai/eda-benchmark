timestamp=2026-11-04T19:37:45.404Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Aggregate earliest drift per subsystem with consistent detection\nsubsystems = ['COOLING', 'PRIMARY_LOOP', 'CORE', 'STEAM_GEN', 'TURBINE']\nresults = []\nfor sub in subsystems:\n    earliest = None\n    for sid in meta[meta['subsystem']==sub]['sensor_id'].tolist():\n        m = meta[meta['sensor_id']==sid].iloc[0]\n        g = s[s['sensor_id']==sid].sort_values('timestamp').copy()\n        vals = g['value'].values\n        baseline = np.median(vals[:100])\n        base_std = np.std(vals[:100])\n        thresh = max(3*base_std, 0.015*abs(baseline)) if base_std > 0 else 0.015*abs(baseline)\n        for i in range(100, len(vals)-10):\n            if abs(vals[i]-baseline) > thresh:\n                # require persistence\n                persist = all(abs(vals[i+j]-baseline) > thresh*0.7 for j in range(1, 6))\n                if persist:\n                    t_obs = g['timestamp'].iloc[i]\n                    t_phys = t_obs - pd.Timedelta(minutes=float(m['response_delay_minutes']))\n                    if earliest is None or t_phys < earliest:\n                        earliest = t_phys\n                    break\n    results.append((sub, earliest))\nresults.sort(key=lambda x: x[1])\nfor r in results:\n    print(r)\nPY" action.permission=* action.action=allow action.pattern=*
