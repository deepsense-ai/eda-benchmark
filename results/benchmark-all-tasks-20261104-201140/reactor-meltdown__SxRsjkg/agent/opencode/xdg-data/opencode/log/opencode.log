timestamp=2026-11-04T19:39:24.255Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\n# Let us look at all key sensors for very early deviations (subtle trends)\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Check for very early changes using derivative with smoothing\nfor sid in meta['sensor_id'].tolist():\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    g = s[s['sensor_id']==sid].sort_values('timestamp').copy()\n    vals = g['value'].values\n    if len(vals) < 200: continue\n    # smooth and diff\n    kernel = np.ones(20)/20\n    smooth = np.convolve(vals, kernel, mode='same')\n    diff = np.diff(smooth)\n    # look for sustained non-zero diff\n    # find when diff becomes consistently negative or positive (depending on trend)\n    for i in range(100, min(800, len(diff)-30)):\n        if abs(diff[i]) > np.std(diff[50:100]) * 2.5:\n            # check if persistent for next 15 points\n            if all(abs(diff[i+j]) > np.std(diff[50:100]) * 1.0 for j in range(1, 15)):\n                t_obs = g['timestamp'].iloc[i+1]  # diff gives offset\n                t_phys = t_obs - pd.Timedelta(minutes=float(m['response_delay_minutes']))\n                trend = 'up' if diff[i] > 0 else 'down'\n                print(f'{sid:20s} ({m[\"subsystem\"]:12s}): trend {trend} at phys={t_phys}')\n                break\nPY" action.permission=* action.action=allow action.pattern=*
