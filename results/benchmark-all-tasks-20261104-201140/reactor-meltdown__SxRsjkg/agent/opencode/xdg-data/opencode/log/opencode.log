timestamp=2026-11-04T19:37:07.158Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Look for subtle changes - e.g. trend breaks\nfor sid in ['TURB_OUTPUT_01', 'STEAM_PRES_01', 'COOLING_PRES_01', 'PRIMARY_TEMP_01', 'CORE_EXIT_01']:\n    m = meta[meta['sensor_id']==sid].iloc[0]\n    g = s[s['sensor_id']==sid].sort_values('timestamp').copy()\n    vals = g['value'].values\n    # use difference to detect change in trend\n    diffs = np.diff(vals)\n    # find where diff changes sign or magnitude persistently\n    # simple: rolling mean of diff\n    window = 30\n    if len(diffs) >= window:\n        roll = np.convolve(diffs, np.ones(window)/window, mode='valid')\n        # find where roll deviates from ~0 consistently\n        idx = np.where(np.abs(roll) > (np.std(roll[:50]) * 3) if np.std(roll[:50]) > 0 else 0.001)[0]\n        if len(idx) > 0:\n            t = g['timestamp'].iloc[idx[0] + window]\n            print(f'{sid}: trend change ~{t} (phys ~ {t - pd.Timedelta(minutes=m[\"response_delay_minutes\"])}), roll_mag={roll[idx[0]]:.4f}')\n        else:\n            print(f'{sid}: no clear trend change')\nPY" action.permission=* action.action=allow action.pattern=*
