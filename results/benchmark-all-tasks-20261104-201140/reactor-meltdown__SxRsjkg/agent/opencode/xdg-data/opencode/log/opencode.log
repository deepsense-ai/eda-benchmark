timestamp=2026-11-04T19:37:27.582Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\n# The task says: \"onset time of a subsystem is when its physical state first began to deviate from normal operating conditions\"\n# \"normal operating conditions\" might mean baseline. Let us look at when values start to systematically drift from baseline.\n# Also look at the structure: TURBINE first based on range breach (output dropped), affecting others? Or is it different?\n# Compare with alarms - alarms fired when already in warning. But the question wants when physical state first began to deviate.\n\n# Let us look more broadly at all subsystems, not just one representative sensor per sub.\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\nsubsystems = ['TURBINE', 'STEAM_GEN', 'COOLING', 'PRIMARY_LOOP', 'CORE']\nfor sub in subsystems:\n    sensors = meta[meta['subsystem']==sub]['sensor_id'].tolist()\n    earliest = None\n    for sid in sensors:\n        m = meta[meta['sensor_id']==sid].iloc[0]\n        g = s[s['sensor_id']==sid].sort_values('timestamp').copy()\n        vals = g['value'].values\n        # find first persistent deviation from baseline (first 50-100 pts)\n        baseline_win = min(100, len(vals)//10) if len(vals) > 0 else 50\n        baseline = np.median(vals[:baseline_win]) if baseline_win > 0 else np.median(vals)\n        # detect when value moves away from baseline by > threshold (e.g. 2% or 2*std of baseline)\n        base_std = np.std(vals[:baseline_win])\n        thresh = max(0.02 * abs(baseline) if baseline != 0 else 1, 2 * base_std if base_std > 0 else 1)\n        # find first index where |val - baseline| > thresh and stays that way for a bit?\n        for i in range(baseline_win, len(vals)):\n            if abs(vals[i] - baseline) > thresh:\n                # check persistence - next 5 points also deviate\n                persistent = True\n                for j in range(1, min(5, len(vals)-i)):\n                    if abs(vals[i+j] - baseline) <= thresh * 0.5:\n                        persistent = False\n                        break\n                if persistent:\n                    t_obs = g['timestamp'].iloc[i]\n                    t_phys = t_obs - pd.Timedelta(minutes=float(m['response_delay_minutes']))\n                    if earliest is None or t_phys < earliest:\n                        earliest = t_phys\n                    break\n    print(f'{sub}: earliest phys deviation ~ {earliest}')\nPY" action.permission=* action.action=allow action.pattern=*
