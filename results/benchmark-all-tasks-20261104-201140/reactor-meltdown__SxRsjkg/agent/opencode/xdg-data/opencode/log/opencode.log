timestamp=2026-11-04T19:39:03.444Z level=INFO run=5b2c05d3 message=evaluated permission=bash pattern="python << 'PY'\nimport pandas as pd\nimport numpy as np\n\nmeta = pd.read_csv('/app/dataset/sensor_metadata.csv')\ns1 = pd.read_csv('/app/dataset/sensors_01.csv')\ns2 = pd.read_csv('/app/dataset/sensors_02.csv')\ns3 = pd.read_csv('/app/dataset/sensors_03.csv')\ns = pd.concat([s1, s2, s3], ignore_index=True)\ns['timestamp'] = pd.to_datetime(s['timestamp'])\n\n# Look at TURBINE output more closely - when did it really start deviating?\nsid = 'TURB_OUTPUT_01'\nm = meta[meta['sensor_id']==sid].iloc[0]\ng = s[s['sensor_id']==sid].sort_values('timestamp').copy()\nvals = g['value'].values\n# Find when it first drops below its normal operating level consistently\n# Normal range is 800-1000. It starts at ~900. Drops below 800 eventually.\n# But did it deviate from \"normal\" earlier? e.g. started dropping from steady state\n# Look for first monotonic decrease from baseline\nbaseline = np.median(vals[:100])\n# find first point where value is below baseline and continues downward\nfor i in range(100, len(vals)):\n    if vals[i] < baseline - 0.5 and vals[i+1] < vals[i] if i+1 < len(vals) else False:\n        # check persistence\n        going_down = True\n        for j in range(1, 10):\n            if i+j < len(vals) and vals[i+j] >= vals[i+j-1]:\n                going_down = False\n                break\n        if going_down or vals[i+5] < vals[i] - 2 if i+5 < len(vals) else False:\n            t_obs = g['timestamp'].iloc[i]\n            t_phys = t_obs - pd.Timedelta(minutes=m['response_delay_minutes'])\n            print(f'{sid}: sustained drop starts at phys={t_phys}, obs={t_obs}, val={vals[i]:.2f}')\n            break\nPY" action.permission=* action.action=allow action.pattern=*
