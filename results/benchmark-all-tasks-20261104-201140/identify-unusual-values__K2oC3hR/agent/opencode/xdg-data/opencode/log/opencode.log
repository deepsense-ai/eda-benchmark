timestamp=2026-11-04T19:31:09.909Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf = df.reset_index(drop=True)\nmask_bad = (\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['age'] > 120)\n)\ndf_clean = df[~mask_bad].copy()\n\n# compute IQR outliers\niqr_outliers_by_idx = set()\nfor c in ['age', 'bmi', 'avg_glucose_level']:\n    q1 = df_clean[c].quantile(0.25)\n    q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1\n    lo = q1 - 3*iqr\n    hi = q3 + 3*iqr\n    mask = (df_clean[c] < lo) | (df_clean[c] > hi)\n    for idx in df_clean[mask].index:\n        iqr_outliers_by_idx.add(idx)\n\n# apply rule for avg_glucose_level outliers\nfinal_iqr_rejects = set()\nfor idx in iqr_outliers_by_idx:\n    # check if this idx is an outlier due to glucose? look up its glucose value\n    val = df_clean.loc[idx, 'avg_glucose_level']\n    # recheck if it's outlier by glucose IQR\n    c = 'avg_glucose_level'\n    q1 = df_clean[c].quantile(0.25); q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1; lo = q1-3*iqr; hi = q3+3*iqr\n    is_glc_out = (val < lo) or (val > hi)\n    if not is_glc_out:\n        final_iqr_rejects.add(idx)  # outlier due to other vars? keep as reject? let us check all\n        continue\n    # apply glucose-specific rule\n    same = df_clean[df_clean['avg_glucose_level'] == val]\n    total = len(same)\n    stroke = same['stroke'].sum()\n    rate = stroke/total if total else 0\n    if rate >= 0.5:\n        # not considered outlier - do not reject\n        pass\n    elif rate > 0.2:\n        # log transform base-2 and check again\n        df_check = df_clean.copy()\n        df_check.loc[df_check['avg_glucose_level'] == val, 'avg_glucose_level'] = np.log2(val) if val > 0 else val\n        # but we need to re-evaluate the same observation after transformation? the rule says \"a base-2 logarithmic transformation should be applied and the above check should be performed again\"\n        # apply to observations sharing same values? or to that observation. Apply transformation and then recheck the condition (the 50%/20% check).\n        same_t = df_check[df_check['avg_glucose_level'] == np.log2(val) if val > 0 else val]\n        # easier: simulate\n        val_t = np.log2(val) if val > 0 else val\n        same_t = df_check[df_check['avg_glucose_level'] == val_t]\n        total_t = len(same_t)\n        stroke_t = same_t['stroke'].sum()\n        rate_t = stroke_t/total_t if total_t else 0\n        if rate_t >= 0.5:\n            pass  # keep\n        else:\n            final_iqr_rejects.add(idx)\n    else:\n        final_iqr_rejects.add(idx)\nPY" action.permission=* action.action=allow action.pattern=*
