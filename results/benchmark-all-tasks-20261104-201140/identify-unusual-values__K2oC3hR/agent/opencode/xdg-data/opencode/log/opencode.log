df_no_std = df_no_std.drop(index=[i for i in outliers if i in df_no_std.index]).copy()\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nrisk = np.ones(len(df_no_std))\nfor c in num_cols:\n    mx = df_no_std[c].max()\n    risk *= (df_no_std[c].values / mx) if mx != 0 else 0\ndf_no_std['risk_proxy'] = risk\nprint(df_no_std.shape)\nPY" action.permission=* action.action=allow action.pattern=*
