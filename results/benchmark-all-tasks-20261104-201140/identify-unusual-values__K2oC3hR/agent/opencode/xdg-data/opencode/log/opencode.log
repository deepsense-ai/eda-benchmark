timestamp=2026-11-04T19:43:16.943Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport json\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndef answer() -> list[int]:\n    df = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\n    df = df.reset_index(drop=True)\n\n    outliers = set()\n    # 1. Technical noise\n    for idx, row in df.iterrows():\n        age = row['age']\n        bmi = row['bmi']\n        glucose = row['avg_glucose_level']\n        bad = False\n        if glucose < 20 or glucose > 800:\n            bad = True\n        if bmi < 10 or bmi > 60:\n            bad = True\n        if age > 120:\n            bad = True\n        if bad:\n            outliers.add(idx)\n\n    mask_bad_tech = (\n        (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n        (df['bmi'] < 10) | (df['bmi'] > 60) |\n        (df['age'] > 120)\n    )\n    df_clean = df[~mask_bad_tech].copy()\n\n    # 2. IQR with glucose rule\n    bounds = {}\n    for c in ['age', 'bmi', 'avg_glucose_level']:\n        q1 = df_clean[c].quantile(0.25)\n        q3 = df_clean[c].quantile(0.75)\n        iqr = q3 - q1\n        lo = q1 - 3 * iqr\n        hi = q3 + 3 * iqr\n        bounds[c] = (lo, hi)\n\n    for idx in df_clean.index:\n        out_by = []\n        for c in ['age', 'bmi', 'avg_glucose_level']:\n            lo, hi = bounds[c]\n            v = df_clean.loc[idx, c]\n            if v < lo or v > hi:\n                out_by.append(c)\n        if len(out_by) == 0:\n            continue\n        if 'avg_glucose_level' not in out_by:\n            outliers.add(idx)\n            continue\n        val = df_clean.loc[idx, 'avg_glucose_level']\n        same = df_clean[df_clean['avg_glucose_level'] == val]\n        total = len(same)\n        stroke = same['stroke'].sum()\n        rate = stroke / total if total else 0\n        reject = True\n        if rate >= 0.5:\n            reject = False\n        elif rate > 0.2:\n            val_t = np.log2(val) if val > 0 else val\n            same_t = df_clean[np.isclose(df_clean['avg_glucose_level'].apply(lambda x: np.log2(x) if x > 0 else x), val_t)]\n            total_t = len(same_t)\n            stroke_t = same_t['stroke'].sum()\n            rate_t = stroke_t / total_t if total_t else 0\n            if rate_t >= 0.5:\n                reject = False\n        if reject:\n            outliers.add(idx)\n\n    # 3. Remove standard outliers from data and create risk_proxy\n    df_no_std = df.drop(index=[i for i in outliers if i in df.index]).copy()\n    num_cols = ['age', 'bmi', 'avg_glucose_level']\n    risk = np.ones(len(df_no_std))\n    for c in num_cols:\n        mx = df_no_std[c].max()\n        if mx != 0:\n            risk *= (df_no_std[c].values / mx)\n        else:\n            risk *= 0\n    df_no_std['risk_proxy'] = risk\n\n    # 4. Mahalanobis outliers\n    X = df_no_std[num_cols].values\n    mu = X.mean(axis=0)\n    cov = np.cov(X, rowvar=False)\n    inv_cov = np.linalg.pinv(cov)\n    d2 = np.zeros(X.shape[0])\n    for i in range(X.shape[0]):\n        diff = X[i] - mu\n        d2[i] = diff @ inv_cov @ diff\n    crit = chi2.ppf(0.99, df=len(num_cols))\n    mah_mask = d2 > crit\n    for idx in df_no_std.index[mah_mask]:\n        outliers.add(idx)\n\n    # 5. Categorical checks\n    for idx, row in df.iterrows():\n        age = row['age']\n        work = str(row['work_type']).lower() if pd.notna(row['work_type']) else ''\n        smoking = str(row['smoking_status']).lower() if pd.notna(row['smoking_status']) else ''\n        is_smoke_group = (smoking == 'smokes' or smoking == 'formerly smoked')\n        mark = False\n        if age <= 3 and 'student' in work:\n            mark = True\n        if is_smoke_group and work == 'children':\n            mark = True\n        if is_smoke_group and age <= 14:\n            mark = True\n        if mark:\n            outliers.add(idx)\n\n    result = sorted(list(outliers))\n    return result\n\n\nif __name__ == \"__main__\":\n    res = answer()\n    with open(\"/app/answer.json\", \"w\") as f:\n        json.dump(res, f, default=list)\nPY" action.permission=* action.action=allow action.pattern=*
