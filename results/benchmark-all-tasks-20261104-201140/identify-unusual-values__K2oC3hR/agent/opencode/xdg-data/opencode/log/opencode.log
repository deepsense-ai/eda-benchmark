timestamp=2026-11-04T19:32:00.287Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="cat > /tmp/step_iqr2.py << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf = df.reset_index(drop=True)\nmask_bad = (\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['age'] > 120)\n)\ndf_clean = df[~mask_bad].copy()\n\n# bounds\nbounds = {}\nfor c in ['age', 'bmi', 'avg_glucose_level']:\n    q1 = df_clean[c].quantile(0.25); q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1; lo = q1-3*iqr; hi = q3+3*iqr\n    bounds[c] = (lo, hi)\n\nrejects = set()\nfor idx in df_clean.index:\n    out_by = []\n    for c in ['age', 'bmi', 'avg_glucose_level']:\n        lo, hi = bounds[c]\n        if (df_clean.loc[idx, c] < lo) or (df_clean.loc[idx, c] > hi):\n            out_by.append(c)\n    if len(out_by) == 0:\n        continue\n    # if glucose is not the reason, just reject?\n    if 'avg_glucose_level' not in out_by:\n        rejects.add(idx)\n        continue\n    # glucose outlier: apply rule\n    val = df_clean.loc[idx, 'avg_glucose_level']\n    same = df_clean[df_clean['avg_glucose_level'] == val]\n    total = len(same); stroke = same['stroke'].sum()\n    rate = stroke/total if total else 0\n    if rate >= 0.5:\n        continue  # keep, not rejected\n    elif rate > 0.2:\n        # transform and check again (above check = 50%+)\n        val_t = np.log2(val) if val > 0 else val\n        # group by transformed value? look for same transformed value as this observation\n        same_t = df_clean[df_clean['avg_glucose_level'].apply(lambda x: np.log2(x) if x > 0 else x) == val_t]\n        total_t = len(same_t); stroke_t = same_t['stroke'].sum()\n        rate_t = stroke_t/total_t if total_t else 0\n        if rate_t >= 0.5:\n            continue  # keep\n        else:\n            rejects.add(idx)\n    else:\n        rejects.add(idx)\nPY" action.permission=* action.action=allow action.pattern=*
