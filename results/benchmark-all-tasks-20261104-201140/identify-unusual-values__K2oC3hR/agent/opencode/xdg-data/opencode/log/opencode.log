timestamp=2026-11-04T19:28:30.307Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf = df.reset_index(drop=True)\n\n# Step 1: discard technical noise\nmask_bad = (\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['age'] > 120)\n)\ndf_clean = df[~mask_bad].copy()\nprint('after tech noise:', len(df_clean))\n\n# Step 2: 3*IQR on numeric cols\ncols = ['age', 'bmi', 'avg_glucose_level']\nfor c in cols:\n    q1 = df_clean[c].quantile(0.25)\n    q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1\n    lo = q1 - 3*iqr\n    hi = q3 + 3*iqr\n    out = ((df_clean[c] < lo) | (df_clean[c] > hi)).sum()\n    print(f'{c}: lo={lo:.2f}, hi={hi:.2f}, outliers={out}')\nPY" action.permission=* action.action=allow action.pattern=*
