timestamp=2026-11-04T19:39:20.755Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="python3 << 'PY'\n# simulate by running the logic incrementally\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf = df.reset_index(drop=True)\n\noutliers = set()\n# 1\nfor idx, row in df.iterrows():\n    age = row['age']; bmi = row['bmi']; glucose = row['avg_glucose_level']\n    bad = False\n    if glucose < 20 or glucose > 800: bad = True\n    if bmi < 10 or bmi > 60: bad = True\n    if age > 120: bad = True\n    if bad:\n        outliers.add(idx)\n\nmask_bad_tech = (\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['age'] > 120)\n)\ndf_clean = df[~mask_bad_tech].copy()\n\n# 2\nbounds = {}\nfor c in ['age', 'bmi', 'avg_glucose_level']:\n    q1 = df_clean[c].quantile(0.25); q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1; lo = q1-3*iqr; hi = q3+3*iqr\n    bounds[c] = (lo, hi)\n\nfor idx in df_clean.index:\n    out_by = []\n    for c in ['age', 'bmi', 'avg_glucose_level']:\n        lo, hi = bounds[c]; v = df_clean.loc[idx, c]\n        if v < lo or v > hi: out_by.append(c)\n    if len(out_by) == 0: continue\n    if 'avg_glucose_level' not in out_by:\n        outliers.add(idx); continue\n    val = df_clean.loc[idx, 'avg_glucose_level']\n    same = df_clean[df_clean['avg_glucose_level'] == val]\n    total = len(same); stroke = same['stroke'].sum()\n    rate = stroke/total if total else 0\n    reject = True\n    if rate >= 0.5: reject = False\n    elif rate > 0.2:\n        val_t = np.log2(val) if val > 0 else val\n        same_t = df_clean[np.isclose(df_clean['avg_glucose_level'].apply(lambda x: np.log2(x) if x>0 else x), val_t)]\n        total_t = len(same_t); stroke_t = same_t['stroke'].sum()\n        rate_t = stroke_t/total_t if total_t else 0\n        if rate_t >= 0.5: reject = False\n    if reject: outliers.add(idx)\n\n# mah\ndf_no_std = df.drop(index=[i for i in outliers if i in df.index]).copy()\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nrisk = np.ones(len(df_no_std))\nfor c in num_cols:\n    mx = df_no_std[c].max()\n    risk *= (df_no_std[c].values / mx)\ndf_no_std['risk_proxy'] = risk\n\nX = df_no_std[num_cols].values\nmu = X.mean(axis=0); cov = np.cov(X, rowvar=False)\ninv_cov = np.linalg.pinv(cov)\nd2 = np.zeros(X.shape[0])\nfor i in range(X.shape[0]):\n    diff = X[i]-mu; d2[i] = diff @ inv_cov @ diff\ncrit = chi2.ppf(0.99, df=len(num_cols))\nfor idx in df_no_std.index[d2 > crit]:\n    outliers.add(idx)\n\nprint('after mah:', len(outliers))\n\n# cat\nadded = 0\nfor idx, row in df.iterrows():\n    age = row['age']\n    work = str(row['work_type']).lower() if pd.notna(row['work_type']) else ''\n    smoking = str(row['smoking_status']).lower() if pd.notna(row['smoking_status']) else ''\n    is_smoke_group = (smoking == 'smokes' or smoking == 'formerly smoked')\n    mark = False\n    if age <= 3 and 'student' in work:\n        mark = True\n    if is_smoke_group and work == 'children':\n        mark = True\n    if is_smoke_group and age <= 14:\n        mark = True\n    if mark:\n        if idx not in outliers:\n            added += 1\n        outliers.add(idx)\nprint('after cat:', len(outliers), 'added:', added)\nPY" action.permission=* action.action=allow action.pattern=*
