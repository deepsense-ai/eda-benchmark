timestamp=2026-11-04T19:30:56.596Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf = df.reset_index(drop=True)\nmask_bad = (\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['age'] > 120)\n)\ndf_clean = df[~mask_bad].copy()\n\n# find IQR outliers per column\niqr_outliers = set()\ncols = ['age', 'bmi', 'avg_glucose_level']\nfor c in cols:\n    q1 = df_clean[c].quantile(0.25)\n    q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1\n    lo = q1 - 3*iqr\n    hi = q3 + 3*iqr\n    mask = (df_clean[c] < lo) | (df_clean[c] > hi)\n    for idx in df_clean[mask].index:\n        iqr_outliers.add((idx, c))\n\n# group by idx\nby_idx = {}\nfor idx, c in iqr_outliers:\n    by_idx.setdefault(idx, []).append(c)\n\n# check glucose rule\nglc_out = [idx for idx, cols in by_idx.items() if 'avg_glucose_level' in cols]\nprint('glc outlier count:', len(glc_out))\nPY" action.permission=* action.action=allow action.pattern=*
