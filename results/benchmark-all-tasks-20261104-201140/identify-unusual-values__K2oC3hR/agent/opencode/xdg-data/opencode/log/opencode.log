timestamp=2026-11-04T19:37:28.092Z level=INFO run=ebc6dc18 message=evaluated permission=bash pattern="cat > /tmp/step7.py << 'PY'\nimport pandas as pd\nimport numpy as np\nfrom scipy.stats import chi2\n\ndf = pd.read_csv('/app/dataset/synthetic_stroke_data.csv')\ndf = df.reset_index(drop=True)\n\noutliers = set()\n# 1\nfor idx, row in df.iterrows():\n    age = row['age']; bmi = row['bmi']; glucose = row['avg_glucose_level']\n    bad = False\n    if glucose < 20 or glucose > 800: bad = True\n    if bmi < 10 or bmi > 60: bad = True\n    if age > 120: bad = True\n    if bad:\n        outliers.add(idx)\n\nmask_bad_tech = (\n    (df['avg_glucose_level'] < 20) | (df['avg_glucose_level'] > 800) |\n    (df['bmi'] < 10) | (df['bmi'] > 60) |\n    (df['age'] > 120)\n)\ndf_clean = df[~mask_bad_tech].copy()\n\n# 2\nbounds = {}\nfor c in ['age', 'bmi', 'avg_glucose_level']:\n    q1 = df_clean[c].quantile(0.25); q3 = df_clean[c].quantile(0.75)\n    iqr = q3 - q1; lo = q1-3*iqr; hi = q3+3*iqr\n    bounds[c] = (lo, hi)\n\nfor idx in df_clean.index:\n    out_by = []\n    for c in ['age', 'bmi', 'avg_glucose_level']:\n        lo, hi = bounds[c]; v = df_clean.loc[idx, c]\n        if v < lo or v > hi: out_by.append(c)\n    if len(out_by) == 0: continue\n    if 'avg_glucose_level' not in out_by:\n        outliers.add(idx); continue\n    val = df_clean.loc[idx, 'avg_glucose_level']\n    same = df_clean[df_clean['avg_glucose_level'] == val]\n    total = len(same); stroke = same['stroke'].sum()\n    rate = stroke/total if total else 0\n    reject = True\n    if rate >= 0.5: reject = False\n    elif rate > 0.2:\n        val_t = np.log2(val) if val > 0 else val\n        same_t = df_clean[np.isclose(df_clean['avg_glucose_level'].apply(lambda x: np.log2(x) if x>0 else x), val_t)]\n        total_t = len(same_t); stroke_t = same_t['stroke'].sum()\n        rate_t = stroke_t/total_t if total_t else 0\n        if rate_t >= 0.5: reject = False\n    if reject: outliers.add(idx)\n\n# 3 & mah\ndf_no_std = df.drop(index=[i for i in outliers if i in df.index]).copy()\nnum_cols = ['age', 'bmi', 'avg_glucose_level']\nrisk = np.ones(len(df_no_std))\nfor c in num_cols:\n    mx = df_no_std[c].max()\n    risk *= (df_no_std[c].values / mx)\ndf_no_std['risk_proxy'] = risk\n\nX = df_no_std[num_cols].values\nmu = X.mean(axis=0)\ncov = np.cov(X, rowvar=False)\ninv_cov = np.linalg.pinv(cov)\nd2 = np.zeros(X.shape[0])\nfor i in range(X.shape[0]):\n    diff = X[i]-mu\n    d2[i] = diff @ inv_cov @ diff\ncrit = chi2.ppf(0.99, df=len(num_cols))\nmah_out_mask = d2 > crit\nfor idx in df_no_std.index[mah_out_mask]:\n    outliers.add(idx)\n\n# 5. Categorical checks\n# - values unlikely: “smoker” or “formerly smoked” / person working in children? \n#   \"values that are unlikely in reality, such as “smoker” or “formerly smoked” / person working in children\"\n#   Maybe a specific combination? Or just unusual combinations like children with smoking status \"smoker\" or \"formerly smoked\"? Also \"person working in children\" - work_type \"children\" maybe? Or maybe work_type involving children inappropriately? Or the example given is a bit odd.\n#   Also: \"additionally you should check whether there are any toddlers that are students. If so they should be also considered as outliers.\"\n#   Age of toddlers <= 3, age of children <= 14 (given thresholds for categorical outlier detection). \n#   So if age <= 3 (toddler) and work_type is \"student\" -> outlier. Also other cases: \"smoker\" or \"formerly smoked\" but person is a child? Or combinations like that. Let us look at the exact text: \"check whether there are any values among the categorical variables that are unlikely in reality, such as “smoker” or “formerly smoked” / person working in children.\" Maybe the slash means cases where someone is \"working in children\" (work_type children?) and also has smoking status like smoker/formerly smoked? Or just the combinations mentioned. Also \"children\" as work_type means children (probably child labor is not usual? Or maybe just age group context). Let us look at the dataset: work_type has \"children\", \"student\" etc. Children as work_type - could be odd in some contexts, but combined with smoking? Or maybe the rule is: if smoking_status is \"smoker\" or \"formerly smoked\" AND work_type is \"children\" (or person is child), that’s unlikely. Also check toddlers who are students: age <= 3 and work_type \"student\" -> outlier.\nprint('before cat:', len(outliers))\nPY" action.permission=* action.action=allow action.pattern=*
