timestamp=2026-11-04T19:33:34.190Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /app/process_full.py << 'PY'\nimport csv\nimport json\nimport math\nimport re\nfrom datetime import datetime\nfrom collections import defaultdict\n\ndef parse_amount_str(s):\n    if s is None:\n        return float('nan')\n    s = str(s).strip()\n    if s == '':\n        return float('nan')\n    negative = False\n    s_upper = s.upper()\n    if 'CR' in s_upper:\n        negative = True\n    if '(' in s and ')' in s:\n        negative = True\n    if '-' in s:\n        negative = True\n    s_work = s\n    s_work = re.sub(r'C1', '', s_work, flags=re.I)\n    s_work = re.sub(r'C2', '', s_work, flags=re.I)\n    s_work = s_work.replace('(', '').replace(')', '')\n    s_work = re.sub(r'[a-zA-Z]', '', s_work)\n    s_work = re.sub(r'\\s+', '', s_work)\n    if s_work == '':\n        return float('nan')\n    commas = [m.start() for m in re.finditer(r',', s_work)]\n    dots = [m.start() for m in re.finditer(r'\\.', s_work)]\n    if len(commas) > 0 and len(dots) > 0:\n        if commas[-1] > dots[-1]:\n            s_res = s_work.replace('.', '')\n            s_res = s_res.replace(',', '.')\n        else:\n            s_res = s_work.replace(',', '')\n    elif len(commas) > 0 and len(dots) == 0:\n        if len(commas) == 1:\n            pos = commas[0]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work.replace(',', '.')\n            else:\n                s_res = s_work.replace(',', '')\n        else:\n            pos = commas[-1]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work.replace(',', '.')\n            else:\n                s_res = s_work.replace(',', '')\n    elif len(dots) > 0 and len(commas) == 0:\n        if len(dots) == 1:\n            pos = dots[0]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work\n            else:\n                s_res = s_work.replace('.', '')\n        else:\n            pos = dots[-1]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work\n            else:\n                s_res = s_work.replace('.', '')\n    else:\n        s_res = s_work\n    try:\n        val = float(s_res) if s_res else float('nan')\n    except:\n        try:\n            val = float(re.sub(r'[^0-9\\.-]', '', s_res))\n        except:\n            val = float('nan')\n    if negative and not math.isnan(val):\n        val = -abs(val)\n    return val\n\ndef parse_notes(s):\n    if s is None:\n        s = ''\n    s = str(s)\n    res = {'items': None, 'adj_pct': 0.0, 'fee': 0.0, 'waive': False}\n    m = re.search(r'items\\s*=\\s*(-?\\d+)', s, flags=re.I)\n    if m:\n        try:\n            res['items'] = int(m.group(1))\n        except:\n            res['items'] = None\n    m = re.search(r'adj\\s*=\\s*([+-]?[\\d]+(?:\\.\\d+)?)\\s*%', s, flags=re.I)\n    if not m:\n        m = re.search(r'adj\\s*=\\s*([+-]?\\d+(?:\\.\\d+)?)', s, flags=re.I)\n        # need %? check if % appears nearby? but format says adj=<signed number>%\n        # better: require % in first search as per spec; but be flexible\n    # do spec as stated\n    m2 = re.search(r'adj\\s*=\\s*([+-]?[\\d\\.]+)\\s*%', s, flags=re.I)\n    if m2:\n        try:\n            res['adj_pct'] = float(m2.group(1)) / 100.0\n        except:\n            pass\n    m3 = re.search(r'fee\\s*=\\s*([+-]?[\\d\\.]+)', s, flags=re.I)\n    if m3:\n        try:\n            res['fee'] = float(m3.group(1))\n        except:\n            pass\n    if re.search(r'waive\\s*=\\s*true', s, flags=re.I):\n        res['waive'] = True\n    return res\nPY" action.permission=* action.action=allow action.pattern=*
