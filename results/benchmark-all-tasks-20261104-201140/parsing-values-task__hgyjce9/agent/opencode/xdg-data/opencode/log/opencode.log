timestamp=2026-11-04T19:50:35.335Z level=INFO run=90d54173 message=evaluated permission=bash pattern="python3 << 'PYTHON'\n# quick inline to find chosen for R00125 with old logic\nimport csv, math, re\nfrom datetime import datetime\n\ndef parse_amount_str(s):\n    if s is None: return float('nan')\n    s = str(s).strip()\n    if s == '': return float('nan')\n    negative = False; s_upper = s.upper()\n    if 'CR' in s_upper: negative = True\n    if '(' in s and ')' in s: negative = True\n    if '-' in s: negative = True\n    s_work = s\n    s_work = re.sub(r'C1','',s_work,flags=re.I); s_work = re.sub(r'C2','',s_work,flags=re.I)\n    s_work = s_work.replace('(','').replace(')','')\n    s_work = re.sub(r'[a-zA-Z]','',s_work); s_work = re.sub(r'\\s+','',s_work)\n    if s_work == '': return float('nan')\n    commas=[m.start() for m in re.finditer(r',',s_work)]; dots=[m.start() for m in re.finditer(r'\\.',s_work)]\n    if len(commas)>0 and len(dots)>0:\n        if commas[-1]>dots[-1]: s_res = s_work.replace('.',''); s_res = s_res.replace(',','.')\n        else: s_res = s_work.replace(',','')\n    elif len(commas)>0 and len(dots)==0:\n        if len(commas)==1:\n            pos=commas[0]\n            if len(s_work)-pos-1==2: s_res = s_work.replace(',','.')\n            else: s_res = s_work.replace(',','')\n        else:\n            pos=commas[-1]\n            if len(s_work)-pos-1==2: s_res = s_work.replace(',','.')\n            else: s_res = s_work.replace(',','')\n    elif len(dots)>0 and len(commas)==0:\n        if len(dots)==1:\n            pos=dots[0]\n            if len(s_work)-pos-1==2: s_res = s_work\n            else: s_res = s_work.replace('.','')\n        else:\n            pos=dots[-1]\n            if len(s_work)-pos-1==2: s_res = s_work\n            else: s_res = s_work.replace('.','')\n    else: s_res = s_work\n    try:\n        val = float(s_res) if s_res else float('nan')\n    except:\n        try: val = float(re.sub(r'[^0-9\\.-]','',s_res))\n        except: val = float('nan')\n    if negative and not math.isnan(val): val = -abs(val)\n    return val\n\ndef parse_notes(s):\n    if s is None: s = ''\n    s = str(s)\n    res = {'items':None,'adj_pct':0.0,'fee':0.0,'waive':False}\n    m = re.search(r'items\\s*=\\s*(-?\\d+)',s,flags=re.I)\n    if m:\n        try: res['items']=int(m.group(1))\n        except: res['items']=None\n    m = re.search(r'adj\\s*=\\s*([+-]?[\\d\\.]+)\\s*%',s,flags=re.I)\n    if m:\n        try: res['adj_pct']=float(m.group(1))/100.0\n        except: pass\n    m = re.search(r'fee\\s*=\\s*([+-]?[\\d\\.]+)',s,flags=re.I)\n    if m:\n        try: res['fee']=float(m.group(1))\n        except: pass\n    if re.search(r'waive\\s*=\\s*true',s,flags=re.I): res['waive']=True\n    return res\n\ndef parse_dt(s):\n    if s is None: return None\n    s = str(s).strip()\n    if s == '': return None\n    try:\n        if s.endswith('Z'): s = s[:-1]\n        for f in ['%Y-%m-%dT%H:%M:%S','%Y-%m-%d %H:%M:%S','%Y-%m-%d %H:%M','%Y-%m-%d']:\n            try: return datetime.strptime(s,f)\n            except: continue\n    except: pass\n    return None\n\ndef compute_net(base, adj, fee, waive):\n    if math.isnan(base): return float('nan')\n    if waive: return 0.0\n    return base*(1.0+adj)+fee\n\nparsed = []\nwith open('/app/dataset/data.csv') as f:\n    r = csv.DictReader(f)\n    for i, row in enumerate(r):\n        if row['record_id'] == 'R00125':\n            dt = parse_dt(row['event_time'])\n            base = parse_amount_str(row['amount_str'])\n            n = parse_notes(row['notes'])\n            net = compute_net(base, n['adj_pct'], n['fee'], n['waive'])\n            parsed.append({'idx':i,'dt':dt,'net':net,'channel':row['channel'],'row':row})\n# find best\nbest = parsed[0]\nfor x in parsed[1:]:\n    bdt = best['dt']; rdt = x['dt']\n    if rdt is not None and bdt is None: best=x; continue\n    if rdt is None and bdt is not None: continue\n    if rdt is not None and bdt is not None:\n        if rdt > bdt: best=x; continue\n        if rdt < bdt: continue\n    if (not math.isnan(x['net'])) and math.isnan(best['net']): best=x; continue\n    if (not math.isnan(best['net'])) and math.isnan(x['net']): continue\n    if x['idx'] < best['idx']: best=x; continue\nprint(best['dt'], best['channel'], best['row']['amount_str'], best['net'])\nPYTHON" action.permission=* action.action=allow action.pattern=*
