timestamp=2026-11-04T19:36:42.515Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /tmp/parse_dt2.py << 'PY'\nfrom datetime import datetime\n\ndef parse_dt(s):\n    if s is None: return None\n    s = str(s).strip()\n    if s == '': return None\n    # handle Z\n    try:\n        if s.endswith('Z'):\n            # replace Z\n            s2 = s[:-1] + '+00:00'\n            try:\n                dt = datetime.fromisoformat(s2)\n                if dt.tzinfo:\n                    dt = dt.replace(tzinfo=None)\n                return dt\n            except:\n                pass\n            # fallback\n            s2 = s[:-1]\n            for f in ['%Y-%m-%dT%H:%M:%S', '%Y-%m-%d %H:%M:%S']:\n                try:\n                    return datetime.strptime(s2, f)\n                except:\n                    pass\n        # try fromisoformat\n        try:\n            dt = datetime.fromisoformat(s)\n            if dt.tzinfo:\n                dt = dt.replace(tzinfo=None)\n            return dt\n        except:\n            pass\n        for f in ['%Y-%m-%dT%H:%M:%S', '%Y-%m-%d %H:%M:%S', '%Y-%m-%d']:\n            try:\n                return datetime.strptime(s, f)\n            except:\n                pass\n    except:\n        pass\n    return None\n\n# test\nprint(parse_dt('2025-09-11T04:50:00Z'))\nPY" action.permission=* action.action=allow action.pattern=*
