timestamp=2026-11-04T19:46:34.678Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /tmp/recompute.py << 'PY'\nimport csv\nimport json\nimport math\nimport re\nfrom datetime import datetime\nfrom collections import defaultdict\n\n# copy full functions\ndef parse_amount_str(s):\n    if s is None: return float('nan')\n    s = str(s).strip()\n    if s == '': return float('nan')\n    negative = False\n    s_upper = s.upper()\n    if 'CR' in s_upper: negative = True\n    if '(' in s and ')' in s: negative = True\n    if '-' in s: negative = True\n    s_work = s\n    s_work = re.sub(r'C1','',s_work,flags=re.I); s_work = re.sub(r'C2','',s_work,flags=re.I)\n    s_work = s_work.replace('(','').replace(')','')\n    s_work = re.sub(r'[a-zA-Z]','',s_work); s_work = re.sub(r'\\s+','',s_work)\n    if s_work == '': return float('nan')\n    commas = [m.start() for m in re.finditer(r',',s_work)]; dots = [m.start() for m in re.finditer(r'\\.',s_work)]\n    if len(commas)>0 and len(dots)>0:\n        if commas[-1]>dots[-1]:\n            s_res = s_work.replace('.',''); s_res = s_res.replace(',','.')\n        else:\n            s_res = s_work.replace(',','')\n    elif len(commas)>0 and len(dots)==0:\n        if len(commas)==1:\n            pos = commas[0]\n            if len(s_work)-pos-1 == 2: s_res = s_work.replace(',','.')\n            else: s_res = s_work.replace(',','')\n        else:\n            pos = commas[-1]\n            if len(s_work)-pos-1 == 2: s_res = s_work.replace(',','.')\n            else: s_res = s_work.replace(',','')\n    elif len(dots)>0 and len(commas)==0:\n        if len(dots)==1:\n            pos = dots[0]\n            if len(s_work)-pos-1 == 2: s_res = s_work\n            else: s_res = s_work.replace('.','')\n        else:\n            pos = dots[-1]\n            if len(s_work)-pos-1 == 2: s_res = s_work\n            else: s_res = s_work.replace('.','')\n    else:\n        s_res = s_work\n    try:\n        val = float(s_res) if s_res else float('nan')\n    except:\n        try: val = float(re.sub(r'[^0-9\\.-]','',s_res))\n        except: val = float('nan')\n    if negative and not math.isnan(val): val = -abs(val)\n    return val\nPY" action.permission=* action.action=allow action.pattern=*
