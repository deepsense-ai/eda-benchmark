timestamp=2026-11-04T19:27:33.436Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /app/process.py << 'PY'\nimport csv\nimport json\nimport math\nimport re\nfrom datetime import datetime\nfrom collections import defaultdict\n\ndef parse_amount_str(s):\n    if s is None:\n        return float('nan')\n    s = str(s).strip()\n    if s == '':\n        return float('nan')\n    # Detect negatives\n    negative = False\n    s_upper = s.upper()\n    if 'CR' in s_upper:\n        negative = True\n    if '(' in s and ')' in s:\n        negative = True\n    if '-' in s:\n        negative = True\n    # Remove tokens C1, C2\n    s_clean = re.sub(r'\\bC1\\b', '', s, flags=re.I)\n    s_clean = re.sub(r'\\bC2\\b', '', s, flags=re.I)\n    # Remove parentheses\n    s_clean = s_clean.replace('(', '').replace(')', '')\n    # Remove letters and spaces\n    s_clean = re.sub(r'[a-zA-Z]', '', s_clean)\n    s_clean = re.sub(r'\\s+', '', s_clean)\n    if s_clean == '':\n        return float('nan')\n    # Find separators\n    commas = [m.start() for m in re.finditer(r',', s_clean)]\n    dots = [m.start() for m in re.finditer(r'\\.', s_clean)]\n    if len(commas) > 0 and len(dots) > 0:\n        if commas[-1] > dots[-1]:\n            # comma is decimal\n            s_work = s_clean.replace('.', '')\n            s_work = s_work.replace(',', '.')\n        else:\n            # dot is decimal\n            s_work = s_clean.replace(',', '')\n    elif len(commas) > 0 and len(dots) == 0:\n        if len(commas) == 1:\n            pos = commas[0]\n            if len(s_clean) - pos - 1 == 2:\n                s_work = s_clean.replace(',', '.')\n            else:\n                s_work = s_clean.replace(',', '')\n        else:\n            pos = commas[-1]\n            if len(s_clean) - pos - 1 == 2:\n                s_work = s_clean.replace(',', '.')\n            else:\n                s_work = s_clean.replace(',', '')\n    elif len(dots) > 0 and len(commas) == 0:\n        if len(dots) == 1:\n            pos = dots[0]\n            if len(s_clean) - pos - 1 == 2:\n                s_work = s_clean\n            else:\n                s_work = s_clean.replace('.', '')\n        else:\n            pos = dots[-1]\n            if len(s_clean) - pos - 1 == 2:\n                s_work = s_clean\n            else:\n                s_work = s_clean.replace('.', '')\n    else:\n        s_work = s_clean\n    try:\n        val = float(s_work) if s_work else float('nan')\n    except:\n        try:\n            # extract digits and dot\n            s_work2 = re.sub(r'[^0-9\\.-]', '', s_work)\n            val = float(s_work2) if s_work2 else float('nan')\n        except:\n            val = float('nan')\n    if negative and not math.isnan(val):\n        val = -abs(val)\n    return val\nPY" action.permission=* action.action=allow action.pattern=*
