timestamp=2026-11-04T19:27:20.328Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /tmp/parse.py << 'PY'\nimport csv\nimport re\nfrom datetime import datetime\nimport math\n\ndef parse_amount_str(s):\n    if s is None:\n        return float('nan')\n    s = str(s).strip()\n    if s == '':\n        return float('nan')\n    # Detect negatives\n    negative = False\n    if 'CR' in s.upper():\n        negative = True\n    if '(' in s and ')' in s:\n        negative = True\n    if '-' in s:\n        negative = True\n    # Remove tokens C1, C2\n    s = re.sub(r'\\bC1\\b', '', s, flags=re.I)\n    s = re.sub(r'\\bC2\\b', '', s, flags=re.I)\n    # Remove parentheses\n    s = s.replace('(', '').replace(')', '')\n    # Keep only digits, comma, dot, spaces? remove letters and spaces\n    # Remove letters\n    s = re.sub(r'[a-zA-Z]', '', s)\n    # Remove spaces\n    s = re.sub(r'\\s+', '', s)\n    # Now we have only digits, comma, dot\n    # Find separators\n    commas = [m.start() for m in re.finditer(r',', s)]\n    dots = [m.start() for m in re.finditer(r'\\.', s)]\n    # Apply last-separator rule\n    if len(commas) > 0 and len(dots) > 0:\n        # Both present; use last one as decimal\n        if commas[-1] > dots[-1]:\n            # comma is last -> comma is decimal\n            # decimal is comma: remove dots as thousand? and replace comma with dot\n            s_work = s.replace('.', '')\n            s_work = s_work.replace(',', '.')\n        else:\n            # dot is last -> dot is decimal\n            s_work = s.replace(',', '')\n    elif len(commas) > 0 and len(dots) == 0:\n        # Only commas\n        if len(commas) == 1:\n            # Check if exactly two digits follow\n            pos = commas[0]\n            if len(s) - pos - 1 == 2:\n                # treat as decimal\n                s_work = s.replace(',', '.')\n            else:\n                # treat as thousand sep -> remove\n                s_work = s.replace(',', '')\n        else:\n            # multiple commas: last is decimal if 2 digits follow? typical\n            pos = commas[-1]\n            if len(s) - pos - 1 == 2:\n                s_work = s.replace(',', '.')\n            else:\n                s_work = s.replace(',', '')\n    elif len(dots) > 0 and len(commas) == 0:\n        if len(dots) == 1:\n            if len(s) - dots[0] - 1 == 2:\n                s_work = s\n            else:\n                s_work = s.replace('.', '')\n        else:\n            pos = dots[-1]\n            if len(s) - pos - 1 == 2:\n                s_work = s.replace('.', '')\n            else:\n                s_work = s.replace('.', '')\n    else:\n        s_work = s\n    # Try to parse\n    try:\n        val = float(s_work) if s_work else float('nan')\n    except:\n        try:\n            val = float(re.sub(r'[^0-9\\.]', '', s_work)) if s_work else float('nan')\n        except:\n            val = float('nan')\n    if negative and not math.isnan(val):\n        val = -val\n    return val\nPY" action.permission=* action.action=allow action.pattern=*
