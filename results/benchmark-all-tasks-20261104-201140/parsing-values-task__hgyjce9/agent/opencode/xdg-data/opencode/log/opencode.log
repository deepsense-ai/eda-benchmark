timestamp=2026-11-04T19:30:53.134Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /tmp/process3.py << 'PY'\nimport re\nimport math\n\ndef parse_amount_str(s):\n    if s is None:\n        return float('nan')\n    s = str(s).strip()\n    if s == '':\n        return float('nan')\n    negative = False\n    s_upper = s.upper()\n    if 'CR' in s_upper:\n        negative = True\n    if '(' in s and ')' in s:\n        negative = True\n    if '-' in s:\n        negative = True\n    s_work = s\n    # Remove tokens C1, C2\n    s_work = re.sub(r'\\bC1\\b', '', s_work, flags=re.I)\n    s_work = re.sub(r'\\bC2\\b', '', s_work, flags=re.I)\n    s_work = s_work.replace('(', '').replace(')', '')\n    # Remove letters (but keep digits, comma, dot, space)\n    s_work = re.sub(r'[a-zA-Z]', '', s_work)\n    s_work = re.sub(r'\\s+', '', s_work)\n    if s_work == '':\n        return float('nan')\n    commas = [m.start() for m in re.finditer(r',', s_work)]\n    dots = [m.start() for m in re.finditer(r'\\.', s_work)]\n    if len(commas) > 0 and len(dots) > 0:\n        if commas[-1] > dots[-1]:\n            s_res = s_work.replace('.', '')\n            s_res = s_res.replace(',', '.')\n        else:\n            s_res = s_work.replace(',', '')\n    elif len(commas) > 0 and len(dots) == 0:\n        if len(commas) == 1:\n            pos = commas[0]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work.replace(',', '.')\n            else:\n                s_res = s_work.replace(',', '')\n        else:\n            pos = commas[-1]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work.replace(',', '.')\n            else:\n                s_res = s_work.replace(',', '')\n    elif len(dots) > 0 and len(commas) == 0:\n        if len(dots) == 1:\n            pos = dots[0]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work\n            else:\n                s_res = s_work.replace('.', '')\n        else:\n            pos = dots[-1]\n            if len(s_work) - pos - 1 == 2:\n                s_res = s_work\n            else:\n                s_res = s_work.replace('.', '')\n    else:\n        s_res = s_work\n    try:\n        val = float(s_res) if s_res else float('nan')\n    except:\n        val = float('nan')\n    if negative and not math.isnan(val):\n        val = -abs(val)\n    return val\nPY" action.permission=* action.action=allow action.pattern=*
timestamp=2026-11-04T19:30:53.134Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /tmp/test_parse4.py << 'PY'\nfrom process3 import parse_amount_str\n\ncases = [\n  \"808.824\",\n  \"1.000\",\n  \"150.594\",\n  \"1.000,00 C2\",\n  \"C1 1.000\",\n  \"43.48 C1\",\n  \"C1 245.07\",\n  \"(1,128)\",\n]\nfor c in cases:\n    print(repr(c), '->', parse_amount_str(c))\nPY" action.permission=* action.action=allow action.pattern=*
