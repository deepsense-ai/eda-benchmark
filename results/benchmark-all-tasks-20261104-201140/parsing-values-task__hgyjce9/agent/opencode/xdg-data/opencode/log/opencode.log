timestamp=2026-11-04T19:33:02.253Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat > /tmp/notes.py << 'PY'\nimport re\n\ndef parse_notes(s):\n    if s is None:\n        s = ''\n    s = str(s)\n    res = {'items': None, 'adj_pct': 0.0, 'fee': 0.0, 'waive': False}\n    # items from items=<int>\n    m = re.search(r'items\\s*=\\s*(-?\\d+)', s, flags=re.I)\n    if m:\n        try:\n            res['items'] = int(m.group(1))\n        except:\n            res['items'] = None\n    # adj_pct from adj=<signed number>%\n    m = re.search(r'adj\\s*=\\s*([+-]?[\\d\\.]+)\\s*%', s, flags=re.I)\n    if m:\n        try:\n            res['adj_pct'] = float(m.group(1)) / 100.0 if m.group(1) else 0.0\n        except:\n            res['adj_pct'] = 0.0\n    else:\n        # maybe just number without % in some cases? probably not as per format\n        pass\n    # fee\n    m = re.search(r'fee\\s*=\\s*([+-]?[\\d\\.]+)', s, flags=re.I)\n    if m:\n        try:\n            res['fee'] = float(m.group(1))\n        except:\n            res['fee'] = 0.0\n    # waive\n    if re.search(r'waive\\s*=\\s*true', s, flags=re.I):\n        res['waive'] = True\n    else:\n        res['waive'] = False\n    return res\nPY" action.permission=* action.action=allow action.pattern=*
