timestamp=2026-11-04T19:48:51.495Z level=INFO run=90d54173 message=evaluated permission=bash pattern="cat >> /tmp/recomp_full.py << 'PYTHON'\n\ndef answer_norm(strip_chan=True):\n    rows_raw = []\n    with open('/app/dataset/data.csv', newline='') as f:\n        reader = csv.DictReader(f)\n        for i, row in enumerate(reader):\n            rows_raw.append((i, row))\n    parsed = []\n    for idx, row in rows_raw:\n        record_id = row['record_id']\n        event_time_str = row.get('event_time', '')\n        region = row.get('region', '')\n        channel = row.get('channel', '')\n        amount_str = row.get('amount_str', '')\n        notes = row.get('notes', '')\n        dt = parse_dt(event_time_str)\n        base = parse_amount_str(amount_str)\n        n = parse_notes(notes)\n        adj_pct = n['adj_pct']; fee = n['fee']; waive = n['waive']; items = n['items']\n        net = compute_net(base, adj_pct, fee, waive)\n        if strip_chan:\n            channel_norm = channel.strip() if isinstance(channel, str) else channel\n        else:\n            channel_norm = channel\n        parsed.append({\n            'idx': idx,\n            'record_id': record_id,\n            'dt': dt,\n            'region': region,\n            'channel': channel_norm,\n            'base': base,\n            'adj_pct': adj_pct,\n            'fee': fee,\n            'waive': waive,\n            'items': items,\n            'net': net,\n        })\n    by_rec = defaultdict(list)\n    for p in parsed: by_rec[p['record_id']].append(p)\n    chosen = []\n    for rec_id, recs in by_rec.items():\n        best = recs[0]\n        for r in recs[1:]:\n            bdt = best['dt']; rdt = r['dt']\n            if rdt is not None and bdt is None:\n                best = r; continue\n            if rdt is None and bdt is not None:\n                continue\n            if rdt is not None and bdt is not None:\n                if rdt > bdt: best = r; continue\n                if rdt < bdt: continue\n            best_net_real = not math.isnan(best['net'])\n            r_net_real = not math.isnan(r['net'])\n            if r_net_real and not best_net_real: best = r; continue\n            if best_net_real and not r_net_real: continue\n            if r['idx'] < best['idx']: best = r; continue\n        chosen.append(best)\n    start = datetime(2025,10,1,0,0,0); end = datetime(2025,12,31,23,59,59)\n    filtered = []\n    for r in chosen:\n        dt = r['dt']\n        if dt is None: continue\n        if dt < start or dt > end: continue\n        ch = r['channel'] or ''\n        if isinstance(ch, str) and ch.strip().lower() == 'phone':\n            continue\n        if isinstance(ch, str) and ch.lower() == 'phone':\n            continue  # also handle tabbed? strip already done\n        net = r['net']\n        if math.isnan(net) or not math.isfinite(net): continue\n        filtered.append(r)\n    groups = defaultdict(list)\n    for r in filtered:\n        dt = r['dt']; month = dt.strftime('%Y-%m')\n        key = (r['region'], month)\n        groups[key].append(r)\n    for key, items_list in groups.items():\n        nets = [x['net'] for x in items_list]\n        medv = median(nets); mv = mad(nets, medv)\n        for x in items_list:\n            if mv == 0: x['robust_z'] = 0.0\n            else: x['robust_z'] = 0.6745*(x['net']-medv)/mv\n    result = []\n    for r in filtered:\n        if 'robust_z' not in r: r['robust_z'] = 0.0\n        items = r['items']\n        if items is None: items_eff = 1\n        else:\n            try: items_eff = int(items)\n            except: items_eff = 1\n        if items_eff < 1: items_eff = 1\n        score = abs(r['robust_z'])*math.log1p(items_eff)\n        r['anomaly_score'] = score\n        result.append(r)\n    result.sort(key=lambda x: (-x['anomaly_score'], -abs(x['robust_z']), -x['dt'].timestamp() if x['dt'] else 0, x['record_id']))\n    top = result[:10]\n    return [t['record_id'] for t in top]\n\nif __name__ == '__main__':\n    print(answer_norm(strip_chan=True))\nPYTHON" action.permission=* action.action=allow action.pattern=*
