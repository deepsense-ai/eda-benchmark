timestamp=2026-11-04T20:01:55.006Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Look at overall seller stats\n# For each seller, compute total gross, n_invoices, n_unique buyers (internal/external)\nseller_stats = invoices.groupby('seller_id').agg(\n    n_invoices=('invoice_id', 'count'),\n    total_gross=('gross_amount', 'sum'),\n    total_net=('net_amount', 'sum'),\n    n_buyer=('buyer_id', 'nunique'),\n    avg_gross=('gross_amount', 'mean'),\n    min_gross=('gross_amount', 'min'),\n    max_gross=('gross_amount', 'max'),\n).reset_index()\n\n# External payments\nexternal = invoices[~invoices['buyer_id'].isin(companies['company_id'])]\next_stats = external.groupby('seller_id').agg(\n    ext_invoices=('invoice_id', 'count'),\n    ext_gross=('gross_amount', 'sum'),\n    ext_net=('net_amount', 'sum'),\n    ext_buyers=('buyer_id', 'nunique'),\n).reset_index()\n\nseller_stats = seller_stats.merge(ext_stats, on='seller_id', how='left')\nseller_stats['ext_gross_frac'] = seller_stats['ext_gross'] / seller_stats['total_gross']\nseller_stats = seller_stats.fillna(0)\n\n# Join with company info\nseller_stats = seller_stats.merge(companies, left_on='seller_id', right_on='company_id', how='left')\n\n# Look for high ext_gross_frac or large ext_gross relative to size\nseller_stats = seller_stats.sort_values('ext_gross', ascending=False)\nprint(seller_stats[['seller_id','ext_gross','total_gross','ext_gross_frac','ext_buyers','employees','declared_revenue_annual']].head(15))\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
