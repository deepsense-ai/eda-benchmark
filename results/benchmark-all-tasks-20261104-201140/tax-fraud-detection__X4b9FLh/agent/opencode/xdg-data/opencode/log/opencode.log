timestamp=2026-11-04T20:05:16.832Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Compute some overall metrics to spot anomalies\n# For each company (or each seller), compute various signals\n\n# Sellers stats\nseller_stats = invoices.groupby('seller_id').agg(\n    n_invoices=('invoice_id', 'count'),\n    total_gross=('gross_amount', 'sum'),\n    total_net=('net_amount', 'sum'),\n    n_unique_buyers=('buyer_id', 'nunique'),\n    mean_gross=('gross_amount', 'mean'),\n    std_gross=('gross_amount', 'std'),\n).reset_index()\nseller_stats['cv_gross'] = seller_stats['std_gross'] / seller_stats['mean_gross']\nseller_stats = seller_stats.fillna(0)\n\n# External\nexternal = invoices[~invoices['buyer_id'].isin(companies['company_id'])]\next = external.groupby('seller_id').agg(ext_gross=('gross_amount', 'sum'), ext_invoices=('invoice_id', 'count')).reset_index()\nseller_stats = seller_stats.merge(ext, on='seller_id', how='left').fillna(0)\nseller_stats['ext_frac'] = seller_stats['ext_gross'] / seller_stats['total_gross'] if 'total_gross' in seller_stats else 0\nseller_stats['ext_frac'] = seller_stats.apply(lambda x: x['ext_gross']/x['total_gross'] if x['total_gross']>0 else 0, axis=1)\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
