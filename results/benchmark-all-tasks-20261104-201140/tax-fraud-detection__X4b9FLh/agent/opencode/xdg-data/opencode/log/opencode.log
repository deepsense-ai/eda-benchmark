timestamp=2026-11-04T20:14:14.310Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Now combine all signals for each company that might be relevant\n# Consider all companies that appear as sellers or are otherwise interesting\n\n# Build comprehensive scores\nbuyers = set(invoices['buyer_id'])\nsellers = set(invoices['seller_id'])\n\nresults = []\n\n# For each company\nfor _, c in companies.iterrows():\n    cid = c['company_id']\n    is_seller = cid in sellers\n    is_buyer = cid in buyers\n    only_buyer = is_buyer and (cid not in sellers)\n    \n    s_inv = invoices[invoices['seller_id'] == cid] if is_seller else pd.DataFrame()\n    b_inv = invoices[invoices['buyer_id'] == cid] if is_buyer else pd.DataFrame()\n    \n    score = 0\n    reasons = []\n    \n    # (b) only buyers with weak fundamentals\n    if only_buyer:\n        rev_per_emp = c['declared_revenue_annual'] / c['employees'] if c['employees'] > 0 else 0\n        if c['employees'] < 50 and c['bank_account_age_months'] < 6 and rev_per_emp < 20000:\n            score += 5\n            reasons.append('only_buyer_weak_fundamentals')\n        elif c['employees'] < 50:\n            score += 3\n            reasons.append('only_buyer_small')\n    \n    # (c) sellers with outsized external payments relative to footprint\n    if is_seller and len(s_inv) > 0:\n        external = s_inv[~s_inv['buyer_id'].isin(companies['company_id'])]\n        ext_gross = external['gross_amount'].sum()\n        total_gross = s_inv['gross_amount'].sum()\n        ext_frac = ext_gross / total_gross if total_gross > 0 else 0\n        rev_per_emp = c['declared_revenue_annual'] / c['employees'] if c['employees'] > 0 else 0\n        \n        if ext_gross > 300000 and c['employees'] < 50 and c['declared_revenue_annual'] < 200000:\n            score += 6\n            reasons.append('massive_ext_small_company')\n        elif ext_gross > 100000 and c['employees'] < 100 and rev_per_emp < 5000:\n            score += 4\n            reasons.append('large_ext_low_efficiency')\n        elif ext_frac > 0.5 and c['employees'] < 200:\n            score += 2\n            reasons.append('high_ext_frac')\n    \n    # (a) leading digit anomalies\n    if is_seller and len(s_inv) > 0:\n        first = s_inv['gross_amount'].astype(str).str.extract(r'^([1-9])')[0].astype(int)\n        frac1 = (first == 1).sum() / len(first) if len(first) > 0 else 0\n        if frac1 == 1.0 and len(s_inv) >= 5:\n            score += 5\n            reasons.append('all_leading_ones_high_volume')\n        elif frac1 == 1.0 and len(s_inv) < 5:\n            score += 2\n            reasons.append('all_leading_ones_low_volume')\n        elif frac1 >= 0.8 and len(s_inv) >= 5:\n            score += 3\n            reasons.append('very_high_frac1')\n        elif frac1 >= 0.7 and len(s_inv) >= 7:\n            score += 1\n            reasons.append('high_frac1')\n    \n    # Other red flags\n    rev_per_emp = c['declared_revenue_annual'] / c['employees'] if c['employees'] > 0 else 0\n    if is_seller and c['employees'] > 500 and rev_per_emp < 200:\n        score += 3\n        reasons.append('very_low_rev_per_emp_large_staff')\n    if c['bank_account_age_months'] < 6:\n        score += 0.5  # minor\n    \n    if score > 0:\n        results.append({\n            'company_id': cid,\n            'score': score,\n            'reasons': reasons,\n            'only_buyer': only_buyer,\n            'is_seller': is_seller,\n            'ext_gross': s_inv[~s_inv['buyer_id'].isin(companies['company_id'])]['gross_amount'].sum() if is_seller else 0,\n            'rev_per_emp': rev_per_emp,\n            'employees': c['employees'],\n            'bank_age': c['bank_account_age_months'],\n            'n_seller_invoices': len(s_inv),\n        })\n\nresults = pd.DataFrame(results)\nif not results.empty:\n    results = results.sort_values('score', ascending=False)\n    print(results.head(15).to_string())\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
