timestamp=2026-11-04T20:03:10.262Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Check sellers with 100% leading 1s\nfor sid in [4612, 8382, 1256, 9132, 3554]:\n    s_inv = invoices[invoices['seller_id'] == sid]\n    print(f'=== {sid}: {len(s_inv)} invoices ===')\n    # show range\n    print(f'  gross range: {s_inv[\\\"gross_amount\\\"].min():.2f} - {s_inv[\\\"gross_amount\\\"].max():.2f}')\n    print(f'  net range: {s_inv[\\\"net_amount\\\"].min():.2f} - {s_inv[\\\"net_amount\\\"].max():.2f}')\n    # check if they have external buyers?\n    ext = s_inv[~s_inv['buyer_id'].isin(companies['company_id'])]\n    print(f'  external invoices: {len(ext)}')\n    print()\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
