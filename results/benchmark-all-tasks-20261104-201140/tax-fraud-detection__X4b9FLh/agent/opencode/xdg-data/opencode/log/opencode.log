timestamp=2026-11-04T20:02:18.037Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# These 'only buyers' have very small employee counts, low revenue, very new bank accounts (age 1-4 months)\n# Also recent registrations (late 2019). They appear only as buyers, never as sellers. \n# This fits (b): 'companies that appear only as buyers despite having weak operating fundamentals'\n\n# Look at how much was invoiced to them? Also who sells to them\nbuyers = set(invoices['buyer_id'])\nsellers = set(invoices['seller_id'])\nonly_buyers = buyers - sellers\ncompanies_only_buyers = companies[companies['company_id'].isin(only_buyers)]\n\nfor bid in companies_only_buyers['company_id']:\n    inv = invoices[invoices['buyer_id'] == bid]\n    print(f'=== {bid} ===')\n    print(f'n_invoices={len(inv)}, total_gross={inv[\\\"gross_amount\\\"].sum():.2f}, sellers={inv[\\\"seller_id\\\"].nunique()}')\n    # show top sellers\n    top = inv.groupby('seller_id')['gross_amount'].sum().sort_values(ascending=False).head(3)\n    for sid, amt in top.items():\n        c = companies[companies['company_id']==sid]\n        if not c.empty:\n            cs = c.iloc[0]\n            print(f'  -> seller {sid}: {amt:.2f} (emp={cs[\\\"employees\\\"]}, rev={cs[\\\"declared_revenue_annual\\\"]:.2f})')\n    print()\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
