timestamp=2026-11-04T20:13:16.052Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# (a) unusual leading-digit behavior among active sellers\nseller_stats = invoices.groupby('seller_id').agg(\n    n_invoices=('invoice_id', 'count'),\n    total_gross=('gross_amount', 'sum'),\n).reset_index()\n\nresults = []\nfor sid in seller_stats['seller_id']:\n    s_inv = invoices[invoices['seller_id'] == sid]\n    first = s_inv['gross_amount'].astype(str).str.extract(r'^([1-9])')[0].astype(int)\n    n1 = (first == 1).sum()\n    n = len(first)\n    if n > 0:\n        frac1 = n1 / n\n        results.append((sid, n, n1, frac1))\nresults = pd.DataFrame(results, columns=['seller_id','n_invoices','n1','frac1'])\nresults = results.merge(companies, left_on='seller_id', right_on='company_id', how='left')\nresults = results.sort_values(['frac1', 'n_invoices'], ascending=[False, False])\nprint(results[['seller_id','frac1','n_invoices','employees','declared_revenue_annual']].head(15))\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
