timestamp=2026-11-04T20:09:10.825Z level=INFO run=1247a727 message=evaluated permission=bash pattern="python -c \"\nimport pandas as pd\nimport numpy as np\n\ncompanies = pd.read_csv('/app/dataset/companies.csv')\ninvoices = pd.read_csv('/app/dataset/invoices.csv')\n\n# Recompute all\nseller_stats = invoices.groupby('seller_id').agg(\n    n_invoices=('invoice_id', 'count'),\n    total_gross=('gross_amount', 'sum'),\n    n_unique_buyers=('buyer_id', 'nunique'),\n    mean_gross=('gross_amount', 'mean'),\n    std_gross=('gross_amount', 'std'),\n).reset_index()\nseller_stats['cv_gross'] = seller_stats['std_gross'] / seller_stats['mean_gross']\nseller_stats = seller_stats.fillna(0)\n\nexternal = invoices[~invoices['buyer_id'].isin(companies['company_id'])]\next = external.groupby('seller_id').agg(ext_gross=('gross_amount', 'sum'), ext_invoices=('invoice_id', 'count'), ext_buyers=('buyer_id', 'nunique')).reset_index()\nseller_stats = seller_stats.merge(ext, on='seller_id', how='left').fillna(0)\nseller_stats['ext_frac'] = np.where(seller_stats['total_gross'] > 0, seller_stats['ext_gross'] / seller_stats['total_gross'], 0)\n\nseller_stats = seller_stats.merge(companies, left_on='seller_id', right_on='company_id', how='left')\nseller_stats['rev_per_emp'] = np.where(seller_stats['employees'] > 0, seller_stats['declared_revenue_annual'] / seller_stats['employees'], 0)\n\n# Find strong candidates\n# (c) sellers with outsized payments to external recipients relative to declared business footprint\n# High ext_gross, low rev, low rev_per_emp, few employees\ncands = seller_stats.copy()\ncands = cands.sort_values(['ext_gross', 'ext_frac'], ascending=[False, False])\nprint(cands[['seller_id','ext_gross','ext_frac','total_gross','employees','declared_revenue_annual','rev_per_emp']].head(10))\n\" 2>&1" action.permission=* action.action=allow action.pattern=*
