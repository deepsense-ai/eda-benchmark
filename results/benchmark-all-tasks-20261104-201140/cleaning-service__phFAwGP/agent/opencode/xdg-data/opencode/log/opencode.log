timestamp=2026-11-04T19:27:08.561Z level=INFO run=c2c30b4a message=evaluated permission=bash pattern="python3 << 'PY'\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict\nimport calendar\nimport csv\nimport ast\nimport re\n\ndef parse_tasks(s):\n    if not s or s.strip()=='':\n        return []\n    s = s.strip()\n    if s.startswith('[') and not s.endswith(']'): s += ']'\n    if not s.startswith('[') and s.endswith(']'): s = '[' + s\n    try: return ast.literal_eval(s)\n    except:\n        try:\n            import json\n            return json.loads(s)\n        except:\n            return [int(x) for x in re.findall(r'-?\\d+', s)]\n\ndef fix_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except Exception:\n        parts = s.split('-')\n        if len(parts) != 3: return None\n        try:\n            y, m, d = int(parts[0]), int(parts[1]), int(parts[2])\n        except: return None\n        last = calendar.monthrange(y, m)[1]\n        if d > last: d = last\n        if d < 1: d = 1\n        try: return datetime(y, m, d)\n        except: return None\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {int(r['task_id']): float(r['pay_per_completion']) for r in csv.DictReader(f)}\nwith open('/app/dataset/employees.csv') as f:\n    emps = list(csv.DictReader(f))\n    emp_rate = {r['PESEL']: float(r['hourly_rate']) for r in emps}\n\nmapping = {\n  '16102016795': '96102016751',\n  '62020111425': '65020111422',\n  '15720759071': '75020759171',\n  '84731091580': '87031491580',\n  '68011910138': '68011810139',\n}\n\nprocessed = []\ndates = []\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        eid_raw = row['employee_id']\n        eid = mapping.get(eid_raw, eid_raw)\n        if eid not in emp_rate: continue\n        dt = fix_date(row['date'])\n        if dt is None: continue\n        try: hw = float(row['hours_worked'])\n        except: continue\n        if hw < 0 or hw > 24*2: continue\n        tids = parse_tasks(row['performed_tasks'])\n        bonus = 0.0\n        for t in tids:\n            if t in tasks: bonus += tasks[t]\n        processed.append({'employee': eid, 'date': dt, 'hours': hw, 'bonus': bonus})\n        dates.append(dt)\n\ndates.sort()\nearliest = dates[0]\nstart_day = earliest.weekday()\n\nagg_b = defaultdict(lambda: {'hours': 0.0, 'bonus': 0.0})\nfor p in processed:\n    d = p['date']\n    delta = (d.weekday() - start_day) % 7\n    period_start = d - timedelta(days=delta)\n    k = (p['employee'], period_start)\n    agg_b[k]['hours'] += p['hours']\n    agg_b[k]['bonus'] += p['bonus']\n\nperiods = sorted(set(ps for (_, ps) in agg_b.keys()))\nall_emps = sorted(emp_rate.keys())\n\n# how many periods total?\n# also check which periods map to which calendar months conceptually\nfor i, ps in enumerate(periods):\n    if i < 4:\n        print(ps.strftime('%Y-%m-%d'))\nPY" action.permission=* action.action=allow action.pattern=*
