timestamp=2026-11-04T19:28:09.290Z level=INFO run=c2c30b4a message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nfrom collections import defaultdict\nimport csv\nimport ast\nimport re\nfrom datetime import datetime, timedelta\nimport calendar\n\n\ndef parse_tasks(s):\n    if not s or s.strip() == '':\n        return []\n    s = s.strip()\n    if s.startswith('[') and not s.endswith(']'):\n        s += ']'\n    if not s.startswith('[') and s.endswith(']'):\n        s = '[' + s\n    try:\n        return ast.literal_eval(s)\n    except Exception:\n        try:\n            import json\n\n            return json.loads(s)\n        except Exception:\n            nums = re.findall(r'-?\\d+', s)\n            return [int(x) for x in nums]\n\n\ndef fix_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except Exception:\n        parts = s.split('-')\n        if len(parts) != 3:\n            return None\n        try:\n            y, m, d = int(parts[0]), int(parts[1]), int(parts[2])\n        except Exception:\n            return None\n        last = calendar.monthrange(y, m)[1]\n        if d > last:\n            d = last\n        if d < 1:\n            d = 1\n        try:\n            return datetime(y, m, d)\n        except Exception:\n            return None\n\n\ndef answer() -> dict[str, list[int]]:\n    # Load tasks\n    tasks = {}\n    with open('/app/dataset/tasks.csv') as f:\n        reader = csv.DictReader(f)\n        for r in reader:\n            try:\n                tasks[int(r['task_id'])] = float(r['pay_per_completion'])\n            except Exception:\n                continue\n\n    # Load employees\n    emp_rate = {}\n    with open('/app/dataset/employees.csv') as f:\n        reader = csv.DictReader(f)\n        for r in reader:\n            try:\n                emp_rate[r['PESEL']] = float(r['hourly_rate'])\n            except Exception:\n                continue\n\n    # Mapping for known typos in employee_id\n    mapping = {\n        '16102016795': '96102016751',\n        '62020111425': '65020111422',\n        '15720759071': '75020759171',\n        '84731091580': '87031491580',\n        '68011910138': '68011810139',\n    }\n\n    # Process all entries\n    processed = []\n    with open('/app/dataset/timesheet.csv') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            eid_raw = row['employee_id']\n            eid = mapping.get(eid_raw, eid_raw)\n            if eid not in emp_rate:\n                continue\n            dt = fix_date(row['date'])\n            if dt is None:\n                continue\n            try:\n                hw = float(row['hours_worked'])\n            except Exception:\n                continue\n            if hw < 0 or hw > 24 * 2:\n                continue\n            tids = parse_tasks(row['performed_tasks'])\n            bonus = 0.0\n            for t in tids:\n                if t in tasks:\n                    bonus += tasks[t]\n            processed.append({\n                'employee': eid,\n                'date': dt,\n                'hours': hw,\n                'bonus': bonus,\n            })\n\n    if len(processed) == 0:\n        return {}\n\n    # Determine billing period grouping by weekday of earliest record\n    dates = [p['date'] for p in processed]\n    dates.sort()\n    earliest = dates[0]\n    start_day = earliest.weekday()\n\n    # Aggregate by billing month (month of billing period start)\n    agg = defaultdict(lambda: {'hours': 0.0, 'bonus': 0.0})\n    for p in processed:\n        d = p['date']\n        delta = (d.weekday() - start_day) % 7\n        period_start = d - timedelta(days=delta)\n        bm = (period_start.year, period_start.month)\n        k = (p['employee'], bm[0], bm[1])\n        agg[k]['hours'] += p['hours']\n        agg[k]['bonus'] += p['bonus']\n\n    months = sorted(set((y, m) for (_, y, m) in agg.keys()))\n    all_emps = sorted(emp_rate.keys())\n\n    result = {}\n    for eid in all_emps:\n        salaries = []\n        for y, m in months:\n            key = (eid, y, m)\n            if key in agg:\n                a = agg[key]\n                total = a['hours'] * emp_rate[eid] + a['bonus']\n            else:\n                total = 0.0\n            sal = round(total)\n            salaries.append(sal)\n        result[eid] = salaries\n\n    return result\n\n\nif __name__ == '__main__':\n    import json\n\n    with open('/app/answer.json', 'w') as f:\n        json.dump(answer(), f, default=list)\nPY" action.permission=* action.action=allow action.pattern=*
