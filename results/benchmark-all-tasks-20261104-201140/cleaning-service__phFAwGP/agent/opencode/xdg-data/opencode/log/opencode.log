timestamp=2026-11-04T19:25:18.305Z level=INFO run=c2c30b4a message="llm runtime selected" llm.runtime=ai-sdk llm.provider=litellm llm.model=mai-thinking-1
timestamp=2026-11-04T19:25:31.367Z level=INFO run=c2c30b4a message=evaluated permission=bash pattern="python3 << 'PY'\n# Now compute total monthly salary per employee per month according to the formula\n# Total salary = (total hours worked in the month × hourly rate) + any bonuses earned for completed tasks in that month\n# Hourly rate comes from employees.csv (per employee). Bonuses from valid tasks in that month.\n# Also we need to compute this for each employee for every month, and return as dict mapping PESEL -> list of integer salaries, sorted by billing month ascending.\n# If grouping is by calendar month, then list order is by (year,month) ascending.\nimport csv\nimport ast\nimport re\nfrom datetime import datetime\nimport calendar\nfrom collections import defaultdict\n\ndef parse_tasks(s):\n    if not s or s.strip()=='':\n        return []\n    s = s.strip()\n    if s.startswith('[') and not s.endswith(']'): s += ']'\n    if not s.startswith('[') and s.endswith(']'): s = '[' + s\n    try: return ast.literal_eval(s)\n    except:\n        try:\n            import json\n            return json.loads(s)\n        except:\n            return [int(x) for x in re.findall(r'-?\\d+', s)]\n\ndef fix_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except Exception:\n        parts = s.split('-')\n        if len(parts) != 3: return None\n        try:\n            y, m, d = int(parts[0]), int(parts[1]), int(parts[2])\n        except: return None\n        last = calendar.monthrange(y, m)[1]\n        if d > last: d = last\n        if d < 1: d = 1\n        try: return datetime(y, m, d)\n        except: return None\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {int(r['task_id']): float(r['pay_per_completion']) for r in csv.DictReader(f)}\nwith open('/app/dataset/employees.csv') as f:\n    emp = {r['PESEL']: float(r['hourly_rate']) for r in csv.DictReader(f)}\n\nmapping = {\n  '16102016795': '96102016751',\n  '62020111425': '65020111422',\n  '15720759071': '75020759171',\n  '84731091580': '87031491580',\n  '68011910138': '68011810139',\n}\n\n# aggregate\n# key: (employee, year, month) -> sum hours, sum bonus\nagg = defaultdict(lambda: {'hours': 0.0, 'bonus': 0.0})\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        eid_raw = row['employee_id']\n        eid = mapping.get(eid_raw, eid_raw)\n        if eid not in emp: continue\n        dt = fix_date(row['date'])\n        if dt is None: continue\n        try: hw = float(row['hours_worked'])\n        except: continue\n        if hw < 0 or hw > 24*2: continue\n        tids = parse_tasks(row['performed_tasks'])\n        bonus = 0.0\n        for t in tids:\n            if t in tasks: bonus += tasks[t]\n        key = (eid, dt.year, dt.month)\n        agg[key]['hours'] += hw\n        agg[key]['bonus'] += bonus\n\n# compute salaries\nresult = defaultdict(list)\n# get all billing months in order\nmonths = sorted(set((y,m) for (_,y,m) in agg.keys()))\nprint(months)\nPY" action.permission=* action.action=allow action.pattern=*
