timestamp=2026-11-04T19:28:37.128Z level=INFO run=c2c30b4a message=evaluated permission=bash pattern="python3 << 'PY'\n# Let us verify a couple of examples manually for a specific employee to be sure\n# Take 79011320010: earlier when we looked at data, they had entries across months.\n# Let us recompute their totals under billing-period grouping (Tue start) as we just did.\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict\nimport csv\nimport ast\nimport re\nimport calendar\n\ndef parse_tasks(s):\n    if not s or s.strip()=='':\n        return []\n    s = s.strip()\n    if s.startswith('[') and not s.endswith(']'): s += ']'\n    if not s.startswith('[') and s.endswith(']'): s = '[' + s\n    try: return ast.literal_eval(s)\n    except:\n        try:\n            import json\n            return json.loads(s)\n        except:\n            return [int(x) for x in re.findall(r'-?\\d+', s)]\n\ndef fix_date(s):\n    try:\n        return datetime.strptime(s, '%Y-%m-%d')\n    except Exception:\n        parts = s.split('-')\n        if len(parts) != 3: return None\n        try:\n            y, m, d = int(parts[0]), int(parts[1]), int(parts[2])\n        except: return None\n        last = calendar.monthrange(y, m)[1]\n        if d > last: d = last\n        if d < 1: d = 1\n        try: return datetime(y, m, d)\n        except: return None\n\nwith open('/app/dataset/tasks.csv') as f:\n    tasks = {int(r['task_id']): float(r['pay_per_completion']) for r in csv.DictReader(f)}\nwith open('/app/dataset/employees.csv') as f:\n    emp_rate = {r['PESEL']: float(r['hourly_rate']) for r in csv.DictReader(f)}\n\nmapping = {\n  '16102016795': '96102016751',\n  '62020111425': '65020111422',\n  '15720759071': '75020759171',\n  '84731091580': '87031491580',\n  '68011910138': '68011810139',\n}\n\n# check specific employee 79011320010\neid_target = '79011320010'\nrate = emp_rate[eid_target]\nprint('rate=', rate)\n\n# process their rows\nby_bm = defaultdict(lambda: {'hours': 0.0, 'bonus': 0.0})\nwith open('/app/dataset/timesheet.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        eid_raw = row['employee_id']\n        eid = mapping.get(eid_raw, eid_raw)\n        if eid != eid_target: continue\n        dt = fix_date(row['date'])\n        if dt is None: continue\n        try: hw = float(row['hours_worked'])\n        except: continue\n        if hw < 0 or hw > 24*2: continue\n        tids = parse_tasks(row['performed_tasks'])\n        bonus = 0.0\n        for t in tids:\n            if t in tasks: bonus += tasks[t]\n        # billing month by period start Tue (earliest in full dataset)\n        pass\n\n# easier: compute with same logic\npass\nPY" action.permission=* action.action=allow action.pattern=*
