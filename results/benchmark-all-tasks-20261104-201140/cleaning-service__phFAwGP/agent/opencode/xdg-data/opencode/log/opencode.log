timestamp=2026-11-04T19:20:36.770Z level=INFO run=c2c30b4a message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nimport difflib\nfrom collections import defaultdict\n\nwith open('/app/dataset/employees.csv') as f:\n    emps = list(csv.DictReader(f))\n    pesels = [e['PESEL'] for e in emps]\n\nunique_ts = set()\nwith open('/app/dataset/timesheet.csv') as f:\n    for row in csv.DictReader(f):\n        unique_ts.add(row['employee_id'])\n\nmapping = {}\nfor tid in unique_ts:\n    if tid in pesels:\n        mapping[tid] = tid\n        continue\n    # best by ratio\n    best = pesels[0]\n    best_ratio = -1\n    for p in pesels:\n        r = difflib.SequenceMatcher(None, tid, p).ratio()\n        if r > best_ratio:\n            best_ratio = r\n            best = p\n        elif r == best_ratio and r > 0.8:\n            # tie breaker: hamming-like? or prefer same length\n            if abs(len(tid) - len(p)) < abs(len(tid) - len(best)):\n                best = p\n    mapping[tid] = best\n    print(f\"{tid} -> {best} (r={best_ratio:.3f})\")\nPY" action.permission=* action.action=allow action.pattern=*
