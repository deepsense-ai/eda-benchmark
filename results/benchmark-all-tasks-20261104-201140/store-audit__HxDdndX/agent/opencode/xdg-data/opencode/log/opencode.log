timestamp=2026-11-04T21:46:10.858Z level=INFO run=6d5b9917 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\n# Build full picture\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    prods = {}\n    for r in reader:\n        r['unit_price'] = float(r['unit_price'].replace(',', '.'))\n        r['max_safe_temp_c'] = float(r['max_safe_temp_c'])\n        prods[r['product_id']] = r\n\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    dispatches = []\n    for d in reader:\n        pid = d['product_id']\n        if pid not in prods:\n            # try ean\n            for k, v in prods.items():\n                if v['ean_code'] == pid:\n                    pid = k\n                    break\n        dispatches.append({\n            'ts': datetime.strptime(d['timestamp'], '%Y-%m-%d %H:%M:%S'),\n            'product_id': pid,\n            'qty': int(d['quantity']),\n        })\n\n# look for meat dispatches on 18 july\nmeat_on_18 = []\nfor dis in dispatches:\n    if dis['ts'].date().day == 18:\n        prod = prods[dis['product_id']]\n        if prod['storage_category'] == 'Meat':\n            meat_on_18.append(dis)\nmeat_on_18.sort(key=lambda x: x['ts'])\nfor m in meat_on_18:\n    print(m, prods[m['product_id']]['name'], prods[m['product_id']]['price'])\nPY" action.permission=* action.action=allow action.pattern=*
