timestamp=2026-11-04T21:51:52.864Z level=INFO run=6d5b9917 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    prods = {}\n    for r in reader:\n        r['unit_price'] = float(r['unit_price'].replace(',', '.'))\n        prods[r['product_id']] = r\n\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    dispatches = []\n    for d in reader:\n        pid = d['product_id']\n        if pid not in prods:\n            for k, v in prods.items():\n                if v['ean_code'] == pid:\n                    pid = k\n                    break\n        prod = prods[pid]\n        dispatches.append({\n            'ts': datetime.strptime(d['timestamp'], '%Y-%m-%d %H:%M:%S'),\n            'product_id': pid,\n            'qty': int(d['quantity']),\n            'cat': prod['storage_category'],\n            'price': prod['unit_price'],\n            'name': prod['name']\n        })\n\n# Total revenue if all sales (no exclusions)\ntotal_all = sum(d['qty'] * d['price'] for d in dispatches)\nprint('Total all:', total_all)\n\n# Exclude only the 03:17 batch (Meat + Frozen)?\nexclude_batch = []\nfor d in dispatches:\n    if d['ts'] == datetime(2023, 7, 18, 3, 17):\n        exclude_batch.append(d)\n        print('EXCL:', d['name'], d['qty'], d['price'], d['qty']*d['price'], d['cat'])\n\ntotal_excl_batch = sum(d['qty'] * d['price'] for d in exclude_batch)\nprint('\\nSum excluded:', total_excl_batch)\nprint('Revenue:', total_all - total_excl_batch)\nPY" action.permission=* action.action=allow action.pattern=*
