timestamp=2026-11-04T21:46:50.279Z level=INFO run=6d5b9917 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    prods = {}\n    for r in reader:\n        r['unit_price'] = float(r['unit_price'].replace(',', '.'))\n        r['max_safe_temp_c'] = float(r['max_safe_temp_c'])\n        prods[r['product_id']] = r\n\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    dispatches = []\n    for d in reader:\n        pid = d['product_id']\n        if pid not in prods:\n            for k, v in prods.items():\n                if v['ean_code'] == pid:\n                    pid = k\n                    break\n        dispatches.append({\n            'ts': datetime.strptime(d['timestamp'], '%Y-%m-%d %H:%M:%S'),\n            'product_id': pid,\n            'qty': int(d['quantity']),\n        })\n\n# frozen dispatches on 18 july\nfor dis in dispatches:\n    if dis['ts'].date().day == 18:\n        prod = prods[dis['product_id']]\n        if prod['storage_category'] == 'Frozen':\n            print(dis, prod['name'])\nPY" action.permission=* action.action=allow action.pattern=*
