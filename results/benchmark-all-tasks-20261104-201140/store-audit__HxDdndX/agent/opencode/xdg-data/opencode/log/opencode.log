timestamp=2026-11-04T21:46:04.740Z level=INFO run=6d5b9917 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    prods = {}\n    for r in reader:\n        # normalize price\n        r['unit_price'] = float(r['unit_price'].replace(',', '.'))\n        r['max_safe_temp_c'] = float(r['max_safe_temp_c'])\n        prods[r['product_id']] = r\n\n# Map EANs in dispatches\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    dispatches = []\n    for d in reader:\n        pid = d['product_id']\n        if pid not in prods:\n            # try to find by ean in catalog keys? or look up\n            # find by ean\n            for k, v in prods.items():\n                if v['ean_code'] == pid:\n                    pid = k\n                    break\n        q = int(d['quantity'])\n        ts = datetime.strptime(d['timestamp'], '%Y-%m-%d %H:%M:%S')\n        prod = prods[pid]\n        dispatches.append({\n            'id': d['dispatch_id'],\n            'ts': ts,\n            'product_id': pid,\n            'qty': q,\n            'cat': prod['storage_category'],\n            'price': prod['unit_price']\n        })\n\n# look at 18 july\nfor dis in sorted(dispatches, key=lambda x: x['ts'])[:5]:\n    print(dis)\n\nprint('---')\nfor dis in sorted(dispatches, key=lambda x: x['ts']):\n    if dis['ts'].date().day == 18:\n        print(dis)\n        break\nPY" action.permission=* action.action=allow action.pattern=*
