timestamp=2026-11-04T21:47:48.748Z level=INFO run=6d5b9917 message=evaluated permission=bash pattern="python3 << 'PY'\nimport csv\nfrom datetime import datetime\n\nwith open('/app/dataset/product_catalog.csv') as f:\n    reader = csv.DictReader(f)\n    prods = {}\n    for r in reader:\n        r['unit_price'] = float(r['unit_price'].replace(',', '.'))\n        r['max_safe_temp_c'] = float(r['max_safe_temp_c'])\n        r['storage_category'] = r['storage_category']\n        prods[r['product_id']] = r\n\nwith open('/app/dataset/warehouse_dispatches.csv') as f:\n    reader = csv.DictReader(f)\n    dispatches = []\n    for d in reader:\n        pid = d['product_id']\n        if pid not in prods:\n            for k, v in prods.items():\n                if v['ean_code'] == pid:\n                    pid = k\n                    break\n        prod = prods[pid]\n        dispatches.append({\n            'ts': datetime.strptime(d['timestamp'], '%Y-%m-%d %H:%M:%S'),\n            'product_id': pid,\n            'qty': int(d['quantity']),\n            'cat': prod['storage_category'],\n            'price': prod['unit_price'],\n            'name': prod['name'],\n            'max_t': prod['max_safe_temp_c']\n        })\n\n# summarize by category for 18 July dispatches\nby_cat = {}\nfor dis in dispatches:\n    if dis['ts'].date().day == 18:\n        by_cat[dis['cat']] = by_cat.get(dis['cat'], 0) + dis['qty'] * dis['price']\nfor k, v in sorted(by_cat.items()):\n    print(k, v)\nPY" action.permission=* action.action=allow action.pattern=*
