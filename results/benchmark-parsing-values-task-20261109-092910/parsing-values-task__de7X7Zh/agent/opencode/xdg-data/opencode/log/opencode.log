timestamp=2026-11-09T08:30:13.280Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/parse_amount.py << 'PY'\nimport re\nfrom decimal import Decimal\n\ndef parse_amount(s):\n    if s is None:\n        return float('nan')\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    # signs\n    is_neg = False\n    su = s.upper()\n    if 'CR' in su:\n        is_neg = True\n    if '(' in s and ')' in s:\n        is_neg = True\n    if '-' in s:\n        is_neg = True\n    # remove tokens and letters/spaces, keep digits , .\n    # remove C1, C2\n    s = re.sub(r'\\bC1\\b', '', s, flags=re.I)\n    s = re.sub(r'\\bC2\\b', '', s, flags=re.I)\n    # remove letters\n    s = re.sub(r'[A-Za-z]', '', s)\n    # keep only digits , .\n    s = re.sub(r'[^0-9,\\.]', '', s)\n    print('clean:', s, 'neg:', is_neg)\n    if s == '':\n        return float('nan')\n    # count separators\n    comma = s.count(',')\n    dot = s.count('.')\n    if comma == 0 and dot == 0:\n        try:\n            v = float(s)\n        except:\n            return float('nan')\n    else:\n        # decide decimal sep: last-separator rule\n        # if both exist, the one that appears last is decimal?\n        last_comma = s.rfind(',')\n        last_dot = s.rfind('.')\n        if comma > 0 and dot > 0:\n            if last_comma > last_dot:\n                # comma is last -> decimal? e.g. 1.234,56 in some formats; or 1,234.56 means comma as thousands, dot decimal. If comma appears last, then comma is decimal, dot thousands\n                # last separator is decimal: so replace other with empty, replace decimal with .\n                decimal_sep = ','\n            else:\n                decimal_sep = '.'\n        elif comma > 1 and dot == 0:\n            # multiple commas, no dot - maybe thousands? or maybe decimal in some locales\n            # rule 6: if only one type exists, treat as decimal when exactly two digits follow its last occurrence\n            if s.endswith(',') or len(s) - last_comma != 3:\n                # heuristic - but follow rule precisely\n                pass\n            decimal_sep = ',' if (len(s) - last_comma == 3) else None  # not quite\n        # easier: apply rules as stated\n        pass\n    return s\n\n# test\nfor x in ['(1,128)', '80,87 C2', '(-81.45)', '105.16', '113 , 61 C2) ', 'C1 245.07', '124', '97,20 C2', '121,43 C2', '138.87 C1', 'C1 118.59 CR']:\n    print(x, '->', parse_amount(x))\nPY" action.permission=* action.action=allow action.pattern=*
