timestamp=2026-11-09T08:37:59.797Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/parse_notes.py << 'PY'\ndef parse_notes(notes):\n    items = None\n    adj_pct = 0.0\n    fee = 0.0\n    waive = False\n    if notes is None or notes == '':\n        return items, adj_pct, fee, waive\n    # split by ;\n    parts = notes.split(';')\n    for p in parts:\n        p = p.strip()\n        if '=' not in p:\n            continue\n        k, v = p.split('=', 1)\n        k = k.strip().lower()\n        v = v.strip()\n        if k == 'items':\n            try:\n                items = int(v)\n            except:\n                items = None\n        elif k == 'adj':\n            # adj=<signed number>%  e.g. -5.62% or +12.03%\n            try:\n                v = v.replace('%', '').strip()\n                adj_pct = float(v) / 100.0 if '%' in p or True else float(v)\n            except:\n                adj_pct = 0.0\n        elif k == 'fee':\n            try:\n                fee = float(v)\n            except:\n                fee = 0.0\n        elif k == 'waive':\n            if v.lower() == 'true':\n                waive = True\n            else:\n                waive = False\n    # fix adj - if we already converted above, need to be careful\n    return items, adj_pct, fee, waive\nPY" action.permission=* action.action=allow action.pattern=*
