timestamp=2026-11-09T08:38:06.164Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/parse_notes2.py << 'PY'\nimport re\n\ndef parse_notes(notes):\n    items = None\n    adj_pct = 0.0\n    fee = 0.0\n    waive = False\n    if not notes:\n        return items, adj_pct, fee, waive\n    # split by semicolon\n    for p in notes.split(';'):\n        p = p.strip()\n        if not p or '=' not in p:\n            continue\n        k, v = p.split('=', 1)\n        k = k.strip().lower()\n        v = v.strip()\n        if k == 'items':\n            try:\n                # extract int\n                m = re.search(r'[-\\d]+', v)\n                if m:\n                    items = int(m.group(0))\n                else:\n                    items = int(v)\n            except:\n                items = None\n        elif k == 'adj':\n            try:\n                m = re.search(r'[-+]?[\\d\\.]+(?:[eE][-+]?[\\d]+)?', v.replace(',', ''))\n                if m:\n                    adj_pct = float(m.group(0)) / 100.0\n                else:\n                    adj_pct = 0.0\n            except:\n                adj_pct = 0.0\n        elif k == 'fee':\n            try:\n                m = re.search(r'[-+]?[\\d\\.]+(?:[eE][-+]?[\\d]+)?', v.replace(',', ''))\n                if m:\n                    fee = float(m.group(0))\n                else:\n                    fee = float(v)\n            except:\n                fee = 0.0\n        elif k == 'waive':\n            if v.lower() == 'true':\n                waive = True\n            else:\n                waive = False\n    return items, adj_pct, fee, waive\nPY" action.permission=* action.action=allow action.pattern=*
