timestamp=2026-11-09T08:31:31.597Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/parse_amount3.py << 'PY'\nimport re\n\ndef parse_amount(s):\n    if s is None:\n        return float('nan')\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    su = s.upper()\n    is_neg = False\n    if 'CR' in su:\n        is_neg = True\n    if '(' in s and ')' in s:\n        is_neg = True\n    if '-' in s:\n        is_neg = True\n    # remove tokens C1 C2\n    s = re.sub(r'\\bC1\\b', '', s, flags=re.I)\n    s = re.sub(r'\\bC2\\b', '', s, flags=re.I)\n    # remove spaces\n    s = re.sub(r'\\s+', '', s)\n    # remove letters\n    s = re.sub(r'[A-Za-z]', '', s)\n    # now keep only digits , .\n    s = re.sub(r'[^0-9,\\.]', '', s)\n    if s == '':\n        return float('nan')\n    comma = s.count(',')\n    dot = s.count('.')\n    num_str = s\n    if comma == 0 and dot == 0:\n        num_str = s\n    elif comma > 0 and dot > 0:\n        last_comma = s.rfind(',')\n        last_dot = s.rfind('.')\n        if last_comma > last_dot:\n            # comma is decimal\n            num_str = s.replace('.', '').replace(',', '.')\n        else:\n            # dot is decimal\n            num_str = s.replace(',', '')\n    else:\n        # only one type of separator\n        if comma > 0:\n            last = s.rfind(',')\n            # treat as decimal only if exactly 2 digits follow its last occurrence\n            if len(s) - last == 3:\n                num_str = s.replace(',', '.')\n            else:\n                num_str = s.replace(',', '')\n        elif dot > 0:\n            last = s.rfind('.')\n            if len(s) - last == 3:\n                # 3 digits follow - not decimal per rule 6 → thousands, remove\n                num_str = s.replace('.', '')\n            else:\n                num_str = s\n    try:\n        v = float(num_str)\n    except:\n        return float('nan')\n    if is_neg:\n        v = -v\n    return v\n\ntests = [\n    \"C1 1.000\",\n    \"1.234,56 C2\",\n    \"C1 1,234.56\",\n    \"1.000\",\n    \"100.00\",\n    \"66 . 45\",\n    \"C1 66 . 45\",\n    \"C1 100.00\",\n    \"72,21 C2\",\n    \"(1,128)\",\n    \"(-81.45)\",\n]\nfor t in tests:\n    print(t, '->', parse_amount(t))\nPY" action.permission=* action.action=allow action.pattern=*
