timestamp=2026-11-09T08:33:44.957Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/test_parens.py << 'PY'\nimport re\n\ndef parse_amount(s):\n    if s is None: return float('nan')\n    s = s.strip()\n    if s == '': return float('nan')\n    su = s.upper()\n    is_neg = False\n    if 'CR' in su: is_neg = True\n    if '(' in s and ')' in s: is_neg = True  # strict\n    if '-' in s: is_neg = True\n    s = re.sub(r'\\bC1\\b|\\bC2\\b', '', s, flags=re.I)\n    s = re.sub(r'\\s+', '', s)\n    s = re.sub(r'[A-Za-z]', '', s)\n    s = re.sub(r'[^0-9,\\.]', '', s)\n    if s == '': return float('nan')\n    # ...\n    return s, is_neg\n\nprint(parse_amount('113 , 61 C2) '))\nPY" action.permission=* action.action=allow action.pattern=*
