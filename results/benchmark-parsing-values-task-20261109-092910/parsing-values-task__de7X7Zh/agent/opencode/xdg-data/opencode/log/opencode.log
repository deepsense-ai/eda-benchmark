timestamp=2026-11-09T08:38:59.610Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /app/answer.py << 'PY'\nimport csv\nimport math\nimport json\nfrom collections import defaultdict\nfrom datetime import datetime\n\ndef parse_amount(s):\n    if s is None:\n        return float('nan')\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    su = s.upper()\n    is_neg = False\n    if 'CR' in su:\n        is_neg = True\n    if s.startswith('(') and s.endswith(')'):\n        is_neg = True\n    if '-' in s:\n        is_neg = True\n    s = s.replace('C1', '').replace('C2', '').replace('c1', '').replace('c2', '')\n    import re\n    s = re.sub(r'\\bC1\\b|\\bC2\\b', '', s, flags=re.I)\n    s = re.sub(r'\\s+', '', s)\n    s = re.sub(r'[A-Za-z]', '', s)\n    s = re.sub(r'[^0-9,\\.]', '', s)\n    if s == '':\n        return float('nan')\n    comma = s.count(',')\n    dot = s.count('.')\n    num_str = s\n    if comma == 0 and dot == 0:\n        num_str = s\n    elif comma > 0 and dot > 0:\n        last_comma = s.rfind(',')\n        last_dot = s.rfind('.')\n        if last_comma > last_dot:\n            num_str = s.replace('.', '').replace(',', '.')\n        else:\n            num_str = s.replace(',', '')\n    else:\n        if comma > 0:\n            last = s.rfind(',')\n            if (len(s) - last - 1) == 2:\n                num_str = s.replace(',', '.')\n            else:\n                num_str = s.replace(',', '')\n        elif dot > 0:\n            last = s.rfind('.')\n            if (len(s) - last - 1) == 2:\n                num_str = s\n            else:\n                num_str = s.replace('.', '')\n    try:\n        v = float(num_str)\n    except:\n        return float('nan')\n    if is_neg:\n        v = -v\n    return v\n\ndef parse_notes(notes):\n    items = None\n    adj_pct = 0.0\n    fee = 0.0\n    waive = False\n    if not notes:\n        return items, adj_pct, fee, waive\n    import re\n    for p in notes.split(';'):\n        p = p.strip()\n        if not p or '=' not in p:\n            continue\n        k, v = p.split('=', 1)\n        k = k.strip().lower()\n        v = v.strip()\n        if k == 'items':\n            try:\n                m = re.search(r'[-\\d]+', v)\n                items = int(m.group(0)) if m else int(v)\n            except:\n                items = None\n        elif k == 'adj':\n            try:\n                m = re.search(r'[-+]?[\\d\\.]+(?:[eE][-+]?[\\d]+)?', v.replace(',', ''))\n                if m:\n                    adj_pct = float(m.group(0)) / 100.0\n            except:\n                pass\n        elif k == 'fee':\n            try:\n                m = re.search(r'[-+]?[\\d\\.]+(?:[eE][-+]?[\\d]+)?', v.replace(',', ''))\n                if m:\n                    fee = float(m.group(0))\n            except:\n                pass\n        elif k == 'waive':\n            if v.lower() == 'true':\n                waive = True\n    return items, adj_pct, fee, waive\n\ndef median(x):\n    if len(x) == 0:\n        return 0.0\n    x = sorted(x)\n    n = len(x)\n    if n % 2 == 1:\n        return x[n//2]\n    return (x[n//2 - 1] + x[n//2]) / 2.0\n\ndef mad(x):\n    med = median(x)\n    abs_dev = [abs(v - med) for v in x]\n    return median(abs_dev)\n\ndef is_finite(x):\n    return x == x and math.isfinite(x)\nPY" action.permission=* action.action=allow action.pattern=*
