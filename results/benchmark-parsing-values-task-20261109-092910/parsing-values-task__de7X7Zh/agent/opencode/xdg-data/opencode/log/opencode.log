timestamp=2026-11-09T08:30:41.648Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/parse_amount2.py << 'PY'\nimport re\n\ndef parse_amount(s):\n    if s is None:\n        return float('nan')\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    su = s.upper()\n    is_neg = False\n    if 'CR' in su:\n        is_neg = True\n    if '(' in s and ')' in s:\n        is_neg = True\n    if '-' in s:\n        is_neg = True\n    # remove tokens C1 C2\n    s = re.sub(r'\\bC1\\b', '', s, flags=re.I)\n    s = re.sub(r'\\bC2\\b', '', s, flags=re.I)\n    # remove letters and spaces\n    s = re.sub(r'[A-Za-z\\s]', '', s)\n    # keep only digits , .\n    s = re.sub(r'[^0-9,\\.]', '', s)\n    if s == '':\n        return float('nan')\n    comma = s.count(',')\n    dot = s.count('.')\n    num_str = s\n    if comma == 0 and dot == 0:\n        num_str = s\n    elif comma > 0 and dot > 0:\n        last_comma = s.rfind(',')\n        last_dot = s.rfind('.')\n        if last_comma > last_dot:\n            # comma is decimal\n            num_str = s.replace('.', '').replace(',', '.')\n        else:\n            # dot is decimal\n            num_str = s.replace(',', '')\n    else:\n        # only one type\n        if comma > 0:\n            last = s.rfind(',')\n            if len(s) - last == 3:\n                # treat as thousands? because exactly 2 digits after last occurrence - wait rule 6: \"treat it as a decimal separator only when exactly two digits follow its last occurrence\"\n                # so if only comma exists, and there are exactly 2 digits after last comma → comma is decimal separator\n                num_str = s.replace(',', '.')\n            else:\n                # not exactly 2 digits after last → treat as NOT decimal? so it’s thousands separator → remove\n                num_str = s.replace(',', '')\n        elif dot > 0:\n            last = s.rfind('.')\n            if len(s) - last == 3:\n                num_str = s  # but is dot decimal or thousands? if 3 digits follow, that’s unusual for decimal. Or maybe 1.000? could be thousands. But rule says decimal only if exactly 2 digits follow. So 3 digits → not decimal → treat as thousands/grouping, remove dot → 1000\n                # but let us look at actual case \"C1 1.000\" from data: R00097 has \"C1 1.000\" (amount_str)\n                num_str = s.replace('.', '')\n            else:\n                num_str = s.replace('.', '.')\n    try:\n        v = float(num_str)\n    except:\n        return float('nan')\n    if is_neg:\n        v = -v\n    return v\n\n# test\ntests = ['(1,128)', '80,87 C2', '(-81.45)', '105.16', '113 , 61 C2) ', 'C1 245.07', '124', '97,20 C2', '121,43 C2', '138.87 C1', 'C1 118.59 CR', 'C1 1.000', '1.234,56 C2', 'C1 1,234.56', 'C1 66 . 45', '124)', '72,21 C2', '(142']\nfor t in tests:\n    print(t, '->', parse_amount(t))\nPY" action.permission=* action.action=allow action.pattern=*
