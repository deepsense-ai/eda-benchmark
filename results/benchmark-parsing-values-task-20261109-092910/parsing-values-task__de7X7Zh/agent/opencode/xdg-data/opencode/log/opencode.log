timestamp=2026-11-09T08:37:27.042Z level=INFO run=d54a47dc message=evaluated permission=bash pattern="cat > /tmp/parse_amount_v8.py << 'PY'\nimport re\n\ndef parse_amount(s):\n    if s is None:\n        return float('nan')\n    s = s.strip()\n    if s == '':\n        return float('nan')\n    su = s.upper()\n    is_neg = False\n    if 'CR' in su:\n        is_neg = True\n    if s.startswith('(') and s.endswith(')'):\n        is_neg = True\n    if '-' in s:\n        is_neg = True\n    # remove tokens C1 and C2 - as exact strings (case-insensitive)\n    s = s.replace('C1', '').replace('C2', '').replace('c1', '').replace('c2', '')\n    # or use re.sub with boundaries? but attached forms need char removal - simpler to also strip letters. But also explicitly remove tokens.\n    # also handle spaced forms\n    s = re.sub(r'\\bC1\\b|\\bC2\\b', '', s, flags=re.I)\n    s = re.sub(r'\\s+', '', s)\n    s = re.sub(r'[A-Za-z]', '', s)\n    s = re.sub(r'[^0-9,\\.]', '', s)\n    if s == '':\n        return float('nan')\n    comma = s.count(',')\n    dot = s.count('.')\n    num_str = s\n    if comma == 0 and dot == 0:\n        num_str = s\n    elif comma > 0 and dot > 0:\n        last_comma = s.rfind(',')\n        last_dot = s.rfind('.')\n        if last_comma > last_dot:\n            num_str = s.replace('.', '').replace(',', '.')\n        else:\n            num_str = s.replace(',', '')\n    else:\n        if comma > 0:\n            last = s.rfind(',')\n            if (len(s) - last - 1) == 2:\n                num_str = s.replace(',', '.')\n            else:\n                num_str = s.replace(',', '')\n        elif dot > 0:\n            last = s.rfind('.')\n            if (len(s) - last - 1) == 2:\n                num_str = s\n            else:\n                num_str = s.replace('.', '')\n    try:\n        v = float(num_str)\n    except:\n        return float('nan')\n    if is_neg:\n        v = -v\n    return v\nPY" action.permission=* action.action=allow action.pattern=*
