timestamp=2026-11-09T11:48:34.549Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# Build a proper loader for all files\nimport pandas as pd\nimport os\n\nds = '/app/dataset'\nprod_files = sorted([f for f in os.listdir(ds) if f.startswith('production_')])\n\ndef detect_encoding(path):\n    with open(path, 'rb') as f:\n        b = f.read(2)\n    if b == b'\\xff\\xfe' or b == b'\\xfe\\xff':\n        return 'utf-16'\n    return 'utf-8'\n\ndef load_prod_file(path, enc):\n    # Try to read - some use comma/tab, some use semicolon\n    try:\n        df = pd.read_csv(path, encoding=enc, sep=None, engine='python', skiprows=3)\n    except:\n        df = pd.read_csv(path, encoding=enc, sep=';', skiprows=3)\n    # Clean column names\n    df.columns = df.columns.str.strip().str.replace('\\t', '')\n    return df\n\n# Sample\nfor pf in prod_files[:3]:\n    path = os.path.join(ds, pf)\n    enc = detect_encoding(path)\n    try:\n        df = load_prod_file(path, enc)\n        print(f'{pf}: {df.shape} cols={list(df.columns)[:5]}')\n    except Exception as e:\n        print(f'ERR {pf}: {e}')\nPY" action.permission=* action.action=allow action.pattern=*
