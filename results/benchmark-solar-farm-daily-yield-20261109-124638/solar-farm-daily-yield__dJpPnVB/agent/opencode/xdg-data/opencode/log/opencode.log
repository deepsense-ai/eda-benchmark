timestamp=2026-11-09T11:53:24.445Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# rebuild with lookup\n# get farm meta\nimport json\nimport pandas as pd\nfrom pathlib import Path\n\nds = Path('/app/dataset')\ndf_reg = pd.read_csv(ds / 'farm_registry.csv')\ndf_farms = pd.read_csv(ds / 'farms.csv')\ndf_farms.columns = df_farms.columns.str.strip()\ndf_reg.columns = df_reg.columns.str.strip()\ndf_farms['key'] = df_farms['farm_name'].astype(str).str.strip().str.lower()\ndf_reg['key'] = df_reg['farm_name'].astype(str).str.strip().str.lower()\nmerged = pd.merge(df_reg, df_farms, on='key', how='left')\nname_to_fid = {}\nfid_to_meta = {}\nfor _, r in merged.iterrows():\n    fid = r['farm_id']\n    fname_orig = str(r['farm_name_x']).strip() if 'farm_name_x' in r else str(r['farm_name']).strip()\n    name_to_fid[fname_orig.lower()] = fid\n    fid_to_meta[fid] = {'timezone': r['timezone']}\n\nname_to_fid\nPY" action.permission=* action.action=allow action.pattern=*
