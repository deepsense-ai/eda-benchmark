timestamp=2026-11-09T11:58:33.618Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="cat > /tmp/load_prod2.py << 'PY'\nimport pandas as pd\nimport os\n\ndef load_production(fid):\n    ds = '/app/dataset'\n    pf = f'production_{fid}.csv'\n    path = os.path.join(ds, pf)\n    with open(path, 'rb') as f:\n        b = f.read(2)\n    enc = 'utf-16' if b == b'\\xff\\xfe' or b == b'\\xfe\\xff' else 'utf-8'\n    # try multiple strategies\n    df = None\n    # strategy 1: sep=None\n    try:\n        df = pd.read_csv(path, encoding=enc, sep=None, engine='python', skiprows=3)\n        # check if first col contains semicolons or if cols look wrong\n        if len(df.columns) <= 2 and df.columns[0] == 'timestamp':\n            # maybe all data crammed\n            pass\n    except Exception as e:\n        df = None\n    # strategy 2: semicolon\n    if df is None or len(df.columns) < 5 or (len(df.columns) == 2 and ';' in str(df.iloc[0,0]) if len(df)>0 else False):\n        try:\n            df = pd.read_csv(path, encoding=enc, sep=';', skiprows=3)\n        except Exception:\n            df = pd.read_csv(path, encoding='utf-8', sep=None, engine='python', skiprows=3)\n    # also if after load, first col has semicolon content and second is mostly NaN, split by semicolon on first col\n    if len(df.columns) == 2 and df.iloc[:,1].isna().mean() > 0.9:\n        # split first col\n        expanded = df[df.columns[0]].str.split(';', expand=True)\n        # if expanded gives many cols, use it\n        if expanded.shape[1] > 5:\n            df = expanded\n            # need headers - read headers separately\n            # simpler: re-read with sep=';'\n            try:\n                df = pd.read_csv(path, encoding=enc, sep=';', skiprows=3)\n            except:\n                pass\n    df.columns = df.columns.str.strip().str.replace('\\t', '')\n    # dedupe\n    if len(df.columns) != len(set(df.columns)):\n        cols = []\n        seen = {}\n        for c in df.columns:\n            if c in seen:\n                seen[c] += 1\n                cols.append(f'{c}_{seen[c]}')\n            else:\n                seen[c] = 0\n                cols.append(c)\n        df.columns = cols\n    # parse timestamp\n    df['timestamp'] = pd.to_datetime(df['timestamp'], errors='coerce', dayfirst=True)\n    mask = df['timestamp'].isna()\n    if mask.any():\n        df.loc[mask, 'timestamp'] = pd.to_datetime(df.loc[mask, 'timestamp'], errors='coerce', dayfirst=False)\n    mask = df['timestamp'].isna()\n    if mask.any():\n        df.loc[mask, 'timestamp'] = pd.to_datetime(df.loc[mask, 'timestamp'], errors='coerce')\n    # numeric\n    for c in df.columns:\n        if c == 'timestamp':\n            continue\n        try:\n            s = df[c].astype(str).str.replace(',', '.', regex=False)\n            df[c] = pd.to_numeric(s, errors='coerce')\n        except:\n            try:\n                df[c] = pd.to_numeric(df[c], errors='coerce')\n            except:\n                pass\n    df = df.dropna(subset=['timestamp'])\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
timestamp=2026-11-09T11:58:33.618Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\nimport sys\nsys.path.insert(0, '/tmp')\nfrom load_prod2 import load_production\n\nfor fid in ['FARM_C', 'FARM_G', 'FARM_I', 'FARM_N', 'FARM_H', 'FARM_A', 'FARM_B']:\n    try:\n        df = load_production(fid)\n        print(f'{fid}: ok n={len(df)} cols={len(df.columns)}')\n    except Exception as e:\n        print(f'ERR {fid}: {e}')\nPY" action.permission=* action.action=allow action.pattern=*
