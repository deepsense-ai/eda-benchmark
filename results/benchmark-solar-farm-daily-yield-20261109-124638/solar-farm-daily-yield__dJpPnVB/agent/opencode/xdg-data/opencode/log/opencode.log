timestamp=2026-11-09T11:56:41.882Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# Build a robust loader\nimport pandas as pd\nimport os\n\ndef load_production(fid):\n    ds = '/app/dataset'\n    pf = f'production_{fid}.csv'\n    path = os.path.join(ds, pf)\n    with open(path, 'rb') as f:\n        b = f.read(2)\n    enc = 'utf-16' if b == b'\\xff\\xfe' or b == b'\\xfe\\xff' else 'utf-8'\n    # try to read\n    try:\n        df = pd.read_csv(path, encoding=enc, sep=None, engine='python', skiprows=3)\n    except:\n        df = pd.read_csv(path, encoding=enc, sep=';', skiprows=3)\n    df.columns = df.columns.str.strip().str.replace('\\t', '')\n    # dedupe columns if needed\n    if len(df.columns) != len(set(df.columns)):\n        cols = []\n        seen = {}\n        for c in df.columns:\n            if c in seen:\n                seen[c] += 1\n                cols.append(f'{c}_{seen[c]}')\n            else:\n                seen[c] = 0\n                cols.append(c)\n        df.columns = cols\n    # parse timestamp\n    df['timestamp'] = pd.to_datetime(df['timestamp'], errors='coerce', dayfirst=False)\n    # try dayfirst variants for European formats\n    mask = df['timestamp'].isna()\n    if mask.any():\n        df.loc[mask, 'timestamp'] = pd.to_datetime(df.loc[mask, 'timestamp'], errors='coerce', dayfirst=True, format='mixed')\n    # general fallback\n    mask = df['timestamp'].isna()\n    if mask.any():\n        df.loc[mask, 'timestamp'] = pd.to_datetime(df.loc[mask, 'timestamp'], errors='coerce')\n    # numeric conversion - handle comma decimals\n    for c in df.columns:\n        if c == 'timestamp':\n            continue\n        try:\n            df[c] = pd.to_numeric(df[c].astype(str).str.replace(',', '.', regex=False), errors='coerce')\n        except:\n            try:\n                df[c] = pd.to_numeric(df[c], errors='coerce')\n            except:\n                pass\n    df = df.dropna(subset=['timestamp'])\n    return df\nPY" action.permission=* action.action=allow action.pattern=*
