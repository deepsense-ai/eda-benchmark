timestamp=2026-11-09T11:53:07.136Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# Now build the full logic. Let us start by collecting all metadata for the 24 farms.\nimport json\nimport pandas as pd\nfrom pathlib import Path\n\nds = Path('/app/dataset')\n\n# registry + farms\ndf_reg = pd.read_csv(ds / 'farm_registry.csv')\ndf_farms = pd.read_csv(ds / 'farms.csv')\ndf_farms.columns = df_farms.columns.str.strip()\ndf_reg.columns = df_reg.columns.str.strip()\ndf_farms['key'] = df_farms['farm_name'].astype(str).str.strip().str.lower()\ndf_reg['key'] = df_reg['farm_name'].astype(str).str.strip().str.lower()\nmerged = pd.merge(df_reg, df_farms, on='key', how='left')\nfarm_meta = {}\nfor _, r in merged.iterrows():\n    farm_meta[r['farm_id']] = {\n        'timezone': r['timezone'],\n        'farm_name': r['farm_name_x'].strip() if 'farm_name_x' in r else str(r['farm_name'])\n    }\n\n# calibration\nwith open(ds / 'sensors_calibration.json') as f:\n    cal = json.load(f)\ncal_farms = cal['enterprise_platform']['deployment_environments']['system_config']['farms']\nPY" action.permission=* action.action=allow action.pattern=*
