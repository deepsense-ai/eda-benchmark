timestamp=2026-11-09T11:50:38.043Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\nimport re\n\ntxt = open('/app/dataset/maintenance_notes.txt').read()\nlines = [l for l in txt.splitlines() if 'Status:' in l]\n\nfor line in lines:\n    status = 'COMPLETED' if 'COMPLETED' in line else 'CANCELLED'\n    if status != 'COMPLETED':\n        continue\n    # extract farm name - look for \"on <Farm Name>\" or \"at <Farm Name>\"\n    # try on first\n    m = re.search(r'(?:on|at)\\s+([A-Za-z\\s]+(?:[A-Z][A-Za-z\\s]+)*)\\s+on\\b', line)\n    if not m:\n        m = re.search(r'(?:on|at)\\s+([A-Za-z\\s]+)\\s+March\\b', line)\n    if not m:\n        # broader\n        m = re.search(r'(?:on|at)\\s+(.+?)\\s+(?:on|March|the\\s+\\d+)', line)\n    farm = m.group(1).strip() if m else None\n    # extract date\n    m = re.search(r'(?:March|the\\s+\\d+(?:st|nd|rd|th)\\s+of\\s+March)\\s+(\\d{1,2})(?:st|nd|rd|th)?', line)\n    if not m:\n        m = re.search(r'March\\s+(\\d{1,2})', line)\n    day = m.group(1) if m else None\n    # times\n    m = re.findall(r'(\\d{1,2}:\\d{2})', line)\n    start, end = m[0], m[1] if len(m) >= 2 else (None, None)\n    print(farm, day, start, end, status)\nPY" action.permission=* action.action=allow action.pattern=*
