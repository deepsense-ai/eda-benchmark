timestamp=2026-11-09T11:47:58.745Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\nimport pandas as pd\nimport os\n\nds = '/app/dataset'\nprod_files = sorted([f for f in os.listdir(ds) if f.startswith('production_')])\n\n# Sample a few\nfor pf in prod_files[:8]:\n    path = os.path.join(ds, pf)\n    enc = 'utf-16' if pf in ['production_FARM_A.csv', 'production_FARM_AA.csv', 'production_FARM_AC.csv'] or ('AE' in pf or 'AF' in pf or 'AG' in pf or 'AH' in pf) else None\n    # just detect\n    if enc is None:\n        # try utf-8 first\n        try:\n            with open(path, 'rb') as f:\n                b = f.read(2)\n            enc = 'utf-16' if b == b'\\xff\\xfe' or b == b'\\xfe\\xff' else 'utf-8'\n        except:\n            enc = 'utf-8'\n    try:\n        # skip first 3 lines (metadata)\n        df = pd.read_csv(path, encoding=enc, sep=None, engine='python', skiprows=3, nrows=1)\n        cols = list(df.columns)\n        print(f'{pf}: {enc}, cols[{cols.index(\"timestamp\") if \"timestamp\" in cols else \"?\"}]=\"timestamp\", ncols={len(cols)}, read_col_sample={cols[15] if len(cols)>15 else cols[-1]}')\n    except Exception as e:\n        print(f'ERR {pf}: {e}')\nPY" action.permission=* action.action=allow action.pattern=*
