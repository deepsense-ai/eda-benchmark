timestamp=2026-11-09T11:55:20.670Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\nfrom zoneinfo import ZoneInfo\nfrom datetime import datetime\n\n# maint: FARM_C (Sakura) on 2024-03-16 08:00-12:00 local (Asia/Tokyo)\n# FARM_F on 2024-03-15 12:00-14:00 local (Europe/Warsaw)\nmaint = [\n  ('FARM_C', 2024, 3, 16, 8, 0, 12, 0),\n  ('FARM_F', 2024, 3, 15, 12, 0, 14, 0),\n]\n\ntz_map = {'FARM_A': 'Europe/Warsaw', 'FARM_B': 'America/Los_Angeles', 'FARM_C': 'Asia/Tokyo', 'FARM_D': 'Pacific/Auckland', 'FARM_E': 'America/Sao_Paulo', 'FARM_F': 'Europe/Warsaw', 'FARM_G': 'Africa/Cairo', 'FARM_H': 'Australia/Sydney', 'FARM_I': 'Asia/Dubai', 'FARM_J': 'Europe/London', 'FARM_K': 'America/New_York', 'FARM_L': 'Asia/Singapore', 'FARM_M': 'Europe/Berlin', 'FARM_N': 'Asia/Tokyo', 'FARM_O': 'America/Toronto', 'FARM_P': 'Europe/Rome', 'FARM_Q': 'Australia/Melbourne', 'FARM_R': 'America/Chicago', 'FARM_S': 'Asia/Shanghai', 'FARM_T': 'Europe/Madrid', 'FARM_U': 'Asia/Kolkata', 'FARM_V': 'America/Mexico_City', 'FARM_W': 'Europe/Paris', 'FARM_X': 'Africa/Johannesburg'}\n\nfor fid, y, m, d, sh, sm, eh, em in maint:\n    tz = ZoneInfo(tz_map[fid])\n    start = datetime(y, m, d, sh, sm, tzinfo=tz)\n    end = datetime(y, m, d, eh, em, tzinfo=tz)\n    start_utc = start.astimezone(ZoneInfo('UTC'))\n    end_utc = end.astimezone(ZoneInfo('UTC'))\n    print(fid, start, '->', start_utc, '  |  ', end, '->', end_utc)\nPY" action.permission=* action.action=allow action.pattern=*
timestamp=2026-11-09T11:55:20.670Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="tail -30" action.permission=* action.action=allow action.pattern=*
