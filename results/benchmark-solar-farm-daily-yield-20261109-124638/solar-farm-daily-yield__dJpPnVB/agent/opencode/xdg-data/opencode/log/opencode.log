timestamp=2026-11-09T11:51:51.259Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\nimport json\nimport os\n\nwith open('/app/dataset/sensors_calibration.json') as f:\n    cal = json.load(f)\nfarms = cal['enterprise_platform']['deployment_environments']['system_config']['farms']\ncal_keys = sorted(farms.keys())\n# from files\nfiles = sorted([f for f in os.listdir('/app/dataset') if f.startswith('production_')])\nfile_farms = []\nfor fname in files:\n    # extract FARM_XXX\n    import re\n    m = re.search(r'(FARM_[A-Z]+)', fname)\n    if m:\n        file_farms.append(m.group(1))\nfile_farms = sorted(set(file_farms))\nprint('cal:', len(cal_keys), cal_keys[:5])\nprint('files:', len(file_farms), file_farms[:5], '...', file_farms[-5:])\nPY" action.permission=* action.action=allow action.pattern=*
