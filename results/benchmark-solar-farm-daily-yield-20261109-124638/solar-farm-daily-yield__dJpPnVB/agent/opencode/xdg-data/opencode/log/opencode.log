timestamp=2026-11-09T12:05:55.487Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="cat >> /app/answer.py << 'PY'\n\ndef compute_farm_total(farm_id):\n    if farm_id not in cal_farms:\n        return 0\n    cfg = cal_farms[farm_id]\n    vcol_cfg = cfg['calibration_data']['value_column_name']\n    offset = float(cfg['calibration_data']['calibration_offset'])\n    unit = cfg['sensor_info']['unit']\n    reading_type = cfg['sensor_info']['reading_type']  # 'energy' or 'power'\n\n    # load data\n    try:\n        df = load_production(farm_id)\n    except Exception as e:\n        return 0\n\n    if df.empty:\n        return 0\n\n    # ensure timestamps are timezone-aware (UTC) for comparison\n    if df['timestamp'].dt.tz is None:\n        df['timestamp'] = df['timestamp'].dt.tz_localize('UTC')\n    else:\n        df['timestamp'] = df['timestamp'].dt.tz_convert('UTC')\n\n    # filter to reporting day UTC [day_start, day_end)\n    mask_day = (df['timestamp'] >= day_start) & (df['timestamp'] < day_end)\n    df = df.loc[mask_day].copy()\n    if df.empty:\n        return 0\n\n    # exclude readings during maintenance windows for this farm\n    for mid, mstart, mend in maint_list:\n        if mid == farm_id:\n            # drop readings that fall within [mstart, mend)\n            msk = (df['timestamp'] >= mstart) & (df['timestamp'] < mend)\n            df = df.loc[~msk].copy()\n    if df.empty:\n        return 0\n\n    # drop duplicates (pandas drop_duplicates as required)\n    df = df.drop_duplicates()\n\n    # get value column - find the recorded value column\n    vcol = _get_value_column(df, vcol_cfg)\n    if vcol is None:\n        # try common names\n        candidates = [c for c in df.columns if 'read' in c or 'power' in c or 'yield' in c or 'value' in c or 'energy' in c or 'kw' in c or 'wh' in c or 'output' in c or 'generation' in c]\n        vcol = candidates[0] if candidates else None\n    if vcol is None or vcol not in df.columns:\n        return 0\n\n    # get recorded values\n    vals = df[vcol].copy()\n    # convert to numeric if not already\n    vals = pd.to_numeric(vals, errors='coerce')\n    df = df.loc[~vals.isna()].copy()\n    vals = vals.loc[~vals.isna()].copy()\n    if len(vals) == 0:\n        return 0\n\n    # apply calibration: true value = recorded value - calibration_offset\n    true_vals = vals - offset\n\n    # any value that is negative must be dropped - this rule is valid only after calibration offset is applied\n    true_vals = true_vals[true_vals >= 0]\n    if true_vals.empty:\n        return 0\n\n    # now compute total energy in kWh for the reporting window\n    total_kwh = 0.0\n    if reading_type == 'energy':\n        # energy reading - sum energy over the window? depends on units\n        # units given: KwH, MwH, WH, Kwh, kWh, etc.\n        unit_norm = str(unit).strip().lower()\n        # sum the energy values as given, converted to kWh\n        if unit_norm in ('kwh', 'kwh', 'kw h', 'kw-h'):\n            total_kwh = float(true_vals.sum())\n        elif unit_norm in ('mwh', 'mw h', 'mw-h'):\n            total_kwh = float(true_vals.sum() * 1000.0)\n        elif unit_norm in ('wh', 'w h', 'w-h'):\n            total_kwh = float(true_vals.sum() / 1000.0)\n        elif unit_norm in ('btu', 'btu'):\n            # btu is a unit of energy - convert to kWh? 1 kWh = 3412.14163 BTU approx\n            total_kwh = float(true_vals.sum() / 3412.14163)\n        else:\n            # default assume kWh\n            total_kwh = float(true_vals.sum())\n    else:\n        # power reading (e.g., kw) - energy = power * time integrated over intervals\n        # sum power * interval_hours\n        df_sel = df.loc[true_vals.index].copy()\n        # compute intervals in hours\n        if len(df_sel) >= 1:\n            # use time difference to next/prev; if regular intervals, use median\n            t = df_sel['timestamp'].sort_values()\n            dt_hours = (t.diff().dt.total_seconds() / 3600.0).fillna(method='bfill') if hasattr(t.diff().dt, 'total_seconds') else (t.diff().astype('timedelta64[s]') / 3600.0).fillna(method='bfill')\n            # simpler\n            dt = t.diff().dt.total_seconds().fillna(0) / 3600.0\n            if dt.iloc[0] == 0 and len(dt) > 1:\n                dt.iloc[0] = dt.iloc[1] if dt.iloc[1] > 0 else dt.median()\n            # if still zeros, use median\n            if (dt == 0).any():\n                dt[dt == 0] = dt[dt > 0].median() if (dt > 0).any() else (30.0 / 60.0)\n            unit_norm = str(unit).strip().lower()\n            power_vals = true_vals.copy()\n            if unit_norm in ('kw', 'kilowatt', 'kilowatts'):\n                energy_vals = power_vals * dt.values\n            elif unit_norm in ('mw', 'megawatt'):\n                energy_vals = power_vals * 1000.0 * dt.values\n            elif unit_norm in ('w', 'watt'):\n                energy_vals = power_vals * dt.values / 1000.0\n            else:\n                energy_vals = power_vals * dt.values\n            total_kwh = float(energy_vals.sum())\n        else:\n            total_kwh = 0.0\n\n    # round to nearest integer with Python's round()\n    total_kwh_rounded = int(round(total_kwh)) if not (pd.isna(total_kwh) or np.isinf(total_kwh)) else 0\n    if total_kwh_rounded < 0:\n        total_kwh_rounded = 0\n    return total_kwh_rounded\nPY" action.permission=* action.action=allow action.pattern=*
