timestamp=2026-11-09T11:52:01.505Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# Which farms in files have no calibration?\nimport json\nimport os\nimport re\n\nwith open('/app/dataset/sensors_calibration.json') as f:\n    cal = json.load(f)\ncal_keys = set(cal['enterprise_platform']['deployment_environments']['system_config']['farms'].keys())\n\nfiles = sorted([f for f in os.listdir('/app/dataset') if f.startswith('production_')])\nfor fname in files:\n    m = re.search(r'(FARM_[A-Z]+)', fname)\n    fid = m.group(1) if m else fname\n    if fid not in cal_keys:\n        print(fid, fname)\nPY" action.permission=* action.action=allow action.pattern=*
