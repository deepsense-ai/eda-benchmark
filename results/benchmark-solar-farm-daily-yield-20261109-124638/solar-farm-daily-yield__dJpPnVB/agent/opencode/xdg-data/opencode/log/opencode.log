timestamp=2026-11-09T11:48:09.154Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# Check encodings more systematically\nimport os\n\nds = '/app/dataset'\nprod_files = sorted([f for f in os.listdir(ds) if f.startswith('production_')])\n# FARM_A is utf-16 BOM, AA utf-16, AC utf-16, AE utf-16, AG utf-16 (BOM marked)\n# Others like AB, AD, AF? are utf-8? Or different\nfor pf in prod_files:\n    path = os.path.join(ds, pf)\n    with open(path, 'rb') as f:\n        b = f.read(3)\n    enc = 'utf-16' if b[:2] in (b'\\xff\\xfe', b'\\xfe\\xff') else ('utf-8-sig' if b[:3] == b'\\xef\\xbb\\xbf' else 'utf-8')\n    print(f'{pf}: {enc}')\nPY" action.permission=* action.action=allow action.pattern=*
