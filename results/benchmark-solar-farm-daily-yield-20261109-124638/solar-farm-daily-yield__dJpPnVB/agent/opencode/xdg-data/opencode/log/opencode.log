timestamp=2026-11-09T11:54:28.548Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# Build maintenance windows with timezone conversion\nfrom datetime import datetime\nimport pytz\n\n# we need tz for each farm\n# get tz from farms.csv + reg\nimport pandas as pd\n\ndf_reg = pd.read_csv('/app/dataset/farm_registry.csv')\ndf_farms = pd.read_csv('/app/dataset/farms.csv')\ndf_farms.columns = df_farms.columns.str.strip()\ndf_reg.columns = df_reg.columns.str.strip()\nreg_map = {}\nfor _, r in df_reg.iterrows():\n    reg_map[str(r['farm_name']).strip().lower()] = r['farm_id']\ntz_map = {}\nfor _, r in df_farms.iterrows():\n    k = str(r['farm_name']).strip().lower()\n    if k in reg_map:\n        fid = reg_map[k]\n        tz_map[fid] = r['timezone']\ntz_map\nPY" action.permission=* action.action=allow action.pattern=*
