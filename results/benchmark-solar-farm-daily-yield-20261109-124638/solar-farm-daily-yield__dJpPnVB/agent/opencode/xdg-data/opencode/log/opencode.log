timestamp=2026-11-09T11:52:07.650Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\n# So 10 farms have production files but no calibration in the given calibration JSON.\n# What about their details in farms.csv/farm_registry? Let us check registry and farms for these.\nimport pandas as pd\n\ndf_reg = pd.read_csv('/app/dataset/farm_registry.csv')\ndf_farms = pd.read_csv('/app/dataset/farms.csv')\ndf_farms.columns = df_farms.columns.str.strip()\ndf_reg.columns = df_reg.columns.str.strip()\ndf_farms['key'] = df_farms['farm_name'].astype(str).str.strip().str.lower()\ndf_reg['key'] = df_reg['farm_name'].astype(str).str.strip().str.lower()\n\nextra = ['FARM_AA', 'FARM_AB', 'FARM_AC', 'FARM_AD', 'FARM_AE', 'FARM_AF', 'FARM_AG', 'FARM_AH', 'FARM_Y', 'FARM_Z']\nfor fid in extra:\n    # find in reg\n    row = df_reg[df_reg['farm_id'] == fid]\n    if not row.empty:\n        print(fid, 'reg:', row['farm_name'].iloc[0])\n    else:\n        print(fid, 'NO REG')\nPY" action.permission=* action.action=allow action.pattern=*
