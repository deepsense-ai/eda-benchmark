timestamp=2026-11-09T12:12:46.552Z level=INFO run=1ef60999 message=evaluated permission=bash pattern="python3 << 'PY'\nimport sys\nsys.path.insert(0, '/tmp')\nfrom loader2 import load_production\nimport pandas as pd\n\ndf = load_production('FARM_F')\nfrom datetime import datetime\nfrom zoneinfo import ZoneInfo\nday_start = datetime(2024, 3, 15, 0, 0, tzinfo=ZoneInfo('UTC'))\nday_end = datetime(2024, 3, 16, 0, 0, tzinfo=ZoneInfo('UTC'))\nif df['timestamp'].dt.tz is None:\n    df['timestamp'] = df['timestamp'].dt.tz_localize('UTC')\nelse:\n    df['timestamp'] = df['timestamp'].dt.tz_convert('UTC')\ndfd = df[(df['timestamp']>=day_start)&(df['timestamp']<day_end)].copy()\n# apply maint\nmstart = datetime(2024, 3, 15, 11, 0, tzinfo=ZoneInfo('UTC'))\nmend = datetime(2024, 3, 15, 13, 0, tzinfo=ZoneInfo('UTC'))\ndfd = dfd[~((dfd['timestamp']>=mstart)&(dfd['timestamp']<mend))]\ndfd = dfd.drop_duplicates()\ndfd = dfd.sort_values('timestamp')\n# look at values\nprint(dfd['output'].head(3), '...', dfd['output'].tail(3))\nPY" action.permission=* action.action=allow action.pattern=*
